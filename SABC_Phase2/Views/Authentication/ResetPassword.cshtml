@using SABC_Phase2.Models.Administrator
@model ResetPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reset Password</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: #ededed url('/lib/Images/bg.png') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        .center-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .main-panel {
            background: #181818;
            border-radius: 32px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
            width: 700px;
            max-width: 95vw;
            padding: 0 0 40px 0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .logo-container {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top: 32px;
            margin-bottom: 16px;
        }

            .logo-container img {
                width: 160px;
                margin-bottom: 8px;
            }

        .form-panel {
            background: #444;
            border-radius: 16px;
            width: 90%;
            margin-top: 0;
            display: flex;
            flex-direction: row;
            padding: 32px 32px 24px 32px;
            box-sizing: border-box;
        }

        .form-left {
            flex: 1;
            margin-right: 32px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-label {
            color: #f9a825;
            font-weight: 600;
            margin-bottom: 6px;
            font-size: 1rem;
        }

        .form-control {
            width: 100%;
            padding: 10px 0;
            border: none;
            border-bottom: 2px solid #bbb;
            background: transparent;
            color: #fff;
            font-size: 1.1rem;
            margin-bottom: 24px;
            outline: none;
            transition: border-color 0.2s;
        }

            .form-control:focus {
                border-bottom: 2px solid #f9a825;
            }

        .submit-btn {
            width: 60%;
            margin: 0 auto;
            padding: 12px 0;
            border: none;
            border-radius: 25px;
            background: #f9a825;
            color: #fff;
            font-weight: bold;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background 0.2s;
            display: block;
            margin-top: 12px;
        }

            .submit-btn:hover {
                background: #ffd54f;
                color: #181818;
            }

        .error-list {
            margin-top: 10px;
            padding-left: 0;
            list-style: none;
        }

            .error-list li {
                color: #f44336;
                font-size: 0.95rem;
            }

        .form-right {
            flex: 1;
            padding-left: 32px;
            border-left: 1px solid #666;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .requirements-title {
            color: #f9a825;
            font-weight: 600;
            margin-bottom: 12px;
            font-size: 1.05rem;
        }

        .password-rules {
            color: #bbb;
            font-size: 0.98rem;
            list-style: none;
            padding-left: 0;
        }

            .password-rules li {
                margin-bottom: 8px;
                transition: color 0.2s;
            }

        @@media (max-width: 900px) {
            .main-panel {
                width: 98vw;
            }

            .form-panel {
                flex-direction: column;
            }

            .form-left, .form-right {
                margin-right: 0;
                padding-left: 0;
                border-left: none;
            }

            .form-right {
                margin-top: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="center-container">
        <div class="main-panel">
            <div class="logo-container">
                <img src="/lib/Images/logo.png" alt="SABC Logo" />
            </div>
            <div class="form-panel">
                <div class="form-left">
                    <form asp-action="ResetPassword" method="post" id="resetPasswordForm" autocomplete="off">
                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="Email" />

                        <label class="form-label" for="NewPassword">New Password</label>
                        <input type="password" asp-for="NewPassword" id="NewPassword" class="form-control" required />

                        <label class="form-label" for="ConfirmPassword">Confirm Password</label>
                        <input type="password" asp-for="ConfirmPassword" id="ConfirmPassword" class="form-control" required />

                        <button type="submit" class="submit-btn">Submit</button>
                    </form>
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <ul class="error-list">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    }
                </div>
                <div class="form-right">
                    <div class="requirements-title">Password requirements</div>
                    <ul id="passwordRules" class="password-rules">
                        <li id="lengthRule">❌ Must be 8 to 15 characters long</li>
                        <li id="lowerRule">❌ Must contain a lowercase letter</li>
                        <li id="upperRule">❌ Must contain an uppercase letter</li>
                        <li id="numberRule">❌ Must contain a number</li>
                        <li id="specialRule">❌ Must contain special character</li>
                        <li id="matchRule">❌ Passwords must match</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script>
        const newPassword = document.getElementById("NewPassword");
        const confirmPassword = document.getElementById("ConfirmPassword");
        const lengthRule = document.getElementById("lengthRule");
        const lowerRule = document.getElementById("lowerRule");
        const upperRule = document.getElementById("upperRule");
        const numberRule = document.getElementById("numberRule");
        const specialRule = document.getElementById("specialRule");
        const matchRule = document.getElementById("matchRule");

        function validatePassword() {
            const pwd = newPassword.value;
            const confirmPwd = confirmPassword.value;

            updateRule(lengthRule, pwd.length >= 8 && pwd.length <= 15);
            updateRule(lowerRule, /[a-z]/.test(pwd));
            updateRule(upperRule, /[A-Z]/.test(pwd));
            updateRule(numberRule, /\d/.test(pwd));
            updateRule(specialRule, /[^a-zA-Z0-9]/.test(pwd));
            updateRule(matchRule, pwd && pwd === confirmPwd);
        }

        function updateRule(element, isValid) {
            if (isValid) {
                element.textContent = "✔ " + element.textContent.replace(/^[❌✔] /, "");
                element.style.color = "#f9a825";
            } else {
                element.textContent = "❌ " + element.textContent.replace(/^[❌✔] /, "");
                element.style.color = "#bbb";
            }
        }

        newPassword.addEventListener("input", validatePassword);
        confirmPassword.addEventListener("input", validatePassword);
    </script>
</body>
</html>