@model List<SABC_Phase2.Models.Tender.ScheduledTender>

@{
    ViewData["BannerText"] = "Scheduled Tenders";
    int pageSize = ViewBag.PageSize ?? 7;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalItems = ViewBag.TotalItems ?? Model.Count;
    int totalPages = ViewBag.TotalPages ?? 1;
    int emptyRows = pageSize - Model.Count;

    var saTimeZone = TimeZoneInfo.FindSystemTimeZoneById("South Africa Standard Time");
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

<div class="breadcrumb-custom">
    <span class="breadcrumb-active">Scheduled Tenders</span>
</div>

<div class="tender-action-bar">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" class="search-input" placeholder="Search keyword" />
    </div>
    <select class="filter-dropdown">
        <option value="all">ALL</option>
        <option value="scheduled">Scheduled</option>
    </select>
    <button class="refresh-btn">
        <i class="fas fa-sync-alt"></i>
    </button>
    <button class="new-tender-btn" onclick="window.location.href='@Url.Action("Create", "TenderAdmin")'">
        <i class="fas fa-plus"></i> New Tender
    </button>
</div>

<div class="table-container">
    <div class="table-scroll-container">
        <table class="tender-table">
            <thead>
                <tr>
                    <th>THUMBNAILS</th>
                    <th>TITLES</th>
                    <th>TENDER STATUS</th>
                    <th>SCHEDULED PUBLISH <i class="fas fa-sort"></i></th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tender in Model)
                {
                    var localTime = TimeZoneInfo.ConvertTimeFromUtc(tender.ScheduledPublishDateTime, saTimeZone);
                    <tr>
                        <td>
                            <img src="~/lib/Images/logoblack.png" class="tender-thumbnail" alt="SABC Logo" />
                        </td>
                        <td>@tender.Title</td>
                        <td>
                            <span class="tender-status tender-status-scheduled">
                                @tender.Status
                            </span>
                        </td>
                        <td>@localTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a asp-controller="TenderAdmin" asp-action="EditScheduled" asp-route-id="@tender.Id" class="edit-btn">Edit <i class="fas fa-edit"></i></a>
                        </td>
                    </tr>
                }
                @for (int i = 0; i < emptyRows; i++)
                {
                    <tr>
                        <td colspan="5" style="background:transparent; border:none;"></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1){
<div class="custom-pagination">
    <ul class="pagination-list">
        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
            <a class="page-link arrow-link"
               href="?page=@(currentPage - 1)"
               tabindex="@(currentPage == 1 ? "-1" : "0")"
               aria-label="Previous">
                <span aria-hidden="true">&#8592;</span>
            </a>
        </li>
        @if (currentPage > 3)
        {
            <li class="page-item">
                <a class="page-link" href="?page=1">1</a>
            </li>
            @if (currentPage > 4)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
        }
        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
        {
            if (i == currentPage)
            {
                <li class="page-item active">
                    <span class="page-link"><span class="page-number">@i</span></span>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
        }
        @if (currentPage < totalPages - 2)
        {
            if (currentPage < totalPages - 3)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
            <li class="page-item">
                <a class="page-link" href="?page=@totalPages">@totalPages</a>
            </li>
        }
        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
            <a class="page-link arrow-link"
               href="?page=@(currentPage + 1)"
               tabindex="@(currentPage == totalPages ? "-1" : "0")"
               aria-label="Next">
                <span aria-hidden="true">&#8594;</span>
            </a>
        </li>
    </ul>
</div>
}


