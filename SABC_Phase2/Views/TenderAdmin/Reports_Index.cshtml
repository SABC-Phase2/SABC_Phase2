@model List<SABC_Phase2.Models.Tender.Tender>

@{
    ViewData["BannerText"] = "Reports";
    var closedTenders = Model?.Where(t => t.Status != null && t.Status.ToLower().Contains("closed")).ToList() ?? new List<SABC_Phase2.Models.Tender.Tender>();
    int tendersPerRow = 4;
    int maxRows = 2;
    int maxTenders = tendersPerRow * maxRows;
    var displayTenders = closedTenders.Take(maxTenders).ToList();
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
<!-- Add this modal HTML (similar to the PDF one but with different ID) -->
<!-- Calendar Date Range Picker Modal -->
<div id="newReportModal" class="modal">
    <div class="modal-content calendar-modal">
        <div class="modal-header centered-header">
            <div class="modal-header-text">
                <h1 class="modal-tender-title">Closed Tenders Summary</h1>
                <h3 class="modal-subtitle">Select the duration for the report</h3>
            </div>
            <span class="close">&times;</span>
        </div>

        <div class="modal-body">
            <div class="calendar-controls">
                <button id="prevMonth" class="month-nav">&lt;</button>
                <div class="month-header">
                    <span id="currentMonth">Month Year</span>
                </div>
                <button id="nextMonth" class="month-nav">&gt;</button>
            </div>

            <div class="calendar">
                <div class="calendar-header weekdays-row">
                    <div>S</div>
                    <div>M</div>
                    <div>T</div>
                    <div>W</div>
                    <div>T</div>
                    <div>F</div>
                    <div>S</div>
                </div>
                <div class="calendar-body" id="calendarDays">
                    <!-- Calendar days go here -->
                </div>
            </div>

            <div class="selected-dates">
                <div>Start Date: <span id="startDateDisplay">Not selected</span></div>
                <div>End Date: <span id="endDateDisplay">Not selected</span></div>
            </div>
        </div>

        <div class="modal-footer">
            <button id="clearSelection" class="btn-clear">Clear</button>
            <button id="generateReportBtn" class="btn-generate">Done</button>
        </div>
    </div>
</div>

<!-- Your existing report action bar -->
<div class="report-action-bar">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" class="search-input" placeholder="Search keyword" />
    </div>
    <button class="new-tender-btn" id="newReportBtn">
        <i class="fas fa-plus"></i> New Report
    </button>
</div>


<div class="card report-card">
    <div class="card-header">
        <div class="label-toggle-wrap">
            <label class="closed-label">Closed Tenders</label>
        </div>

        <div class="view-toggle-buttons">
            <button id="gridViewBtn" class="view-toggle active" title="Grid View">
                <i class="fas fa-th"></i>
            </button>
            <button id="listViewBtn" class="view-toggle" title="List View">
                <i class="fas fa-list"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (!displayTenders.Any())
        {
            <div class="no-tenders">No closed tenders found.</div>
        }
        else
        {
            <div class="tender-blocks-container">
                @for (int i = 0; i < displayTenders.Count; i += tendersPerRow)
                {
                    <div class="tender-block-row">
                        @foreach (var tender in displayTenders.Skip(i).Take(tendersPerRow))
                        {
                            <a href="@Url.Action("tender_Report", "TenderAdmin", new { id = tender.Id })" style="text-decoration:none; color:inherit;">
                                <div class="tender-block">
                                    <div class="tender-block-logo-wrap">
                                        <img src="~/lib/Images/logoblack.png" class="tender-block-thumbnail" alt="SABC Logo" />
                                        <span class="tender-block-status">CLOSED</span>
                                    </div>
                                    <div class="tender-block-content">
                                        <div class="tender-block-number">@tender.TenderNumber</div>
                                        <div class="tender-block-title">
                                            @(tender.Title?.Length > 60 ? tender.Title.Substring(0, 57) + "..." : tender.Title)
                                        </div>
                                        <div class="tender-block-closing">
                                            CLOSING DATE: <span class="closing-red">@tender.ClosingDate.ToString("dd MMM yyyy")</span>
                                            TIME: <span class="closing-red">@tender.ClosingTime?.ToString(@"hh\:mm")</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
          // Elements
          const modal = document.getElementById("newReportModal");
          const openBtn = document.getElementById("newReportBtn");
          const closeBtn = modal.querySelector(".close");
          const prevMonthBtn = document.getElementById("prevMonth");
          const nextMonthBtn = document.getElementById("nextMonth");
          const currentMonthEl = document.getElementById("currentMonth");
          const calendarDays = document.getElementById("calendarDays");
          const startDateDisplay = document.getElementById("startDateDisplay");
          const endDateDisplay = document.getElementById("endDateDisplay");
          const clearSelectionBtn = document.getElementById("clearSelection");
          const generateReportBtn = document.getElementById("generateReportBtn");

          let currentDate = new Date();
          let startDate = null;
          let endDate = null;

          // Show modal
          openBtn.onclick = function () {
              renderCalendar();
              modal.style.display = "block";
          };

          // Close modal
          closeBtn.onclick = function () {
              modal.style.display = "none";
          };

          // Close on outside click
          window.onclick = function (event) {
              if (event.target === modal) {
                  modal.style.display = "none";
              }
          };

          // Month navigation
          prevMonthBtn.addEventListener("click", () => {
              currentDate.setMonth(currentDate.getMonth() - 1);
              renderCalendar();
          });

          nextMonthBtn.addEventListener("click", () => {
              currentDate.setMonth(currentDate.getMonth() + 1);
              renderCalendar();
          });

          // Clear selection
          clearSelectionBtn.addEventListener("click", () => {
              startDate = null;
              endDate = null;
              updateDateDisplays();
              renderCalendar();
          });

          // Render calendar
          function renderCalendar() {
              currentMonthEl.textContent = currentDate.toLocaleDateString("en-US", {
                  month: "long",
                  year: "numeric"
              });

              calendarDays.innerHTML = "";

              const year = currentDate.getFullYear();
              const month = currentDate.getMonth();

              const firstDay = new Date(year, month, 1).getDay();
              const totalDays = new Date(year, month + 1, 0).getDate();
              const prevMonthLastDate = new Date(year, month, 0).getDate();

              let dateCounter = 1;
              let nextMonthDay = 1;

              for (let i = 0; i < 6; i++) {
                  const row = document.createElement("div");
                  row.classList.add("week");

                  for (let j = 0; j < 7; j++) {
                      const dayCell = document.createElement("div");
                      dayCell.classList.add("day");

                      if (i === 0 && j < firstDay) {
                          dayCell.textContent = prevMonthLastDate - (firstDay - j - 1);
                          dayCell.classList.add("other-month");
                      } else if (dateCounter > totalDays) {
                          dayCell.textContent = nextMonthDay++;
                          dayCell.classList.add("other-month");
                      } else {
                          const thisDate = new Date(year, month, dateCounter);
                          dayCell.textContent = dateCounter;

                          if (startDate && isSameDay(thisDate, startDate)) {
                              dayCell.classList.add("selected");
                          } else if (endDate && isSameDay(thisDate, endDate)) {
                              dayCell.classList.add("selected");
                          } else if (startDate && endDate && thisDate > startDate && thisDate < endDate) {
                              dayCell.classList.add("in-range");
                          }

                          dayCell.addEventListener("click", () => selectDate(thisDate));
                          dateCounter++;
                      }

                      row.appendChild(dayCell);
                  }

                  calendarDays.appendChild(row);
              }
          }

          // Handle date selection
          function selectDate(date) {
              if (!startDate || (startDate && endDate)) {
                  startDate = new Date(date);
                  endDate = null;
              } else if (date < startDate) {
                  endDate = new Date(startDate);
                  startDate = new Date(date);
              } else {
                  endDate = new Date(date);
              }

              updateDateDisplays();
              renderCalendar();
          }

          function updateDateDisplays() {
              startDateDisplay.textContent = startDate
                  ? startDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
                  : "Not selected";

              endDateDisplay.textContent = endDate
                  ? endDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
                  : "Not selected";
          }

          function isSameDay(d1, d2) {
              return d1.getFullYear() === d2.getFullYear() &&
                     d1.getMonth() === d2.getMonth() &&
                     d1.getDate() === d2.getDate();
          }

          // Generate report
          generateReportBtn.addEventListener("click", () => {
              if (!startDate || !endDate) {
                  alert("Please select both start and end dates.");
                  return;
              }

              const startDateIso = startDate.toISOString();
              const endDateIso = endDate.toISOString();

              const url = '@Url.Action("GenerateClosedTendersSummaryReport", "TenderAdmin")' +
                  '?startDate=' + encodeURIComponent(startDateIso) +
                  '&endDate=' + encodeURIComponent(endDateIso);

              window.open(url, '_blank');
              modal.style.display = "none";
          });
      });

      document.addEventListener("DOMContentLoaded", function () {
        const gridBtn = document.getElementById("gridViewBtn");
        const listBtn = document.getElementById("listViewBtn");
        const tenderContainer = document.querySelector(".tender-blocks-container");

        gridBtn.addEventListener("click", function () {
            tenderContainer.classList.remove("list-view");
            gridBtn.classList.add("active");
            listBtn.classList.remove("active");
        });

        listBtn.addEventListener("click", function () {
            tenderContainer.classList.add("list-view");
            listBtn.classList.add("active");
            gridBtn.classList.remove("active");
        });
    });
</script>

<style>

    /* Modal container */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 50px;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(2px);
    }

    /* Modal content */
    .modal-content {
        background-color: #fff;
        margin: 5% auto;
        padding: 40px 30px;
        border-radius: 16px;
        width: 90%;
        max-width: 700px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        font-family: 'Segoe UI', sans-serif;
    }

    /* Header */
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .modal-header-text {
        flex-grow: 1;
        text-align: center;
    }

    .modal-tender-title {
        font-size: 2.3rem;
        font-weight: 700;
        color: #00a651;
        margin-bottom: 10px;
        text-align: center;
    }

    .modal-subtitle {
        font-size: 1rem;
        font-weight: 500;
        text-align: center;
        color: #444;
    }

    .close {
        color: #ccc;
        font-size: 24px;
        font-weight: bold;
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .close:hover {
            color: #333;
        }

    /* Calendar Controls */
    .calendar-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .month-header {
        font-size: 1.2rem;
        font-weight: 600;
        color: #333;
    }

    .month-nav {
        background: none;
        border: none;
        font-size: 20px;
        color: #00a651;
        cursor: pointer;
    }

    /* Calendar Structure */
    .calendar {
        width: 100%;
    }

    .calendar-header {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
        font-weight: 600;
        color: #666;
        background-color: #f5f5f5;
        padding: 8px 0;
        border-radius: 4px;
        margin-bottom: 8px;
    }

    .calendar-body {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .week {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
    }

    .day {
        padding: 10px 0;
        cursor: pointer;
        transition: background 0.2s ease;
        border-radius: 6px;
        font-size: 0.95rem;
        color: #333;
    }

        .day:hover {
            background-color: #f0f0f0;
        }

        .day.selected,
        .day.start,
        .day.end {
            background-color: #00a651;
            color: #fff;
            font-weight: bold;
            border-radius: 50%;
        }

        .day.in-range {
            background-color: #e6f7ef;
        }

    .other-month {
        color: #ccc;
    }

    /* Date display */
    .selected-dates {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid #eee;
        font-size: 0.95rem;
        color: #555;
        display: flex;
        justify-content: space-between;
    }

        .selected-dates span {
            font-weight: 600;
            color: #00a651;
        }

    /* Footer */
    .modal-footer {
        margin-top: 30px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #eee;
        padding-top: 16px;
    }

    /* Buttons */
    .btn-generate {
        background-color: #00a651;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 12px 28px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .btn-generate:hover {
            background-color: #008f47;
        }

    .btn-clear {
        background-color: #f5f5f5;
        color: #333;
        border: none;
        border-radius: 8px;
        padding: 12px 20px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .btn-clear:hover {
            background-color: #e4e4e4;
        }

    .btn-generate {
        background: #00a651;
