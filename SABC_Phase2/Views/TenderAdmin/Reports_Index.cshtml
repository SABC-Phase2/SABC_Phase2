        }

        .day.selected,
        .day.start,
        .day.end {
            background-color: #00a651;
            color: #fff;
            font-weight: bold;
            border-radius: 50%;
        }

        .day.in-range {
            background-color: #e6f7ef;
        }

    .other-month {
        color: #ccc;
    }

    /* Date display */
    .selected-dates {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid #eee;
        font-size: 0.95rem;
        color: #555;
        display: flex;
        justify-content: space-between;
    }

        .selected-dates span {
            font-weight: 600;
            color: #00a651;
        }

    /* Footer */
    .modal-footer {
        margin-top: 30px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #eee;
        padding-top: 16px;
    }

    /* Buttons */
    .btn-generate {
        background-color: #00a651;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 12px 28px;
        font-size: 1rem;
