@model List<SABC_Phase2.Models.Tender.Tender>

@{
    ViewData["BannerText"] = "Reports";
    var closedTenders = Model ?? new List<SABC_Phase2.Models.Tender.Tender>();
    string search = ViewBag.Search as string ?? "";
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />

<!-- Calendar Date Range Picker Modal -->
<div id="newReportModal" class="modal">
    <div class="modal-content calendar-modal">
        <div class="modal-header centered-header">
            <div class="modal-header-text">
                <h1 class="modal-tender-title">Closed Tenders Summary</h1>
                <h3 class="modal-subtitle">Select the duration for the report</h3>
            </div>
            <span class="close">&times;</span>
        </div>

        <div class="modal-body">
            <div class="calendar-controls">
                <button id="prevMonth" class="month-nav">&lt;</button>
                <div class="month-header">
                    <span id="currentMonth">Month Year</span>
                </div>
                <button id="nextMonth" class="month-nav">&gt;</button>
            </div>

            <div class="calendar">
                <div class="calendar-header weekdays-row">
                    <div>S</div>
                    <div>M</div>
                    <div>T</div>
                    <div>W</div>
                    <div>T</div>
                    <div>F</div>
                    <div>S</div>
                </div>
                <div class="calendar-body" id="calendarDays">
                    <!-- Calendar days go here -->
                </div>
            </div>

            <div class="selected-dates">
                <div>Start Date: <span id="startDateDisplay">Not selected</span></div>
                <div>End Date: <span id="endDateDisplay">Not selected</span></div>
            </div>
        </div>

        <div class="modal-footer">
            <button id="clearSelection" class="btn-clear">Clear</button>
            <button id="generateReportBtn" class="btn-generate">Done</button>
        </div>
    </div>
</div>

<div class="report-action-bar">
    <form method="get" id="reportFilterForm" style="display: flex; align-items: center; gap: 16px;">
        <span class="search-wrapper" style="position: relative; display: flex; align-items: center;">
            <i class="fas fa-search" style="position:absolute; left:12px; color:#ccc; font-size:1rem;"></i>
            <input type="text" name="search" class="search-input"
                   value="@search"
                   placeholder="   Search keyword"
                   autocomplete="off"
                   style="padding-left: 38px;" />
        </span>
    </form>
    <button class="new-tender-btn" id="newReportBtn">
        <i class="fas fa-plus"></i> New Report
    </button>
</div>

<div id="reports-table">
    @await Html.PartialAsync("Tender_Admin_ReportsTablePartial", Model)
</div>

<script>
    // Debounce function
    function debounce(fn, delay) {
        let timer = null;
        return function(...args) {
            clearTimeout(timer);
            timer = setTimeout(() => fn.apply(this, args), delay);
        };
    }

    // Form submission for reports
    function submitReportForm(keepPage = false) {
        const form = document.getElementById('reportFilterForm');
        if(!keepPage) {
            let pageInput = document.createElement('input');
            pageInput.type = "hidden";
            pageInput.name = "page";
            pageInput.value = "1";
            form.appendChild(pageInput);
        }
        const data = new URLSearchParams(new FormData(form)).toString();

        fetch('@Url.Action("Reports_Index", "TenderAdmin")' + '?' + data, {
            headers: { "X-Requested-With": "XMLHttpRequest" }
        })
        .then(resp => resp.text())
        .then(html => {
            document.getElementById('reports-table').innerHTML = html;
            hookReportPaginationLinks();
            initializeReportViewToggle();
        });
    }

    const debouncedReportSubmit = debounce(() => submitReportForm(false), 300);

    function hookReportPaginationLinks() {
        document.querySelectorAll('.pagination-list a.page-link').forEach(function(link) {
            link.onclick = function(e) {
                e.preventDefault();
                fetch(link.href, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                .then(resp => resp.text())
                .then(html => {
                    document.getElementById('reports-table').innerHTML = html;
                    hookReportPaginationLinks();
                    initializeReportViewToggle();
                });
            };
        });
    }

    function initializeReportViewToggle() {
        const gridBtn = document.getElementById("gridViewBtn");
        const listBtn = document.getElementById("listViewBtn");
        const gridContainer = document.querySelector(".tender-blocks-container.grid-view");
        const listContainer = document.querySelector(".tender-blocks-container.list-view");
        const listPaginationBar = document.getElementById("listPaginationBar");

        if (gridBtn && listBtn) {
            // Remove existing event listeners to prevent duplication
            const newGridBtn = gridBtn.cloneNode(true);
            const newListBtn = listBtn.cloneNode(true);
            gridBtn.parentNode.replaceChild(newGridBtn, gridBtn);
            listBtn.parentNode.replaceChild(newListBtn, listBtn);

            newGridBtn.addEventListener("click", function() {
                newGridBtn.classList.add("active");
                newListBtn.classList.remove("active");
                if (gridContainer) gridContainer.style.display = "";
                if (listContainer) listContainer.style.display = "none";
                if (listPaginationBar) listPaginationBar.style.display = "none";
            });

            newListBtn.addEventListener("click", function() {
                newListBtn.classList.add("active");
                newGridBtn.classList.remove("active");
                if (gridContainer) gridContainer.style.display = "none";
                if (listContainer) listContainer.style.display = "";
                if (listPaginationBar) listPaginationBar.style.display = "";
            });

            // Set initial view based on URL parameters
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('page')) {
                newGridBtn.classList.remove("active");
                newListBtn.classList.add("active");
                if (gridContainer) gridContainer.style.display = "none";
                if (listContainer) listContainer.style.display = "";
                if (listPaginationBar) listPaginationBar.style.display = "";
            } else {
                newGridBtn.classList.add("active");
                newListBtn.classList.remove("active");
                if (gridContainer) gridContainer.style.display = "";
                if (listContainer) listContainer.style.display = "none";
                if (listPaginationBar) listPaginationBar.style.display = "none";
            }
        }
    }

    // Calendar Modal functionality
    document.addEventListener("DOMContentLoaded", function() {
        const modal = document.getElementById("newReportModal");
        const openBtn = document.getElementById("newReportBtn");
        const closeBtn = modal.querySelector(".close");
        const prevMonthBtn = document.getElementById("prevMonth");
        const nextMonthBtn = document.getElementById("nextMonth");
        const currentMonthEl = document.getElementById("currentMonth");
        const calendarDays = document.getElementById("calendarDays");
        const startDateDisplay = document.getElementById("startDateDisplay");
        const endDateDisplay = document.getElementById("endDateDisplay");
        const clearSelectionBtn = document.getElementById("clearSelection");
        const generateReportBtn = document.getElementById("generateReportBtn");

        let currentDate = new Date();
        let startDate = null;
        let endDate = null;

        // Show modal
        openBtn.onclick = function() {
            renderCalendar();
            modal.style.display = "block";
        };

        // Close modal
        closeBtn.onclick = function() {
            modal.style.display = "none";
        };

        // Close on outside click
        window.onclick = function(event) {
            if (event.target === modal) {
                modal.style.display = "none";
            }
        };

        // Month navigation
        prevMonthBtn.addEventListener("click", () => {
            currentDate.setMonth(currentDate.getMonth() - 1);
            renderCalendar();
        });

        nextMonthBtn.addEventListener("click", () => {
            currentDate.setMonth(currentDate.getMonth() + 1);
            renderCalendar();
        });

        // Clear selection
        clearSelectionBtn.addEventListener("click", () => {
            startDate = null;
            endDate = null;
            updateDateDisplays();
            renderCalendar();
        });

        // Render calendar
        function renderCalendar() {
            currentMonthEl.textContent = currentDate.toLocaleDateString("en-US", {
                month: "long",
                year: "numeric"
            });

            calendarDays.innerHTML = "";

            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();

            const firstDay = new Date(year, month, 1).getDay();
            const totalDays = new Date(year, month + 1, 0).getDate();
            const prevMonthLastDate = new Date(year, month, 0).getDate();

            let dateCounter = 1;
            let nextMonthDay = 1;

            for (let i = 0; i < 6; i++) {
                const row = document.createElement("div");
                row.classList.add("week");

                for (let j = 0; j < 7; j++) {
                    const dayCell = document.createElement("div");
                    dayCell.classList.add("day");

                    if (i === 0 && j < firstDay) {
                        dayCell.textContent = prevMonthLastDate - (firstDay - j - 1);
                        dayCell.classList.add("other-month");
                    } else if (dateCounter > totalDays) {
                        dayCell.textContent = nextMonthDay++;
                        dayCell.classList.add("other-month");
                    } else {
                        const thisDate = new Date(year, month, dateCounter);
                        dayCell.textContent = dateCounter;

                        if (startDate && isSameDay(thisDate, startDate)) {
                            dayCell.classList.add("selected");
                        } else if (endDate && isSameDay(thisDate, endDate)) {
                            dayCell.classList.add("selected");
                        } else if (startDate && endDate && thisDate > startDate && thisDate < endDate) {
                            dayCell.classList.add("in-range");
                        }

                        dayCell.addEventListener("click", () => selectDate(thisDate));
                        dateCounter++;
                    }

                    row.appendChild(dayCell);
                }

                calendarDays.appendChild(row);
            }
        }

        // Handle date selection
        function selectDate(date) {
            if (!startDate || (startDate && endDate)) {
                startDate = new Date(date);
                endDate = null;
            } else if (date < startDate) {
                endDate = new Date(startDate);
                startDate = new Date(date);
            } else {
                endDate = new Date(date);
            }

            updateDateDisplays();
            renderCalendar();
        }

        function updateDateDisplays() {
            startDateDisplay.textContent = startDate
                ? startDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
                : "Not selected";

            endDateDisplay.textContent = endDate
                ? endDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
                : "Not selected";
        }

        function isSameDay(d1, d2) {
            return d1.getFullYear() === d2.getFullYear() &&
                   d1.getMonth() === d2.getMonth() &&
                   d1.getDate() === d2.getDate();
        }

        // Generate report
        generateReportBtn.addEventListener("click", () => {
            if (!startDate || !endDate) {
                alert("Please select both start and end dates.");
                return;
            }

            const startDateIso = startDate.toISOString();
            const endDateIso = endDate.toISOString();

            const url = '@Url.Action("GenerateClosedTendersSummaryReport", "TenderAdmin")' +
                '?startDate=' + encodeURIComponent(startDateIso) +
                '&endDate=' + encodeURIComponent(endDateIso);

            window.open(url, '_blank');
            modal.style.display = "none";
        });

        // Initialize search functionality
        const searchInput = document.querySelector('.search-input');
        if (searchInput) {
            searchInput.addEventListener('input', debouncedReportSubmit);
        }

        // Initialize pagination and view toggle
        hookReportPaginationLinks();
        initializeReportViewToggle();
    });
</script>

