@model List<SABC_Phase2.Models.Tender.AdminUserRowViewModel>
@{
    bool isOvrsUser = ViewBag.IsOVRSUser == true;
    int pageSize = ViewBag.PageSize ?? 7;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalItems = ViewBag.TotalItems ?? Model.Count;
    int totalPages = ViewBag.TotalPages ?? 1;
    string search = ViewBag.Search ?? "";
    string roleFilter = ViewBag.RoleFilter ?? "";
    string statusFilter = ViewBag.StatusFilter ?? "";
}

<div class="user-table-card">
    <div class="table-scroll-container">
        <table class="user-table">
            <thead>
                <tr>
                    <th style="width: 40px;">Selected</th>
                    <th>FULL NAME</th>
                    @if (isOvrsUser)
                    {
                        <th>COMPANY NAME</th>
                    }
                    <th>EMAIL</th>
                    <th>TYPE OF USER</th>
                    <th>STATUS</th>
                    <th>ACTION</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <input type="checkbox" name="selectedUserIds" value="@user.Id" data-role="@user.Role" />
                        </td>
                        <td>@user.FullName</td>
                        @if (isOvrsUser)
                        {
                            <td>@user.CompanyName</td>
                        }
                        <td>@user.Email</td>
                        <td>@user.Role</td>
                        <td class="user-status @(user.Status == "Active" ? "status-active" : "status-inactive")">@user.Status</td>
                        <td>
                            <div class="action-menu-container">
                                <button class="action-menu-btn" data-user-id="@user.Id" title="More actions">
                                    <i class="fas fa-ellipsis-h" style="color: #222;"></i>
                                </button>
                                <div class="action-dropdown">
                                    <button class="action-dropdown-item view-user-btn" data-user-id="@user.Id">
                                        <i class="fas fa-eye"></i> View User
                                    </button>
                                    @if (user.Status == "Active")
                                    {
                                        <button class="action-dropdown-item delete-user-btn delete-option"
                                                data-user-id="@user.Id"
                                                data-role="@user.Role">
                                            <i class="fas fa-trash-alt"></i> Delete User
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="action-dropdown-item reactivate-user-btn"
                                                data-user-id="@user.Id"
                                                data-role="@user.Role">
                                            <i class="fas fa-undo"></i> Reactivate User
                                        </button>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
