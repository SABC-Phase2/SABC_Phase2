@{
    // Set the banner text for the page (used in the layout or header)
    ViewData["BannerText"] = "Tenders";
}

@* Strongly-typed model for editing tenders. *@
@* This should be kept in sync with SABC_Phase2.Models.Tender.TenderEditDto *@
@model TenderEditDto

@{
    // Set the page title visible in the browser/tab
    ViewBag.Title = "Edit Tender";
}

<!-- Breadcrumb navigation for user context and navigation hierarchy -->
<div class="breadcrumb-custom">
    Dashboard <span class="breadcrumb-arrow">&#x2794;</span> Tenders <span class="breadcrumb-arrow">&#x2794;</span> <span class="breadcrumb-active">Edit Tender</span>
</div>

<!-- Tab headers for switching between tender details and documents -->
<div class="tab-header">
    <div id="tabDetails" class="tab-btn active" onclick="showTab('details')">Details</div>
    <div id="tabDocuments" class="tab-btn" onclick="showTab('documents')">Documents</div>
</div>

<div class="tab-container">
    <!-- Begin Edit Tender Form -->
    <form asp-action="Edit" enctype="multipart/form-data" method="post" autocomplete="off">
        <!-- Maintain DraftId and Id for edit context (hidden fields) -->
        @if (Model.DraftId != null)
        {
            <input type="hidden" name="DraftId" value="@Model.DraftId" />
        }
        @if (Model.Id != 0)
        {
            <input type="hidden" name="Id" value="@Model.Id" />
        }

        <!-- Tab: Tender Details -->
        <div id="details" class="tab-content active">
            <div class="form-row">
                <!-- Tender Type (radio buttons) -->
                <div class="form-group">
                    <label>Tender Type <span class="text-danger">*</span></label>
                    <div>
                        <!-- Each radio button is checked if it matches the model value -->
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFQ" required
                                   @(Model.TenderType == "RFQ" ? "checked" : "") />
                            <label class="form-check-label">RFQ</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFP"
                                   @(Model.TenderType == "RFP" ? "checked" : "") />
                            <label class="form-check-label">RFP</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFI"
                                   @(Model.TenderType == "RFI" ? "checked" : "") />
                            <label class="form-check-label">RFI</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFO"
                                   @(Model.TenderType == "RFO" ? "checked" : "") />
                            <label class="form-check-label">RFO</label>
                        </div>
                    </div>
                </div>

                <!-- Tender Number -->
                <div class="form-group">
                    <label asp-for="TenderNumber">Tender number <span class="text-danger">*</span></label>
                    <input asp-for="TenderNumber" class="form-control" />
                    <span asp-validation-for="TenderNumber" class="text-danger"></span>
                </div>

                <!-- Closing Date -->
                <div class="form-group">
                    <label asp-for="ClosingDate">Closing Date <span class="text-danger">*</span></label>
                    <input asp-for="ClosingDate" type="date" class="form-control" />
                    <span asp-validation-for="ClosingDate" class="text-danger"></span>
                </div>

                <!-- Closing Time -->
                <div class="form-group">
                    <label asp-for="ClosingTime">Closing Time <span class="text-danger">*</span></label>
                    <input asp-for="ClosingTime" type="time" class="form-control" />
                    <span asp-validation-for="ClosingTime" class="text-danger"></span>
                </div>

                <!-- Status Dropdown & Awarded Tender (side by side) -->
                <div class="form-group" style="display: flex; align-items: flex-end; gap: 20px;">
                    <!-- Status Dropdown -->
                    <div style="flex: 1;">
                        <label asp-for="Status">Status <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-control custom-dropdown" id="StatusDropdown">
                            <option value="" disabled selected hidden>~Please select the status of the tender~</option>
                            <option value="Open Tender">Open Tender</option>
                            <option value="Closed Tender">Closed Tender</option>
                            <option value="Awarded Tender">Awarded Tender</option>
                            <option value="Cancelled Tender">Cancelled Tender</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                    <!-- Awarded Tender Input, shown only if 'Awarded Tender' is selected -->
                    <div id="AwardedTenderContainer" style="flex: 1; display: none;">
                        <label id="AwardedTenderLabel" for="AwardedTenderDropdown" class="mb-1">Awarded To <span class="text-danger">*</span></label>

                        <!-- Custom Dropdown Container -->
                        <div class="custom-dropdown-container" id="customDropdownContainer">
                            <!-- Hidden select for form submission -->
                            <select asp-for="AwardedTender"
                                    id="AwardedTenderDropdown"
                                    class="form-control"
                                    data-awarded-value="@Model.AwardedTender"
                                    style="display: none;">
                                <option value="" disabled selected hidden>~Select company to award tender to~</option>
                                @if (Model.ApplicantCompanies != null && Model.ApplicantCompanies.Any())
                                {
                                    @foreach (var company in Model.ApplicantCompanies)
                                    {
                                        <option value="@company.CompanyName" selected="@(Model.AwardedTender == company.CompanyName)">
                                            @company.CompanyName
                                        </option>
                                    }
                                }
                            </select>

                            <!-- Custom Dropdown Display -->
                            <div class="custom-dropdown-display form-control custom-dropdown" id="customDropdownDisplay">
                                <span class="selected-text">~Select company to award tender to~</span>
                                <i class="fas fa-chevron-down dropdown-arrow"></i>
                            </div>

                            <!-- Dropdown Menu -->
                            <div class="custom-dropdown-menu" id="customDropdownMenu">
                                <!-- Search Input inside dropdown -->
                                <div class="dropdown-search-container">
                                    <input type="text"
                                           class="form-control dropdown-search-input"
                                           id="dropdownSearchInput"
                                           placeholder="Search for a company..."
                                           autocomplete="off" />
                                    <i class="fas fa-search search-icon"></i>
                                </div>

                                <!-- Options Container -->
                                <div class="dropdown-options" id="dropdownOptions">
                                    <!-- Options will be populated here -->
                                </div>
                            </div>
                        </div>

                        <span asp-validation-for="AwardedTender" class="text-danger"></span>
                    </div>
                </div>


                <!-- Tender Title (full width) -->
                <div class="form-group full-width">
                    <label asp-for="Title">Tender Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" maxlength="100" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <!-- Tender Description (full width, textarea) -->
                <div class="form-group full-width">
                    <label asp-for="Description">Tender Description <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="200"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Tab: Upload Documents Section -->
        <div id="documents" class="tab-content">
            <label for="UploadedFiles" class="upload-label">Upload Documents</label>
            <div class="upload-label-underline"></div>

            <!-- List of already uploaded/existing documents for this tender -->
            <div id="uploadedFilesContainer" class="mt-3">
                @if (Model.ExistingDocuments != null && Model.ExistingDocuments.Any())
                {
                    @foreach (var doc in Model.ExistingDocuments)
                    {
                        <div class="uploaded-file-entry existing-doc" data-doc-id="@doc.Id">
                            <div class="uploaded-file-entry-content">
                                <div class="uploaded-file-name">@doc.FileName</div>
                            </div>
                            <div class="uploaded-file-actions">
                                <button type="button" class="icon-btn view-upload-btn" onclick="window.open('@doc.SharePointPath', '_blank')">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" class="icon-btn text-danger remove-upload-btn" onclick="document.getElementById('delete_doc_@doc.Id').checked = true;">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                            <div style="display:none;">
                                <input type="checkbox" name="DocumentsToDelete" value="@doc.Id" id="delete_doc_@doc.Id" />
                            </div>
                        </div>
                    }
                }
            </div>

            <div id="awardedDocumentsContainer" class="mt-3" style="display: none;">
                <label class="supporting-label mb-2">
                    <i class="fas fa-trophy text-warning me-1"></i> Awarded Tender Document
                </label>
                <div>

                    @if (Model.AwardedDocuments != null && Model.AwardedDocuments.Any())

                    {

                        foreach (var doc in Model.AwardedDocuments)

                        {
                            <div class="uploaded-file-entry existing-doc" data-doc-id="@doc.Id">
                                <div class="uploaded-file-entry-content">
                                    <div class="uploaded-file-name">@doc.FileName</div>
                                </div>
                                <div class="uploaded-file-actions">
                                    <button type="button" class="icon-btn view-upload-btn" onclick="window.open('@doc.SharePointPath', '_blank')" title="View">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button type="button" class="icon-btn text-danger remove-upload-btn" onclick="document.getElementById('delete_awarded_doc_@doc.Id').checked = true;" title="Delete">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                                <div style="display:none;">
                                    <input type="checkbox" name="AwardedDocumentsToDelete" value="@doc.Id" id="delete_awarded_doc_@doc.Id" />
                                </div>
                            </div>

                        }

                    }
                    <span id="noAwardedDocMsg" class="text-danger" @( (Model.AwardedDocuments != null && Model.AwardedDocuments.Any()) ? "style='display:none;'" : "" )>

                        No awarded document uploaded
                    </span>

                </div>
            </div>


            <!-- File upload input for new supporting documents -->
            <div id="uploadInputGroup" class="d-flex align-items-center gap-2 mt-3">
                <label class="supporting-label mb-0"><i class="fas fa-file-pdf text-danger me-1"></i> Supporting Document</label>
                <label class="btn btn-success btn-sm d-flex align-items-center gap-1 mb-0">
                    <i class="fas fa-upload"></i> Upload
                    <input type="file" id="UploadedFiles" name="UploadedFiles" multiple accept=".pdf" hidden />
                </label>
            </div>
        </div>
    </form>
</div>

<!-- Form action buttons: Cancel and Save Changes -->
<div class="action-buttons">
    <button type="button" class="action-btn cancel-btn" onclick="window.location.href='@Url.Action("Index", "TenderAdmin")'">Cancel</button>
    <button type="button" id="continueBtn" class="action-btn continue-btn" onclick="submitForm()">Save Changes <span class="arrow-icon"></span></button>
</div>

<!-- Awarded Tender Modal -->
<div id="awardedModal" class="modal fade" tabindex="-1" aria-labelledby="awardedModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="awardedModalLabel" style="width:100%;text-align:center;">
                    <span id="awardedModalTenderNumber" style="font-weight:bold; color:#16a34a; font-size:1.4rem;"></span>
                </h5>
                <img src="~/lib/Images/Tick-Box.png" alt="Success" style="width: 64px; height: 64px; margin: 12px auto 0 auto; display: block;" />
            </div>
            <div class="modal-body">
                <p style="font-size:1.3rem; font-weight:700; color:#16a34a;">Successfully Awarded the Tender</p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="awardedModalCloseBtn" class="btn btn-success" style="min-width:100px; font-weight:600;">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteDocModal" class="modal fade" tabindex="-1" aria-labelledby="deleteDocModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header border-0">
                <h5 class="modal-title w-100" id="deleteDocModalLabel" style="color:#e11d48;">Delete Document</h5>
            </div>
            <div class="modal-body">
                <p style="font-size:1.1rem;">Are you sure you want to delete this document?</p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center gap-2">
                <button type="button" id="confirmDeleteDocBtn" class="btn btn-danger" style="min-width:100px;">Delete</button>
                <button type="button" id="cancelDeleteDocBtn" class="btn btn-secondary" style="min-width:100px;" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="modal fade" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0" style="padding-bottom:0;">
                <!-- Tender Number Heading in Green -->
                <h4 id="successModalTenderNumber" style="font-size:1.5rem; font-weight:700; color:#16a34a; margin-bottom:0;"></h4>
            </div>
            <!-- Green Tick -->
            <img src="~/lib/Images/Tick-Box.png" alt="Success" style="width: 64px; height: 64px; margin: 18px auto 0 auto; display: block;" />
            <div class="modal-body" style="padding-top:18px;">
                <!-- Big Green Text -->
                <div style="font-size:1.35rem; font-weight:700; color:#16a34a;">Tender Successfully Updated</div>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="successOkBtn" class="btn btn-success" style="min-width:120px;">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Awarded Company Account Deleted -->
<div class="modal fade" id="deletedAccountModal" tabindex="-1" aria-labelledby="deletedAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deletedAccountModalLabel">Company Account Deleted</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                The selected company <strong id="deletedCompanyName"></strong> has had their account deleted.<br />
                Please select another company to award this tender to.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            let docToDeleteEntry = null;
            let docToDeleteCheckbox = null;
            let companiesLoaded = false; // Track if companies have been loaded

            // === Custom Company Dropdown with Integrated Search ===
            let allCompanyOptions = [];
            let isDropdownOpen = false;
             let hasShownDeletedAccountPopup = false;

            // Attach event listeners to all existing document delete buttons (multi-step)
            document.querySelectorAll('.uploaded-file-entry.existing-doc .remove-upload-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    docToDeleteEntry = btn.closest('.uploaded-file-entry.existing-doc');
                    docToDeleteCheckbox = docToDeleteEntry.querySelector('input[type="checkbox"][name="DocumentsToDelete"]');
                    // Show confirmation modal
                    var modal = new bootstrap.Modal(document.getElementById('deleteDocModal'));
                    modal.show();
                });
            });

            // Confirm delete
            document.getElementById('confirmDeleteDocBtn').addEventListener('click', function() {
                if (docToDeleteCheckbox) {
                    docToDeleteCheckbox.checked = true;
                }
                if (docToDeleteEntry) {
                    docToDeleteEntry.style.display = 'none';
                }
                // Hide modal
                var modal = bootstrap.Modal.getInstance(document.getElementById('deleteDocModal'));
                modal.hide();
                // Reset
                docToDeleteEntry = null;
                docToDeleteCheckbox = null;
            });

            // Cancel delete (optional, modal will close automatically)
            document.getElementById('cancelDeleteDocBtn').addEventListener('click', function() {
                docToDeleteEntry = null;
                docToDeleteCheckbox = null;
            });

            // ---------- Tab Logic ----------
            const tabs = ['details', 'documents'];
            let currentTab = 'details';

            window.showTab = function(tabName) {
                document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
                document.querySelectorAll('.tab-btn').forEach(tb => tb.classList.remove('active'));
                document.getElementById(tabName).classList.add('active');
                document.getElementById('tab' + capitalize(tabName)).classList.add('active');
                currentTab = tabName;

                // Handle document visibility based on tender status
                if (tabName === 'documents') {
                    const status = statusDropdown.value;
                    if (uploadedFilesContainer) {
                        uploadedFilesContainer.style.display = (status === 'Awarded Tender') ? 'none' : '';
                    }
                    if (awardedDocumentsContainer) {
                        awardedDocumentsContainer.style.display = (status === 'Awarded Tender') ? 'block' : 'none';
                    }
                    toggleNoAwardedDocMsg();
                }
            };

            function capitalize(str) {
                return str.charAt(0).toUpperCase() + str.slice(1);
            }

            // ---------- Awarded Tender Visibility ----------
            const statusDropdown = document.getElementById('StatusDropdown');
            const awardedContainer = document.getElementById('AwardedTenderContainer');
            const uploadedFilesContainer = document.getElementById('uploadedFilesContainer');
            const awardedDocumentsContainer = document.getElementById('awardedDocumentsContainer');

            // Initialize custom dropdown
            function initializeCustomDropdown() {
                const displayElement = document.getElementById('customDropdownDisplay');
                const menuElement = document.getElementById('customDropdownMenu');
                const searchInput = document.getElementById('dropdownSearchInput');
                const optionsContainer = document.getElementById('dropdownOptions');
                const hiddenSelect = document.getElementById('AwardedTenderDropdown');

                if (!displayElement || !menuElement || !searchInput || !optionsContainer || !hiddenSelect) {
                    console.error('Custom dropdown elements not found');
                    return;
                }

                // Remove any existing event listeners by cloning elements
                const newDisplayElement = displayElement.cloneNode(true);
                displayElement.parentNode.replaceChild(newDisplayElement, displayElement);

                const newSearchInput = document.getElementById('dropdownSearchInput');
                const newMenuElement = document.getElementById('customDropdownMenu');

                // Toggle dropdown on display click
                newDisplayElement.addEventListener('click', function(e) {
                    e.stopPropagation();
                    console.log('Dropdown clicked');
                    toggleCustomDropdown();
                });

                // Search functionality
                newSearchInput.addEventListener('input', function() {
                    filterDropdownOptions(this.value);
                });

                // Close dropdown when clicking outside
                document.addEventListener('click', function(e) {
                    if (!document.getElementById('customDropdownContainer').contains(e.target)) {
                        closeCustomDropdown();
                    }
                });

                // Prevent dropdown from closing when clicking inside the menu
                newMenuElement.addEventListener('click', function(e) {
                    e.stopPropagation();
                });

                // Handle keyboard navigation
                newSearchInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        closeCustomDropdown();
                    } else if (e.key === 'Enter') {
                        e.preventDefault();
                        const firstOption = document.getElementById('dropdownOptions').querySelector('.dropdown-option:not(.disabled)');
                        if (firstOption) {
                            selectOption(firstOption.textContent, firstOption.getAttribute('data-value'));
                        }
                    }
                });

                console.log('Custom dropdown initialized successfully');
            }

            function toggleCustomDropdown() {
                console.log('Toggle dropdown, current state:', isDropdownOpen);
                if (isDropdownOpen) {
                    closeCustomDropdown();
                } else {
                    openCustomDropdown();
                }
            }

            function openCustomDropdown() {
                const displayElement = document.getElementById('customDropdownDisplay');
                const menuElement = document.getElementById('customDropdownMenu');
                const searchInput = document.getElementById('dropdownSearchInput');
                const arrow = displayElement.querySelector('.dropdown-arrow');

                console.log('Opening dropdown');
                displayElement.classList.add('active');
                menuElement.classList.add('show');
                arrow.classList.add('rotate');
                isDropdownOpen = true;

                // Clear search and show all options
                searchInput.value = '';
                filterDropdownOptions('');

                // Focus on search input
                setTimeout(() => searchInput.focus(), 100);
            }

            function closeCustomDropdown() {
                const displayElement = document.getElementById('customDropdownDisplay');
                const menuElement = document.getElementById('customDropdownMenu');
                const arrow = displayElement.querySelector('.dropdown-arrow');

                if (displayElement && menuElement && arrow) {
                    console.log('Closing dropdown');
                    displayElement.classList.remove('active');
                    menuElement.classList.remove('show');
                    arrow.classList.remove('rotate');
                    isDropdownOpen = false;
                }
            }

            function filterDropdownOptions(searchText) {
                const normalizedSearch = searchText.toLowerCase().trim();

                let filteredOptions = allCompanyOptions;

                if (normalizedSearch !== '') {
                    filteredOptions = allCompanyOptions.filter(option =>
                        option.companyName.toLowerCase().includes(normalizedSearch)
                    );
                }

                renderDropdownOptions(filteredOptions);
            }

                function renderDropdownOptions(options) {
            const optionsContainer = document.getElementById('dropdownOptions');
            const hiddenSelect = document.getElementById('AwardedTenderDropdown');
            const currentValue = hiddenSelect.value;

            optionsContainer.innerHTML = '';

            if (options.length === 0) {
                const noResults = document.createElement('div');
                noResults.className = 'no-results';
                noResults.textContent = 'No companies match your search';
                optionsContainer.appendChild(noResults);
                return;
            }

            options.forEach(option => {
                const optionElement = document.createElement('div');
                optionElement.className = 'dropdown-option';
                optionElement.textContent = option.companyName;
                optionElement.setAttribute('data-value', option.companyName);

                // Only show deleted account styling if popup has been shown
                if (option.isAccountDeleted && hasShownDeletedAccountPopup) {
                    optionElement.classList.add('deleted-account');
                    optionElement.classList.add('disabled');
                    optionElement.style.opacity = '0.5';
                    optionElement.style.color = '#999';
                    optionElement.style.cursor = 'not-allowed';
                    optionElement.style.textDecoration = 'line-through';

                    // Add a label to indicate deleted account
                    optionElement.innerHTML = `${option.companyName} <small class="text-muted">(Account Deleted)</small>`;

                    // Prevent selection of deleted accounts
                    optionElement.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        alert('This company account has been deleted and cannot be selected.');
                    });
                } else {
                    // Normal behavior for all accounts (including deleted ones before popup is shown)
                    if (option.companyName === currentValue) {
                        optionElement.classList.add('selected');
                    }

                    optionElement.addEventListener('click', function() {
                        // If this is a deleted account and popup hasn't been shown yet, allow selection
                        // The backend will catch it and show the popup
                        selectOption(option.companyName, option.companyName);
                    });
                }

                optionsContainer.appendChild(optionElement);
            });
        }


            function selectOption(displayText, value) {
                const displayElement = document.getElementById('customDropdownDisplay');
                const hiddenSelect = document.getElementById('AwardedTenderDropdown');
                const selectedTextElement = displayElement.querySelector('.selected-text');

                selectedTextElement.textContent = displayText;
                hiddenSelect.value = value;

                // Trigger change event for validation
                hiddenSelect.dispatchEvent(new Event('change', { bubbles: true }));

                closeCustomDropdown();
            }

            // Load applicant companies function
        // Update the loadApplicantCompanies function
        async function loadApplicantCompanies(tenderId) {
            const hiddenSelect = document.getElementById('AwardedTenderDropdown');
            if (!hiddenSelect) return;

            const currentAwardedTender = hiddenSelect.getAttribute('data-awarded-value') || hiddenSelect.value;

            try {
                const response = await fetch(`/TenderAdmin/GetApplicantCompanies?tenderId=${tenderId}`);
                const data = await response.json();

                if (data.success) {
                    allCompanyOptions = [];

                    if (data.companies && data.companies.length > 0) {
                        data.companies.forEach((company, index) => {
                            let companyName = company.CompanyName || company.companyName || company.name || company.Name || `Company ${index + 1}`;
                            let isAccountDeleted = company.IsAccountDeleted || company.isAccountDeleted || false;

                            allCompanyOptions.push({
                                companyName: companyName,
                                isAccountDeleted: isAccountDeleted
                            });
                        });

                        // Add previously awarded if not in list
                        if (currentAwardedTender && !allCompanyOptions.find(c => c.companyName === currentAwardedTender)) {
                            allCompanyOptions.push({
                                companyName: currentAwardedTender,
                                isAccountDeleted: false // Assume not deleted if not in current list
                            });
                        }
                    }

                    // Update hidden select options for form submission
                    updateHiddenSelectOptions();

                    // Update display text if there's a current value
                    if (currentAwardedTender) {
                        selectOption(currentAwardedTender, currentAwardedTender);
                    } else {
                        const selectedTextElement = document.getElementById('customDropdownDisplay')?.querySelector('.selected-text');
                        if (selectedTextElement) {
                            selectedTextElement.textContent = '~Select company to award tender to~';
                        }
                    }
                }
            } catch (error) {
                console.error('Error loading applicant companies:', error);
            }
        }


           // Update the updateHiddenSelectOptions function
        function updateHiddenSelectOptions() {
            const hiddenSelect = document.getElementById('AwardedTenderDropdown');
            const currentValue = hiddenSelect.value;

            // Clear existing options except the default
            hiddenSelect.innerHTML = '<option value="" disabled>~Select company to award tender to~</option>';

            allCompanyOptions.forEach(option => {
                const optionElement = document.createElement('option');
                optionElement.value = option.companyName;
                optionElement.textContent = option.companyName;

                // Only disable deleted accounts in the select if popup has been shown
                if (option.isAccountDeleted && hasShownDeletedAccountPopup) {
                    optionElement.disabled = true;
                    optionElement.textContent = `${option.companyName} (Account Deleted)`;
                }

                if (option.companyName === currentValue && !(option.isAccountDeleted && hasShownDeletedAccountPopup)) {
                    optionElement.selected = true;
                }

                hiddenSelect.appendChild(optionElement);
            });
        }

            // Update the visibility function
            function updateAwardedTenderVisibility() {
                if (statusDropdown.value === 'Awarded Tender') {
                    awardedContainer.style.display = 'block';
                    if (uploadedFilesContainer) uploadedFilesContainer.style.display = 'none';
                    if (awardedDocumentsContainer) awardedDocumentsContainer.style.display = 'block';

                    // Initialize custom dropdown after the container is visible
                    setTimeout(() => {
                        initializeCustomDropdown();
                    }, 100);

                    // Load companies if needed
                    const tenderId = document.querySelector('input[name="Id"]')?.value;
                    if (tenderId && (!companiesLoaded || allCompanyOptions.length === 0)) {
                        loadApplicantCompanies(tenderId).then(() => {
                            companiesLoaded = true;
                        });
                    }
                } else {
                    awardedContainer.style.display = 'none';
                    if (uploadedFilesContainer) uploadedFilesContainer.style.display = 'block';
                    if (awardedDocumentsContainer) awardedDocumentsContainer.style.display = 'none';
                    closeCustomDropdown(); // Close dropdown if open
                }
                toggleNoAwardedDocMsg();
            }

            if (statusDropdown) {
                statusDropdown.addEventListener('change', updateAwardedTenderVisibility);
                updateAwardedTenderVisibility(); // Initial state
            }

            // ---------- Toggle "No awarded document uploaded" message ----------
            function toggleNoAwardedDocMsg() {
                const noMsg = document.getElementById('noAwardedDocMsg');
                if (!noMsg) return;

                const existingDocsCount = awardedDocumentsContainer.querySelectorAll('.uploaded-file-entry.existing-doc').length;
                const newDocsCount = awardedDocumentsContainer.querySelectorAll('.uploaded-file-entry.new-doc').length;

                if (existingDocsCount + newDocsCount > 0) {
                    noMsg.style.display = 'none';
                } else {
                    noMsg.style.display = 'inline';
                }
            }

            // ---------- PDF Upload Logic: Multi-batch, Removable ----------
            const fileInput = document.getElementById('UploadedFiles');
            let selectedFiles = [];

            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    const files = Array.from(fileInput.files);
                    files.forEach(file => {
                        if (file.type !== "application/pdf") {
                            alert("Only PDF files are allowed.");
                            return;
                        }
                        // Check for duplicate by name+size
                        if (!selectedFiles.find(f => f.name === file.name && f.size === file.size)) {
                            selectedFiles.push(file);
                        }
                    });

                    updateFilesDisplay();
                    // Reset input so same file can be added again if needed
                    fileInput.value = "";
                });
            }

            function updateFilesDisplay() {
                // Remove all new uploaded entries (not existing ones)
                document.querySelectorAll('.uploaded-file-entry.new-doc').forEach(e => e.remove());

                selectedFiles.forEach(function (file, idx) {
                    const entryDiv = document.createElement('div');
                    entryDiv.className = "uploaded-file-entry new-doc p-2 rounded d-flex justify-content-between align-items-center mb-2 bg-light";
                    entryDiv.innerHTML = `
                        <div>
                            <strong>${file.name}</strong>
                        </div>
                        <div class="uploaded-file-actions d-flex gap-2">
                            <button type="button" class="icon-btn view-upload-btn" title="View">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button type="button" class="icon-btn text-danger remove-upload-btn" title="Delete">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    `;

                    // View button logic
                    entryDiv.querySelector('.view-upload-btn').addEventListener('click', function () {
                        const fileURL = URL.createObjectURL(file);
                        window.open(fileURL, '_blank');
                    });

                    // Remove button logic
                    entryDiv.querySelector('.remove-upload-btn').addEventListener('click', function () {
                        // Remove the file from selectedFiles by index
                        selectedFiles.splice(idx, 1);
                        updateFilesDisplay();
                        toggleNoAwardedDocMsg();
                    });

                    // Append to awarded or main documents container based on status
                    if (statusDropdown.value === 'Awarded Tender') {
                        if (awardedDocumentsContainer) awardedDocumentsContainer.appendChild(entryDiv);
                    } else {
                        if (uploadedFilesContainer) uploadedFilesContainer.appendChild(entryDiv);
                    }
                });

                toggleNoAwardedDocMsg();
            }

            // ---------- Validation Utilities ----------
            function showFieldError(fieldIdOrName, message, tabName) {
                let field = document.getElementById(fieldIdOrName) || document.querySelector(`[name='${fieldIdOrName}']`);
                if (field) {
                    let label = null;
                    // Try to find the associated label
                    if (field.id) {
                        label = document.querySelector(`label[for='${field.id}']`);
                    }
                    if (!label) {
                        let formGroup = field.closest('.form-group');
                        if (formGroup) {
                            label = formGroup.querySelector('label');
                        }
                    }
                    // Remove any existing error span near this label
                    if (label) {
                        let oldError = label.parentNode.querySelector('.validation-custom-error');
                        if (oldError) oldError.remove();

                        let errorSpan = document.createElement('span');
                        errorSpan.className = 'validation-custom-error text-danger';
                        errorSpan.innerText = message;
                        errorSpan.style.fontWeight = 'bold';

                        if (tabName === 'documents') {
                            // Insert after label
                            label.insertAdjacentElement('afterend', errorSpan);
                        } else {
                            // Append next to label
                            errorSpan.classList.add('ms-2');
                            label.appendChild(errorSpan);
                        }
                    }
                    field.classList.add('field-error-highlight');
                } else {
                    // Fallback error on the whole tab section
                    let tabContent = document.getElementById(tabName);
                    if (tabContent) {
                        let oldError = tabContent.querySelector('.validation-custom-error');
                        if (oldError) oldError.remove();
                        let errorSpan = document.createElement('span');
                        errorSpan.className = 'validation-custom-error text-danger';
                        errorSpan.innerText = message;
                        errorSpan.style.display = 'block';
                        errorSpan.style.fontWeight = 'bold';
                        errorSpan.style.marginBottom = '10px';
                        tabContent.prepend(errorSpan);
                    }
                }
            }

            function clearAllCustomErrors() {
                document.querySelectorAll('.validation-custom-error').forEach(e => e.remove());
                document.querySelectorAll('.field-error-highlight').forEach(e => e.classList.remove('field-error-highlight'));
            }

            function clearFieldError(e) {
                let field = e.target;
                let label = null;
                if (field.id) {
                    label = document.querySelector(`label[for='${field.id}']`);
                }
                if (!label) {
                    let formGroup = field.closest('.form-group');
                    if (formGroup) {
                        label = formGroup.querySelector('label');
                    }
                }
                if (label) {
                    let oldError = label.parentNode.querySelector('.validation-custom-error');
                    if (oldError) oldError.remove();
                }
                field.classList.remove('field-error-highlight');
            }

            document.querySelectorAll('input, textarea, select').forEach(e => {
                e.addEventListener('input', clearFieldError);
                e.addEventListener('change', clearFieldError);
            });

            // ---------- Form Submission Logic: Attach all selected files and Validate ----------
            window.submitForm = function() {
                const saveBtn = document.getElementById('continueBtn');

                // Prevent multiple submissions
                if (saveBtn.classList.contains('loading')) {
                    return;
                }

                // Add loading state
                saveBtn.classList.add('loading');
                saveBtn.innerHTML = 'Saving<span class="loading-dots"></span>';
                saveBtn.disabled = true;

                clearAllCustomErrors();

                // VALIDATION SECTION
                let errors = [];
                let errorFields = [];
                let errorTabs = [];

                // Required fields (details tab)
                let tenderType = document.querySelector('input[name="TenderType"]:checked');
                let tenderNumber = document.querySelector('input[name="TenderNumber"]');
                let closingDate = document.querySelector('input[name="ClosingDate"]');
                let closingTime = document.querySelector('input[name="ClosingTime"]');
                let title = document.querySelector('input[name="Title"]');
                let description = document.querySelector('textarea[name="Description"]');
                let status = statusDropdown.value;
                let awardedTenderNote = document.getElementById('AwardedTenderNote');

                if (!tenderType) {
                    errors.push({field: 'TenderType', message: 'Please select a Tender Type', tab: 'details'});
                    errorFields.push('TenderType'); errorTabs.push('details');
                }
                if (!tenderNumber.value.trim()) {
                    errors.push({field: 'TenderNumber', message: 'Tender Number is required', tab: 'details'});
                    errorFields.push('TenderNumber'); errorTabs.push('details');
                }
                if (!closingDate.value.trim()) {
                    errors.push({field: 'ClosingDate', message: 'Closing Date is required', tab: 'details'});
                    errorFields.push('ClosingDate'); errorTabs.push('details');
                }
                if (!closingTime.value.trim()) {
                    errors.push({field: 'ClosingTime', message: 'Closing Time is required', tab: 'details'});
                    errorFields.push('ClosingTime'); errorTabs.push('details');
                }
                if (!title.value.trim()) {
                    errors.push({field: 'Title', message: 'Tender Title is required', tab: 'details'});
                    errorFields.push('Title'); errorTabs.push('details');
                }
                if (!description.value.trim()) {
                    errors.push({field: 'Description', message: 'Tender Description is required', tab: 'details'});
                    errorFields.push('Description'); errorTabs.push('details');
                }
                if (!status) {
                    errors.push({field: 'StatusDropdown', message: 'Tender Status is required', tab: 'details'});
                    errorFields.push('StatusDropdown'); errorTabs.push('details');
                }

                // Awarded Note required if status is Awarded Tender
                if (status === 'Awarded Tender') {
                    let awardedTenderDropdown = document.getElementById('AwardedTenderDropdown');
                    console.log('Dropdown validation - Value:', awardedTenderDropdown.value);
                    console.log('Dropdown validation - Selected index:', awardedTenderDropdown.selectedIndex);
                    console.log('Dropdown validation - Selected option:', awardedTenderDropdown.selectedOptions[0]);

                    if (!awardedTenderDropdown.value || awardedTenderDropdown.value.trim() === '') {
                        errors.push({field: 'AwardedTenderDropdown', message: 'Please select a company to award the tender to', tab: 'details'});
                        errorFields.push('AwardedTenderDropdown'); errorTabs.push('details');
                    }
                    // Count only awarded docs not marked for deletion + new uploads
                    const awardedDocCount =
                        Array.from(awardedDocumentsContainer.querySelectorAll('.uploaded-file-entry.existing-doc'))
                            .filter(div => {
                                const docId = div.getAttribute('data-doc-id');
                                // FIX: Use AwardedDocumentsToDelete for awarded docs
                                const delCheckbox = document.querySelector(`input[name="AwardedDocumentsToDelete"][value="${docId}"]`);
                                return !(delCheckbox && delCheckbox.checked);
                            }).length
                        +
                        awardedDocumentsContainer.querySelectorAll('.uploaded-file-entry.new-doc').length;

                    if (awardedDocCount === 0) {
                        errors.push({field: 'AwardedDocuments', message: 'You must upload at least one awarded document.', tab: 'documents'});
                        errorFields.push('AwardedDocuments'); errorTabs.push('documents');
                    }
                } else {
                    // For supporting docs: count existing (not marked for deletion) + new uploads
                    const existingDocsCount =
                        Array.from(uploadedFilesContainer.querySelectorAll('.uploaded-file-entry.existing-doc'))
                            .filter(div => {
                                const docId = div.getAttribute('data-doc-id');
                                const delCheckbox = document.querySelector(`input[name="DocumentsToDelete"][value="${docId}"]`);
                                return !(delCheckbox && delCheckbox.checked);
                            }).length
                        +
                        uploadedFilesContainer.querySelectorAll('.uploaded-file-entry.new-doc').length;
                    if (existingDocsCount === 0) {
                        errors.push({field: 'UploadedFiles', message: 'You must upload at least one supporting document.', tab: 'documents'});
                        errorFields.push('UploadedFiles'); errorTabs.push('documents');
                    }
                }

                // Show all errors next to their fields
                if (errors.length > 0) {
                    // Remove loading state if validation fails
                    saveBtn.classList.remove('loading');
                    saveBtn.innerHTML = 'Save Changes <span class="arrow-icon"></span>';
                    saveBtn.disabled = false;

                    errors.forEach(function(err) {
                        showFieldError(err.field, err.message, err.tab);
                    });
                    // Switch to first errored tab and focus field
                    showTab(errors[0].tab);
                    let firstField = document.getElementById(errors[0].field) || document.querySelector(`[name='${errors[0].field}']`);
                    if (firstField) {
                        firstField.scrollIntoView({behavior: "smooth", block: "center"});
                        firstField.focus();
                    }
                    return;
                }

                let form = document.querySelector('form[asp-action="Edit"]') || document.querySelector('form[action*="Edit"]');
                if (!form) {
                    alert("Form not found!");
                    // Remove loading state if form not found
                    saveBtn.classList.remove('loading');
                    saveBtn.innerHTML = 'Save Changes <span class="arrow-icon"></span>';
                    saveBtn.disabled = false;
                    return;
                }

                let formData = new FormData(form);

                // Remove any existing files from input (to avoid duplicates)
                formData.delete('UploadedFiles');

                // Append all files from selectedFiles array
                selectedFiles.forEach(function(file) {
                    formData.append('UploadedFiles', file, file.name);
                });

               fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            }
        })
        .then(async response => {
            const contentType = response.headers.get("content-type");
            if (contentType && contentType.includes("application/json")) {
                const data = await response.json();

                if (data.deletedAccount) {
                    // Set the flag to true when deleted account popup is shown
                    hasShownDeletedAccountPopup = true;

                    // Show the modal popup with company name
                    document.getElementById('deletedCompanyName').textContent = data.companyName || '';
                    var modal = new bootstrap.Modal(document.getElementById('deletedAccountModal'));
                    modal.show();

                    // When the modal is closed, refresh the dropdown to show greyed out accounts
                    modal._element.addEventListener('hidden.bs.modal', function() {
                        // Clear the current selection since it was a deleted account
                        const hiddenSelect = document.getElementById('AwardedTenderDropdown');
                        const displayElement = document.getElementById('customDropdownDisplay');
                        const selectedTextElement = displayElement.querySelector('.selected-text');

                        hiddenSelect.value = '';
                        selectedTextElement.textContent = '~Select company to award tender to~';

                        // Re-render options with deleted accounts now greyed out
                        updateHiddenSelectOptions();
                        if (isDropdownOpen) {
                            renderDropdownOptions(allCompanyOptions);
                        }
                    });

                    // Remove loading state
                    saveBtn.classList.remove('loading');
                    saveBtn.innerHTML = 'Save Changes <span class="arrow-icon"></span>';
                    saveBtn.disabled = false;
                    return; // stop further processing
                }

                            if (data.success && data.awarded) {
                                // Show awarded tender modal
                                document.getElementById('awardedModalTenderNumber').textContent = data.tenderNumber || '';
                                var modal = new bootstrap.Modal(document.getElementById('awardedModal'));
                                modal.show();
                                document.getElementById('awardedModalCloseBtn').onclick = function () {
                                    window.location.href = data.redirectUrl || '/TenderAdmin/Index';
                                };
                                    } else if (data.success) {
            // Set the tender number as green heading (above tick)
            const tenderNumber = data.tenderNumber || document.querySelector('input[name="TenderNumber"]').value;
            document.getElementById('successModalTenderNumber').textContent = tenderNumber || '';

            // Show success modal
            var successModal = new bootstrap.Modal(document.getElementById('successModal'));
            successModal.show();

            // On OK button click, redirect
            document.getElementById('successOkBtn').onclick = function () {
                window.location.href = data.redirectUrl || '/TenderAdmin/Index';
            };
        } else {
            alert("Failed to save changes: " + (data.message || "Unknown error"));
        }
                        } else if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            response.text().then(html => {
                                document.body.innerHTML = html;
                                window.scrollTo(0, 0);
                            });
                        }
                    })
                          .catch(error => {
                console.error(error);
                alert("An error occurred while saving changes.");
            })
            .finally(() => {
                // Remove loading state after response (success or error)
                saveBtn.classList.remove('loading');
                saveBtn.innerHTML = 'Save Changes <span class="arrow-icon"></span>';
                saveBtn.disabled = false;
            });
        };


            // Show initial tab and toggle no-doc message on load
            showTab(currentTab);
            toggleNoAwardedDocMsg();
        });
    </script>
}
