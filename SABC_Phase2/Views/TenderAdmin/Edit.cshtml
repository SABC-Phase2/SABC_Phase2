@{
    // Set the banner text for the page (used in the layout or header)
    ViewData["BannerText"] = "Tenders";
}

@* Strongly-typed model for editing tenders. *@
@* This should be kept in sync with SABC_Phase2.Models.Tender.TenderEditDto *@
@model TenderEditDto

@{
    // Set the page title visible in the browser/tab
    ViewBag.Title = "Edit Tender";
}

<!-- Breadcrumb navigation for user context and navigation hierarchy -->
<div class="breadcrumb-custom">
    Dashboard <span class="breadcrumb-arrow">&#x2794;</span> Tenders <span class="breadcrumb-arrow">&#x2794;</span> <span class="breadcrumb-active">Edit Tender</span>
</div>

<!-- Tab headers for switching between tender details and documents -->
<div class="tab-header">
    <div id="tabDetails" class="tab-btn active" onclick="showTab('details')">Details</div>
    <div id="tabDocuments" class="tab-btn" onclick="showTab('documents')">Documents</div>
</div>

<div class="tab-container">
    <!-- Begin Edit Tender Form -->
    <form asp-action="Edit" enctype="multipart/form-data" method="post" autocomplete="off">
        <!-- Maintain DraftId and Id for edit context (hidden fields) -->
        @if (Model.DraftId != null)
        {
            <input type="hidden" name="DraftId" value="@Model.DraftId" />
        }
        @if (Model.Id != 0)
        {
            <input type="hidden" name="Id" value="@Model.Id" />
        }

        <!-- Tab: Tender Details -->
        <div id="details" class="tab-content active">
            <div class="form-row">
                <!-- Tender Type (radio buttons) -->
                <div class="form-group">
                    <label>Tender Type <span class="text-danger">*</span></label>
                    <div>
                        <!-- Each radio button is checked if it matches the model value -->
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFQ" required
                                   @(Model.TenderType == "RFQ" ? "checked" : "") />
                            <label class="form-check-label">RFQ</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFP"
                                   @(Model.TenderType == "RFP" ? "checked" : "") />
                            <label class="form-check-label">RFP</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFI"
                                   @(Model.TenderType == "RFI" ? "checked" : "") />
                            <label class="form-check-label">RFI</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFO"
                                   @(Model.TenderType == "RFO" ? "checked" : "") />
                            <label class="form-check-label">RFO</label>
                        </div>
                    </div>
                </div>

                <!-- Tender Number -->
                <div class="form-group">
                    <label asp-for="TenderNumber">Tender number <span class="text-danger">*</span></label>
                    <input asp-for="TenderNumber" class="form-control" />
                    <span asp-validation-for="TenderNumber" class="text-danger"></span>
                </div>

                <!-- Closing Date -->
                <div class="form-group">
                    <label asp-for="ClosingDate">Closing Date <span class="text-danger">*</span></label>
                    <input asp-for="ClosingDate" type="date" class="form-control" />
                    <span asp-validation-for="ClosingDate" class="text-danger"></span>
                </div>

                <!-- Closing Time -->
                <div class="form-group">
                    <label asp-for="ClosingTime">Closing Time <span class="text-danger">*</span></label>
                    <input asp-for="ClosingTime" type="time" class="form-control" />
                    <span asp-validation-for="ClosingTime" class="text-danger"></span>
                </div>

                <!-- Status Dropdown & Awarded Tender (side by side) -->
                <div class="form-group" style="display: flex; align-items: flex-end; gap: 20px;">
                    <!-- Status Dropdown -->
                    <div style="flex: 1;">
                        <label asp-for="Status">Status <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-control custom-dropdown" id="StatusDropdown">
                            <option value="" disabled selected hidden>~Please select the status of the tender~</option>
                            <option value="Open Tender">Open Tender</option>
                            <option value="Closed Tender">Closed Tender</option>
                            <option value="Awarded Tender">Awarded Tender</option>
                            <option value="Cancelled Tender">Cancelled Tender</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                    <!-- Awarded Tender Input, shown only if 'Awarded Tender' is selected -->
                    <div id="AwardedTenderContainer" style="flex: 1; display: none;">
                        <label id="AwardedTenderLabel" for="AwardedTenderNote" class="mb-1">Awarded To <span class="text-danger">*</span></label>
                        <input asp-for="AwardedTender"
                               id="AwardedTenderNote"
                               class="form-control"
                               placeholder="Enter award details or notes" />
                        <span asp-validation-for="AwardedTender" class="text-danger"></span>
                    </div>
                </div>

                <!-- Tender Title (full width) -->
                <div class="form-group full-width">
                    <label asp-for="Title">Tender Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" maxlength="100" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <!-- Tender Description (full width, textarea) -->
                <div class="form-group full-width">
                    <label asp-for="Description">Tender Description <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="200"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
        </div>

        <!-- Tab: Upload Documents Section -->
        <div id="documents" class="tab-content">
            <label for="UploadedFiles" class="upload-label">Upload Documents</label>
            <div class="upload-label-underline"></div>

            <!-- List of already uploaded/existing documents for this tender -->
            <div id="uploadedFilesContainer" class="mt-3">
                @if (Model.ExistingDocuments != null && Model.ExistingDocuments.Any())
                {
                    @foreach (var doc in Model.ExistingDocuments)
                    {
                        <div class="uploaded-file-entry existing-doc p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light" data-doc-id="@doc.Id">
                            <div>
                                <strong>@doc.FileName</strong>
                                <div class="text-muted small mt-1" style="font-size:0.75rem;">
                                    <a href="@doc.SharePointPath" target="_blank">View</a>
                                </div>
                            </div>
                            <div>
                                <input type="checkbox" name="DocumentsToDelete" value="@doc.Id" id="delete_doc_@doc.Id" />
                                <label for="delete_doc_@doc.Id" class="text-danger" style="font-size:0.9em;">Delete</label>
                            </div>
                        </div>
                    }
                }
            </div>

            <div id="awardedDocumentsContainer" class="mt-3" style="display: none;">
                <label class="supporting-label mb-2"><i class="fas fa-trophy text-warning me-1"></i> Awarded Tender Document</label>
                <div class="uploaded-file-entry p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light">
                    <div>
                        <strong>Awarded Document</strong>
                        <div class="text-muted small mt-1" style="font-size:0.75rem;">
                            @if (Model.AwardedDocuments != null && Model.AwardedDocuments.Any())
                            {
                                foreach (var doc in Model.AwardedDocuments)
                                {
                                    <div class="uploaded-file-entry p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light">
                                        <div>
                                            <strong>@doc.FileName</strong>
                                            <div class="text-muted small mt-1" style="font-size:0.75rem;">
                                                <a href="@doc.SharePointPath" target="_blank">View</a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            <!-- Always include this span, will toggle visibility in JS -->
                            <span id="noAwardedDocMsg" @( (Model.AwardedDocuments != null && Model.AwardedDocuments.Any()) ? "style='display:none;'" : "" )>
                                No awarded document uploaded
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- File upload input for new supporting documents -->
            <div id="uploadInputGroup" class="d-flex align-items-center gap-2 mt-3">
                <label class="supporting-label mb-0"><i class="fas fa-file-pdf text-danger me-1"></i> Supporting Document</label>
                <label class="btn btn-success btn-sm d-flex align-items-center gap-1 mb-0">
                    <i class="fas fa-upload"></i> Upload
                    <input type="file" id="UploadedFiles" name="UploadedFiles" multiple accept=".pdf" hidden />
                </label>
            </div>
        </div>
    </form>
</div>

<!-- Form action buttons: Cancel and Save Changes -->
<div class="action-buttons">
    <button type="button" class="action-btn cancel-btn" onclick="window.location.href='@Url.Action("Index", "TenderAdmin")'">Cancel</button>
    <button type="button" id="continueBtn" class="action-btn continue-btn" onclick="submitForm()">Save Changes <span class="arrow-icon"></span></button>
</div>

<!-- Awarded Tender Modal -->
<div id="awardedModal" class="modal fade" tabindex="-1" aria-labelledby="awardedModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="awardedModalLabel" style="width:100%;text-align:center;">
                    <span id="awardedModalTenderNumber" style="font-weight:bold;"></span>
                </h5>
                <img src="~/lib/Images/Tick-Box.png" alt="Success" style="width: 64px; height: 64px; margin: 12px auto 0 auto; display: block;" />
            </div>
            <div class="modal-body">
                <p style="font-size:1.25rem; font-weight:600;">Successfully Awarded the tender</p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="awardedModalCloseBtn" class="btn btn-primary" style="min-width:100px;">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // ---------- Tab Logic ----------
            const tabs = ['details', 'documents'];
            let currentTab = 'details';

            window.showTab = function(tabName) {
                document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
                document.querySelectorAll('.tab-btn').forEach(tb => tb.classList.remove('active'));
                document.getElementById(tabName).classList.add('active');
                document.getElementById('tab' + capitalize(tabName)).classList.add('active');
                currentTab = tabName;

                // Handle document visibility based on tender status
                if (tabName === 'documents') {
                    const status = statusDropdown.value;
                    if (uploadedFilesContainer) {
                        uploadedFilesContainer.style.display = (status === 'Awarded Tender') ? 'none' : '';
                    }
                    if (awardedDocumentsContainer) {
                        awardedDocumentsContainer.style.display = (status === 'Awarded Tender') ? 'block' : 'none';
                    }
                    toggleNoAwardedDocMsg();
                }
            };

            function capitalize(str) {
                return str.charAt(0).toUpperCase() + str.slice(1);
            }

            // ---------- Awarded Tender Visibility ----------
            const statusDropdown = document.getElementById('StatusDropdown');
            const awardedContainer = document.getElementById('AwardedTenderContainer');
            const uploadedFilesContainer = document.getElementById('uploadedFilesContainer');
            const awardedDocumentsContainer = document.getElementById('awardedDocumentsContainer');

            function updateAwardedTenderVisibility() {
                if (statusDropdown.value === 'Awarded Tender') {
                    awardedContainer.style.display = 'block';
                    if (uploadedFilesContainer) uploadedFilesContainer.style.display = 'none';
                    if (awardedDocumentsContainer) awardedDocumentsContainer.style.display = 'block';
                } else {
                    awardedContainer.style.display = 'none';
                    if (uploadedFilesContainer) uploadedFilesContainer.style.display = 'block';
                    if (awardedDocumentsContainer) awardedDocumentsContainer.style.display = 'none';
                    document.getElementById('AwardedTenderNote').value = '';
                }
                toggleNoAwardedDocMsg();
            }

            if (statusDropdown) {
                statusDropdown.addEventListener('change', updateAwardedTenderVisibility);
                updateAwardedTenderVisibility(); // Initial state
            }

            // ---------- Toggle "No awarded document uploaded" message ----------
            function toggleNoAwardedDocMsg() {
                const noMsg = document.getElementById('noAwardedDocMsg');
                if (!noMsg) return;

                const existingDocsCount = awardedDocumentsContainer.querySelectorAll('.uploaded-file-entry.existing-doc').length;
                const newDocsCount = awardedDocumentsContainer.querySelectorAll('.uploaded-file-entry.new-doc').length;

                if (existingDocsCount + newDocsCount > 0) {
                    noMsg.style.display = 'none';
                } else {
                    noMsg.style.display = 'inline';
                }
            }

            // ---------- PDF Upload Logic: Multi-batch, Removable ----------
            const fileInput = document.getElementById('UploadedFiles');
            let selectedFiles = [];

            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    const files = Array.from(fileInput.files);
                    files.forEach(file => {
                        if (file.type !== "application/pdf") {
                            alert("Only PDF files are allowed.");
                            return;
                        }
                        // Check for duplicate by name+size
                        if (!selectedFiles.find(f => f.name === file.name && f.size === file.size)) {
                            selectedFiles.push(file);
                        }
                    });

                    updateFilesDisplay();
                    // Reset input so same file can be added again if needed
                    fileInput.value = "";
                });
            }

            function updateFilesDisplay() {
                // Remove all new uploaded entries (not existing ones)
                document.querySelectorAll('.uploaded-file-entry.new-doc').forEach(e => e.remove());

                selectedFiles.forEach(function (file, idx) {
                    const entryDiv = document.createElement('div');
                    entryDiv.className = "uploaded-file-entry new-doc p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light";
                    entryDiv.innerHTML = `
                        <div>
                            <strong>${file.name}</strong>
                            <div class="text-muted small mt-1" style="font-size:0.75rem;">
                                <span>Selected for upload</span>
                            </div>
                        </div>
                        <button type="button" class="btn btn-danger btn-sm ms-2 remove-upload-btn">Remove</button>
                    `;
                    entryDiv.querySelector('.remove-upload-btn').addEventListener('click', function () {
                        selectedFiles = selectedFiles.filter(f => !(f.name === file.name && f.size === file.size));
                        updateFilesDisplay();
                        toggleNoAwardedDocMsg();
                    });

                    // Append to awarded or main documents container based on status
                    if (statusDropdown.value === 'Awarded Tender') {
                        if (awardedDocumentsContainer) awardedDocumentsContainer.appendChild(entryDiv);
                    } else {
                        if (uploadedFilesContainer) uploadedFilesContainer.appendChild(entryDiv);
                    }
                });

                toggleNoAwardedDocMsg();
            }

            // ---------- Validation Utilities ----------
            function showFieldError(fieldIdOrName, message, tabName) {
                let field = document.getElementById(fieldIdOrName) || document.querySelector(`[name='${fieldIdOrName}']`);
                if (field) {
                    let label = null;
                    // Try to find the associated label
                    if (field.id) {
                        label = document.querySelector(`label[for='${field.id}']`);
                    }
                    if (!label) {
                        let formGroup = field.closest('.form-group');
                        if (formGroup) {
                            label = formGroup.querySelector('label');
                        }
                    }
                    // Remove any existing error span near this label
                    if (label) {
                        let oldError = label.parentNode.querySelector('.validation-custom-error');
                        if (oldError) oldError.remove();

                        let errorSpan = document.createElement('span');
                        errorSpan.className = 'validation-custom-error text-danger';
                        errorSpan.innerText = message;
                        errorSpan.style.fontWeight = 'bold';

                        if (tabName === 'documents') {
                            // Insert after label
                            label.insertAdjacentElement('afterend', errorSpan);
                        } else {
                            // Append next to label
                            errorSpan.classList.add('ms-2');
                            label.appendChild(errorSpan);
                        }
                    }
                    field.classList.add('field-error-highlight');
                } else {
                    // Fallback error on the whole tab section
                    let tabContent = document.getElementById(tabName);
                    if (tabContent) {
                        let oldError = tabContent.querySelector('.validation-custom-error');
                        if (oldError) oldError.remove();
                        let errorSpan = document.createElement('span');
                        errorSpan.className = 'validation-custom-error text-danger';
                        errorSpan.innerText = message;
                        errorSpan.style.display = 'block';
                        errorSpan.style.fontWeight = 'bold';
                        errorSpan.style.marginBottom = '10px';
                        tabContent.prepend(errorSpan);
                    }
                }
            }

            function clearAllCustomErrors() {
                document.querySelectorAll('.validation-custom-error').forEach(e => e.remove());
                document.querySelectorAll('.field-error-highlight').forEach(e => e.classList.remove('field-error-highlight'));
            }

            function clearFieldError(e) {
                let field = e.target;
                let label = null;
                if (field.id) {
                    label = document.querySelector(`label[for='${field.id}']`);
                }
                if (!label) {
                    let formGroup = field.closest('.form-group');
                    if (formGroup) {
                        label = formGroup.querySelector('label');
                    }
                }
                if (label) {
                    let oldError = label.parentNode.querySelector('.validation-custom-error');
                    if (oldError) oldError.remove();
                }
                field.classList.remove('field-error-highlight');
            }

            document.querySelectorAll('input, textarea, select').forEach(e => {
                e.addEventListener('input', clearFieldError);
                e.addEventListener('change', clearFieldError);
            });

            // ---------- Form Submission Logic: Attach all selected files and Validate ----------
            window.submitForm = function() {
                clearAllCustomErrors();

                // VALIDATION SECTION
                let errors = [];
                let errorFields = [];
                let errorTabs = [];

                // Required fields (details tab)
                let tenderType = document.querySelector('input[name="TenderType"]:checked');
                let tenderNumber = document.querySelector('input[name="TenderNumber"]');
                let closingDate = document.querySelector('input[name="ClosingDate"]');
                let closingTime = document.querySelector('input[name="ClosingTime"]');
                let title = document.querySelector('input[name="Title"]');
                let description = document.querySelector('textarea[name="Description"]');
                let status = statusDropdown.value;
                let awardedTenderNote = document.getElementById('AwardedTenderNote');

                if (!tenderType) {
                    errors.push({field: 'TenderType', message: 'Please select a Tender Type', tab: 'details'});
                    errorFields.push('TenderType'); errorTabs.push('details');
                }
                if (!tenderNumber.value.trim()) {
                    errors.push({field: 'TenderNumber', message: 'Tender Number is required', tab: 'details'});
                    errorFields.push('TenderNumber'); errorTabs.push('details');
                }
                if (!closingDate.value.trim()) {
                    errors.push({field: 'ClosingDate', message: 'Closing Date is required', tab: 'details'});
                    errorFields.push('ClosingDate'); errorTabs.push('details');
                }
                if (!closingTime.value.trim()) {
                    errors.push({field: 'ClosingTime', message: 'Closing Time is required', tab: 'details'});
                    errorFields.push('ClosingTime'); errorTabs.push('details');
                }
                if (!title.value.trim()) {
                    errors.push({field: 'Title', message: 'Tender Title is required', tab: 'details'});
                    errorFields.push('Title'); errorTabs.push('details');
                }
                if (!description.value.trim()) {
                    errors.push({field: 'Description', message: 'Tender Description is required', tab: 'details'});
                    errorFields.push('Description'); errorTabs.push('details');
                }
                if (!status) {
                    errors.push({field: 'StatusDropdown', message: 'Tender Status is required', tab: 'details'});
                    errorFields.push('StatusDropdown'); errorTabs.push('details');
                }

                // Awarded Note required if status is Awarded Tender
                // For Awarded Tender (in documents tab):
        if (status === 'Awarded Tender') {
            if (!awardedTenderNote.value.trim()) {
                errors.push({field: 'AwardedTenderNote', message: 'Awarded feild is required', tab: 'details'});
                errorFields.push('AwardedTenderNote'); errorTabs.push('details');
            }
            // Count only awarded docs not marked for deletion + new uploads
            const awardedDocCount =
                Array.from(awardedDocumentsContainer.querySelectorAll('.uploaded-file-entry.existing-doc'))
                    .filter(div => {
                        const docId = div.getAttribute('data-doc-id');
                        const delCheckbox = document.querySelector(`input[name="DocumentsToDelete"][value="${docId}"]`);
                        return !(delCheckbox && delCheckbox.checked);
                    }).length
                +
                awardedDocumentsContainer.querySelectorAll('.uploaded-file-entry.new-doc').length;
            if (awardedDocCount === 0) {
                errors.push({field: 'AwardedDocuments', message: 'You must upload at least one awarded document.', tab: 'documents'});
                errorFields.push('AwardedDocuments'); errorTabs.push('documents');
            }
        } else {
            // For supporting docs: count existing (not marked for deletion) + new uploads
            const existingDocsCount =
                Array.from(uploadedFilesContainer.querySelectorAll('.uploaded-file-entry.existing-doc'))
                    .filter(div => {
                        const docId = div.getAttribute('data-doc-id');
                        const delCheckbox = document.querySelector(`input[name="DocumentsToDelete"][value="${docId}"]`);
                        return !(delCheckbox && delCheckbox.checked);
                    }).length
                +
                uploadedFilesContainer.querySelectorAll('.uploaded-file-entry.new-doc').length;
            if (existingDocsCount === 0) {
                errors.push({field: 'UploadedFiles', message: 'You must upload at least one supporting document.', tab: 'documents'});
                errorFields.push('UploadedFiles'); errorTabs.push('documents');
            }
        }

                // Show all errors next to their fields
                if (errors.length > 0) {
                    errors.forEach(function(err) {
                        showFieldError(err.field, err.message, err.tab);
                    });
                    // Switch to first errored tab and focus field
                    showTab(errors[0].tab);
                    let firstField = document.getElementById(errors[0].field) || document.querySelector(`[name='${errors[0].field}']`);
                    if (firstField) {
                        firstField.scrollIntoView({behavior: "smooth", block: "center"});
                        firstField.focus();
                    }
                    return;
                }

                let form = document.querySelector('form[asp-action="Edit"]') || document.querySelector('form[action*="Edit"]');
                if (!form) {
                    alert("Form not found!");
                    return;
                }

                let formData = new FormData(form);

                // Remove any existing files from input (to avoid duplicates)
                formData.delete('UploadedFiles');

                // Append all files from selectedFiles array
                selectedFiles.forEach(function(file) {
                    formData.append('UploadedFiles', file, file.name);
                });

                fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    }
                })
                .then(async response => {
                    const contentType = response.headers.get("content-type");
                    if (contentType && contentType.includes("application/json")) {
                        const data = await response.json();
                        if (data.success && data.awarded) {
                            document.getElementById('awardedModalTenderNumber').textContent = data.tenderNumber || '';
                            var modal = new bootstrap.Modal(document.getElementById('awardedModal'));
                            modal.show();
                            document.getElementById('awardedModalCloseBtn').onclick = function () {
                                window.location.reload();
                            };
                        } else if (data.success) {
                            // redirect or show success
                            window.location.href = data.redirectUrl || '/TenderAdmin/Index';
                        } else {
                            alert("Failed to save changes.");
                        }
                    } else if (response.redirected) {
                        window.location.href = response.url;
                    } else {
                        response.text().then(html => {
                            document.body.innerHTML = html;
                            window.scrollTo(0, 0);
                        });
                    }
                })
                .catch(error => {
                    console.error(error);
                    alert("An error occurred while saving changes.");
                });
            };

            // Show initial tab and toggle no-doc message on load
            showTab(currentTab);
            toggleNoAwardedDocMsg();
        });
    </script>
}


<style>
    .custom-dropdown {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        background: #f9fafb url("data:image/svg+xml;utf8,<svg fill='gray' height='20' viewBox='0 0 20 20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M7.293 7.293a1 1 0 011.414 0L10 8.586l1.293-1.293a1 1 0 111.414 1.414l-2 2a1 1 0 01-1.414 0l-2-2a1 1 0 010-1.414z'/></svg>") no-repeat right 1rem center/1.2em 1.2em;
        padding-right: 2.5em;
        cursor: pointer;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .custom-dropdown:focus {
            border-color: #1a7f37;
            box-shadow: 0 0 0 2px #d1fae5;
            background-color: #fff;
        }

        .custom-dropdown option[disabled] {
            color: #aaa;
            font-style: italic;
        }

