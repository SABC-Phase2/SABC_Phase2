@model SABC_Phase2.Models.Tender.TenderReportViewModel
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/litepicker/dist/css/litepicker.css" />
<script src="https://cdn.jsdelivr.net/npm/litepicker/dist/bundle.js"></script>

<div class="page-wrapper">
    <!-- Breadcrumb navigation -->
    <div style="font-size: 0.95rem; color: #888; margin-bottom: 8px;">
        <span style="color: #222;">Dashboard</span> &gt; <span style="color: #00a651;">Reports</span>
    </div>

    <!-- Main report card -->
    <div style="background: #fff; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.10); padding: 48px 0 60px 0; max-width: 900px; margin: 0 auto;">
        <!-- Header row -->
        <div style="display: flex; align-items: center; gap: 18px; margin-bottom: 18px; margin-left: 60px;">
            <a href="javascript:history.back()" style="color: #00a651; font-size: 2rem; text-decoration: none;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h2 class="report-title">@Model.Tender.TenderNumber</h2>

        </div>

        <!-- Table section -->
        <div class="table-wrapper" style="display: flex; justify-content: center; margin-top: 40px;">
            <table class="report-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Local Suppliers</td>
                        <td>@Model.LocalSupplierCount</td>
                    </tr>
                    <tr>
                        <td>Foreign Suppliers</td>
                        <td>@Model.ForeignSupplierCount</td>
                    </tr>
                    <tr>
                        <td>Total Responses</td>
                        <td>@Model.TotalResponses</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- PDF generation button -->
<div style="display: flex; justify-content: center; margin-top: 48px;">
    <button id="generatePdfBtn" style="background: #00a651; color: #fff; border: none; border-radius: 6px; padding: 14px 38px; font-size: 1.1rem; font-weight: 600; box-shadow: 0 2px 8px rgba(0,166,81,0.10); cursor: pointer; display: flex; align-items: center; gap: 10px;">

        Generate PDF
    </button>
</div>

<!-- Font Awesome for icons -->
<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />

<!-- jQuery for functionality -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


<script>

    $(document).ready(function() {

        // Generate report button click handler

        $("#generatePdfBtn").click(function() {

            var tenderId = @Model.Tender.Id;

            // Generate the PDF URL without date range parameters

            var url = '@Url.Action("GenerateTenderSupplierReport", "TenderAdmin")' +

                       '?id=' + tenderId;

            // Open the PDF in a new tab

            window.open(url, '_blank');

        });

    });
</script>


<style>

    .report-title {
        color: #00a651;
        font-weight: 600;
        font-size: 2rem;
        margin: 0;
        letter-spacing: 0.01em;
        border-bottom: 3px solid #00a651;
        padding-bottom: 6px;
        max-width: 100%;
        white-space: nowrap; /* single line */
        overflow: hidden; /* hide overflow */
        text-overflow: ellipsis; /* show ... */
    }

    .report-table {
        width: 100%; /* take available width */
        border-collapse: separate;
        border-spacing: 0;
        font-family: 'Segoe UI', sans-serif;
        margin: 0 auto;
        box-shadow: 0 1px 6px rgba(0,0,0,0.04);
        max-width: 480px; /* limit on large screens */
    }

    /* Scrollable wrapper for table */
    .table-wrapper {
        overflow-x: auto; /* allow horizontal scroll if needed */
        -webkit-overflow-scrolling: touch;
    }

    .report-table th {
        background: #00a651;
        color: #fff;
        font-weight: 600;
        font-size: 1.1rem;
        padding: 12px 24px;
        text-align: left;
        border-bottom: 3px solid #fff;
    }

        .report-table th:first-child {
            border-radius: 6px 0 0 0;
        }

        .report-table th:last-child {
            border-radius: 0 6px 0 0;
            text-align: center;
        }

    .report-table td {
        padding: 12px 24px;
        font-size: 1rem;
    }

    .report-table tr:nth-child(even) td {
        background: #f5f5f5;
    }

    .report-table tr:nth-child(odd) td {
        background: #ededed;
    }

    .report-table td:last-child {
        text-align: center;
        font-weight: 600;
        color: #444;
    }

    .report-table td:first-child {
        color: #888;
        font-weight: 500;
    }

    .report-table tr:last-child td:first-child {
        font-weight: 700;
    }

    /* Mobile responsiveness */
    @@media (max-width: 600px) {
        .report-card {
            padding: 24px 12px;
            margin: 0 12px; /* keep spacing from screen edges */
        }

        .report-header {
            margin-left: 0; /* remove forced left margin */
        }

        .report-title {
            font-size: 1.4rem;
            white-space: normal; /* allow wrapping instead of pushing left */
        }

        .table-wrapper {
            margin: 0 -8px; /* avoid card overflow */
        }

        .report-table {
            max-width: 90%; /* let it shrink */
            min-width: unset; /* remove 400px restriction */
        }

        .pdf-btn {
            width: 100%;
            justify-content: center;
        }
    }
    /* Fix sidebar overlap on mobile */
    @@media (max-width: 768px) {
        .page-wrapper {
            margin-left: 60px; /* push everything right */
        }

        .report-header {
            margin-left: 0; /* don’t double-shift header */
        }

        .report-title {
            font-size: 1.4rem;
            white-space: normal; /* allow wrapping */
        }

        .pdf-btn {
            width: 100%;
            justify-content: center;
        }
    }
    /* Make everything smaller and more compact */
    .page-wrapper {
        font-size: 0.92rem !important;
    }

    .report-title {
        font-size: 1.2rem !important;
        padding-bottom: 4px !important;
        border-bottom-width: 2px !important;
    }

    .report-table th {
        font-size: 0.95rem !important;
        padding: 8px 14px !important;
    }

    .report-table td {
        font-size: 0.92rem !important;
        padding: 8px 14px !important;
    }

    .table-wrapper {
        margin-top: 24px !important;
    }

    div[style*="background: #fff; border-radius: 8px;"] {
        padding: 24px 0 32px 0 !important;
        max-width: 700px !important;
    }

    div[style*="display: flex; align-items: center; gap: 18px;"] {
        gap: 10px !important;
        margin-bottom: 10px !important;
        margin-left: 30px !important;
    }

    button#generatePdfBtn {
        padding: 8px 18px !important;
        font-size: 0.95rem !important;
        border-radius: 5px !important;
        box-shadow: 0 1px 4px rgba(0,166,81,0.08) !important;
        font-weight: 500 !important;
        margin-top: 24px !important;
    }

    @@media (max-width: 600px) {
        .page-wrapper {
            font-size: 0.88rem !important;
            margin-left: 50px !important;
        }

        div[style*="background: #fff; border-radius: 8px;"] {
            padding: 12px 0 18px 0 !important;
            max-width: 98vw !important;
        }

        .report-title {
            font-size: 1rem !important;
            padding-bottom: 2px !important;
        }

        .report-table th,
        .report-table td {
            font-size: 0.85rem !important;
            padding: 6px 8px !important;
        }

        button#generatePdfBtn {
            padding: 7px 10px !important;
            font-size: 0.88rem !important;
            border-radius: 4px !important;
            margin-top: 12px !important;
        }
    }</style>


