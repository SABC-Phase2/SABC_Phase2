@model SABC_Phase2.Models.Tender.TenderReportViewModel
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/litepicker/dist/css/litepicker.css" />
<script src="https://cdn.jsdelivr.net/npm/litepicker/dist/bundle.js"></script>

<div class="page-wrapper">
    <!-- Breadcrumb navigation -->
    <div style="font-size: 0.95rem; color: #888; margin-bottom: 8px;">
        <span style="color: #222;">Dashboard</span> &gt; <span style="color: #00a651;">Reports</span>
    </div>

    <!-- Main report card -->
    <div style="background: #fff; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.10); padding: 48px 0 60px 0; max-width: 900px; margin: 0 auto;">
        <!-- Header row -->
        <div style="display: flex; align-items: center; gap: 18px; margin-bottom: 18px; margin-left: 60px;">
            <a href="javascript:history.back()" style="color: #00a651; font-size: 2rem; text-decoration: none;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h2 class="report-title">@Model.Tender.TenderNumber</h2>
        </div>
        <!-- Table section -->
        <div class="table-wrapper" style="display: flex; justify-content: center; margin-top: 40px;">
            <table class="report-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Local Suppliers</td>
                        <td>@Model.LocalSupplierCount</td>
                    </tr>
                    <tr>
                        <td>Foreign Suppliers</td>
                        <td>@Model.ForeignSupplierCount</td>
                    </tr>
                    <tr>
                        <td>Total Responses</td>
                        <td>@Model.TotalResponses</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- PDF generation button -->
<div style="display: flex; justify-content: center; margin-top: 48px;">
    <button id="generatePdfBtn" style="background: #00a651; color: #fff; border: none; border-radius: 6px; padding: 14px 38px; font-size: 1.1rem; font-weight: 600; box-shadow: 0 2px 8px rgba(0,166,81,0.10); cursor: pointer; display: flex; align-items: center; gap: 10px;">
        Generate PDF
    </button>
</div>

<!-- Font Awesome for icons -->
<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />

<script>
    console.log("PDF generation script loaded");

    // Check if button exists immediately
    var pdfBtn = document.getElementById("generatePdfBtn");

    if (!pdfBtn) {
        console.error("PDF button with ID 'generatePdfBtn' not found!");
        console.log("Available buttons:", document.querySelectorAll('button'));
    } else {
        console.log("PDF button found, attaching event listener");

        pdfBtn.addEventListener("click", function () {
            console.log("Generate PDF button clicked");

            var tenderId = @Model.Tender.Id;
            var button = this;
            var originalText = button.textContent;

            // Prevent double-clicks
            if (button.disabled) {
                console.warn("Button already processing, ignoring click");
                return;
            }

            console.log("Processing tender ID:", tenderId);

            button.textContent = "Generating...";
            button.disabled = true;

            // Build the GET URL for PDF generation
            var url = '@Url.Action("GenerateTenderSupplierReport", "TenderAdmin")' + '?id=' + tenderId;
            console.log("Fetching PDF from URL:", url);

            fetch(url, {
                method: 'GET',
                credentials: 'same-origin',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => {
                console.log("Response status:", response.status);
                console.log("Response OK:", response.ok);
                console.log("Content-Type:", response.headers.get('content-type'));

                if (!response.ok) {
                    return response.text().then(text => {
                        console.error("Server error response:", text);
                        throw new Error(`Server error (${response.status}): ${text}`);
                    });
                }

                // Check content type
                var contentType = response.headers.get('content-type');
                if (contentType && !contentType.includes('application/pdf')) {
                    console.warn('Unexpected content type:', contentType);
                }

                return response.blob();
            })
            .then(blob => {
                console.log("Blob received - Size:", blob.size, "Type:", blob.type);

                if (blob.size === 0) {
                    throw new Error("Generated PDF is empty. Please check your tender data.");
                }

                // Create object URL
                var blobUrl = window.URL.createObjectURL(blob);
                console.log("Blob URL created:", blobUrl);

                // Create download link
                var link = document.createElement('a');
                link.href = blobUrl;
                link.download = `SupplierReport_Tender_${tenderId}_${new Date().toISOString().slice(0, 10)}.pdf`;
                link.style.display = 'none';

                console.log("Download filename:", link.download);

                // Append to body
                document.body.appendChild(link);
                console.log("Link appended to DOM");

                // Trigger download with delay to ensure browser processes
                setTimeout(function() {
                    try {
                        link.click();
                        console.log("Download triggered successfully");
                    } catch (e) {
                        console.error("Click failed:", e);
                        // Fallback: try opening in new window
                        window.open(blobUrl, '_blank');
                        console.log("Opened in new tab as fallback");
                    }

                    // Cleanup after delay
                    setTimeout(function() {
                        try {
                            document.body.removeChild(link);
                            window.URL.revokeObjectURL(blobUrl);
                            console.log("Cleanup completed");
                        } catch (e) {
                            console.error("Cleanup error:", e);
                        }
                    }, 250);
                }, 100);

            })
            .catch(error => {
                console.error('PDF Generation Error:', error);
                console.error('Error details:', error.message);
                alert("Failed to generate report: " + error.message);
            })
            .finally(() => {
                console.log("Restoring button state");
                button.textContent = originalText;
                button.disabled = false;
            });
        });

        console.log("Event listener attached successfully");
    }
</script>


<style>

    .report-title {
        color: #00a651;
        font-weight: 600;
        font-size: 2rem;
        margin: 0;
        letter-spacing: 0.01em;
        border-bottom: 3px solid #00a651;
        padding-bottom: 6px;
        max-width: 100%;
        white-space: nowrap; /* single line */
        overflow: hidden; /* hide overflow */
        text-overflow: ellipsis; /* show ... */
    }

    .report-table {
        width: 100%; /* take available width */
        border-collapse: separate;
        border-spacing: 0;
        font-family: 'Segoe UI', sans-serif;
        margin: 0 auto;
        box-shadow: 0 1px 6px rgba(0,0,0,0.04);
        max-width: 480px; /* limit on large screens */
    }

    /* Scrollable wrapper for table */
    .table-wrapper {
        overflow-x: auto; /* allow horizontal scroll if needed */
        -webkit-overflow-scrolling: touch;
    }

    .report-table th {
        background: #00a651;
        color: #fff;
        font-weight: 600;
        font-size: 1.1rem;
        padding: 12px 24px;
        text-align: left;
        border-bottom: 3px solid #fff;
    }

        .report-table th:first-child {
            border-radius: 6px 0 0 0;
        }

        .report-table th:last-child {
            border-radius: 0 6px 0 0;
            text-align: center;
        }

    .report-table td {
        padding: 12px 24px;
        font-size: 1rem;
    }

    .report-table tr:nth-child(even) td {
        background: #f5f5f5;
    }

    .report-table tr:nth-child(odd) td {
        background: #ededed;
    }

    .report-table td:last-child {
        text-align: center;
        font-weight: 600;
        color: #444;
    }

    .report-table td:first-child {
        color: #888;
        font-weight: 500;
    }

    .report-table tr:last-child td:first-child {
        font-weight: 700;
    }

    /* Mobile responsiveness */
    @@media (max-width: 600px) {
        .report-card {
            padding: 24px 12px;
            margin: 0 12px; /* keep spacing from screen edges */
        }

        .report-header {
            margin-left: 0; /* remove forced left margin */
        }

        .report-title {
            font-size: 1.4rem;
            white-space: normal; /* allow wrapping instead of pushing left */
        }

        .table-wrapper {
            margin: 0 -8px; /* avoid card overflow */
        }

        .report-table {
            max-width: 90%; /* let it shrink */
            min-width: unset; /* remove 400px restriction */
        }

        .pdf-btn {
            width: 100%;
            justify-content: center;
        }
    }
    /* Fix sidebar overlap on mobile */
    @@media (max-width: 768px) {
        .page-wrapper {
            margin-left: 60px; /* push everything right */
        }

        .report-header {
            margin-left: 0; /* don’t double-shift header */
        }

        .report-title {
            font-size: 1.4rem;
            white-space: normal; /* allow wrapping */
        }

        .pdf-btn {
            width: 100%;
            justify-content: center;
        }
    }</style>


