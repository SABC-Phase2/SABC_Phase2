@model SABC_Phase2.Models.Tender.TenderReportViewModel
<!--
    This Razor view uses the TenderReportViewModel as its model.
    The model contains:
      - Tender: the Tender entity for this report
      - LocalSupplierCount: number of local suppliers who applied
      - ForeignSupplierCount: number of foreign suppliers who applied
      - TotalResponses: total number of applications (local + foreign)
-->

<div style="margin: 30px 0 0 0;">
    <!-- Breadcrumb navigation for user context -->
    <div style="font-size: 0.95rem; color: #888; margin-bottom: 8px;">
        <span style="color: #222;">Dashboard</span> &gt; <span style="color: #00a651;">Reports</span>
    </div>
    <!-- Main report card container with styling for background, border, and padding -->
    <div style="background: #fff; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.10); padding: 48px 0 60px 0; max-width: 900px; margin: 0 auto;">
        <!-- Header row: back button and tender number -->
        <div style="display: flex; align-items: center; gap: 18px; margin-bottom: 18px; margin-left: 60px;">
            <!-- Back button: returns user to previous page -->
            <a href="javascript:history.back()" style="color: #00a651; font-size: 2rem; text-decoration: none;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <!-- Tender number displayed as the main heading -->
            <h2 style="color: #00a651; font-weight: 600; font-size: 2rem; margin: 0; letter-spacing: 0.01em; border-bottom: 3px solid #00a651; padding-bottom: 6px;">
                <h2>@Model.Tender.TenderNumber</h2>
            </h2>
        </div>
        <!-- Table section: displays supplier counts -->
        <div style="display: flex; justify-content: center; margin-top: 40px;">
            <table class="report-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Local supplier count from the model -->
                    <tr>
                        <td>Local Suppliers</td>
                        <td>@Model.LocalSupplierCount</td>
                    </tr>
                    <!-- Foreign supplier count from the model -->
                    <tr>
                        <td>Foreign Suppliers</td>
                        <td>@Model.ForeignSupplierCount</td>
                    </tr>
                    <!-- Total responses (local + foreign) -->
                    <tr>
                        <td>Total Responses</td>
                        <td>@Model.TotalResponses</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- PDF generation button: links to the controller action to generate a PDF for this tender -->
<div style="display: flex; justify-content: center; margin-top: 48px;">
    <a href="@Url.Action("GenerateTenderSupplierReport", "TenderAdmin", new { id = Model.Tender.Id })" target="_blank"
       style="text-decoration: none;">
        <button style="background: #00a651; color: #fff; border: none; border-radius: 6px; padding: 14px 38px; font-size: 1.1rem; font-weight: 600; box-shadow: 0 2px 8px rgba(0,166,81,0.10); cursor: pointer; display: flex; align-items: center; gap: 10px;">
            Generate PDF <i class="fas fa-file-pdf"></i>
        </button>
    </a>
</div>
<!-- Font Awesome for icons (arrow, PDF) -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

<style>
    .report-table {
        min-width: 400px;
        max-width: 480px;
        border-collapse: separate;
        border-spacing: 0;
        font-family: 'Segoe UI', sans-serif;
        margin: 0 auto;
        box-shadow: 0 1px 6px rgba(0,0,0,0.04);
    }
    .report-table th {
        background: #00a651;
        color: #fff;
        font-weight: 600;
        font-size: 1.1rem;
        padding: 12px 24px;
        text-align: left;
        border-bottom: 3px solid #fff;
    }
    .report-table th:first-child {
        border-radius: 6px 0 0 0;
    }
    .report-table th:last-child {
        border-radius: 0 6px 0 0;
        text-align: center;
    }
    .report-table td {
        padding: 12px 24px;
        font-size: 1rem;
    }
    .report-table tr:nth-child(even) td {
        background: #f5f5f5;
    }
    .report-table tr:nth-child(odd) td {
        background: #ededed;
    }
    .report-table td:last-child {
        text-align: center;
        font-weight: 600;
        color: #444;
    }
    .report-table td:first-child {
        color: #888;
        font-weight: 500;
    }
    .report-table tr:last-child td:first-child {
        font-weight: 700;
    }
</style>

