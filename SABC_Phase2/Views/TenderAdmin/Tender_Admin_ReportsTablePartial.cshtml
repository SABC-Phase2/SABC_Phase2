@model List<SABC_Phase2.Models.Tender.Tender>

@{
    var closedTenders = Model ?? new List<SABC_Phase2.Models.Tender.Tender>();
    int tendersPerRow = 4;
    int gridItemsCount = Model?.Count ?? 0;
    int gridViewMax = 8;
    int gridTotalItems = closedTenders.Count;
    int gridTotalPages = (int)Math.Ceiling(gridTotalItems / (double)gridViewMax);

    // List view: paginated
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 5;
    int totalItems = ViewBag.TotalItems ?? closedTenders.Count;
    int totalPages = ViewBag.TotalPages ?? (int)Math.Ceiling((double)totalItems / pageSize);
    string typeFilter = ViewBag.Type as string ?? "";
    string search = ViewBag.Search as string ?? "";
    var pagedTenders = closedTenders.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
}

<div class="card report-card">
    <div class="card-header">
        <div class="label-toggle-wrap">
            <label class="closed-label">Closed Tenders</label>
            <span id="totalClosedTenders" style="margin-left: 10px; font-weight: 600; color:#808080; font-size: 1.1rem;">
                Total: @closedTenders.Count
            </span>
        </div>

        <div class="view-toggle-buttons" style="display: flex; align-items: center; gap: 8px;">
            <button id="gridViewBtn" class="view-toggle" title="Grid View">
                <i class="fas fa-th"></i>
            </button>
            <button id="listViewBtn" class="view-toggle active" title="List View">
                <i class="fas fa-list"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (!closedTenders.Any())
        {
            <div class="no-tenders">No closed tenders found.</div>
        }
        else
        {
            <!-- GRID VIEW: Carousel of 8 per slide -->
            <div class="tender-blocks-container grid-view">
                <div class="carousel-controls-wrapper" style="display: flex; align-items: center; justify-content: center; gap: 10px;">
                    @if (gridItemsCount >= 8)
                    {
                        <button class="carousel-arrow prev" id="gridCarouselPrev" onclick="moveGridCarousel(-1)">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                    }
                    <div class="carousel-track" style="width: 100%;">
                        <div class="tender-carousel-row" id="tenderGridCarouselRow" style="display: flex; flex-wrap: wrap; gap: 20px;">
                            @for (int i = 0; i < gridItemsCount; i++)
                            {
                                var tender = Model[i];
                                <div class="tender-block tender-carousel-item" style="width: 23.5%;">
                                    <a href="@Url.Action("tender_Report", "TenderAdmin", new { id = tender.Id })" style="text-decoration:none; color:inherit;">
                                        <div class="tender-block-logo-wrap">
                                            <span class="tender-block-status">CLOSED</span>
                                            <img src="~/lib/Images/logoblack.png" class="tender-block-thumbnail" alt="SABC Logo" />
                                        </div>
                                        <div class="tender-block-content">
                                            <div class="tender-block-number">@tender.TenderNumber</div>
                                            <div class="tender-block-title">
                                                @(tender.Title?.Length > 60 ? tender.Title.Substring(0, 57) + "..." : tender.Title)
                                            </div>
                                            <div class="tender-block-closing">
                                                CLOSING DATE: <span class="closing-red">@tender.ClosingDate.ToString("dd MMM yyyy")</span>
                                                TIME: <span class="closing-red">@tender.ClosingTime?.ToString(@"hh\:mm")</span>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                    @if (gridItemsCount >= 8)
                    {
                        <button class="carousel-arrow next" id="gridCarouselNext" onclick="moveGridCarousel(1)">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    }
                </div>
            </div>
            <!-- LIST VIEW: Paginated -->
            <div class="tender-blocks-container list-view" style="display:none;">
                @foreach (var tender in pagedTenders)
                {
                    <a href="@Url.Action("tender_Report", "TenderAdmin", new { id = tender.Id })" style="text-decoration:none; color:inherit;">
                        <div class="tender-block">
                            <div class="tender-block-logo-wrap">
                                <img src="~/lib/Images/logoblack.png" class="tender-block-thumbnail" alt="SABC Logo" />
                                <span class="tender-block-status">CLOSED</span>
                            </div>
                            <div class="tender-block-content">
                                <div class="tender-block-number">@tender.TenderNumber</div>
                                <div class="tender-block-title">
                                    @(tender.Title?.Length > 60 ? tender.Title.Substring(0, 57) + "..." : tender.Title)
                                </div>
                                <div class="tender-block-closing">
                                    CLOSING DATE: <span class="closing-red">@tender.ClosingDate.ToString("dd MMM yyyy")</span>
                                    TIME: <span class="closing-red">@tender.ClosingTime?.ToString(@"hh\:mm")</span>
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>

<!-- Pagination Controls: Only for List View -->
@if (totalPages > 1)
{
    <div id="listPaginationBar" class="custom-pagination report-list-pagination" style="margin-top: 1rem; display:none;">
        <ul class="pagination-list">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link arrow-link"
                   href="?page=@(currentPage - 1)&search=@search&type=@typeFilter"
                   tabindex="@(currentPage == 1 ? "-1" : "0")"
                   aria-label="Previous">
                    <span aria-hidden="true">&#8592;</span>
                </a>
            </li>
            @if (currentPage > 3)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=1&search=@search&type=@typeFilter">1</a>
                </li>
                @if (currentPage > 4)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                if (i == currentPage)
                {
                    <li class="page-item active">
                        <span class="page-link"><span class="page-number">@i</span></span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@i&search=@search&type=@typeFilter">@i</a>
                    </li>
                }
            }
            @if (currentPage < totalPages - 2)
            {
                if (currentPage < totalPages - 3)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link" href="?page=@totalPages&search=@search&type=@typeFilter">@totalPages</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link arrow-link"
                   href="?page=@(currentPage + 1)&search=@search&type=@typeFilter"
                   tabindex="@(currentPage == totalPages ? "-1" : "0")"
                   aria-label="Next">
                    <span aria-hidden="true">&#8594;</span>
                </a>
            </li>
        </ul>
    </div>
}