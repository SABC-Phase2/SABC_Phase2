@model List<SABC_Phase2.Models.Tender.TenderDraft>

@{
    ViewData["BannerText"] = "Draft Tenders";
}
@{
    int pageSize = ViewBag.PageSize ?? 7;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalItems = ViewBag.TotalItems ?? (Model?.Count ?? 0);
    int totalPages = ViewBag.TotalPages ?? 1;
    int emptyRows = pageSize - (Model?.Count ?? 0);
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">


<div class="breadcrumb-custom">
    Dashboard <span class="breadcrumb-arrow">&#x2794;</span> <span class="breadcrumb-active">Drafts</span>
</div>

<div class="tender-action-bar">
    <div class="search-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" class="search-input" placeholder="Search keyword" />
    </div>

    <button class="refresh-btn">
        <i class="fas fa-sync-alt"></i>
    </button>

</div>

<div class="table-container">
    <div class="tender-total-label">
        Total: @totalItems
    </div>
    <div class="table-scroll-container">
        <table class="tender-table">
            <thead>
                <tr>
                    <th>THUMBNAIL</th>
                    <th>TITLE</th>
                    <th>DRAFT DATE <i class="fas fa-sort"></i></th>
                    <th>ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var draft in Model)
                    {
                        <tr>
                            <td>
                                <img src="~/lib/Images/logoblack.png" class="tender-thumbnail" alt="SABC Logo" />
                            </td>
                            <td class="tender-title">@(!string.IsNullOrWhiteSpace(draft.Title) ? draft.Title : "(No Title)")</td>
                            <td class="tender-date">@draft.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <a asp-controller="TenderAdmin" asp-action="EditDraft" asp-route-id="@draft.Id" class="edit-btn">
                                    Continue <i class="fas fa-edit"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="no-tenders-row">
                        <td colspan="4">No drafts found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1){

    <div class="custom-pagination">
    <ul class="pagination-list">
        <!-- Previous button -->
        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
            <a class="page-link arrow-link"
               href="?page=@(currentPage - 1)"
               tabindex="@(currentPage == 1 ? "-1" : "0")"
               aria-label="Previous">
                <span aria-hidden="true">&#8592;</span>
            </a>
        </li>
        <!-- First page -->
        @if (currentPage > 3)
        {
            <li class="page-item">
                <a class="page-link" href="?page=1">1</a>
            </li>
            @if (currentPage > 4)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
        }
        <!-- Pages around current -->
        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
        {
            if (i == currentPage)
            {
                <li class="page-item active">
                    <span class="page-link"><span class="page-number">@i</span></span>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
        }
        <!-- Last page -->
        @if (currentPage < totalPages - 2)
        {
            if (currentPage < totalPages - 3)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
            }
            <li class="page-item">
                <a class="page-link" href="?page=@totalPages">@totalPages</a>
            </li>
        }
        <!-- Next button -->
        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
            <a class="page-link arrow-link"
               href="?page=@(currentPage + 1)"
               tabindex="@(currentPage == totalPages ? "-1" : "0")"
               aria-label="Next">
                <span aria-hidden="true">&#8594;</span>
            </a>
        </li>
    </ul>
</div>
}
<style>
    .breadcrumb-custom {
        color: #888;
        font-size: 1.00rem;
        font-weight: 500;
        margin-bottom: 8px;
        margin-top: 18px;
        letter-spacing: 0.01em;
        display: flex;
        align-items: center;
        gap: 0.2em;
    }

    .breadcrumb-active {
        color: #1a7f37;
        font-weight: 500;
    }

    .table-container {
        margin-top: 35px;
        margin-bottom: 50px;
        padding: 30px;
        background-color: #fff;
        border-radius: 8px;
        overflow-x: hidden;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    .tender-table {
        width: 100%;
        max-width: 100%;
        border-collapse: collapse;
        font-family: 'Segoe UI', sans-serif;
    }

        .tender-table thead th {
            background-color: #f5c012;
            color: #fff;
            padding: 12px;
            text-align: center;
            font-weight: bold;
            border-radius: 0;
        }

            .tender-table thead th:nth-child(3) {
                white-space: nowrap;
            }

            .tender-table thead th:nth-child(4) {
                white-space: nowrap;
            }

            /* Specific column background overrides */
            .tender-table thead th:nth-child(2) {
                /* TITLES */

                background-color: #333;
            }

            .tender-table thead th:nth-child(3) {
                background-color: #f5c012;
            }

            .tender-table thead th:first-child {
                border-top-left-radius: 6px;
            }

            .tender-table thead th:last-child {
                border-top-right-radius: 6px;
                background-color: #333;
            }

        .tender-table tbody tr {
            background-color: #f9f9f9;
            border-radius: 6px;
            transition: background 0.2s ease-in-out;
        }

            .tender-table tbody tr:hover {
                background-color: #f1f1f1;
            }

        .tender-table td {
            padding: 16px;
            vertical-align: middle;
            text-align: center;
        }

    .tender-thumbnail {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
    }

    .tender-title {
        font-size: 0.95rem;
        color: #333;
    }

    .edit-btn {
        background-color: #fff;
        border: 1px solid #00a651;
        color: #00a651;
        font-size: 0.85rem;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .edit-btn:hover {
            background-color: #00a651;
            color: #fff;
        }

    .tender-table tbody tr {
        border-bottom: 1px solid rgba(0,0,0,0.08);
    }

    .tender-action-bar {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 25px 0;
        margin-top: 45px;
        flex-wrap: wrap;
    }

    .search-wrapper {
        position: relative;
        width: 250px;
    }

        .search-wrapper i {
            position: absolute;
            top: 50%;
            left: 12px;
            transform: translateY(-50%);
            color: #ccc;
            font-size: 1rem;
        }

    .search-input {
        width: 100%;
        padding: 12px 12px 12px 38px;
        border: none;
        border-radius: 4px;
        background-color: #333;
        color: #fff;
        font-family: 'Segoe UI', sans-serif;
        font-size: 1rem;
    }

        .search-input::placeholder {
            color: #ccc;
        }

    .refresh-btn {
        background-color: #333;
        color: #fff;
        border: none;
        border-radius: 4px;
        padding: 12px 14px;
        font-size: 1.1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .new-tender-btn {
        margin-left: auto;
        background: linear-gradient(to bottom, #00a651 90%, #008c44 100%);
        color: #fff;
        border: none;
        border-radius: 4px;
        padding: 12px 20px;
        font-size: 1rem;
        font-family: 'Segoe UI', sans-serif;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 0 0 #007a3d, 0 8px 16px -4px rgba(0, 166, 81, 0.25);
        transition: background 0.2s, box-shadow 0.2s, transform 0.1s;
        position: relative;
    }

        .new-tender-btn:hover {
            background: linear-gradient(to bottom, #009344 90%, #007a3d 100%);
            box-shadow: 0 2px 0 0 #007a3d, 0 4px 8px -2px rgba(0, 166, 81, 0.18);
            transform: translateY(2px);
        }

    .table-scroll-container {
        max-height: 700px;
        overflow-y: auto;
        margin-bottom: 20px;
        border-radius: 8px;
    }

    .tender-table thead {
        position: sticky;
        top: 0;
        z-index: 10;
    }

    /* Custom scrollbar */
    .table-scroll-container::-webkit-scrollbar {
        width: 8px;
    }

    .table-scroll-container::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .table-scroll-container::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 10px;
    }

        .table-scroll-container::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    .no-tenders-row td {
        border: none !important;
        background: transparent !important;
        text-align: center;
        color: #888;
        font-style: italic;
    }

    .tender-date {
        color: #888;
        font-size: 0.98rem;
    }

    .tender-total-label {
        width: 100%;
        text-align: right;
        margin: 0px 2px 8px 0;
        font-size: 1rem;
        color: #666;
        font-family: 'Segoe UI', sans-serif;
        background: none;
        border: none;
        box-shadow: none;
        padding: 0;
        border-radius: 0;
    }

    .page-item:first-child .page-link,
    .page-item:last-child .page-link {
        border-radius: 50%;
    }



    /* Pagination */
    .custom-pagination {
        display: flex;
        justify-content: center;
        margin-top: -90px; /* Pull up closer to card */
        z-index: 1;
    }

    .pagination-list {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 18px;
        background: #fff;
        padding: 8px 20px;
        border-radius: 15px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
    }

    .page-item {
        margin: 0;
    }

    .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: #fff;
        color: #333;
        border: 1px solid #ddd;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

    .page-item.active .page-link {
        background-color: #000;
        color: white;
        border-color: #000;
        font-weight: 700;
        transform: rotate(45deg);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        padding: 0;
        transition: background 0.2s, color 0.2s;
        cursor: pointer;
    }

        .page-item.active .page-link .page-number {
            display: inline-block;
            transform: rotate(-45deg);
            font-size: 1rem;
            width: 100%;
            text-align: center;
            color: white;
            transition: color 0.2s;
        }

        .page-item.active .page-link:hover,
        .page-item.active .page-link:focus {
            background: #fff;
            color: #000;
            border-color: #000;
        }

            .page-item.active .page-link:hover .page-number,
            .page-item.active .page-link:focus .page-number {
                color: #000;
            }

    .page-link.arrow-link {
        font-size: 1.5rem;
        font-weight: bold;
        background: #f5f5f5;
        color: #000;
        text-decoration: none;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        transition: background 0.2s, color 0.2s, border 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

        .page-link.arrow-link:hover:not(.disabled) {
            background: #000;
            color: #fff;
            border-color: #000;
        }

    .page-item.active .page-link span {
        transform: rotate(-45deg);
        display: inline-block;
    }


    .page-item.disabled .page-link {
        color: #ccc !important;
        pointer-events: none;
        background: #f5f5f5 !important;
        border-color: #eee !important;
    }

    .page-link:hover:not(.active):not(.disabled) {
        background-color: #f1f1f1;
        color: #000;
        border-color: #000;
    }
</style>