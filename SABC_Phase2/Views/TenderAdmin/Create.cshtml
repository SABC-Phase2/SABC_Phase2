﻿@{
ViewData["BannerText"] = "Tenders";
}

@model SABC_Phase2.Models.Tender.TenderViewModel

@{
    ViewBag.Title = "Create Tender";
}

<div class="breadcrumb-custom">
    Dashboard <span class="breadcrumb-arrow">&#x2794;</span> Tenders <span class="breadcrumb-arrow">&#x2794;</span> <span class="breadcrumb-active">Create Tender</span>
</div>

<div class="tab-header">
    <div id="tabDetails" class="tab-btn active" onclick="showTab('details')">Details</div>
    <div id="tabDocuments" class="tab-btn" onclick="showTab('documents')">Documents</div>


    <div id="tabSubmit" class="tab-btn disabled" onclick="if(!this.classList.contains('disabled')) showTab('submit')">Submit</div>
</div>

<div class="tab-container">
    <form asp-action="Create" enctype="multipart/form-data" method="post" autocomplete="off">
        @if (Model.DraftId != null)
        {
            <input type="hidden" name="DraftId" value="@Model.DraftId" />
        }
        <div id="details" class="tab-content active">
            <div class="form-row">
                <div class="form-group">
                    <label>Tender Type <span class="text-danger">*</span></label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFQ" required
                                   @(Model.TenderType == "RFQ" ? "checked" : "") />
                            <label class="form-check-label">RFQ</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFP"
                                   @(Model.TenderType == "RFP" ? "checked" : "") />
                            <label class="form-check-label">RFP</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFI"
                                   @(Model.TenderType == "RFI" ? "checked" : "") />
                            <label class="form-check-label">RFI</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFO"
                                   @(Model.TenderType == "RFO" ? "checked" : "") />
                            <label class="form-check-label">RFO</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="TenderNumber">Tender number <span class="text-danger">*</span></label>
                    <input asp-for="TenderNumber" class="form-control" />
                    <span asp-validation-for="TenderNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClosingDate">Closing Date <span class="text-danger">*</span></label>
                    <input asp-for="ClosingDate" type="date" class="form-control" />
                    <span asp-validation-for="ClosingDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClosingTime">Closing Time <span class="text-danger">*</span></label>
                    <input asp-for="ClosingTime" type="time" class="form-control" />
                    <span asp-validation-for="ClosingTime" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-control custom-dropdown" disabled>
                        <option value="Open Tender" selected>Open Tender</option>
                    </select>
                    <input type="hidden" asp-for="Status" value="Open Tender" />
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Title">Tender Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" maxlength="100" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Description">Tender Description <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="200"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>




            </div>
        </div>

        <!-- Upload Documents Section -->
        <div id="documents" class="tab-content">
            <label for="UploadedFiles" class="upload-label">Upload Documents</label>
            <div class="upload-label-underline"></div>

            <div id="uploadedFilesContainer" class="mt-3">
                @if (Model.ExistingDocuments != null && Model.ExistingDocuments.Any())
                {
                    foreach (var doc in Model.ExistingDocuments)
                    {
                        <div class="uploaded-file-entry existing-doc p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light" data-doc-id="@doc.Id">
                            <div>
                                <strong>@doc.FileName</strong>
                                <div class="text-muted small mt-1" style="font-size:0.75rem;">
                                    <a href="@doc.FilePath" target="_blank">View</a>
                                </div>
                            </div>
                            <!-- Optionally, add a remove button here -->
                        </div>
                    }
                }
            </div>

            <div id="uploadInputGroup" class="d-flex align-items-center gap-2 mt-3">
                <label class="supporting-label mb-0"><i class="fas fa-file-pdf text-danger me-1"></i> Supporting Document</label>
                <label class="btn btn-success btn-sm d-flex align-items-center gap-1 mb-0">
                    <i class="fas fa-upload"></i> Upload
                    <input type="file" id="UploadedFiles" name="UploadedFiles" multiple accept=".pdf" hidden />
                </label>
            </div>
        </div>

        <div id="submit" class="tab-content">
            <!-- Centered Tabs Above Submit Tender -->
            <div class="submit-tabs-container">
                <div class="submit-tabs">
                    <div id="submitTabPublish" class="submit-tab active" onclick="showSubmitTab('publish')">Publish Now</div>
                    <div id="submitTabSchedule" class="submit-tab" onclick="showSubmitTab('schedule')">Schedule</div>
                    <div id="submitTabDraft" class="submit-tab" onclick="showSubmitTab('draft')">Save as Draft</div>
                </div>
            </div>

            <!-- Submit Tab Content Sections -->
            <div id="submitTabContentPublish" class="submit-tab-content active">
                <p>Ready to publish your tender immediately.</p>
            </div>
            <div id="submitTabContentSchedule" class="submit-tab-content">
                <p>Set a date and time to schedule your tender publication.</p>
                <div class="form-group full-width">
                    <div class="schedule-container">
                        <!-- Checkbox removed! Only show the date and time pickers -->
                        <div class="schedule-fields show" id="scheduleFields">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="ScheduledDate">Scheduled Date</label>
                                    <input type="date" id="ScheduledDate" name="ScheduledDate" class="form-control" />
                                </div>
                                <div class="form-group">
                                    <label for="ScheduledTime">Scheduled Time</label>
                                    <input type="time" id="ScheduledTime" name="ScheduledTime" class="form-control" />
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="submitTabContentDraft" class="submit-tab-content">
                <p>Your tender will be saved as a draft. You can return and edit or publish it later.</p>
                <!-- Add any additional draft-related form elements or instructions here. -->
            </div>
        </div>
    </form>
</div>


<div class="action-buttons">
    <button type="button" id="cancelBtn" class="action-btn cancel-btn" onclick="window.location.href='@Url.Action("Index", "Tender")'">Cancel</button>
    <button type="button" id="doneBtn" class="action-btn continue-btn" onclick="submitForm()">Done <span class="arrow-icon"></span></button>
    @* <button type="button" id="continueBtn" class="action-btn preview-btn" onclick="goToSubmitTab()">Continue</button> *@
    <button type="button" id="continueBtn" class="action-btn preview-btn">Continue</button>
</div>

@* Modal popup for immediate tender creation (Success) *@
<!-- Modal Popup for Successful Publish -->
<div id="publishSuccessModal" class="modal fade" tabindex="-1" aria-labelledby="publishSuccessModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="publishSuccessModalLabel" style="width:100%;text-align:center;">
                    <span id="modalTenderNumber" style="font-weight:bold;"></span>
                </h5>
                <img src="~/lib/Images/Tick-Box.png" alt="Success" style="width: 64px; height: 64px; margin: 12px auto 0 auto; display: block;" />
            </div>
            <div class="modal-body">
                <p style="font-size:1.25rem; font-weight:600;">Published Successfully</p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="modalCloseBtn" class="btn btn-primary" style="min-width:100px;">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Popup for Scheduled Tender Success -->
<div id="scheduledSuccessModal" class="modal fade" tabindex="-1" aria-labelledby="scheduledSuccessModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="scheduledSuccessModalLabel" style="width:100%;text-align:center;">
                    <span id="scheduledModalTenderNumber" style="font-weight:bold;"></span>
                </h5>
                <img src="~/lib/Images/Tick-Box.png" alt="Success" style="width: 64px; height: 64px; margin: 12px auto 0 auto; display: block;" />
            </div>
            <div class="modal-body">
                <p style="font-size:1.25rem; font-weight:600;">Tender Successfully Scheduled</p>
                <div style="font-size:0.95rem; color: #222; margin-top:10px;">
                    Your Tender has been saved to
                    <a href="#" id="scheduledTendersLink" style="color:#222; text-decoration:underline; font-weight:500;">Scheduled Tenders</a>
                </div>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="scheduledModalCloseBtn" class="btn btn-primary" style="min-width:100px;">Close</button>
            </div>
        </div>
    </div>
</div>


<!-- Modal Popup for Draft Save Success -->
<div id="draftSavedModal" class="modal fade" tabindex="-1" aria-labelledby="draftSavedModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="draftSavedModalLabel" style="width:100%;text-align:center;">
                    <span id="draftModalTenderNumber" style="font-weight:bold;"></span>
                </h5>
                <img src="~/lib/Images/Tick-Box.png" alt="Success" style="width: 64px; height: 64px; margin: 12px auto 0 auto; display: block;" />
            </div>
            <div class="modal-body">
                <p style="font-size:1.25rem; font-weight:600;">Draft saved</p>
                <div style="font-size:0.95rem; color: #222; margin-top:10px;">
                    Your draft has been saved to
                    <a href="#" id="draftResponsesLink" style="color:#222; text-decoration:underline; font-weight:500;">draft responses</a>
                </div>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="draftModalCloseBtn" class="btn btn-primary" style="min-width:100px;">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Tab logic
            const tabs = ['details', 'documents', 'submit'];
            let currentTab = 'details';

            const continueBtn = document.getElementById('continueBtn');
            const doneBtn = document.getElementById('doneBtn');
            let draftBtn = document.getElementById('draftBtn');

            const submitTabs = ['publish', 'schedule', 'draft'];
            let currentSubmitSubTab = 'publish';

            window.showTab = function(tabName) {
                document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
                document.querySelectorAll('.tab-btn').forEach(tb => tb.classList.remove('active'));
                document.getElementById(tabName).classList.add('active');
                document.getElementById('tab' + capitalize(tabName)).classList.add('active');
                updateActionButtons(tabName);
                currentTab = tabName;
            }

            continueBtn.addEventListener('click', function() {
                let idx = tabs.indexOf(currentTab);
                if (idx < tabs.length - 1) {
                    showTab(tabs[idx + 1]);
                }
            });

            function attachDraftBtnLogic() {
                draftBtn = document.getElementById('draftBtn');
                if (draftBtn) {
                    draftBtn.addEventListener('click', function() {
                        showSubmitTab('draft');
                    });
                }
            }

            function updateActionButtons(tabName) {
                if (tabName === 'details' || tabName === 'documents') {
                    continueBtn.style.display = 'inline-block';
                    doneBtn.style.display = 'none';
                    if (draftBtn) draftBtn.style.display = 'none';
                } else if (tabName === 'submit') {
                    continueBtn.style.display = 'none';
                    doneBtn.style.display = 'inline-block';
                    if (draftBtn) draftBtn.style.display = 'inline-block';
                }
            }

            function capitalize(str) {
                return str.charAt(0).toUpperCase() + str.slice(1);
            }

            function showSubmitTab(subTabName) {
                document.querySelectorAll('.submit-tab-content').forEach(stc => stc.classList.remove('active'));
                document.querySelectorAll('.submit-tab').forEach(stb => stb.classList.remove('active'));
                document.getElementById('submitTabContent' + capitalize(subTabName)).classList.add('active');
                document.getElementById('submitTab' + capitalize(subTabName)).classList.add('active');
                currentSubmitSubTab = subTabName;
            }

            submitTabs.forEach(function(subTabName) {
                const tabBtn = document.getElementById('submitTab' + capitalize(subTabName));
                if (tabBtn) {
                    tabBtn.onclick = function() {
                        showSubmitTab(subTabName);
                    };
                }
            });

            showTab(currentTab);
            if (document.getElementById('submitTabPublish')) {
                showSubmitTab('publish');
            }
            attachDraftBtnLogic();

            // ---- PDF upload logic (multi-batch and removable) ----
            const fileInput = document.getElementById('UploadedFiles');
            const uploadedFilesContainer = document.getElementById('uploadedFilesContainer');
            let selectedFiles = [];

            fileInput.addEventListener('change', function () {
                const files = Array.from(fileInput.files);

                // Add new files to the selectedFiles array if not already present
                files.forEach(file => {
                    if (file.type !== "application/pdf") {
                        alert("Only PDF files are allowed.");
                        return;
                    }
                    // Check if already present (by name + size)
                    if (!selectedFiles.find(f => f.name === file.name && f.size === file.size)) {
                        selectedFiles.push(file);
                    }
                });

                updateFilesDisplay();
                // Reset file input so the same file can be added again if needed
                fileInput.value = "";
            });

            function updateFilesDisplay() {
                // Remove all new uploaded entries (not existing ones)
                document.querySelectorAll('.uploaded-file-entry.new-doc').forEach(e => e.remove());

                selectedFiles.forEach(function (file, idx) {
                    const entryDiv = document.createElement('div');
                    entryDiv.className = "uploaded-file-entry.new-doc p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light";
                    entryDiv.innerHTML = `<div>
                        <strong>${file.name}</strong>
                        <div class="text-muted small mt-1" style="font-size:0.75rem;">
                            <span>Selected for upload</span>
                        </div>
                    </div>
                    <button type="button" class="btn btn-danger btn-sm ms-2 remove-upload-btn">Remove</button>`;
                    entryDiv.querySelector('.remove-upload-btn').addEventListener('click', function () {
                        // Remove from selectedFiles and update display
                        selectedFiles = selectedFiles.filter(f => !(f.name === file.name && f.size === file.size));
                        updateFilesDisplay();
                    });
                    uploadedFilesContainer.appendChild(entryDiv);
                });
            }

            // ---- Validation ----
            function showFieldError(fieldIdOrName, message, tabName) {
                let field = document.getElementById(fieldIdOrName) || document.querySelector(`[name='${fieldIdOrName}']`);
                if (field) {
                    let label = null;
                    // Try to find the associated label
                    if (field.id) {
                        label = document.querySelector(`label[for='${field.id}']`);
                    }
                    // Fallback: use the closest .form-group and find label inside it
                    if (!label) {
                        let formGroup = field.closest('.form-group');
                        if (formGroup) {
                            label = formGroup.querySelector('label');
                        }
                    }
                    // Remove any existing error span near this label
                    if (label) {
                        let oldError = label.parentNode.querySelector('.validation-custom-error');
                        if (oldError) oldError.remove();

                        let errorSpan = document.createElement('span');
                        errorSpan.className = 'validation-custom-error text-danger';
                        errorSpan.innerText = message;
                        errorSpan.style.fontWeight = 'bold';

                        if (tabName === 'documents') {
                            // Insert after label
                            label.insertAdjacentElement('afterend', errorSpan);
                        } else {
                            // Append next to label
                            errorSpan.classList.add('ms-2');
                            label.appendChild(errorSpan);
                        }
                    }
                    field.classList.add('field-error-highlight');
                } else {
                    // Fallback error on the whole tab section
                    let tabContent = document.getElementById(tabName);
                    if (tabContent) {
                        let oldError = tabContent.querySelector('.validation-custom-error');
                        if (oldError) oldError.remove();
                        let errorSpan = document.createElement('span');
                        errorSpan.className = 'validation-custom-error text-danger';
                        errorSpan.innerText = message;
                        errorSpan.style.display = 'block';
                        errorSpan.style.fontWeight = 'bold';
                        errorSpan.style.marginBottom = '10px';
                        tabContent.prepend(errorSpan);
                    }
                }
            }

            function clearAllCustomErrors() {
                document.querySelectorAll('.validation-custom-error').forEach(e => e.remove());
                document.querySelectorAll('.field-error-highlight').forEach(e => e.classList.remove('field-error-highlight'));
            }

            // Only clear the error for the field being edited, not all fields
            function clearFieldError(e) {
                let field = e.target;
                let label = null;
                if (field.id) {
                    label = document.querySelector(`label[for='${field.id}']`);
                }
                if (!label) {
                    let formGroup = field.closest('.form-group');
                    if (formGroup) {
                        label = formGroup.querySelector('label');
                    }
                }
                if (label) {
                    let oldError = label.parentNode.querySelector('.validation-custom-error');
                    if (oldError) oldError.remove();
                }
                field.classList.remove('field-error-highlight');
            }

            document.querySelectorAll('input, textarea').forEach(e => {
                e.addEventListener('input', clearFieldError);
                e.addEventListener('change', clearFieldError);
            });

            // ---- Form AJAX submit logic with ALL validation errors at once ----
            doneBtn.addEventListener('click', function() {
                clearAllCustomErrors();

                // VALIDATION SECTION
                let errors = [];
                let errorFields = [];
                let errorTabs = [];

                // Only validate for publish and schedule, skip validation for draft
                if (!(currentTab === 'submit' && currentSubmitSubTab === 'draft')) {
                    let tenderType = document.querySelector('input[name="TenderType"]:checked');
                    let tenderNumber = document.querySelector('input[name="TenderNumber"]');
                    let closingDate = document.querySelector('input[name="ClosingDate"]');
                    let closingTime = document.querySelector('input[name="ClosingTime"]');
                    let title = document.querySelector('input[name="Title"]');
                    let description = document.querySelector('textarea[name="Description"]');

                    if (!tenderType) {
                        errors.push({field: 'TenderType', message: 'You missed Tender Type.', tab: 'details'});
                        errorFields.push('TenderType'); errorTabs.push('details');
                    }
                    if (!tenderNumber.value.trim()) {
                        errors.push({field: 'TenderNumber', message: 'You missed Tender Number.', tab: 'details'});
                        errorFields.push('TenderNumber'); errorTabs.push('details');
                    }
                    if (!closingDate.value.trim()) {
                        errors.push({field: 'ClosingDate', message: 'You missed Closing Date.', tab: 'details'});
                        errorFields.push('ClosingDate'); errorTabs.push('details');
                    }
                    if (!closingTime.value.trim()) {
                        errors.push({field: 'ClosingTime', message: 'You missed Closing Time.', tab: 'details'});
                        errorFields.push('ClosingTime'); errorTabs.push('details');
                    }
                    if (!title.value.trim()) {
                        errors.push({field: 'Title', message: 'You missed Tender Title.', tab: 'details'});
                        errorFields.push('Title'); errorTabs.push('details');
                    }
                    if (!description.value.trim()) {
                        errors.push({field: 'Description', message: 'You missed Tender Description.', tab: 'details'});
                        errorFields.push('Description'); errorTabs.push('details');
                    }
                    if (selectedFiles.length === 0) {
                        errors.push({field: 'UploadedFiles', message: 'You must upload at least one PDF document.', tab: 'documents'});
                        errorFields.push('UploadedFiles'); errorTabs.push('documents');
                    }

                    // If "Schedule" is selected, also require ScheduledDate and ScheduledTime
                    if (currentTab === 'submit' && currentSubmitSubTab === 'schedule') {
                        let scheduledDateField = document.getElementById('ScheduledDate');
                        let scheduledTimeField = document.getElementById('ScheduledTime');
                        let scheduledDate = scheduledDateField.value;
                        let scheduledTime = scheduledTimeField.value;

                        if (!scheduledDate.trim()) {
                            errors.push({field: 'ScheduledDate', message: 'You missed Scheduled Date.', tab: 'submit'});
                            errorFields.push('ScheduledDate'); errorTabs.push('submit');
                        }
                        if (!scheduledTime.trim()) {
                            errors.push({field: 'ScheduledTime', message: 'You missed Scheduled Time.', tab: 'submit'});
                            errorFields.push('ScheduledTime'); errorTabs.push('submit');
                        }
                    }

                    // Show all errors next to their fields
                    if (errors.length > 0) {
                        errors.forEach(function(err) {
                            showFieldError(err.field, err.message, err.tab);
                        });
                        // Switch to first errored tab and focus field
                        showTab(errors[0].tab);
                        let firstField = document.getElementById(errors[0].field) || document.querySelector(`[name='${errors[0].field}']`);
                        if (firstField) {
                            firstField.scrollIntoView({behavior: "smooth", block: "center"});
                            firstField.focus();
                        }
                        return;
                    }
                }

                // No errors (or draft): submit form
                var form = document.querySelector('form[asp-action="Create"]');
                if (!form) form = document.querySelector('form[action*="Create"]');
                if (!form) {
                    alert("Form not found!");
                    return;
                }
                var formData = new FormData(form);

                // Remove any existing files from input (so we don't send duplicates)
                formData.delete('UploadedFiles');

                // Append all files from selectedFiles
                selectedFiles.forEach(function(file) {
                    formData.append('UploadedFiles', file, file.name);
                });

                // SCHEDULE LOGIC
                if (currentTab === 'submit' && currentSubmitSubTab === 'schedule') {
                    let scheduledDate = document.getElementById('ScheduledDate').value;
                    let scheduledTime = document.getElementById('ScheduledTime').value;
                    formData.append('IsScheduled', 'true');
                    formData.append('ScheduledDate', scheduledDate);
                    formData.append('ScheduledTime', scheduledTime);

                    fetch(form.action, {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('scheduledModalTenderNumber').textContent = data.tenderNumber || '';
                            var scheduledLink = document.getElementById('scheduledTendersLink');
                            if (scheduledLink && data.scheduledTendersUrl) {
                                scheduledLink.href = data.scheduledTendersUrl;
                            } else if (scheduledLink) {
                                scheduledLink.href = "/TenderAdmin/ScheduledIndex";
                            }
                            var modal = new bootstrap.Modal(document.getElementById('scheduledSuccessModal'));
                            modal.show();
                            document.getElementById('scheduledModalCloseBtn').onclick = function() {
                                window.location.href = data.scheduledTendersUrl || "/TenderAdmin/ScheduledIndex";
                            }
                        } else {
                            alert("Failed to schedule tender.");
                        }
                    })
                    .catch(error => {
                        alert("An error occurred while scheduling.");
                    });
                    return;
                }

                // PUBLISH LOGIC
                if (currentTab === 'submit' && currentSubmitSubTab === 'publish') {
                    fetch(form.action, {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('modalTenderNumber').textContent = data.tenderNumber || '';
                            var modal = new bootstrap.Modal(document.getElementById('publishSuccessModal'));
                            modal.show();
                            document.getElementById('modalCloseBtn').onclick = function() {
                                window.location.href = "/TenderAdmin/Index";
                            }
                        } else {
                            alert("Failed to publish tender.");
                        }
                    })
                    .catch(error => {
                        alert("An error occurred while publishing.");
                    });
                    return;
                }

                // DRAFT LOGIC
                if (currentTab === 'submit' && currentSubmitSubTab === 'draft') {
                    var draftUrl = '/TenderAdmin/SaveDraft';
                    fetch(draftUrl, {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('draftModalTenderNumber').textContent = data.tenderNumber || '';
                            var draftLink = document.getElementById('draftResponsesLink');
                            if (draftLink && data.draftIndexUrl) {
                                draftLink.href = data.draftIndexUrl;
                            } else if (draftLink) {
                                draftLink.href = "/TenderAdmin/DraftIndex";
                            }
                            var modal = new bootstrap.Modal(document.getElementById('draftSavedModal'));
                            modal.show();
                            document.getElementById('draftModalCloseBtn').onclick = function() {
                                window.location.href = data.draftIndexUrl || "/TenderAdmin/DraftIndex";
                            }
                        } else {
                            alert("Failed to save draft.");
                        }
                    })
                    .catch(error => {
                        alert("An error occurred while saving draft.");
                    });
                    return;
                }
            });

            // Only clear the error for the field being edited -- NOT all fields!
            document.querySelectorAll('input, textarea').forEach(e => {
                e.addEventListener('input', clearFieldError);
                e.addEventListener('change', clearFieldError);
            });
        });
    </script>
}

