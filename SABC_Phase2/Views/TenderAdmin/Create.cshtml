@{
    ViewData["BannerText"] = "Tenders";
}

@model SABC_Phase2.Models.Tender.TenderViewModel

@{
    ViewBag.Title = "Create Tender";
}

<div class="breadcrumb-custom">
    Dashboard <span class="breadcrumb-arrow">&#x2794;</span> Tenders <span class="breadcrumb-arrow">&#x2794;</span> <span class="breadcrumb-active">Create Tender</span>
</div>

<div class="tab-header">
    <div id="tabDetails" class="tab-btn active" onclick="showTab('details')">Details</div>
    <div id="tabDocuments" class="tab-btn" onclick="showTab('documents')">Documents</div>


    <div id="tabSubmit" class="tab-btn disabled" onclick="if(!this.classList.contains('disabled')) showTab('submit')">Submit</div>
</div>

<div class="tab-container">
    <form asp-action="Create" enctype="multipart/form-data" method="post" autocomplete="off">
        @if (Model.DraftId != null)
        {
            <input type="hidden" name="DraftId" value="@Model.DraftId" />
        }
        <div id="details" class="tab-content active">
            <div class="form-row">
                <div class="form-group">
                    <label>Tender Type <span class="text-danger">*</span></label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFQ" required
                                   @(Model.TenderType == "RFQ" ? "checked" : "") />
                            <label class="form-check-label">RFQ</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFP"
                                   @(Model.TenderType == "RFP" ? "checked" : "") />
                            <label class="form-check-label">RFP</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFI"
                                   @(Model.TenderType == "RFI" ? "checked" : "") />
                            <label class="form-check-label">RFI</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFO"
                                   @(Model.TenderType == "RFO" ? "checked" : "") />
                            <label class="form-check-label">RFO</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="TenderNumber">Tender number <span class="text-danger">*</span></label>
                    <input asp-for="TenderNumber" class="form-control" />
                    <span asp-validation-for="TenderNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClosingDate">Closing Date <span class="text-danger">*</span></label>
                    <input asp-for="ClosingDate" type="date" class="form-control" />
                    <span asp-validation-for="ClosingDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClosingTime">Closing Time <span class="text-danger">*</span></label>
                    <input asp-for="ClosingTime" type="time" class="form-control" />
                    <span asp-validation-for="ClosingTime" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-control custom-dropdown">
                        <option value="" disabled selected hidden>~Please select the status of the tender~</option>
                        <option value="Open Tender">Open Tender</option>
                        <option value="Closed Tender">Closed Tender</option>
                        <option value="Awarded Tender">Awarded Tender</option>
                        <option value="Cancelled Tender">Cancelled Tender</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Title">Tender Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" maxlength="100" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Description">Tender Description <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="200"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>




            </div>
        </div>

        <!-- Upload Documents Section -->
        <div id="documents" class="tab-content">
            <label for="UploadedFiles" class="upload-label">Upload Documents</label>
            <div class="upload-label-underline"></div>

            <div id="uploadedFilesContainer" class="mt-3">
                @if (Model.ExistingDocuments != null && Model.ExistingDocuments.Any())
                {
                    foreach (var doc in Model.ExistingDocuments)
                    {
                        <div class="uploaded-file-entry existing-doc p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light" data-doc-id="@doc.Id">
                            <div>
                                <strong>@doc.FileName</strong>
                                <div class="text-muted small mt-1" style="font-size:0.75rem;">
                                    <a href="@doc.FilePath" target="_blank">View</a>
                                </div>
                            </div>
                            <!-- Optionally, add a remove button here -->
                        </div>
                    }
                }
            </div>

            <div id="uploadInputGroup" class="d-flex align-items-center gap-2 mt-3">
                <label class="supporting-label mb-0"><i class="fas fa-file-pdf text-danger me-1"></i> Supporting Document</label>
                <label class="btn btn-success btn-sm d-flex align-items-center gap-1 mb-0">
                    <i class="fas fa-upload"></i> Upload
                    <input type="file" id="UploadedFiles" multiple accept=".pdf" hidden />
                </label>
            </div>
        </div>


        <div id="submit" class="tab-content">
            <!-- Centered Tabs Above Submit Tender -->
            <div class="submit-tabs-container">
                <div class="submit-tabs">
                    <div id="submitTabPublish" class="submit-tab active" onclick="showSubmitTab('publish')">Publish Now</div>
                    <div id="submitTabSchedule" class="submit-tab" onclick="showSubmitTab('schedule')">Schedule</div>
                    <div id="submitTabDraft" class="submit-tab" onclick="showSubmitTab('draft')">Save as Draft</div>
                </div>
            </div>

            <!-- Submit Tab Content Sections -->
            <div id="submitTabContentPublish" class="submit-tab-content active">
                <p>Ready to publish your tender immediately.</p>
            </div>
            <div id="submitTabContentSchedule" class="submit-tab-content">
                <p>Set a date and time to schedule your tender publication.</p>
                <div class="form-group full-width">
                    <div class="schedule-container">
                        <!-- Checkbox removed! Only show the date and time pickers -->
                        <div class="schedule-fields show" id="scheduleFields">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="ScheduledDate">Scheduled Date</label>
                                    <input type="date" id="ScheduledDate" name="ScheduledDate" class="form-control" />
                                </div>
                                <div class="form-group">
                                    <label for="ScheduledTime">Scheduled Time</label>
                                    <input type="time" id="ScheduledTime" name="ScheduledTime" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>


<div class="action-buttons">
    <button type="button" id="cancelBtn" class="action-btn cancel-btn" onclick="window.location.href='@Url.Action("Index", "Tender")'">Cancel</button>
    <button type="button" id="doneBtn" class="action-btn continue-btn" onclick="submitForm()">Done <span class="arrow-icon"></span></button>
    @* <button type="button" id="continueBtn" class="action-btn preview-btn" onclick="goToSubmitTab()">Continue</button> *@
    <button type="button" id="continueBtn" class="action-btn preview-btn">Continue</button>
</div>


@section Scripts {
    <script>
        // Store files in a more persistent way
        let storedFiles = [];
        let fileInputInitialized = false;

        function goToSubmitTab() {
            // Enable the Submit tab
            var submitTab = document.getElementById("tabSubmit");
            submitTab.classList.remove("disabled");
            // Switch to the Submit tab
            showTab('submit');
        }

        function showSubmitTab(tab) {
                 // Remove active from all tabs
                 document.querySelectorAll('.submit-tab').forEach(el => el.classList.remove('active'));
                 document.querySelectorAll('.submit-tab-content').forEach(el => el.classList.remove('active'));

                 // Activate selected tab and content
                 const tabId = 'submitTab' + capitalize(tab);
                 const contentId = 'submitTabContent' + capitalize(tab);

                 const tabElement = document.getElementById(tabId);
                 const contentElement = document.getElementById(contentId);

                 if (tabElement) tabElement.classList.add('active');
                 if (contentElement) contentElement.classList.add('active');
             }

        function capitalize(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }

        // Update showTab to always hide/show continue/done based on tab
        function updateActionButtons(tab) {
            document.getElementById("cancelBtn").style.display = "inline-flex";
            if (tab === "submit") {
                document.getElementById("doneBtn").style.display = "inline-flex";
                document.getElementById("continueBtn").style.display = "none";
            } else {
                document.getElementById("doneBtn").style.display = "none";
                document.getElementById("continueBtn").style.display = "inline-flex";
            }
        }

        function showTab(tab) {
            // Hide all tab contents
            document.getElementById("details").classList.remove("active");
            document.getElementById("documents").classList.remove("active");
            document.getElementById("submit").classList.remove("active");

            // Remove active from tab buttons
            document.getElementById("tabDetails").classList.remove("active");
            document.getElementById("tabDocuments").classList.remove("active");
            document.getElementById("tabSubmit").classList.remove("active");

            // Show selected tab
            document.getElementById(tab).classList.add("active");
            document.getElementById("tab" + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add("active");

            // Update buttons if needed
            updateActionButtons(tab);
        }


        // Function to handle file selection
        function handleFileChange(event) {
            console.log("File input change event triggered", event);
            console.log("Files selected:", this.files);

            for (const file of this.files) {
                if (!file.name.endsWith(".pdf")) {
                    alert(`${file.name} is not a PDF.`);
                    continue;
                }

                if (storedFiles.some(f => f.name === file.name && f.size === file.size)) {
                    continue;
                }

                const fileInfo = {
                    file: file,
                    name: file.name,
                    size: file.size,
                    uploadedAt: new Date()
                };

                storedFiles.push(fileInfo);
            }

            renderUploadedFiles();
            this.value = ""; // Clear the input field
        }

        // Initialize file upload functionality
        function initializeFileUpload() {
            const fileInput = document.getElementById("UploadedFiles");
            if (!fileInput) {
                console.error("File input element not found");
                return;
            }

            // Only attach the event listener if it hasn't been attached already
            if (!fileInputInitialized) {
                console.log("Initializing file input listener");
                fileInput.addEventListener("change", handleFileChange);
                fileInputInitialized = true;
            }
        }

        function renderUploadedFiles() {
            const uploadedFilesContainer = document.getElementById("uploadedFilesContainer");
            const uploadInputGroup = document.getElementById("uploadInputGroup");

            if (!uploadedFilesContainer) {
                console.error("Uploaded files container not found");
                return;
            }

            // 1. Preserve and re-render existing documents (from Razor)
            const existingDocs = Array.from(uploadedFilesContainer.querySelectorAll('.existing-doc'));
            uploadedFilesContainer.innerHTML = "";
            existingDocs.forEach(doc => uploadedFilesContainer.appendChild(doc));

            // 2. Render new uploads (from JS)
            storedFiles.forEach((fileInfo, index) => {
                const { file, uploadedAt } = fileInfo;

                const fileRow = document.createElement("div");
                fileRow.className = `uploaded-file-entry p-2 rounded d-flex justify-content-between align-items-start mb-2 ${index % 2 === 0 ? 'bg-light' : 'bg-secondary text-white'}`;

                const fileDetails = document.createElement("div");

                const fileName = document.createElement("strong");
                fileName.textContent = file.name;

                const fileMeta = document.createElement("div");
                fileMeta.className = "text-muted small mt-1";
                fileMeta.style.fontSize = "0.75rem";

                const size = formatFileSize(file.size);
                const time = uploadedAt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                fileMeta.textContent = `${size} • Uploaded at ${time}`;

                fileDetails.appendChild(fileName);
                fileDetails.appendChild(fileMeta);

                const actions = document.createElement("div");
                actions.className = "uploaded-file-actions d-flex";

                const viewBtn = document.createElement("button");
                viewBtn.type = "button";
                viewBtn.className = "btn btn-outline-primary btn-sm me-2";
                viewBtn.innerHTML = '<i class="fas fa-eye"></i>';
                viewBtn.onclick = () => {
                    const fileURL = URL.createObjectURL(file);
                    window.open(fileURL, "_blank");
                };

                const deleteBtn = document.createElement("button");
                deleteBtn.type = "button";
                deleteBtn.className = "btn btn-outline-danger btn-sm";
                deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
                deleteBtn.onclick = () => {
                    storedFiles.splice(index, 1);
                    renderUploadedFiles();
                };

                actions.appendChild(viewBtn);
                actions.appendChild(deleteBtn);

                fileRow.appendChild(fileDetails);
                fileRow.appendChild(actions);

                uploadedFilesContainer.appendChild(fileRow);
            });

            if (uploadInputGroup && (storedFiles.length === 0 || !uploadInputGroup.classList.contains("mt-3"))) {
                uploadInputGroup.classList.add("mt-3");
            }
        }

        function formatFileSize(bytes) {
            if (bytes < 1024) return `${bytes} B`;
            else if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
            else return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
        }

        function submitForm() {
            const activeSubmitTab = document.querySelector('.submit-tab.active');
            if (!activeSubmitTab) return;

            const doneBtn = document.getElementById("doneBtn");
            if (doneBtn) doneBtn.disabled = true;
            if (doneBtn) doneBtn.innerHTML = 'Processing... <span class="arrow-icon"></span>';

            // Handle different submit tabs
            if (activeSubmitTab.id === 'submitTabDraft') {
                saveDraft();
                return;
            }
            else if (activeSubmitTab.id === 'submitTabSchedule') {
                scheduleTender();
                return;
            }
            else if (activeSubmitTab.id === 'submitTabPublish') {
                // Regular tender creation for Publish Now
                createTender();
                return;
            }
        }

        // Display validation errors without replacing the DOM
        function displayValidationErrors(errors) {
            // Clear existing validation messages
            document.querySelectorAll('.text-danger').forEach(el => {
                if (el.getAttribute('data-valmsg-for') || el.getAttribute('for')) {
                    el.textContent = '';
                }
            });

            // Display new validation messages
            for (const [key, messages] of Object.entries(errors)) {
                const element = document.querySelector(`[data-valmsg-for="${key}"]`) ||
                                document.querySelector(`span[for="${key}"]`) ||
                                document.querySelector(`#${key}-error`);
                if (element) {
                    element.textContent = Array.isArray(messages) ? messages[0] : messages;
                }
            }
        }
        function displayValidationErrorsFromElements(errorElements) {
            let errorsShown = 0;
            let redirectedToTab = null;

            // Define which fields belong to which tab
            const tabMapping = {
                TenderType: 'details',
                TenderNumber: 'details',
                ClosingDate: 'details',
                ClosingTime: 'details',
                Status: 'details',
                Title: 'details',
                Description: 'details',
                UploadedFiles: 'documents',
                ScheduledDate: 'submit',
                ScheduledTime: 'submit'
            };

            errorElements.forEach(element => {
                const message = element.textContent.trim();
                const forAttr = element.getAttribute('data-valmsg-for') || element.getAttribute('for');
                const target = document.querySelector(`[data-valmsg-for="${forAttr}"]`) ||
                               document.querySelector(`span[for="${forAttr}"]`) ||
                               document.querySelector(`#${forAttr}-error`);

                if (target && message) {
                    target.textContent = message;
                    errorsShown++;

                    // Set redirect target tab (use first matched one only)
                    if (!redirectedToTab && tabMapping[forAttr]) {
                        redirectedToTab = tabMapping[forAttr];
                    }
                }
            });

            if (errorsShown === 0 && errorElements.length > 0) {
                const messages = Array.from(errorElements)
                    .map(e => e.textContent.trim())
                    .filter(text => text.length > 0);
                if (messages.length > 0) {
                    alert("Please fix the following errors:\n\n" + messages.join("\n"));
                }
            }

            // ✅ Redirect to the tab containing the first error
            if (redirectedToTab) {
                showTab(redirectedToTab);
                console.warn(`Redirected to '${redirectedToTab}' tab due to validation error.`);
            }
        }


                function createTender() {
            const form = document.querySelector("form");

            if (storedFiles.length === 0) {
                alert("Please upload at least one PDF file.");
                resetDoneButton();
                return;
            }

            const formData = new FormData(form);
            storedFiles.forEach(fileInfo => {
                formData.append("UploadedFiles", fileInfo.file);
            });

            formData.append("PublishNow", "true");

            fetch(form.action, {
                method: "POST",
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => {
                if (response.redirected) {
                    // Server responded with redirect (e.g. success)
                    window.location.href = response.url;
                    return;
                }

                // Handle non-redirect response
                const contentType = response.headers.get("content-type");

                if (contentType && contentType.includes("application/json")) {
                    return response.json().then(data => {
                        if (data.success) {
                            window.location.href = data.redirectUrl || '/Tender/Index';
                        } else {
                            alert(data.message || "Form submission failed");
                            resetDoneButton();
                        }
                    });
                } else {
                    return response.text().then(html => {
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = html;

                        const validationErrors = tempDiv.querySelectorAll('.text-danger');

                        if (validationErrors.length > 0) {
                            displayValidationErrorsFromElements(validationErrors);
                        } else {
                            alert("Form submission failed. Please check all required fields.");
                        }

                        resetDoneButton();
                    });
                }
            })
            .catch(error => {
                alert("Error submitting form");
                console.error("Submission Error:", error);
                resetDoneButton();
            });
        }


        function scheduleTender() {
                 const form = document.querySelector("form");
                 const scheduledDate = document.getElementById('ScheduledDate').value;
                 const scheduledTime = document.getElementById('ScheduledTime').value;

                 // Now: If either field has a value, consider this a scheduled tender
                 if (!scheduledDate || !scheduledTime) {
                     alert("Please provide both date and time for scheduling.");
                     resetDoneButton();
                     return;
                 }

                 if (storedFiles.length === 0) {
                     alert("Please upload at least one PDF file.");
                     resetDoneButton();
                     return;
                 }

                 const formData = new FormData(form);
                 storedFiles.forEach(fileInfo => {
                     formData.append("UploadedFiles", fileInfo.file);
                 });

                 // Always set IsScheduled to true since this is the only way to schedule now
                 formData.append("IsScheduled", "true");
                 formData.append("ScheduledDate", scheduledDate);
                 formData.append("ScheduledTime", scheduledTime);

                 fetch(form.action, {
                     method: "POST",
                     body: formData,
                     headers: {
                         'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                     }
                 })
                 .then(response => {
                     if (response.redirected) {
                         window.location.href = response.url;
                     } else if (response.ok) {
                         return response.json().then(data => {
                             if (data.redirectUrl) {
                                 window.location.href = data.redirectUrl;
                             } else {
                                 alert(data.message || "Tender scheduled successfully");
                                 resetDoneButton();
                             }
                         }).catch(() => {
                             alert("Tender scheduled successfully");
                             resetDoneButton();
                         });
                     } else {
                         // Try to handle as JSON first
                         return response.json().catch(() => {
                             return response.text().then(html => {
                                 const tempDiv = document.createElement('div');
                                 tempDiv.innerHTML = html;

                                 const validationErrors = tempDiv.querySelectorAll('.text-danger');
                                 if (validationErrors.length > 0) {
                                     displayValidationErrorsFromElements(validationErrors);
                                 } else {
                                     alert("Form submission failed. Please check all fields and try again.");
                                 }
                                 resetDoneButton();
                             });
                         }).then(errors => {
                             if (errors) {
                                 displayValidationErrors(errors);
                                 resetDoneButton();
                             }
                         });
                     }
                 })
                 .catch(error => {
                     alert("Error scheduling tender");
                     console.error(error);
                     resetDoneButton();
                 });
             }


        function saveDraft() {
            const form = document.querySelector("form");
            const formData = new FormData(form);

            storedFiles.forEach(fileInfo => {
                formData.append("UploadedFiles", fileInfo.file);
            });

            fetch('/TenderAdmin/SaveDraft', {
                method: "POST",
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                alert(data.message || "Draft saved.");
                resetDoneButton();
            })
            .catch(error => {
                alert("Error saving draft");
                console.error(error);
                resetDoneButton();
            });
        }

        function resetDoneButton() {
            const doneBtn = document.getElementById("doneBtn");
            if (doneBtn) {
                doneBtn.disabled = false;
                doneBtn.innerHTML = 'Done <span class="arrow-icon"></span>';
            }
        }

        // Initial state on page load
        document.addEventListener("DOMContentLoaded", function() {
            // Initialize file upload functionality
            initializeFileUpload();

            updateActionButtons("details"); // start on details

            // Attach context-aware continue
            document.getElementById("continueBtn").onclick = function() {
                // Find which tab is currently active
                if (document.getElementById("details").classList.contains("active")) {
                    // Move to Documents
                    showTab("documents");
                } else if (document.getElementById("documents").classList.contains("active")) {
                    // Enable and move to Submit
                    var submitTab = document.getElementById("tabSubmit");
                    submitTab.classList.remove("disabled");
                    showTab("submit");
                }
                // If already on submit, do nothing
            };
        });

        // Re-initialize the file upload functionality if the page is refreshed or DOM is updated
        // This acts as a safety net to ensure file upload always works
        window.addEventListener('load', initializeFileUpload);
        window.addEventListener('DOMContentLoaded', initializeFileUpload);
    </script>
}



<style>
    .custom-dropdown {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        background: #f9fafb url("data:image/svg+xml;utf8,<svg fill='gray' height='20' viewBox='0 0 20 20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M7.293 7.293a1 1 0 011.414 0L10 8.586l1.293-1.293a1 1 0 111.414 1.414l-2 2a1 1 0 01-1.414 0l-2-2a1 1 0 010-1.414z'/></svg>") no-repeat right 1rem center/1.2em 1.2em;
        padding-right: 2.5em;
        cursor: pointer;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .custom-dropdown:focus {
            border-color: #1a7f37;
            box-shadow: 0 0 0 2px #d1fae5;
            background-color: #fff;
        }

        .custom-dropdown option[disabled] {
            color: #aaa;
            font-style: italic;
        }

    .tab-header {
        display: flex;
        justify-content: left;
        gap: 5px;
        margin-left: 178px;
        margin-bottom: 0;
        margin-top: 40px;
        position: relative;
        z-index: 2;
    }

    .tab-container {
        background: #fff;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 4px 32px rgba(0,0,0,0.08), 0 1.5px 4px rgba(0,0,0,0.04);
        padding: 52px 32px 24px 32px;
        max-width: 900px;
        margin: 0 auto 80px auto;
        margin-top: 0;
        transition: box-shadow 0.2s;
        position: relative;
        z-index: 1;
    }

    .tab-btn {
        padding: 18px 48px 18px 48px;
        font-weight: 600;
        font-size: 1.1rem;
        color: #fff;
        background: #1a7f37;
        border: none;
        border-radius: 16px 16px 0 0;
        cursor: pointer;
        transition: background 0.2s, color 0.2s;
        margin-right: 2px;
        position: relative;
        z-index: 2;
        box-shadow: 0 2px 8px rgba(34,197,94,0.08);
    }

        .tab-btn.active {
            background: #fff;
