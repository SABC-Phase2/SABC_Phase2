        // VALIDATION FUNCTIONS
        function showFieldError(fieldIdOrName, message, tabName) {
            let field = document.getElementById(fieldIdOrName) || document.querySelector(`[name='${fieldIdOrName}']`);
            if (field) {
                let label = null;
                if (field.id) {
                    label = document.querySelector(`label[for='${field.id}']`);
                }
                if (!label) {
                    let formGroup = field.closest('.form-group');
                    if (formGroup) {
                        label = formGroup.querySelector('label');
                    }
                }
                if (label) {
                    let oldError = label.parentNode.querySelector('.validation-custom-error');
                    if (oldError) oldError.remove();

                    let errorSpan = document.createElement('span');
                    errorSpan.className = 'validation-custom-error text-danger';
                    errorSpan.innerText = message;
                    errorSpan.style.fontWeight = 'bold';

                    if (tabName === 'documents') {
                        label.insertAdjacentElement('afterend', errorSpan);
                    } else {
                        errorSpan.classList.add('ms-2');
                        label.appendChild(errorSpan);
                    }
                }
                field.classList.add('field-error-highlight');
            } else {
                let tabContent = document.getElementById(tabName);
                if (tabContent) {
                    let oldError = tabContent.querySelector('.validation-custom-error');
                    if (oldError) oldError.remove();
                    let errorSpan = document.createElement('span');
                    errorSpan.className = 'validation-custom-error text-danger';
                    errorSpan.innerText = message;
                    errorSpan.style.display = 'block';
                    errorSpan.style.fontWeight = 'bold';
                    errorSpan.style.marginBottom = '10px';
                    tabContent.prepend(errorSpan);
                }
            }
        }

        function clearAllCustomErrors() {
            document.querySelectorAll('.validation-custom-error').forEach(e => e.remove());
            document.querySelectorAll('.field-error-highlight').forEach(e => e.classList.remove('field-error-highlight'));
        }

        function clearFieldError(e) {
            let field = e.target;
            let label = null;
            if (field.id) {
                label = document.querySelector(`label[for='${field.id}']`);
            }
            if (!label) {
                let formGroup = field.closest('.form-group');
                if (formGroup) {
                    label = formGroup.querySelector('label');
                }
            }
            if (label) {
                let oldError = label.parentNode.querySelector('.validation-custom-error');
                if (oldError) oldError.remove();
            }
            field.classList.remove('field-error-highlight');
        }

