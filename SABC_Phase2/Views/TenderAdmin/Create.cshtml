        const initCalendar = function() {
            const calendarContainer = document.getElementById('calendarContainer');
            if (!calendarContainer) return;

            const currentSaDate = new Date(window.currentSaDate + 'T00:00:00');

            const calendar = flatpickr("#calendarContainer", {
                inline: true,
                dateFormat: "Y-m-d",
                minDate: currentSaDate,
                onChange: function(selectedDates, dateStr, instance) {
                    const selectedDate = new Date(dateStr + 'T00:00:00');
                    if (selectedDate < currentSaDate) {
                        alert('You cannot schedule a tender for a date in the past.');
                        instance.setDate(currentSaDate);
                        return;
                    }

                    document.getElementById('ScheduledDate').value = dateStr;
                    const formattedDate = instance.formatDate(selectedDates[0], "F j, Y");
                    document.getElementById('selectedDateDisplay').textContent = formattedDate;
                }
            });

            const defaultDate = currentSaDate;
            calendar.setDate(defaultDate);
            document.getElementById('ScheduledDate').value = calendar.selectedDates[0].toISOString().split('T')[0];

            const formattedDate = calendar.formatDate(calendar.selectedDates[0], "F j, Y");
            document.getElementById('selectedDateDisplay').textContent = formattedDate;
        };

               // ENHANCED TIME VALIDATION - FIX FOR SAME DAY SCHEDULING
        const initTimeInput = function() {
            const hoursInput = document.getElementById('hours');
            const minutesInput = document.getElementById('minutes');
            const amBtn = document.querySelector('.am-btn');
            const pmBtn = document.querySelector('.pm-btn');
            const timeHiddenInput = document.getElementById('ScheduledTime');

            if (!hoursInput || !minutesInput || !timeHiddenInput) return;

            let isAM = amBtn && amBtn.classList.contains('active') ? true : false;

            function updateHiddenTimeValue() {
                const currentHoursInput = document.getElementById('hours');
                const currentMinutesInput = document.getElementById('minutes');

                if (!currentHoursInput || !currentMinutesInput) return;

                let hours = currentHoursInput.value.padStart(2, '0') || '00';
                let minutes = currentMinutesInput.value.padStart(2, '0') || '00';
                let seconds = '00';

                let hours24 = parseInt(hours, 10);
                if (isAM) {
                    if (hours24 === 12) hours24 = 0;
                } else {
                    if (hours24 !== 12) hours24 += 12;
                }

                const formattedTime = `${String(hours24).padStart(2, '0')}:${minutes}:${seconds}`;
                timeHiddenInput.value = formattedTime;

                // Only validate if we have meaningful input
                if (currentHoursInput.value && currentHoursInput.value.length > 0 &&
                    currentMinutesInput.value && currentMinutesInput.value.length >= 1) {
                    // Add small delay to ensure DOM is updated
                    setTimeout(() => validateScheduledDateTime(), 50);
                }
            }

            function validateScheduledDateTime() {
                const selectedDate = document.getElementById('ScheduledDate')?.value;
                const selectedTime = document.getElementById('ScheduledTime')?.value;
                const currentHoursInput = document.getElementById('hours');
                const currentMinutesInput = document.getElementById('minutes');

                if (!selectedDate || !selectedTime || !currentHoursInput || !currentMinutesInput) {
                    return true;
                }

                const hoursValue = currentHoursInput.value;
                const minutesValue = currentMinutesInput.value;

                // Only validate if we have complete input
                if (!hoursValue || hoursValue.length === 0 || !minutesValue || minutesValue.length === 0) {
                    return true;
                }

                console.log('Validating:', {
                    selectedDate,
                    selectedTime,
                    hoursValue,
                    minutesValue,
                    currentSaDateTime: window.currentSaDateTime
                });

                try {
                    const currentSaDateTime = new Date(window.currentSaDateTime);
                    const selectedDateTime = new Date(selectedDate + 'T' + selectedTime);

                    // Check if selected date is today
                    const currentSaDateOnly = new Date(window.currentSaDate + 'T00:00:00');
                    const selectedDateOnly = new Date(selectedDate + 'T00:00:00');

                    console.log('Date comparison:', {
                        currentSaDateTime: currentSaDateTime.toISOString(),
                        selectedDateTime: selectedDateTime.toISOString(),
                        isToday: selectedDateOnly.getTime() === currentSaDateOnly.getTime()
                    });

                    if (selectedDateOnly.getTime() === currentSaDateOnly.getTime()) {
                        // Same day - check if time is in the future (reduced buffer to 30 seconds)
                        const bufferTime = new Date(currentSaDateTime.getTime() + (30 * 1000)); // 30 second buffer

                        if (selectedDateTime <= bufferTime) {
                            console.log('Time validation failed:', {
                                selectedDateTime: selectedDateTime.toISOString(),
                                bufferTime: bufferTime.toISOString(),
                                difference: selectedDateTime.getTime() - bufferTime.getTime()
                            });

                            currentHoursInput.value = '';
                            currentMinutesInput.value = '';
                            timeHiddenInput.value = '';
                            alert('You cannot schedule a tender for a time that has already passed. Please select a future time.');
                            return false;
                        }
                    }

                    console.log('Time validation passed');
                    return true;
                } catch (error) {
                    console.error('Date validation error:', error);
                    return true; // Allow submission if validation fails
                }
            }

            function validateHourInput() {
                const newHoursInput = hoursInput.cloneNode(true);
                hoursInput.parentNode.replaceChild(newHoursInput, hoursInput);

                newHoursInput.addEventListener('input', function(e) {
                    let val = this.value.replace(/\D/g, '');
                    if (val.length > 2) val = val.slice(0, 2);
                    if (val.length === 1 && val === '0') val = '';
                    if (val.length === 2 && parseInt(val, 10) > 12) val = val[0] === '1' ? '12' : '1';
                    if (val === '00') val = '';
                    this.value = val ? String(parseInt(val, 10)) : '';
                    updateHiddenTimeValue();
                });

                newHoursInput.addEventListener('blur', function() {
                    if (this.value && this.value.length === 2 && this.value.startsWith('0')) {
                        this.value = this.value.substring(1);
                    }
                    updateHiddenTimeValue();
                });

                newHoursInput.addEventListener('keydown', function(e) {
                    let val = parseInt(this.value || '1', 10) || 1;
                    if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        val = val >= 12 ? 1 : val + 1;
                        this.value = String(val);
                        updateHiddenTimeValue();
                    } else if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        val = val <= 1 ? 12 : val - 1;
                        this.value = String(val);
                        updateHiddenTimeValue();
                    }
                });
            }

            function validateMinuteInput() {
                const newMinutesInput = minutesInput.cloneNode(true);
                minutesInput.parentNode.replaceChild(newMinutesInput, minutesInput);

                newMinutesInput.addEventListener('input', function(e) {
                    let val = this.value.replace(/\D/g, '');
                    if (val.length > 2) val = val.slice(0, 2);
                    if (val.length === 2 && parseInt(val, 10) > 59) val = '59';
                    this.value = val;
                    updateHiddenTimeValue();
                });

                newMinutesInput.addEventListener('blur', function() {
                    if (this.value) {
                        this.value = this.value.padStart(2, '0');
                    }
                    updateHiddenTimeValue();
                });

                newMinutesInput.addEventListener('keydown', function(e) {
                    let val = parseInt(this.value || '0', 10) || 0;
                    if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        val = val >= 59 ? 0 : val + 1;
                        this.value = String(val).padStart(2, '0');
                        updateHiddenTimeValue();
                    } else if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        val = val <= 0 ? 59 : val - 1;
                        this.value = String(val).padStart(2, '0');
                        updateHiddenTimeValue();
                    }
                });
            }

            // AM/PM toggle
            if (amBtn) {
                amBtn.addEventListener('click', function() {
                    if (!isAM) {
                        isAM = true;
                        amBtn.classList.add('active');
                        pmBtn.classList.remove('active');
                        updateHiddenTimeValue();
                    }
                });
            }
            if (pmBtn) {
                pmBtn.addEventListener('click', function() {
                    if (isAM) {
                        isAM = false;
                        pmBtn.classList.add('active');
                        amBtn.classList.remove('active');
                        updateHiddenTimeValue();
                    }
                });
            }

            updateHiddenTimeValue();
            validateHourInput();
            validateMinuteInput();
        };

