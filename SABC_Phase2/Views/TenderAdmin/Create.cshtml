@model SABC_Phase2.Models.Tender.TenderViewModel

@{
    ViewBag.Title = "Create Tender";
}

@{
    var draftDocs = ViewBag.DraftDocuments as IEnumerable<dynamic>;
}




<h2>Create Tender</h2>

<form asp-action="Create" enctype="multipart/form-data" method="post">
    <button type="button" class="btn btn-primary" id="taSaveDraftTender">Save As Draft</button>

    <!-- Schedule Tender Button and Picker Panel -->
<button type="button" class="btn btn-primary" id="scheduleTenderBtn">Schedule Tender</button>
<div id="schedulePickers" style="display:none; margin-top:10px;">
    <div class="form-group">
        <label for="scheduledDate">Scheduled Date</label>
        <input type="date" id="scheduledDate" class="form-control" />
    </div>
    <div class="form-group">
        <label for="scheduledTime">Scheduled Time</label>
        <input type="time" id="scheduledTime" class="form-control" />
    </div>
</div>


    <div class="form-group">
        <label>Tender Type</label><br />
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="TenderType" value="RFQ" required />
            <label class="form-check-label">RFQ</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="TenderType" value="RFP" />
            <label class="form-check-label">RFP</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="TenderType" value="RFI" />
            <label class="form-check-label">RFI</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="TenderType" value="RFO" />
            <label class="form-check-label">RFO</label>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="TenderNumber"></label>
        <input asp-for="TenderNumber" class="form-control" />
        <span asp-validation-for="TenderNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ClosingDate"></label>
        <input asp-for="ClosingDate" type="date" class="form-control" />
        <span asp-validation-for="ClosingDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ClosingTime" class="control-label"></label>
        <input asp-for="ClosingTime" class="form-control" type="time" />
        <span asp-validation-for="ClosingTime" class="text-danger"></span>
    </div>


    <div class="form-group">
        <label asp-for="Status"></label>
        <select asp-for="Status" class="form-control">
            <option value="">-- Select Status --</option>
            <option value="Open Tender">Open Tender</option>
            <option value="Closed Tender">Closed Tender</option>
            <option value="Awarded Tender">Awarded Tender</option>
            <option value="Cancelled Tender">Cancelled Tender</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>



    <div class="form-group">
        <label for="UploadedFiles">Upload PDF Documents</label>
        <input type="file" id="UploadedFiles" multiple accept=".pdf" class="form-control" />
        <div id="fileList" class="mt-2"></div>
        <span asp-validation-for="UploadedFiles" class="text-danger"></span>
    </div>
    <!-- Existing Draft Documents -->
    @if (draftDocs != null && draftDocs.Any())
    {
        <div class="form-group">
            <label>Existing Draft Documents</label>
            <ul class="list-group mb-2" id="existingDocsList">
                @foreach (var doc in draftDocs)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center" data-docid="@doc.Id">
                        <a href="@doc.SasUrl" target="_blank">@doc.FileName</a>
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeExistingDoc(@doc.Id)">Remove</button>
                        <input type="hidden" name="ExistingDocumentIds" value="@doc.Id" />
                    </li>
                }
            </ul>
        </div>
    }

    <!-- Hidden inputs to submit scheduled data -->
    <input type="hidden" name="IsScheduled" id="IsScheduled" value="false" />
    <input type="hidden" name="ScheduledDate" id="HiddenScheduledDate" />
    <input type="hidden" name="ScheduledTime" id="HiddenScheduledTime" />
    <input type="hidden" name="IsDraft" id="IsDraft" value="false" />

    <button type="submit" class="btn btn-primary">Submit</button>
</form>

@section Scripts {
    <script>

           // Remove existing draft document from the list (client-side only)
        function removeExistingDoc(docId) {
            var li = document.querySelector('li[data-docid="' + docId + '"]');
            if (li) {
                li.remove();
            }
            // Optionally, add a hidden input to mark for deletion on submit
            var input = document.createElement("input");
            input.type = "hidden";
            input.name = "RemoveDocumentIds";
            input.value = docId;
            document.querySelector("form").appendChild(input);
        }

                document.getElementById("taSaveDraftTender").addEventListener("click", function () {
            document.getElementById("IsDraft").value = "true";
            form.requestSubmit(); // Triggers the form submit event
        });

               document.getElementById("scheduleTenderBtn").addEventListener("click", function () {
            const pickers = document.getElementById("schedulePickers");
            const isNowVisible = pickers.style.display === "none";
            pickers.style.display = isNowVisible ? "block" : "none";

            // Mark form as scheduled when picker is visible
            document.getElementById("IsScheduled").value = isNowVisible ? "true" : "false";
        });


        const fileInput = document.getElementById("UploadedFiles");
        const fileListDisplay = document.getElementById("fileList");
        const form = document.querySelector("form");

        const storedFiles = [];

        fileInput.addEventListener("change", function () {
            for (const file of fileInput.files) {
                if (!file.name.endsWith(".pdf")) {
                    alert(`"${file.name}" is not a PDF.`);
                    continue;
                }

                // Avoid duplicates
                if (storedFiles.some(f => f.name === file.name && f.size === file.size)) {
                    continue;
                }

                storedFiles.push(file);
            }

            updateFileListDisplay();
            fileInput.value = ""; // Clear file input so new selections work properly
        });

        function updateFileListDisplay() {
            fileListDisplay.innerHTML = "";
            if (storedFiles.length === 0) {
                fileListDisplay.innerHTML = "<p class='text-muted'>No files selected.</p>";
                return;
            }

            const ul = document.createElement("ul");
            ul.classList.add("list-group");

            storedFiles.forEach((file, index) => {
                const li = document.createElement("li");
                li.className = "list-group-item d-flex justify-content-between align-items-center";
                li.innerHTML = `
                    ${file.name}
                    <button type="button" class="btn btn-sm btn-danger" onclick="removeFile(${index})">Remove</button>
                `;
                ul.appendChild(li);
            });

            fileListDisplay.appendChild(ul);
        }

        window.removeFile = function (index) {
            storedFiles.splice(index, 1);
            updateFileListDisplay();
        };

             form.addEventListener("submit", function (e) {
            // Populate hidden fields if scheduling is active
            const isScheduled = document.getElementById("IsScheduled").value === "true";
            const isDraft = document.getElementById("IsDraft").value === "true";

            if (isScheduled) {
                document.getElementById("HiddenScheduledDate").value = document.getElementById("scheduledDate").value;
                document.getElementById("HiddenScheduledTime").value = document.getElementById("scheduledTime").value;
            }

            // Only require PDF if NOT saving as draft
            if (!isDraft && storedFiles.length === 0) {
                alert("Please upload at least one PDF file.");
                e.preventDefault();
                return;
            }

            // Create a new FormData manually
            const formData = new FormData(form);

            storedFiles.forEach(file => {
                formData.append("UploadedFiles", file);
            });

            // Use fetch to submit the form manually
            e.preventDefault();
            fetch(form.action, {
                method: "POST",
                body: formData
            })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url;
                } else {
                    return response.text().then(html => {
                        document.body.innerHTML = html;
                    });
                }
            })
            .catch(error => {
                alert("Error submitting form");
                console.error(error);
            });
        });
    </script>
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}



