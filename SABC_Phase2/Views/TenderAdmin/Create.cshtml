@section Scripts {
    <script>
        // Pass current SA date and time to JavaScript
        window.currentSaDate = '@ViewBag.CurrentSaDate';
        window.currentSaDateTime = '@ViewBag.CurrentSaDateTime';

        // Global variables
        let docIdToDelete = null;
        let selectedFiles = [];
        const tabs = ['details', 'documents', 'submit'];
        let currentTab = 'details';
        const submitTabs = ['publish', 'schedule', 'draft'];
        let currentSubmitSubTab = 'publish';

        document.addEventListener('DOMContentLoaded', function () {
            initializeFormHandlers();
            initializeTabLogic();
                        if (window.flatpickr) {
                flatpickr("#ClosingTime", {
                    enableTime: true,
                    noCalendar: true,
                    dateFormat: "H:i",
                    time_24hr: false,
                    minuteIncrement: 1,
                    allowInput: true
                });
            }

        });

        // MAIN INITIALIZATION FUNCTION
        function initializeFormHandlers() {
            initializeDocumentDeleteHandlers();
            initializeClosingDateValidation();
            initializePdfUploadLogic();
            initializeValidationHandlers();
            initializeSubmitHandlers();
        }

        // DOCUMENT DELETE HANDLERS
        function initializeDocumentDeleteHandlers() {
            document.querySelectorAll('.delete-upload-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    docIdToDelete = btn.getAttribute('data-doc-id');
                    var modal = new bootstrap.Modal(document.getElementById('deleteDocModal'));
                    modal.show();

                    const deleteBtn = document.getElementById('confirmDeleteDocBtn');
                    const btnText = deleteBtn.querySelector('.btn-text');
                    const spinner = deleteBtn.querySelector('.spinner-border');

                    // Reset button state when modal opens
                    deleteBtn.disabled = false;
                    btnText.style.display = '';
                    spinner.classList.add('d-none');

                    deleteBtn.onclick = function() {
                        if (!docIdToDelete) return;
                        deleteBtn.disabled = true;
                        btnText.style.display = 'none';
                        spinner.classList.remove('d-none');

                        fetch('/TenderAdmin/DeleteDraftDocument', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify({ documentId: docIdToDelete })
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                document.querySelector('[data-doc-id="' + docIdToDelete + '"]').remove();
                            } else {
                                alert('Failed to delete document: ' + data.message);
                            }
                            docIdToDelete = null;
                            modal.hide();
                            // Reset button state
                            deleteBtn.disabled = false;
                            btnText.style.display = '';
                            spinner.classList.add('d-none');
                        })
                        .catch(err => {
                            alert('Error deleting document.');
                            docIdToDelete = null;
                            modal.hide();
                            // Reset button state
                            deleteBtn.disabled = false;
                            btnText.style.display = '';
                            spinner.classList.add('d-none');
                        });
                    };

                    document.getElementById('cancelDeleteDocBtn').onclick = function() {
                        docIdToDelete = null;
                        modal.hide();
                        deleteBtn.disabled = false;
                        btnText.style.display = '';
                        spinner.classList.add('d-none');
                    };
                });
            });

            // Alternative delete handlers
            document.querySelectorAll('.btn-link.text-danger').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var container = btn.closest('[data-doc-id]');
                    var docId = container.getAttribute('data-doc-id');
                    if (!docId) return;
                    if (!confirm('Are you sure you want to delete this document?')) return;

                    fetch('/TenderAdmin/DeleteDraftDocument', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({ documentId: docId })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            container.remove();
                        } else {
                            alert('Failed to delete document: ' + data.message);
                        }
                    })
                    .catch(err => alert('Error deleting document.'));
                });
            });
        }

        // CLOSING DATE VALIDATION
        function initializeClosingDateValidation() {
            const closingDateInput = document.querySelector('input[name="ClosingDate"]');
            if (closingDateInput) {
                // Set min attribute on load
                const today = new Date();
                const yyyy = today.getFullYear();
                const mm = String(today.getMonth() + 1).padStart(2, '0');
                const dd = String(today.getDate()).padStart(2, '0');
                const minDate = `${yyyy}-${mm}-${dd}`;
                closingDateInput.setAttribute('min', minDate);

                // Remove existing event listeners and add new ones
                const newInput = closingDateInput.cloneNode(true);
                closingDateInput.parentNode.replaceChild(newInput, closingDateInput);

                // Validate on change
                newInput.addEventListener('change', function () {
                    if (this.value < minDate) {
                        this.value = minDate;
                        alert('Closing date cannot be before today.');
                    }
                });
            }
        }

        // PDF UPLOAD LOGIC
           // ENHANCED PDF UPLOAD LOGIC
        function initializePdfUploadLogic() {
            const fileInput = document.getElementById('UploadedFiles');

            if (fileInput) {
                // Remove existing event listeners first
                const newFileInput = fileInput.cloneNode(true);
                fileInput.parentNode.replaceChild(newFileInput, fileInput);

                // Add the change event listener to the new file input
                newFileInput.addEventListener('change', function (event) {
                    console.log('File input changed:', event.target.files); // Debug log

                    const files = Array.from(event.target.files);

                    files.forEach(file => {
                        console.log('Processing file:', file.name, file.type); // Debug log

                        if (file.type !== "application/pdf") {
                            alert("Only PDF files are allowed.");
                            return;
                        }

                        // Check if file already exists
                        if (!selectedFiles.find(f => f.name === file.name && f.size === file.size)) {
                            selectedFiles.push(file);
                            console.log('File added to selectedFiles:', file.name); // Debug log
                        }
                    });

                    console.log('Current selectedFiles:', selectedFiles); // Debug log
                    updateFilesDisplay();

                    // Reset the file input
                    event.target.value = "";
                });

                // Also add a click event listener to ensure the input is working
                newFileInput.addEventListener('click', function(event) {
                    console.log('File input clicked'); // Debug log
                });
            } else {
                console.error('File input with ID "UploadedFiles" not found'); // Debug log
            }
        }

        function updateFilesDisplay() {
            const uploadedFilesContainer = document.getElementById('uploadedFilesContainer');
            if (!uploadedFilesContainer) {
                console.error('uploadedFilesContainer not found'); // Debug log
                return;
            }

            console.log('Updating files display, selectedFiles count:', selectedFiles.length); // Debug log

            // Remove only the new uploaded file entries (not server-existing ones)
            document.querySelectorAll('.uploaded-file-entry.new-doc').forEach(e => e.remove());

            // Re-render all currently selected new files
            selectedFiles.forEach(function(file, idx) {
                console.log('Rendering file:', file.name); // Debug log

                const entryDiv = document.createElement('div');
                entryDiv.className = "uploaded-file-entry new-doc p-2 rounded d-flex justify-content-between align-items-center mb-2 bg-light";
                entryDiv.innerHTML = `
                    <div>
                        <strong>${file.name}</strong>
                        <small class="text-muted d-block">${(file.size / 1024 / 1024).toFixed(2)} MB</small>
                    </div>
                    <div class="uploaded-file-actions d-flex gap-2">
                        <button type="button" class="icon-btn view-upload-btn" title="View">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button type="button" class="icon-btn text-danger remove-upload-btn" title="Delete">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                `;

                // View button logic
                entryDiv.querySelector('.view-upload-btn').addEventListener('click', function () {
                    try {
                        const fileURL = URL.createObjectURL(file);
                        window.open(fileURL, '_blank');
                    } catch (error) {
                        console.error('Error creating file URL:', error);
                        alert('Unable to preview file');
                    }
                });

                // Remove button logic
                entryDiv.querySelector('.remove-upload-btn').addEventListener('click', function () {
                    console.log('Removing file:', file.name); // Debug log
                    selectedFiles = selectedFiles.filter(f => !(f.name === file.name && f.size === file.size));
                    updateFilesDisplay();
                });

