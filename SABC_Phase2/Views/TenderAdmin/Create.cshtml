        function handleScheduleSubmission(form, formData) {
            let scheduledDate = document.getElementById('ScheduledDate').value;
            let scheduledTime = document.getElementById('ScheduledTime').value;
            formData.append('IsScheduled', 'true');
            formData.append('ScheduledDate', scheduledDate);
            formData.append('ScheduledTime', scheduledTime);

            fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(async response => {
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.includes("application/json")) {
                    const data = await response.json();
                    const doneBtn = document.getElementById('doneBtn');
                    resetLoadingState(doneBtn);

                    if (data.success) {
                        document.getElementById('scheduledModalTenderNumber').textContent = data.tenderNumber || '';
                        var scheduledLink = document.getElementById('scheduledTendersLink');
                        if (scheduledLink && data.scheduledTendersUrl) {
                            scheduledLink.href = data.scheduledTendersUrl;
                        } else if (scheduledLink) {
                            scheduledLink.href = "/TenderAdmin/ScheduledIndex";
                        }
                        var modal = new bootstrap.Modal(document.getElementById('scheduledSuccessModal'));
                        modal.show();
                        document.getElementById('scheduledModalCloseBtn').onclick = function() {
                            window.location.href = data.scheduledTendersUrl || "/TenderAdmin/ScheduledIndex";
                        }
                    } else {
                        alert(data.error || "Failed to schedule tender.");
                    }
                } else {
                    const html = await response.text();
                    handleHtmlValidationResponse(html);
                }
            })
            .catch(error => {
                const doneBtn = document.getElementById('doneBtn');
                resetLoadingState(doneBtn);
                alert("An error occurred while scheduling.");
            });
        }

        function handlePublishSubmission(form, formData) {
            fetch(form.action, {
                method: 'POST',
                body: formData
            })
            .then(async response => {
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.includes("application/json")) {
                    const data = await response.json();
                    const doneBtn = document.getElementById('doneBtn');
                    resetLoadingState(doneBtn);

                    if (data.success) {
                        document.getElementById('modalTenderNumber').textContent = data.tenderNumber || '';
                        var modal = new bootstrap.Modal(document.getElementById('publishSuccessModal'));
                        modal.show();
                        document.getElementById('modalCloseBtn').onclick = function() {
                            window.location.href = "/TenderAdmin/Index";
                        }
                    } else {
                        alert(data.error || "Failed to publish tender.");
                    }
                } else {
                    const html = await response.text();
                    handleHtmlValidationResponse(html);
                }
            })
            .catch(error => {
                const doneBtn = document.getElementById('doneBtn');
                resetLoadingState(doneBtn);
                alert("An error occurred while publishing.");
            });
        }

        function handleDraftSubmission(formData) {
            var draftUrl = '/TenderAdmin/SaveDraft';
            fetch(draftUrl, {
                method: 'POST',
                body: formData
            })
            .then(async response => {
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.includes("application/json")) {
                    const data = await response.json();
                    const doneBtn = document.getElementById('doneBtn');
                    resetLoadingState(doneBtn);

                    if (data.success) {
                        document.getElementById('draftModalTenderNumber').textContent = data.tenderNumber || '';
                        var draftLink = document.getElementById('draftResponsesLink');
                        if (draftLink && data.draftIndexUrl) {
                            draftLink.href = data.draftIndexUrl;
                        } else if (draftLink) {
                            draftLink.href = "/TenderAdmin/DraftIndex";
                        }
                        var modal = new bootstrap.Modal(document.getElementById('draftSavedModal'));
                        modal.show();
                        document.getElementById('draftModalCloseBtn').onclick = function() {
                            window.location.href = data.draftIndexUrl || "/TenderAdmin/DraftIndex";
                        }
                    } else {
                        alert(data.message || "Failed to save draft.");
                    }
                } else {
                    // Handle HTML validation response (tender number uniqueness errors)
                    const html = await response.text();
                    handleHtmlValidationResponse(html);
                }
            })
            .catch(error => {
                const doneBtn = document.getElementById('doneBtn');
                resetLoadingState(doneBtn);
                console.error('Draft save error:', error);
            });
        }
    </script>
}


