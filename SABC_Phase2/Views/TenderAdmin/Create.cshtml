@{
    ViewData["BannerText"] = "Tenders";
}

@model SABC_Phase2.Models.Tender.TenderViewModel

@{
    ViewBag.Title = "Create Tender";
}
<!-- Add these to your <head> section -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>


<div class="breadcrumb-custom">
    Dashboard <span class="breadcrumb-arrow">&#x2794;</span> Tenders <span class="breadcrumb-arrow">&#x2794;</span> <span class="breadcrumb-active">Create Tender</span>
</div>

<div class="tab-header">
    <div id="tabDetails" class="tab-btn active" onclick="showTab('details')">Details</div>
    <div id="tabDocuments" class="tab-btn" onclick="showTab('documents')">Documents</div>


    <div id="tabSubmit" class="tab-btn disabled" onclick="if(!this.classList.contains('disabled')) showTab('submit')">Submit</div>
</div>

<div class="tab-container">
    <form asp-action="Create" enctype="multipart/form-data" method="post" autocomplete="off">
        @if (Model.DraftId != null)
        {
            <input type="hidden" name="DraftId" value="@Model.DraftId" />
        }
        <div id="details" class="tab-content active">
            <div class="form-row">
                <div class="form-group">
                    <label>Tender Type <span class="text-danger">*</span></label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFQ" required
                                   @(Model.TenderType == "RFQ" ? "checked" : "") />
                            <label class="form-check-label">RFQ</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFP"
                                   @(Model.TenderType == "RFP" ? "checked" : "") />
                            <label class="form-check-label">RFP</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFI"
                                   @(Model.TenderType == "RFI" ? "checked" : "") />
                            <label class="form-check-label">RFI</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFO"
                                   @(Model.TenderType == "RFO" ? "checked" : "") />
                            <label class="form-check-label">RFO</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="TenderNumber">Tender number <span class="text-danger">*</span></label>
                    <input asp-for="TenderNumber" class="form-control" />
                    <span asp-validation-for="TenderNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClosingDate">Closing Date <span class="text-danger">*</span></label>
                    <input asp-for="ClosingDate" type="date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="ClosingDate" class="text-danger"></span>
                </div>


                <div class="form-group">
                    <label asp-for="ClosingTime">Closing Time <span class="text-danger">*</span></label>
                    <input asp-for="ClosingTime" type="time" class="form-control" />
                    <span asp-validation-for="ClosingTime" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-control custom-dropdown" disabled>
                        <option value="Open Tender" selected>Open Tender</option>
                    </select>
                    <input type="hidden" asp-for="Status" value="Open Tender" />
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Title">Tender Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" maxlength="100" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Description">Tender Description <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="200"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>




            </div>
        </div>

        <!-- Upload Documents Section -->
        <div id="documents" class="tab-content">
            <label for="UploadedFiles" class="upload-label">Upload Documents</label>
            <div class="upload-label-underline"></div>

            <div id="uploadedFilesContainer" class="mt-3">
                @if (Model.ExistingDocuments != null && Model.ExistingDocuments.Any())
                {
                    @foreach (var doc in Model.ExistingDocuments)
                    {
                        <div class="uploaded-file-entry existing-doc p-2 rounded d-flex justify-content-between align-items-center mb-2 bg-light" data-doc-id="@doc.Id">
                            <div>
                                <strong>@doc.FileName</strong>
                            </div>
                            <div class="uploaded-file-actions d-flex gap-2">
                                <button type="button" class="icon-btn view-upload-btn" title="View" onclick="window.open('@doc.SharePointPath', '_blank')">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" class="icon-btn text-danger delete-upload-btn" title="Delete" data-doc-id="@doc.Id">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                            <input type="checkbox" name="DocumentsToDelete" value="@doc.Id" id="delete_doc_@doc.Id" style="display:none;" />
                        </div>
                    }
                }
            </div>

            <div id="uploadInputGroup" class="d-flex align-items-center gap-2 mt-3">
                <label class="supporting-label mb-0"><i class="fas fa-file-pdf text-danger me-1"></i> Supporting Document</label>
                <label class="btn btn-success btn-sm d-flex align-items-center gap-1 mb-0">
                    <i class="fas fa-upload"></i> Upload
                    <input type="file" id="UploadedFiles" name="UploadedFiles" multiple accept=".pdf" hidden />
                </label>
            </div>
        </div>

        <div id="submit" class="tab-content">
            <!-- Centered Tabs Above Submit Tender -->
            <div class="submit-tabs-container">
                <div class="submit-tabs">
                    <div id="submitTabPublish" class="submit-tab active" onclick="showSubmitTab('publish')">Publish Now</div>
                    <div id="submitTabSchedule" class="submit-tab" onclick="showSubmitTab('schedule')">Schedule</div>
                    <div id="submitTabDraft" class="submit-tab" onclick="showSubmitTab('draft')">Save as Draft</div>
                </div>
            </div>

            <!-- Submit Tab Content Sections -->
            <div id="submitTabContentPublish" class="submit-tab-content active">
                <p>Ready to publish your tender immediately.</p>
            </div>


            <div id="submitTabContentSchedule" class="submit-tab-content">
                <p>Set a date and time to schedule your tender publication.</p>
                <div class="form-group full-width">
                    <div class="schedule-container">
                        <div class="schedule-fields show" id="scheduleFields">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="ScheduledDate">Scheduled Date</label>
                                    <div class="selected-date-display" id="selectedDateDisplay">
                                        No date selected
                                    </div>
                                    <div class="always-visible-calendar" id="calendarContainer"></div>
                                    <input type="hidden" id="ScheduledDate" name="ScheduledDate" />
                                </div>
                                <div class="form-group" style="margin-top: 140px;">
                                    <!-- Added margin-top -->
                                    <label for="timeInput">Scheduled Time</label>
                                    <div class="time-input-container" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 10px;">
                                        <input type="number" id="hours" min="1" max="12" placeholder="HH" class="time-part" style="width: 70px; height: 45px; font-size: 1rem;">
                                        <span style="font-size: 1.5rem;">:</span>
                                        <input type="number" id="minutes" min="0" max="59" placeholder="MM" class="time-part" style="width: 70px; height: 45px; font-size: 1rem;">
                                        <div class="time-period-toggle" style="margin-left: 15px;">
                                            <button type="button" class="time-period-btn am-btn active" style="padding: 8px 12px; font-size: 0.6rem;">AM</button>
                                            <button type="button" class="time-period-btn pm-btn" style="padding: 8px 12px; font-size: 0.6rem;">PM</button>
                                        </div>
                                        <input type="hidden" id="ScheduledTime" name="ScheduledTime">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="submitTabContentDraft" class="submit-tab-content">
                <p>Your tender will be saved as a draft. You can return and edit or publish it later.</p>
                <!-- Add any additional draft-related form elements or instructions here. -->
            </div>
        </div>
    </form>
</div>


<div class="action-buttons">
    <button type="button" id="cancelBtn" class="action-btn cancel-btn" onclick="window.location.href='@Url.Action("Index", "Tender")'">Cancel</button>
    <button type="button" id="doneBtn" class="action-btn continue-btn" onclick="submitForm()">
        <span class="btn-text">Done</span>
        <span class="arrow-icon"></span>
        <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
    </button>
    @* <button type="button" id="continueBtn" class="action-btn preview-btn" onclick="goToSubmitTab()">Continue</button> *@
    <button type="button" id="continueBtn" class="action-btn preview-btn">Continue</button>
</div>

@* Modal popup for immediate tender creation (Success) *@
