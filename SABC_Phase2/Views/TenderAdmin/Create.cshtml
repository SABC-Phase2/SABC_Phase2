@{
    ViewData["BannerText"] = "Tenders";
}

@model SABC_Phase2.Models.Tender.TenderViewModel

@{
    ViewBag.Title = "Create Tender";
}

<style>

    .custom-dropdown {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        background: #f9fafb url("data:image/svg+xml;utf8,<svg fill='gray' height='20' viewBox='0 0 20 20' width='20' xmlns='http://www.w3.org/2000/svg'><path d='M7.293 7.293a1 1 0 011.414 0L10 8.586l1.293-1.293a1 1 0 111.414 1.414l-2 2a1 1 0 01-1.414 0l-2-2a1 1 0 010-1.414z'/></svg>") no-repeat right 1rem center/1.2em 1.2em;
        padding-right: 2.5em;
        cursor: pointer;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .custom-dropdown:focus {
            border-color: #1a7f37;
            box-shadow: 0 0 0 2px #d1fae5;
            background-color: #fff;
        }

        .custom-dropdown option[disabled] {
            color: #aaa;
            font-style: italic;
        }

    .tab-header {
        display: flex;
        justify-content: left;
        gap: 5px;
margin-left: 178px;
        margin-bottom: 0;
        margin-top: 40px;
        position: relative;
        z-index: 2;
    }

    .tab-container {
        background: #fff;
        border-radius: 0 0 16px 16px;
        box-shadow: 0 4px 32px rgba(0,0,0,0.08), 0 1.5px 4px rgba(0,0,0,0.04);
        padding: 52px 32px 24px 32px;
        max-width: 900px;
        margin: 0 auto 80px auto;
        margin-top: 0;
        transition: box-shadow 0.2s;
        position: relative;
        z-index: 1;
    }

    .tab-btn {
        padding: 18px 48px 18px 48px;
        font-weight: 600;
        font-size: 1.1rem;
        color: #fff;
        background: #1a7f37;
        border: none;
        border-radius: 16px 16px 0 0;
        cursor: pointer;
        transition: background 0.2s, color 0.2s;
        margin-right: 2px;
        position: relative;
        z-index: 2;
        box-shadow: 0 2px 8px rgba(34,197,94,0.08);
    }

        .tab-btn.active {
            background: #fff;
            color: #1a7f37;
            border-bottom: 2px solid #fff;
            z-index: 3;
        }

        .tab-btn:not(.active) {
            background: #1a7f37;
            color: #fff;
        }
        .tab-header div {
            padding: 12px 32px;
            cursor: pointer;
            font-weight: 600;
            color: #888;
            border-radius: 12px 12px 0 0;
            transition: background 0.2s, color 0.2s;
            background: transparent;
        }

        .tab-header .active {
            color: #1a7f37;
            background: #fff;

        }

    .tab-content {
        display: none;
        animation: fadeIn 0.3s;
    }

        .tab-content.active {
            display: block;
        }


    .form-row {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
    }

    .form-group {
        flex: 1 1 45%;
        margin-bottom: 18px;
        min-width: 220px;
    }

        .form-group.full-width {
            flex: 1 1 100%;
        }

    label {
        font-weight: 600;
        margin-bottom: 6px;
        color: #222;
        display: block;
    }

    .form-control, select.form-control {
        border-radius: 8px;
        border: 1px solid #d1d5db;
        padding: 10px 14px;
        font-size: 1rem;
        background: #f9fafb;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .form-control:focus, select.form-control:focus {
            border-color: #1a7f37;
            box-shadow: 0 0 0 2px #d1fae5;
            background: #fff;
        }

    .form-check-input[type="radio"] {
        width: 1.2em;
        height: 1.2em;
        margin-top: 0.2em;
        accent-color: #1a7f37;
    }

    .form-check-label {
        margin-left: 0.4em;
        margin-right: 1.2em;
        font-weight: 500;
        color: #444;
    }

    .text-danger {
        color: #e11d48;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 80px;
        max-height: 200px;
    }

    #fileList ul {
        padding-left: 0;
        margin-bottom: 0;
    }

    #fileList li {
        list-style: none;
        background: #f3f4f6;
        border-radius: 6px;
        margin-bottom: 6px;
        padding: 8px 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.98rem;
    }

    #fileList .btn-danger {
        font-size: 0.9rem;
        padding: 2px 10px;
        border-radius: 4px;
    }

    .btn-primary {
        background: linear-gradient(90deg, #1a7f37 60%, #22c55e 100%);
        border: none;
        border-radius: 8px;
        padding: 12px 36px;
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 1px;
        box-shadow: 0 2px 8px rgba(34,197,94,0.08);
        transition: background 0.2s, box-shadow 0.2s;
    }

        .btn-primary:hover, .btn-primary:focus {
            background: linear-gradient(90deg, #15803d 60%, #16a34a 100%);
            box-shadow: 0 4px 16px rgba(34,197,94,0.16);
        }

    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
        margin-bottom: 60px;
    }

    .action-btn {
        padding: 12px 36px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 6px 18px -4px rgba(34,197,94,0.25), 0 2px 4px rgba(0,0,0,0.08);
        display: flex;
        align-items: center;
        gap: 8px;
        position: relative;
    }

    .cancel-btn {
        background-color: white;
        color: #1a7f37;
        border: 1.5px solid #1a7f37;
        box-shadow: 0 8px 24px -6px rgba(34,197,94,0.18), 0 2px 8px rgba(0,0,0,0.10);
    }

        .cancel-btn:hover {
            background-color: #f6fff8;
            color: #15803d;
            box-shadow: 0 12px 32px -8px rgba(34,197,94,0.22), 0 4px 12px rgba(0,0,0,0.12);
        }

    .continue-btn {
        background-color: #1a7f37;
        color: white;
        border: 1.5px solid #1a7f37;
        box-shadow: 0 10px 28px -6px rgba(34,197,94,0.28), 0 4px 12px rgba(0,0,0,0.12);
    }

        .continue-btn:hover {
            background-color: #166534;
            box-shadow: 0 16px 40px -8px rgba(34,197,94,0.32), 0 6px 16px rgba(0,0,0,0.16);
        }

    .arrow-icon {
        display: inline-block;
        width: 16px;
        height: 16px;
        border-top: 3px solid white;
        border-right: 3px solid white;
        transform: rotate(45deg);
        margin-left: 5px;
    }

    media (max-width: 900px) {
        .tab-container

    {
        padding: 18px 4vw;
    }

    .form-row {
        gap: 12px;
    }

    .form-group {
        min-width: 160px;
    }

    }

    media (max-width: 600px) {
        .tab-container

    {
        padding: 8px 2vw;
    }

    .form-row {
        flex-direction: column;
        gap: 0;
    }

    .form-group, .form-group.full-width {
        min-width: 100%;
    }

    .action-buttons {
        flex-direction: column;
        gap: 12px;
    }

    .action-btn {
        width: 100%;
        justify-content: center;
    }

    }

    .breadcrumb-custom {
        color: #888;
        font-size: 1.05rem;
        font-weight: 500;
        margin-left: 0;
        margin-bottom: 18px;
        margin-top: 32px;
        letter-spacing: 0.01em;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.2em;
    }

        .breadcrumb-custom .breadcrumb-arrow {
            margin: 0 0.5em;
            font-size: 1.25em;
            vertical-align: middle;
            color: #bbb;
            font-weight: 400;
            user-select: none;
        }

        .breadcrumb-custom .breadcrumb-active {
            color: #1a7f37;
            font-weight: 600;
        }

.upload-label {
    font-size: 2.55rem;
    color: #1a7f37;
    font-weight: 600;
    display: block;
    margin-bottom: 2.25rem;
}

.upload-label-underline {
    width: 100%;
    height: 2px;
    background: #1a7f37;
    margin-bottom: 16px;
    border-radius: 2px;
}

    .supporting-label {
        font-weight: 500;
        font-size: 0.95rem;
        margin-right: auto; /* Push the label to the left */
    }

    #uploadInputGroup {
        justify-content: space-between;
    }

    .uploaded-file-entry {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 1rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        margin-bottom: 0.6rem;
    }

        .uploaded-file-entry:nth-child(odd) {
            background-color: #f2f2f2;
        }

        .uploaded-file-entry:nth-child(even) {
            background-color: #e0e0e0;
        }

    .uploaded-file-actions button {
        margin-left: 0.5rem;
    }

    .bg-secondary.text-white {
        background-color: #e9ecef !important;
        color: #333 !important;
    }

    .uploaded-file-entry .text-muted {
        color: #6c757d !important;
    }
</style>


<div class="breadcrumb-custom">
    Dashboard <span class="breadcrumb-arrow">&#x2794;</span> Tenders <span class="breadcrumb-arrow">&#x2794;</span> <span class="breadcrumb-active">Edit Tender</span>
</div>

<div class="tab-header">
    <div id="tabDetails" class="tab-btn active" onclick="showTab('details')">Details</div>
    <div id="tabDocuments" class="tab-btn" onclick="showTab('documents')">Documents</div>
</div>

<div class="tab-container">
    <form asp-action="Create" enctype="multipart/form-data" method="post" autocomplete="off">
        <div id="details" class="tab-content active">
            <div class="form-row">
                <div class="form-group">
                    <label>Tender Type <span class="text-danger">*</span></label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFQ" required />
                            <label class="form-check-label">RFQ</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFP" />
                            <label class="form-check-label">RFP</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFI" />
                            <label class="form-check-label">RFI</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFO" />
                            <label class="form-check-label">RFO</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="TenderNumber">Tender number <span class="text-danger">*</span></label>
                    <input asp-for="TenderNumber" class="form-control" />
                    <span asp-validation-for="TenderNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClosingDate">Closing Date <span class="text-danger">*</span></label>
                    <input asp-for="ClosingDate" type="date" class="form-control" />
                    <span asp-validation-for="ClosingDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClosingTime">Closing Time <span class="text-danger">*</span></label>
                    <input asp-for="ClosingTime" type="time" class="form-control" />
                    <span asp-validation-for="ClosingTime" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-control custom-dropdown">
                        <option value="" disabled selected hidden>~Please select the status of the tender~</option>
                        <option value="Open Tender">Open Tender</option>
                        <option value="Closed Tender">Closed Tender</option>
                        <option value="Awarded Tender">Awarded Tender</option>
                        <option value="Cancelled Tender">Cancelled Tender</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Title">Tender Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" maxlength="100" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Description">Tender Description <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="200"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div id="documents" class="tab-content">
            <label for="UploadedFiles" class="upload-label">Upload Documents</label>
            <div class="upload-label-underline"></div>

            <div id="uploadedFilesContainer" class="mt-3"></div>

            <div id="uploadInputGroup" class="d-flex align-items-center gap-2 mt-3">
                <label class="supporting-label mb-0"><i class="fas fa-file-pdf text-danger me-1"></i> Supporting Document</label>
                <label class="btn btn-success btn-sm d-flex align-items-center gap-1 mb-0">
                    <i class="fas fa-upload"></i> Upload
                    <input type="file" id="UploadedFiles" accept=".pdf" hidden />
                </label>
            </div>
        </div>

    </form>
</div>

<div class="action-buttons">
    <button type="button" class="action-btn cancel-btn" onclick="window.location.href='@Url.Action("Index", "Tender")'">Cancel</button>
    <button type="button" class="action-btn continue-btn" onclick="submitForm()">Continue <span class="arrow-icon"></span></button>
</div>
@section Scripts {
    <script>
        function showTab(tab) {
            document.getElementById("details").classList.remove("active");
            document.getElementById("documents").classList.remove("active");
            document.getElementById("tabDetails").classList.remove("active");
            document.getElementById("tabDocuments").classList.remove("active");

            document.getElementById(tab).classList.add("active");
            document.getElementById("tab" + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add("active");
        }

        const fileInput = document.getElementById("UploadedFiles");
        const uploadedFilesContainer = document.getElementById("uploadedFilesContainer");
        const uploadInputGroup = document.getElementById("uploadInputGroup");
        const form = document.querySelector("form");

        const storedFiles = [];

        fileInput.addEventListener("change", function () {
            const file = fileInput.files[0];
            if (!file) return;

            if (!file.name.endsWith(".pdf")) {
                alert(`"${file.name}" is not a PDF.`);
                return;
            }

            if (storedFiles.some(f => f.name === file.name && f.size === file.size)) {
                alert("This file is already uploaded.");
                return;
            }

            const fileInfo = {
                file: file,
                uploadedAt: new Date()
            };

            storedFiles.push(fileInfo);
            renderUploadedFiles();
            fileInput.value = "";
        });

        function renderUploadedFiles() {
            uploadedFilesContainer.innerHTML = "";

            storedFiles.forEach((fileInfo, index) => {
                const { file, uploadedAt } = fileInfo;

                const fileRow = document.createElement("div");
                fileRow.className = `uploaded-file-entry p-2 rounded d-flex justify-content-between align-items-start mb-2 ${index % 2 === 0 ? 'bg-light' : 'bg-secondary text-white'}`;

                const fileDetails = document.createElement("div");

                const fileName = document.createElement("strong");
                fileName.textContent = file.name;

                const fileMeta = document.createElement("div");
                fileMeta.className = "text-muted small mt-1";
                fileMeta.style.fontSize = "0.75rem";

                const size = formatFileSize(file.size);
                const time = uploadedAt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                fileMeta.textContent = `${size} • Uploaded at ${time}`;

                fileDetails.appendChild(fileName);
                fileDetails.appendChild(fileMeta);

                const actions = document.createElement("div");
                actions.className = "uploaded-file-actions d-flex";

                const viewBtn = document.createElement("button");
                viewBtn.type = "button";
                viewBtn.className = "btn btn-outline-primary btn-sm me-2";
                viewBtn.innerHTML = '<i class="fas fa-eye"></i>';
                viewBtn.onclick = () => {
                    const fileURL = URL.createObjectURL(file);
                    window.open(fileURL, "_blank");
                };

                const deleteBtn = document.createElement("button");
                deleteBtn.type = "button";
                deleteBtn.className = "btn btn-outline-danger btn-sm";
                deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
                deleteBtn.onclick = () => {
                    storedFiles.splice(index, 1);
                    renderUploadedFiles();
                };

                actions.appendChild(viewBtn);
                actions.appendChild(deleteBtn);

                fileRow.appendChild(fileDetails);
                fileRow.appendChild(actions);

                uploadedFilesContainer.appendChild(fileRow);
            });

            // Re-add another input field if needed
            if (storedFiles.length === 0 || !uploadInputGroup.classList.contains("mt-3")) {
                uploadInputGroup.classList.add("mt-3");
            }
        }

        function formatFileSize(bytes) {
            if (bytes < 1024) return `${bytes} B`;
            else if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
            else return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
        }

        form.addEventListener("submit", function (e) {
            if (storedFiles.length === 0) {
                alert("Please upload at least one PDF file.");
                e.preventDefault();
                return;
            }

            const formData = new FormData(form);
            storedFiles.forEach(fileInfo => {
                formData.append("UploadedFiles", fileInfo.file);
            });

            e.preventDefault();

            fetch(form.action, {
                method: "POST",
                body: formData
            })
                .then(response => {
                    if (response.redirected) {
                        window.location.href = response.url;
                    } else {
                        return response.text().then(html => {
                            document.body.innerHTML = html;
                        });
                    }
                })
                .catch(error => {
                    alert("Error submitting form");
                    console.error(error);
                });
        });
    </script>

}
