@section Scripts {
    <script>

            // Pass current SA date and time to JavaScript
        window.currentSaDate = '@ViewBag.CurrentSaDate';
        window.currentSaDateTime = '@ViewBag.CurrentSaDateTime';

               document.addEventListener('DOMContentLoaded', function () {
                         let docIdToDelete = null;
        document.querySelectorAll('.delete-upload-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                docIdToDelete = btn.getAttribute('data-doc-id');
                var modal = new bootstrap.Modal(document.getElementById('deleteDocModal'));
                modal.show();

                document.getElementById('confirmDeleteDocBtn').onclick = function() {
                    if (!docIdToDelete) return;
                    fetch('/TenderAdmin/DeleteDraftDocument', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({ documentId: docIdToDelete })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.querySelector('[data-doc-id="' + docIdToDelete + '"]').remove();
                        } else {
                            alert('Failed to delete document: ' + data.message);
                        }
                        docIdToDelete = null;
                        modal.hide();
                    })
                    .catch(err => {
                        alert('Error deleting document.');
                        docIdToDelete = null;
                        modal.hide();
                    });
                };
            document.getElementById('cancelDeleteDocBtn').onclick = function() {
                        docIdToDelete = null;
                        modal.hide();
                    };
                });
            });

        const closingDateInput = document.querySelector('input[name="ClosingDate"]');
        if (closingDateInput) {
            // Set min attribute on load
            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const dd = String(today.getDate()).padStart(2, '0');
            const minDate = `${yyyy}-${mm}-${dd}`;
            closingDateInput.setAttribute('min', minDate);

            // Validate on change
            closingDateInput.addEventListener('change', function () {
                if (this.value < minDate) {
                    this.value = minDate;
                    // Optionally show a validation error
                    alert('Closing date cannot be before today.');
                }
            });
        }

                            document.querySelectorAll('.btn-link.text-danger').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var container = btn.closest('[data-doc-id]');
                    var docId = container.getAttribute('data-doc-id');
                    if (!docId) return;
                    if (!confirm('Are you sure you want to delete this document?')) return;

                    fetch('/TenderAdmin/DeleteDraftDocument', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({ documentId: docId })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            container.remove(); // Instantly remove from UI
                        } else {
                            alert('Failed to delete document: ' + data.message);
                        }
                    })
                    .catch(err => alert('Error deleting document.'));
                });
            });





            // Tab logic...
            const tabs = ['details', 'documents', 'submit'];
            let currentTab = 'details';

            const continueBtn = document.getElementById('continueBtn');
            const doneBtn = document.getElementById('doneBtn');
            let draftBtn = document.getElementById('draftBtn');

            const submitTabs = ['publish', 'schedule', 'draft'];
            let currentSubmitSubTab = 'publish';

            // Initialize Flatpickr calendar (always visible)
            const initCalendar = function() {
            // Parse the current SA date
            const currentSaDate = new Date(window.currentSaDate + 'T00:00:00');

            const calendar = flatpickr("#calendarContainer", {
                inline: true,
                dateFormat: "Y-m-d",
                minDate: currentSaDate, // Prevent selecting dates before today (SA time)
                onChange: function(selectedDates, dateStr, instance) {
                    // Additional validation to ensure selected date is not in the past
                    const selectedDate = new Date(dateStr + 'T00:00:00');
                    if (selectedDate < currentSaDate) {
                        alert('You cannot schedule a tender for a date in the past.');
                        // Reset to minimum date
                        instance.setDate(currentSaDate);
                        return;
                    }

                    document.getElementById('ScheduledDate').value = dateStr;
                    // Update the selected date display
                    const formattedDate = instance.formatDate(selectedDates[0], "F j, Y");
                    document.getElementById('selectedDateDisplay').textContent = formattedDate;
                }
            });

            // Set current SA date as default (or next day if current time is late)
            const defaultDate = currentSaDate;
            calendar.setDate(defaultDate);
            document.getElementById('ScheduledDate').value = calendar.selectedDates[0].toISOString().split('T')[0];

            // Format and display the default date
            const formattedDate = calendar.formatDate(calendar.selectedDates[0], "F j, Y");
            document.getElementById('selectedDateDisplay').textContent = formattedDate;
        };

               // --- FIXED TIME INPUT LOGIC START ---
        const initTimeInput = function() {
            const hoursInput = document.getElementById('hours');
            const minutesInput = document.getElementById('minutes');
            const amBtn = document.querySelector('.am-btn');
            const pmBtn = document.querySelector('.pm-btn');
            const timeHiddenInput = document.getElementById('ScheduledTime');
            let isAM = amBtn && amBtn.classList.contains('active') ? true : false;

            // Set initial time value
            updateHiddenTimeValue();

            function displayHourValue(val) {
                if (!val) return '';
                val = String(parseInt(val, 10));
                return val;
            }

        function validateHourInput() {
            hoursInput.addEventListener('input', function(e) {
                let val = this.value.replace(/\D/g, '');
                if (val.length > 2) val = val.slice(0, 2);
                if (val.length === 1 && val === '0') val = '';
                if (val.length === 2 && parseInt(val, 10) > 12) val = val[0] === '1' ? '12' : '1';
                if (val === '00') val = '';
                // No leading zero for display
                this.value = val ? String(parseInt(val, 10)) : '';
                updateHiddenTimeValue();
            });

            hoursInput.addEventListener('keydown', function(e) {
                let val = parseInt(this.value || '1', 10) || 1;
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    val = val >= 12 ? 1 : val + 1;
                    this.value = String(val); // No leading zero for display
                    updateHiddenTimeValue();
                } else if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    val = val <= 1 ? 12 : val - 1;
                    this.value = String(val); // No leading zero for display
                    updateHiddenTimeValue();
                }
            });

            hoursInput.addEventListener('blur', function() {
                // Remove leading zero if present and value is 1-9
                if (this.value && this.value.length === 2 && this.value.startsWith('0')) {
                    this.value = this.value.substring(1);
                }
                updateHiddenTimeValue();
            });
        }

            function validateMinuteInput() {
                minutesInput.addEventListener('input', function(e) {
                    let val = this.value.replace(/\D/g, '');
                    if (val.length > 2) val = val.slice(0, 2);
                    if (val.length === 2 && parseInt(val, 10) > 59) val = '59';
                    this.value = val;
                    updateHiddenTimeValue();
                });

                minutesInput.addEventListener('keydown', function(e) {
                    let val = parseInt(this.value || '0', 10) || 0;
                    if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        val = val >= 59 ? 0 : val + 1;
                        this.value = String(val).padStart(2, '0');
                        updateHiddenTimeValue();
                    } else if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        val = val <= 0 ? 59 : val - 1;
                        this.value = String(val).padStart(2, '0');
                        updateHiddenTimeValue();
                    }
                });

                minutesInput.addEventListener('blur', function() {
                    if (this.value) {
                        this.value = this.value.padStart(2, '0');
                    }
                    updateHiddenTimeValue();
                });
            }

            // AM/PM toggle
            if (amBtn) {
                amBtn.addEventListener('click', function() {
                    if (!isAM) {
                        isAM = true;
                        amBtn.classList.add('active');
                        pmBtn.classList.remove('active');
                        updateHiddenTimeValue();
                    }
                });
            }
            if (pmBtn) {
                pmBtn.addEventListener('click', function() {
                    if (isAM) {
                        isAM = false;
                        pmBtn.classList.add('active');
                        amBtn.classList.remove('active');
                        updateHiddenTimeValue();
                    }
                });
            }
        function updateHiddenTimeValue() {
            let hours = hoursInput.value.padStart(2, '0') || '00';
            let minutes = minutesInput.value.padStart(2, '0') || '00';
            let seconds = '00';

            // Convert to 24-hour format
            let hours24 = parseInt(hours, 10);
            if (isAM) {
                if (hours24 === 12) hours24 = 0;
            } else {
                if (hours24 !== 12) hours24 += 12;
            }

            const formattedTime = `${String(hours24).padStart(2, '0')}:${minutes}:${seconds}`;
            timeHiddenInput.value = formattedTime;

            // Validate if selected date is today (SA time)
            validateScheduledDateTime();
        }

                function validateScheduledDateTime() {
            const selectedDate = document.getElementById('ScheduledDate').value;
            const selectedTime = document.getElementById('ScheduledTime').value;

