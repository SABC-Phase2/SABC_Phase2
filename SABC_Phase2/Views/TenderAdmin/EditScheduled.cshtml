@{
    ViewData["BannerText"] = "Scheduled Tenders";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
@model TenderEditDto

@{
    ViewBag.Title = "Edit Scheduled Tender";

    var saTimeZone = TimeZoneInfo.FindSystemTimeZoneById("South Africa Standard Time");
    DateTime? localScheduled = Model.ScheduledPublishDateTime.HasValue
        ? TimeZoneInfo.ConvertTimeFromUtc(Model.ScheduledPublishDateTime.Value, saTimeZone)
        : (DateTime?)null;
}

<div class="breadcrumb-custom">
    Dashboard <span class="breadcrumb-arrow">&#x2794;</span> Tenders <span class="breadcrumb-arrow">&#x2794;</span> <span class="breadcrumb-active">Edit Scheduled Tender</span>
</div>

<div class="tab-header">
    <div id="tabDetails" class="tab-btn active" onclick="showTab('details')">Details</div>
    <div id="tabDocuments" class="tab-btn" onclick="showTab('documents')">Documents</div>
</div>

<div class="tab-container">
    <form asp-action="EditScheduled" enctype="multipart/form-data" method="post" autocomplete="off">
        @if (Model.DraftId != null)
        {
            <input type="hidden" name="DraftId" value="@Model.DraftId" />
        }
        @if (Model.Id != 0)
        {
            <input type="hidden" name="Id" value="@Model.Id" />
        }
        <div id="details" class="tab-content active">
            <div class="form-row">
                <div class="form-group">
                    <label>Tender Type <span class="text-danger">*</span></label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFQ" required
                                   @(Model.TenderType == "RFQ" ? "checked" : "") />
                            <label class="form-check-label">RFQ</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFP"
                                   @(Model.TenderType == "RFP" ? "checked" : "") />
                            <label class="form-check-label">RFP</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFI"
                                   @(Model.TenderType == "RFI" ? "checked" : "") />
                            <label class="form-check-label">RFI</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFO"
                                   @(Model.TenderType == "RFO" ? "checked" : "") />
                            <label class="form-check-label">RFO</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="TenderNumber">Tender number <span class="text-danger">*</span></label>
                    <input asp-for="TenderNumber" class="form-control" />
                    <span asp-validation-for="TenderNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClosingDate">Closing Date <span class="text-danger">*</span></label>
                    <input asp-for="ClosingDate" type="date" class="form-control" />
                    <span asp-validation-for="ClosingDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClosingTime">Closing Time <span class="text-danger">*</span></label>
                    <input asp-for="ClosingTime" type="time" class="form-control" />
                    <span asp-validation-for="ClosingTime" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-control custom-dropdown">
                        <option value="" disabled selected hidden>~Please select the status of the tender~</option>
                        <option value="Scheduled">Scheduled</option>
                        <option value="Open Tender">Open Tender</option>
                        <option value="Closed Tender">Closed Tender</option>
                        <option value="Awarded Tender">Awarded Tender</option>
                        <option value="Cancelled Tender">Cancelled Tender</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Title">Tender Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" maxlength="100" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Description">Tender Description <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="200"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label>Scheduled Publish Date & Time</label>
                    <input type="text" class="form-control"
                           value="@(localScheduled.HasValue? localScheduled.Value.ToString("yyyy-MM-dd HH:mm") : "")"
                           readonly />
                </div>

                <!-- Schedule Tender Section -->
                <div class="form-group full-width">
                    <div class="schedule-container">
                        <div class="schedule-toggle" id="scheduleToggle">
                            <input type="checkbox"
                                   id="IsScheduled"
                                   name="IsScheduled"
                                   value="true"
                                   @(Model.IsScheduled ? "checked" : "") />
                            <span class="schedule-toggle-text">Schedule this tender for later publication</span>
                        </div>
                        <div class="schedule-fields @(Model.IsScheduled ? "show" : "")" id="scheduleFields">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="ScheduledDate">Scheduled Date</label>
                                    <div class="selected-date-display" id="selectedDateDisplay">
                                        @(Model.ScheduledDate.HasValue? Model.ScheduledDate.Value.ToString("MMMM d, yyyy") : "No date selected")
                                    </div>
                                    <div class="always-visible-calendar" id="calendarContainer"></div>
                                    <input type="hidden" id="ScheduledDate" name="ScheduledDate" value="@(Model.ScheduledDate?.ToString("yyyy-MM-dd") ?? "")" />
                                </div>
                                <div class="form-group" style="margin-top: 140px;">
                                    <label for="timeInput">Scheduled Time</label>
                                    <div class="time-input-container" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 10px;">
                                        <input type="number" id="hours" min="1" max="12" placeholder="HH" class="time-part" style="width: 70px; height: 45px; font-size: 1rem;">
                                        <span style="font-size: 1.5rem;">:</span>
                                        <input type="number" id="minutes" min="0" max="59" placeholder="MM" class="time-part" style="width: 70px; height: 45px; font-size: 1rem;">
                                        <div class="time-period-toggle" style="margin-left: 15px;">
                                            <button type="button" class="time-period-btn am-btn">AM</button>
                                            <button type="button" class="time-period-btn pm-btn">PM</button>
                                        </div>
                                        <input type="hidden" id="ScheduledTime" name="ScheduledTime">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Upload Documents Section -->
        <div id="documents" class="tab-content">
            <label for="UploadedFiles" class="upload-label">Upload Documents</label>
            <div class="upload-label-underline"></div>

            <div id="uploadedFilesContainer" class="mt-3">
                @if (Model.ExistingDocuments != null && Model.ExistingDocuments.Any())
                {
                    @foreach (var doc in Model.ExistingDocuments)
                    {
                        <div class="uploaded-file-entry existing-doc" data-doc-id="@doc.Id">
                            <div class="uploaded-file-entry-content">
                                <div class="uploaded-file-name">@doc.FileName</div>
                            </div>
                            <div class="uploaded-file-actions">
                                <button type="button" class="icon-btn view-upload-btn" onclick="window.open('@doc.SharePointPath', '_blank')">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" class="icon-btn text-danger remove-upload-btn" onclick="document.getElementById('delete_doc_@doc.Id').checked = true;">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                            <div style="display:none;">
                                <input type="checkbox" name="DocumentsToDelete" value="@doc.Id" id="delete_doc_@doc.Id" />
                            </div>
                        </div>
                    }
                }
            </div>

            <div id="uploadInputGroup" class="d-flex align-items-center gap-2 mt-3">
                <label class="supporting-label mb-0"><i class="fas fa-file-pdf text-danger me-1"></i> Supporting Document</label>
                <label class="btn btn-success btn-sm d-flex align-items-center gap-1 mb-0">
                    <i class="fas fa-upload"></i> Upload
                    <input type="file" id="UploadedFiles" name="UploadedFiles" multiple accept=".pdf" hidden />
                </label>
            </div>
        </div>
    </form>
</div>

<div class="action-buttons">
    <button type="button" class="action-btn cancel-btn" onclick="window.location.href='@Url.Action("ScheduledIndex", "TenderAdmin")'">Cancel</button>
    <button type="button" id="continueBtn" class="action-btn continue-btn" onclick="submitForm()">Save Changes <span class="arrow-icon"></span></button>
</div>


<!-- Delete Confirmation Modal -->
<div id="deleteDocModal" class="modal fade" tabindex="-1" aria-labelledby="deleteDocModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header border-0">
                <h5 class="modal-title w-100" id="deleteDocModalLabel" style="color:#e11d48;">Delete Document</h5>
            </div>
            <div class="modal-body">
                <p style="font-size:1.1rem;">Are you sure you want to delete this document?</p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center gap-2">
                <button type="button" id="confirmDeleteDocBtn" class="btn btn-danger" style="min-width:100px;">Delete</button>
                <button type="button" id="cancelDeleteDocBtn" class="btn btn-secondary" style="min-width:100px;" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

           let docToDeleteEntry = null;
        let docToDeleteCheckbox = null;

        // Attach event listeners to all existing document delete buttons (multi-step)
        document.querySelectorAll('.uploaded-file-entry.existing-doc .remove-upload-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                docToDeleteEntry = btn.closest('.uploaded-file-entry.existing-doc');
                docToDeleteCheckbox = docToDeleteEntry.querySelector('input[type="checkbox"][name="DocumentsToDelete"]');
                // Show confirmation modal
                var modal = new bootstrap.Modal(document.getElementById('deleteDocModal'));
                modal.show();
            });
        });

        // Confirm delete
        document.getElementById('confirmDeleteDocBtn').addEventListener('click', function() {
            if (docToDeleteCheckbox) {
                docToDeleteCheckbox.checked = true;
            }
            if (docToDeleteEntry) {
                docToDeleteEntry.style.display = 'none';
            }
            // Hide modal
            var modal = bootstrap.Modal.getInstance(document.getElementById('deleteDocModal'));
            modal.hide();
            // Reset
            docToDeleteEntry = null;
            docToDeleteCheckbox = null;
        });

        // Cancel delete (optional, modal will close automatically)
        document.getElementById('cancelDeleteDocBtn').addEventListener('click', function() {
            docToDeleteEntry = null;
            docToDeleteCheckbox = null;
        });
            // -------- Tab logic --------
            const tabs = ['details', 'documents'];
            let currentTab = 'details';

            window.showTab = function(tabName) {
                document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
                document.querySelectorAll('.tab-btn').forEach(tb => tb.classList.remove('active'));
                document.getElementById(tabName).classList.add('active');
                document.getElementById('tab' + capitalize(tabName)).classList.add('active');
                currentTab = tabName;
            };

            function capitalize(str) {
                return str.charAt(0).toUpperCase() + str.slice(1);
            }

            showTab(currentTab);

           // --- Schedule toggle logic ---
            const scheduleToggle = document.getElementById('IsScheduled');
            const scheduleFields = document.getElementById('scheduleFields');
            if (scheduleToggle && scheduleFields) {
                function updateScheduleFields() {
                    if (scheduleToggle.checked) {
                        scheduleFields.classList.add('show');
                    } else {
                        scheduleFields.classList.remove('show');
                    }
                }
                 updateScheduleFields();
                scheduleToggle.addEventListener('change', updateScheduleFields);

            }

            // --- Flatpickr calendar logic ---
            const calendarInput = document.getElementById('ScheduledDate');
            const calendarContainer = document.getElementById('calendarContainer');
            const selectedDateDisplay = document.getElementById('selectedDateDisplay');
            let initialDate = calendarInput.value || null;

                   const calendar = flatpickr(calendarContainer, {
            inline: true,
            dateFormat: "Y-m-d",
            defaultDate: initialDate,
            minDate: "today", // <-- Prevents selecting past dates
            onChange: function(selectedDates, dateStr, instance) {
                calendarInput.value = dateStr;
                if (selectedDates.length > 0) {
                    const formattedDate = instance.formatDate(selectedDates[0], "F j, Y");
                    selectedDateDisplay.textContent = formattedDate;
                } else {
                    selectedDateDisplay.textContent = "No date selected";
                }
            }
        });

            // Set display if initial value exists
            if (initialDate) {
                const dateObj = new Date(initialDate);
                selectedDateDisplay.textContent = calendar.formatDate(dateObj, "F j, Y");
            }

            // --- Time input logic (AM/PM) ---
            const hoursInput = document.getElementById('hours');
            const minutesInput = document.getElementById('minutes');
            const amBtn = document.querySelector('.am-btn');
            const pmBtn = document.querySelector('.pm-btn');
            const timeHiddenInput = document.getElementById('ScheduledTime');

                 // Set initial values from model
        @if (Model.ScheduledTime.HasValue)
        {
                    var t = Model.ScheduledTime.Value;
                    <text>
                    hoursInput.value = "@((t.Hours % 12 == 0 ? 12 : t.Hours % 12).ToString().PadLeft(2, '0'))";
                    minutesInput.value = "@t.Minutes.ToString("D2")";
                    let isAM = @(t.Hours < 12).ToString().ToLower();
                    </text>
        }
        else
        {
                    <text>
                    hoursInput.value = "08";
                    minutesInput.value = "00";
                    let isAM = true;
                    </text>
        }

            function updateHiddenTimeValue() {
                let hours = hoursInput.value.padStart(2, '0') || '00';
                let minutes = minutesInput.value.padStart(2, '0') || '00';
                let seconds = '00';
                let hours24 = parseInt(hours, 10);
                if (isAM) {
                    if (hours24 === 12) hours24 = 0;
                } else {
                    if (hours24 !== 12) hours24 += 12;
                }
                const formattedTime = `${String(hours24).padStart(2, '0')}:${minutes}:${seconds}`;
                timeHiddenInput.value = formattedTime;
            }

            // Set initial AM/PM button state
            function setAMPMButtons() {
                if (isAM) {
                    amBtn.classList.add('active');
                    pmBtn.classList.remove('active');
                } else {
                    pmBtn.classList.add('active');
                    amBtn.classList.remove('active');
                }
                }
            setAMPMButtons();
            updateHiddenTimeValue();

            // AM/PM toggle
            amBtn.addEventListener('click', function() {
                if (!isAM) {
                    isAM = true;
                    setAMPMButtons();
                    updateHiddenTimeValue();
                }
            });
            pmBtn.addEventListener('click', function() {
                if (isAM) {
                    isAM = false;
                    setAMPMButtons();
                    updateHiddenTimeValue();
                }
            });

            // Input validation and update
            hoursInput.addEventListener('input', function() {
                let val = this.value.replace(/\D/g, '');
                if (val.length > 2) val = val.slice(0, 2);
                if (val.length === 1 && val === '0') val = '';
                if (val.length === 2 && parseInt(val, 10) > 12) val = '12';
                if (val === '00') val = '';
                this.value = val;
                updateHiddenTimeValue();
            });
            hoursInput.addEventListener('blur', function() {
                if (this.value && this.value.length === 1) {
                    this.value = this.value.padStart(2, '0');
                }
                updateHiddenTimeValue();
            });
             minutesInput.addEventListener('input', function() {
                let val = this.value.replace(/\D/g, '');
                if (val.length > 2) val = val.slice(0, 2);
                if (val.length === 2 && parseInt(val, 10) > 59) val = '59';
                this.value = val;
                updateHiddenTimeValue();
            });
            minutesInput.addEventListener('blur', function() {
                if (this.value) {
                    this.value = this.value.padStart(2, '0');
                }
                updateHiddenTimeValue();
            });

            // Keyboard up/down for hours/minutes
            hoursInput.addEventListener('keydown', function(e) {
                let val = parseInt(this.value || '1', 10) || 1;
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    val = val >= 12 ? 1 : val + 1;
                    this.value = String(val).padStart(2, '0');
                    updateHiddenTimeValue();
                } else if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    val = val <= 1 ? 12 : val - 1;
                    this.value = String(val).padStart(2, '0');
                    updateHiddenTimeValue();
                }
            });
            minutesInput.addEventListener('keydown', function(e) {
                let val = parseInt(this.value || '0', 10) || 0;
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    val = val >= 59 ? 0 : val + 1;
                    this.value = String(val).padStart(2, '0');
                    updateHiddenTimeValue();
                } else if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    val = val <= 0 ? 59 : val - 1;
                    this.value = String(val).padStart(2, '0');
                    updateHiddenTimeValue();
                }
            });

            // Set initial hidden value on load
            updateHiddenTimeValue();
        });

            // -------- Multi PDF upload logic --------
            const fileInput = document.getElementById('UploadedFiles');
            const uploadedFilesContainer = document.getElementById('uploadedFilesContainer');
            let selectedFiles = [];

            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    const files = Array.from(fileInput.files);
                    files.forEach(file => {
                        if (file.type !== "application/pdf") {
                            alert("Only PDF files are allowed.");
                            return;
                        }
                        // Avoid duplicate by name+size
                        if (!selectedFiles.find(f => f.name === file.name && f.size === file.size)) {
                            selectedFiles.push(file);
                        }
                    });
                    updateFilesDisplay();
                    fileInput.value = "";
                });
            }


                    function updateFilesDisplay() {
            // Remove only the new uploaded file entries (not server-existing ones)
            document.querySelectorAll('.uploaded-file-entry.new-doc').forEach(e => e.remove());

            // Re-render all currently selected new files
            selectedFiles.forEach(function(file, idx) {
                const entryDiv = document.createElement('div');
                entryDiv.className = "uploaded-file-entry new-doc p-2 rounded d-flex justify-content-between align-items-center mb-2 bg-light";
                entryDiv.innerHTML = `
                    <div>
                        <strong>${file.name}</strong>
                    </div>
                    <div class="uploaded-file-actions d-flex gap-2">
                        <button type="button" class="icon-btn view-upload-btn" title="View">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button type="button" class="icon-btn text-danger remove-upload-btn" title="Delete">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                `;

                // View button logic
                entryDiv.querySelector('.view-upload-btn').addEventListener('click', function () {
                    const fileURL = URL.createObjectURL(file);
                    window.open(fileURL, '_blank');
                });

                // Remove button logic
                entryDiv.querySelector('.remove-upload-btn').addEventListener('click', function () {
                    selectedFiles = selectedFiles.filter(f => !(f.name === file.name && f.size === file.size));
                    updateFilesDisplay();
                });

                uploadedFilesContainer.appendChild(entryDiv);
            });
        }
            // --------- Custom Validation Utilities ---------
            function showFieldError(fieldIdOrName, message, tabName) {
                let field = document.getElementById(fieldIdOrName) || document.querySelector(`[name='${fieldIdOrName}']`);
                if (field) {
                    let label = null;
                    // Try to find the associated label
                    if (field.id) {
                        label = document.querySelector(`label[for='${field.id}']`);
                    }
                    if (!label) {
                        let formGroup = field.closest('.form-group');
                        if (formGroup) {
                            label = formGroup.querySelector('label');
                        }
                    }
                    // Remove any existing error span near this label
                    if (label) {
                        let oldError = label.parentNode.querySelector('.validation-custom-error');
                        if (oldError) oldError.remove();

                        let errorSpan = document.createElement('span');
                        errorSpan.className = 'validation-custom-error text-danger';
                        errorSpan.innerText = message;
                        errorSpan.style.fontWeight = 'bold';

                        if (tabName === 'documents') {
                            // Insert after label
                            label.insertAdjacentElement('afterend', errorSpan);
                        } else {
                            // Append next to label
                            errorSpan.classList.add('ms-2');
                            label.appendChild(errorSpan);
                        }
                    }
                    field.classList.add('field-error-highlight');
                } else {
                    // Fallback error on the whole tab section
                    let tabContent = document.getElementById(tabName);
                    if (tabContent) {
                        let oldError = tabContent.querySelector('.validation-custom-error');
                        if (oldError) oldError.remove();
                        let errorSpan = document.createElement('span');
                        errorSpan.className = 'validation-custom-error text-danger';
                        errorSpan.innerText = message;
                        errorSpan.style.display = 'block';
                        errorSpan.style.fontWeight = 'bold';
                        errorSpan.style.marginBottom = '10px';
                        tabContent.prepend(errorSpan);
                    }
                }
            }

            function clearAllCustomErrors() {
                document.querySelectorAll('.validation-custom-error').forEach(e => e.remove());
                document.querySelectorAll('.field-error-highlight').forEach(e => e.classList.remove('field-error-highlight'));
            }

            function clearFieldError(e) {
                let field = e.target;
                let label = null;
                if (field.id) {
                    label = document.querySelector(`label[for='${field.id}']`);
                }
                if (!label) {
                    let formGroup = field.closest('.form-group');
                    if (formGroup) {
                        label = formGroup.querySelector('label');
                    }
                }
                if (label) {
                    let oldError = label.parentNode.querySelector('.validation-custom-error');
                    if (oldError) oldError.remove();
                }
                field.classList.remove('field-error-highlight');
            }

            document.querySelectorAll('input, textarea, select').forEach(e => {
                e.addEventListener('input', clearFieldError);
                e.addEventListener('change', clearFieldError);
            });

            // -------- Save Changes/Submit logic (send all selected files) --------
                  window.submitForm = function() {
            const saveBtn = document.getElementById('continueBtn');

            // Prevent multiple submissions
            if (saveBtn.classList.contains('loading')) {
                return;
            }

            // Add loading state
            saveBtn.classList.add('loading');
            saveBtn.innerHTML = 'Saving<span class="loading-dots"></span>';
            saveBtn.disabled = true;

            clearAllCustomErrors();

            // VALIDATION SECTION
            let errors = [];
            let errorFields = [];
            let errorTabs = [];

            // Required fields (details tab)
            let tenderType = document.querySelector('input[name="TenderType"]:checked');
            let tenderNumber = document.querySelector('input[name="TenderNumber"]');
            let closingDate = document.querySelector('input[name="ClosingDate"]');
            let closingTime = document.querySelector('input[name="ClosingTime"]');
            let title = document.querySelector('input[name="Title"]');
            let description = document.querySelector('textarea[name="Description"]');
            let status = document.querySelector('select[name="Status"]').value;
            let isScheduled = scheduleToggle && scheduleToggle.checked;

            if (!tenderType) {
                errors.push({field: 'TenderType', message: 'Please select a Tender Type', tab: 'details'});
                errorFields.push('TenderType'); errorTabs.push('details');
            }
            if (!tenderNumber.value.trim()) {
                errors.push({field: 'TenderNumber', message: 'Tender Number is required', tab: 'details'});
                errorFields.push('TenderNumber'); errorTabs.push('details');
            }
            if (!closingDate.value.trim()) {
                errors.push({field: 'ClosingDate', message: 'Closing Date is required', tab: 'details'});
                errorFields.push('ClosingDate'); errorTabs.push('details');
            }
            if (!closingTime.value.trim()) {
                errors.push({field: 'ClosingTime', message: 'Closing Time is required', tab: 'details'});
                errorFields.push('ClosingTime'); errorTabs.push('details');
            }
            if (!title.value.trim()) {
                errors.push({field: 'Title', message: 'Tender Title is required', tab: 'details'});
                errorFields.push('Title'); errorTabs.push('details');
            }
            if (!description.value.trim()) {
                errors.push({field: 'Description', message: 'Tender Description is required', tab: 'details'});
                errorFields.push('Description'); errorTabs.push('details');
            }
            if (!status) {
                errors.push({field: 'StatusDropdown', message: 'Tender Status is required', tab: 'details'});
                errorFields.push('StatusDropdown'); errorTabs.push('details');
            }

                   // Scheduled date/time required if scheduled
        if (isScheduled) {
            var dateVal = document.getElementById('ScheduledDate').value;
            var timeVal = document.getElementById('ScheduledTime').value;
            if (!dateVal) {
                errors.push({field: 'ScheduledDate', message: 'You missed Scheduled Date.', tab: 'details'});
                errorFields.push('ScheduledDate'); errorTabs.push('details');
            }
            if (!timeVal) {
                errors.push({field: 'ScheduledTime', message: 'You missed Scheduled Time.', tab: 'details'});
                errorFields.push('ScheduledTime'); errorTabs.push('details');
            }

            // --- Prevent scheduling in the past ---
            if (dateVal && timeVal) {
                // Combine date and time into a JS Date object
                var scheduledDateTime = new Date(dateVal + 'T' + timeVal);
                var now = new Date();
                if (scheduledDateTime < now) {
                    errors.push({field: 'ScheduledDate', message: 'Scheduled date and time cannot be in the past.', tab: 'details'});
                    errorFields.push('ScheduledDate'); errorTabs.push('details');
                }
            }
        }
            // Supporting documents required: count only those not marked for deletion + new uploads
            const existingDocsCount =
                Array.from(uploadedFilesContainer.querySelectorAll('.uploaded-file-entry.existing-doc'))
                    .filter(div => {
                        const docId = div.getAttribute('data-doc-id');
                        const delCheckbox = document.querySelector(`input[name="DocumentsToDelete"][value="${docId}"]`);
                        return !(delCheckbox && delCheckbox.checked);
                    }).length
                +
                uploadedFilesContainer.querySelectorAll('.uploaded-file-entry.new-doc').length;
            if (existingDocsCount === 0) {
                errors.push({field: 'UploadedFiles', message: 'You must upload at least one supporting document.', tab: 'documents'});
                errorFields.push('UploadedFiles'); errorTabs.push('documents');
            }

            // Show all errors next to their fields
            if (errors.length > 0) {
                // Remove loading state if validation fails
                saveBtn.classList.remove('loading');
                saveBtn.innerHTML = 'Save Changes <span class="arrow-icon"></span>';
                saveBtn.disabled = false;

                errors.forEach(function(err) {
                    showFieldError(err.field, err.message, err.tab);
                });
                // Switch to first errored tab and focus field
                showTab(errors[0].tab);
                let firstField = document.getElementById(errors[0].field) || document.querySelector(`[name='${errors[0].field}']`);
                if (firstField) {
                    firstField.scrollIntoView({behavior: "smooth", block: "center"});
                    firstField.focus();
                }
                return;
            }

            var form = document.querySelector('form[asp-action="EditScheduled"]');
            if (!form) form = document.querySelector('form[action*="EditScheduled"]');
            if (!form) {
                alert("Form not found!");
                // Remove loading state if form not found
                saveBtn.classList.remove('loading');
                saveBtn.innerHTML = 'Save Changes <span class="arrow-icon"></span>';
                saveBtn.disabled = false;
                return;
            }
            var formData = new FormData(form);

            // Remove any existing files from input (avoid duplicate)
            formData.delete('UploadedFiles');

            // Append all files from selectedFiles
            selectedFiles.forEach(function(file) {
                formData.append('UploadedFiles', file, file.name);
            });

            // If scheduled, ensure scheduled date/time is provided (already validated above)
            if (isScheduled) {
                formData.set('IsScheduled', 'true');
            } else {
                formData.delete('IsScheduled');
                formData.delete('ScheduledDate');
                formData.delete('ScheduledTime');
            }

            // Submit the form via AJAX
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }
            })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url;
                } else {
                    response.text().then(html => {
                        document.body.innerHTML = html;
                        window.scrollTo(0, 0);
                    });
                }
            })
            .catch(error => {
                alert("An error occurred while saving changes.");
            })
            .finally(() => {
                // Remove loading state after response (success or error)
                saveBtn.classList.remove('loading');
                saveBtn.innerHTML = 'Save Changes <span class="arrow-icon"></span>';
                saveBtn.disabled = false;
            });
        };

    </script>
}

