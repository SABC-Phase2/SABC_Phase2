@{
    ViewData["BannerText"] = "Scheduled Tenders";
}
<link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css">
<script src="~/lib/flatpickr/flatpickr.min.js"></script>
@model TenderEditDto

@{
    ViewBag.Title = "Edit Scheduled Tender";

    var saTimeZone = TimeZoneInfo.FindSystemTimeZoneById("South Africa Standard Time");
    DateTime? localScheduled = Model.ScheduledPublishDateTime.HasValue
        ? TimeZoneInfo.ConvertTimeFromUtc(Model.ScheduledPublishDateTime.Value, saTimeZone)
        : (DateTime?)null;
}

<div class="breadcrumb-custom">
    Dashboard <span class="breadcrumb-arrow">&gt;</span> Tenders <span class="breadcrumb-arrow">&gt;</span> <span class="breadcrumb-active">Edit Scheduled Tender</span>
</div>

<div class="tab-header">
    <div id="tabDetails" class="tab-btn active" onclick="showTab('details')">Details</div>
    <div id="tabDocuments" class="tab-btn" onclick="showTab('documents')">Documents</div>
</div>

<div class="tab-container">
    <form asp-action="EditScheduled" enctype="multipart/form-data" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        @if (Model.DraftId != null)
        {
            <input type="hidden" name="DraftId" value="@Model.DraftId" />
        }
        @if (Model.Id != 0)
        {
            <input type="hidden" name="Id" value="@Model.Id" />
        }
        <div id="details" class="tab-content active">
            <div class="form-row">
                <div class="form-group">
                    <label>Tender Type <span class="text-danger">*</span></label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFQ" required
                                   @(Model.TenderType == "RFQ" ? "checked" : "") />
                            <label class="form-check-label">RFQ</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFP"
                                   @(Model.TenderType == "RFP" ? "checked" : "") />
                            <label class="form-check-label">RFP</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFI"
                                   @(Model.TenderType == "RFI" ? "checked" : "") />
                            <label class="form-check-label">RFI</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="TenderType" value="RFO"
                                   @(Model.TenderType == "RFO" ? "checked" : "") />
                            <label class="form-check-label">RFO</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="TenderNumber">Tender number <span class="text-danger">*</span></label>
                    <input asp-for="TenderNumber" class="form-control" />
                    <span asp-validation-for="TenderNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClosingDate">Closing Date <span class="text-danger">*</span></label>
                    <input asp-for="ClosingDate" type="date" class="form-control" min="@ViewBag.MinDate" />
                    <span asp-validation-for="ClosingDate" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClosingTime">Closing Time <span class="text-danger">*</span></label>
                    <input asp-for="ClosingTime" type="time" class="form-control" />
                    <span asp-validation-for="ClosingTime" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-control custom-dropdown" id="StatusDropdown" disabled>
                        <option value="" disabled selected hidden>~Please select the status of the tender~</option>
                        <option value="Scheduled">Scheduled</option>
                        <option value="Open Tender">Open Tender</option>
                        <option value="Closed Tender">Closed Tender</option>
                        <option value="Awarded Tender">Awarded Tender</option>
                        <option value="Cancelled Tender">Cancelled Tender</option>
                    </select>
                    <input type="hidden" name="Status" value="@Model.Status" />
                    <span asp-validation-for="Status" class="text-danger"></span>

                </div>

                <div class="form-group full-width">
                    <label asp-for="Title">Tender Title <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Description">Tender Description <span class="text-danger">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label>Scheduled Publish Date & Time</label>
                    <input type="text" class="form-control"
                           value="@(localScheduled.HasValue? localScheduled.Value.ToString("yyyy-MM-dd HH:mm") : "")"
                           readonly />

                </div>

                <!-- Schedule Tender Section -->
                <div class="form-group full-width">
                    <div class="schedule-container">
                        <div class="schedule-toggle" id="scheduleToggle">
                            <input type="checkbox"
                                   id="IsScheduled"
                                   name="IsScheduled"
                                   value="true"
                                   @(Model.IsScheduled ? "checked" : "") />
                            <span class="schedule-toggle-text">Schedule this tender for later publication</span>
                        </div>
                        <div class="schedule-fields @(Model.IsScheduled ? "show" : "")" id="scheduleFields">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="ScheduledDate">Scheduled Date</label>
                                    <input type="date"
                                           id="ScheduledDate"
                                           name="ScheduledDate"
                                           class="form-control"
                                           min="@ViewBag.MinDate"
                                           max="@ViewBag.MaxDate"
                                           value="@(Model.ScheduledDate.HasValue
                                                                                                        ? Model.ScheduledDate.Value.ToString("yyyy-MM-dd")
                                                                                                        : "")" />

                                </div>
                                <div class="form-group">
                                    <label for="ScheduledTime">Scheduled Time</label>
                                    <input type="time"
                                           id="ScheduledTime"
                                           name="ScheduledTime"
                                           class="form-control"
                                           value="@(Model.ScheduledTime.HasValue? Model.ScheduledTime.Value.ToString(@"hh\:mm") : "")" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Upload Documents Section -->
        <div id="documents" class="tab-content">
            <label for="UploadedFiles" class="upload-label">Upload Documents</label>
            <div class="upload-label-underline"></div>

            <div id="uploadedFilesContainer" class="mt-3">
                @if (Model.ExistingDocuments != null && Model.ExistingDocuments.Any())
                {
                    foreach (var doc in Model.ExistingDocuments)
                    {
                        <div class="uploaded-file-entry existing-doc p-2 rounded d-flex justify-content-between align-items-center mb-2 bg-light" data-doc-id="@doc.Id">
                            <div class="uploaded-file-name-container" title="@doc.FileName">
                                <strong class="uploaded-file-name">@doc.FileName</strong>
                            </div>
                            <div class="uploaded-file-actions d-flex gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm view-upload-btn" title="View" onclick="window.open('@doc.SharePointPath', '_blank')">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm remove-upload-btn" title="Delete"
                                        data-doc-id="@doc.Id">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                            <div style="display:none;">
                                <input type="checkbox" name="DocumentsToDelete" value="@doc.Id" id="delete_doc_@doc.Id" />
                            </div>
                        </div>
                    }
                }
            </div>

            <div id="uploadInputGroup" class="d-flex align-items-center gap-2 mt-3">
                <label class="supporting-label mb-0"><i class="fas fa-file-pdf text-danger me-1"></i> Supporting Document</label>
                <label class="btn btn-success btn-sm d-flex align-items-center gap-1 mb-0">
                    <i class="fas fa-upload"></i> Upload
                    <input type="file" id="UploadedFiles" name="UploadedFiles" multiple accept=".pdf" hidden />
                </label>
            </div>
        </div>

    </form>
</div>

<div class="action-buttons">
    <button type="button" class="action-btn cancel-btn" id="cancelBtn">Cancel</button>
    <button type="button" id="continueBtn" class="action-btn continue-btn" onclick="submitForm()">Save Changes <span class="arrow-icon"></span></button>
</div>


<!-- Delete Confirmation Modal (Styled like Cancel Confirmation Modal) -->
<div id="deleteDocModal" style="display:none; position:fixed; z-index:11000; left:0; top:0; width:100vw; height:100vh; background:rgba(0,0,0,0.4); align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:16px; box-shadow:0 6px 20px rgba(0,0,0,0.15); max-width:400px; width:90%; margin:auto; overflow:hidden; border:2px solid #009344;">
        <div style="background:#009344; color:#fff; padding:20px 0 16px 0; text-align:center;">
            <span style="font-size:1.8rem; font-weight:700;">Delete Confirmation</span>
        </div>
        <div style="padding:20px 10px 0 10px; text-align:center;">
            <span style="font-size:1.2rem; color:#444;">Are you sure you want to delete this document?</span>
        </div>
        <div style="display:flex; justify-content:center; gap:20px; margin:28px 0 20px 0;">
            <button id="cancelDeleteDocBtn" style="background:#009344; color:#fff; font-size:1rem; font-weight:500; border:none; border-radius:6px; padding:10px 28px; box-shadow:0 4px 0 0 #007a3d; cursor:pointer;">No</button>
            <button id="confirmDeleteDocBtn" style="background:#e74c3c; color:#fff; font-size:1rem; font-weight:500; border:none; border-radius:6px; padding:10px 28px; box-shadow:0 4px 0 0 #c0392b; cursor:pointer;">Yes, Delete</button>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="modal fade" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0" style="padding-bottom:0;">
                <!-- Tender Number Heading in Green -->
                <h4 id="successModalTenderNumber" style="font-size:1.5rem; font-weight:700; color:#16a34a; margin-bottom:0;"></h4>
            </div>
            <!-- Green Tick -->
            <img src="~/lib/Images/Tick-Box.png" alt="Success" style="width: 64px; height: 64px; margin: 18px auto 0 auto; display: block;" />
            <div class="modal-body" style="padding-top:18px;">
                <!-- Big Green Text -->
                <div style="font-size:1.35rem; font-weight:700; color:#16a34a;">Scheduled Tender Successfully Updated</div>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="successOkBtn" class="btn btn-success" style="min-width:120px;">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Confirmation Modal -->
<div id="cancelConfirmModal" style="display:none; position:fixed; z-index:11000; left:0; top:0; width:100vw; height:100vh; background:rgba(0,0,0,0.4); align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:16px; box-shadow:0 6px 20px rgba(0,0,0,0.15); max-width:400px; width:90%; margin:auto; overflow:hidden; border:2px solid #009344;">
        <div style="background:#009344; color:#fff; padding:20px 0 16px 0; text-align:center;">
            <span style="font-size:1.8rem; font-weight:700;">Cancel Confirmation</span>
        </div>
        <div style="padding:20px 10px 0 10px; text-align:center;">
            <span style="font-size:1.2rem; color:#444;">Are you sure you want to cancel?</span>
        </div>
        <div style="display:flex; justify-content:center; gap:20px; margin:28px 0 20px 0;">
            <button id="cancelCancelBtn" style="background:#009344; color:#fff; font-size:1rem; font-weight:500; border:none; border-radius:6px; padding:10px 28px; box-shadow:0 4px 0 0 #007a3d; cursor:pointer;">No</button>
            <button id="cancelConfirmBtn" style="background:#e74c3c; color:#fff; font-size:1rem; font-weight:500; border:none; border-radius:6px; padding:10px 28px; box-shadow:0 4px 0 0 #c0392b; cursor:pointer;">Yes, Cancel</button>
        </div>
    </div>
</div>

<!-- Caution Cancelled Modal -->
<div id="cancelledCautionModal" style="display:none; position:fixed; z-index:12000; left:0; top:0; width:100vw; height:100vh; background:rgba(0,0,0,0.4); align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:16px; box-shadow:0 6px 20px rgba(0,0,0,0.15); max-width:400px; width:90%; margin:auto; overflow:hidden; text-align:center; padding:32px 24px;">
        <div>
            <svg width="96" height="96" viewBox="0 0 96 96" fill="none" style="margin-bottom:18px;">
                <circle cx="48" cy="48" r="40" stroke="#ffc107" stroke-width="8" />
                <text x="48" y="62" text-anchor="middle" font-size="56" fill="#ffc107" font-family="Arial">&#33;</text>
            </svg>
        </div>
        <div style="font-size:2rem; color:#ffc107; font-weight:600; margin-bottom:12px;">Caution</div>
        <div style="font-size:1.2rem; color:#444; margin-bottom:28px;">The action was cancelled.</div>
        <button id="cancelledCautionOkBtn" style="background:#009344; color:#fff; font-size:1.1rem; font-weight:500; border:none; border-radius:6px; padding:12px 48px; cursor:pointer;">OK</button>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
                document.addEventListener('DOMContentLoaded', function () {
                               // Cancel button opens confirmation modal
        document.getElementById('cancelBtn').addEventListener('click', function (e) {
            e.preventDefault();
            document.getElementById('cancelConfirmModal').style.display = 'flex';
        });
        // "No" closes the modal
        document.getElementById('cancelCancelBtn').addEventListener('click', function () {
            document.getElementById('cancelConfirmModal').style.display = 'none';
        });
        // "Yes, Cancel" shows caution modal
        document.getElementById('cancelConfirmBtn').addEventListener('click', function () {
            document.getElementById('cancelConfirmModal').style.display = 'none';
            document.getElementById('cancelledCautionModal').style.display = 'flex';
        });
        // "OK" on caution modal navigates away
        document.getElementById('cancelledCautionOkBtn').addEventListener('click', function () {
            document.getElementById('cancelledCautionModal').style.display = 'none';
            window.location.href = '/TenderAdmin/Index';
        });
        // Close caution modal when clicking outside
        document.getElementById('cancelledCautionModal').addEventListener('click', function (e) {
            if (e.target === this) {
                this.style.display = 'none';
                window.location.href = '/TenderAdmin/Index';
            }
        });
                      // ---------- Document Delete Modal Logic ----------
                           // ---------- Document Delete Modal Logic ----------
        let docToDeleteEntry = null;
        let docToDeleteCheckbox = null;

        // Attach event listeners to all existing document delete buttons
        document.querySelectorAll('.uploaded-file-entry.existing-doc .remove-upload-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                docToDeleteEntry = btn.closest('.uploaded-file-entry.existing-doc');
                const docId = btn.getAttribute('data-doc-id');
                docToDeleteCheckbox = docToDeleteEntry.querySelector('input[type="checkbox"][name="DocumentsToDelete"]');
                // Show custom confirmation modal
                document.getElementById('deleteDocModal').style.display = 'flex';
            });
        });

        // Confirm delete
        document.getElementById('confirmDeleteDocBtn').addEventListener('click', function() {
            if (docToDeleteCheckbox) {
                docToDeleteCheckbox.checked = true;
            }
            if (docToDeleteEntry) {
                // keep checkbox inside the form but remove the visible doc entry
                const hiddenCheckbox = docToDeleteEntry.querySelector('input[type="checkbox"][name="DocumentsToDelete"]');
                if (hiddenCheckbox) {
                    hiddenCheckbox.style.display = "none"; // keep it invisible
                    docToDeleteEntry.parentNode.insertBefore(hiddenCheckbox, docToDeleteEntry);
                }
                docToDeleteEntry.remove();
            }
            // Hide modal
            document.getElementById('deleteDocModal').style.display = 'none';
            // Reset
            docToDeleteEntry = null;
            docToDeleteCheckbox = null;
        });

        // Cancel delete
        document.getElementById('cancelDeleteDocBtn').addEventListener('click', function() {
            document.getElementById('deleteDocModal').style.display = 'none';
            docToDeleteEntry = null;
            docToDeleteCheckbox = null;
        });

        // Optional: Close modal when clicking outside
        document.getElementById('deleteDocModal').addEventListener('click', function(e) {
            if (e.target === this) {
                this.style.display = 'none';
                docToDeleteEntry = null;
                docToDeleteCheckbox = null;
            }
        });


                    // ---------- Scheduling Logic ----------
                    const checkbox = document.getElementById('IsScheduled');
                    const scheduleFields = document.getElementById('scheduleFields');

                    function updateScheduleVisibility() {
                        scheduleFields.classList.toggle('show', checkbox.checked);
                    }

                    updateScheduleVisibility();
                    checkbox.addEventListener('change', updateScheduleVisibility);

                    // ---------- Tab Logic ----------
                    const tabs = ['details', 'documents'];
                    let currentTab = 'details';

                    window.showTab = function(tabName) {
                        document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
                        document.querySelectorAll('.tab-btn').forEach(tb => tb.classList.remove('active'));
                        document.getElementById(tabName).classList.add('active');
                        document.getElementById('tab' + capitalize(tabName)).classList.add('active');
                        currentTab = tabName;
                    };

                    function capitalize(str) {
                        return str.charAt(0).toUpperCase() + str.slice(1);
                    }

                    // ---------- File Upload Logic ----------
                    const fileInput = document.getElementById("UploadedFiles");
                    const uploadedFilesContainer = document.getElementById("uploadedFilesContainer");
                    const uploadInputGroup = document.getElementById("uploadInputGroup");
                    let selectedFiles = [];

                    if (fileInput) {
                        fileInput.addEventListener("change", function () {
                            const files = Array.from(fileInput.files);
                            files.forEach(file => {
                                if (file.type !== "application/pdf") {
                                    alert(`${file.name} is not a PDF file. Only PDF files are allowed.`);
                                    return;
                                }
                                // Check for duplicate by name+size
                                if (!selectedFiles.find(f => f.name === file.name && f.size === file.size)) {
                                    selectedFiles.push(file);
                                }
                            });

                            updateFilesDisplay();
                            fileInput.value = ""; // Reset input
                        });
                    }

                    function updateFilesDisplay() {
                        // Remove all new uploaded entries (keep existing ones)
                        document.querySelectorAll('.uploaded-file-entry.new-doc').forEach(e => e.remove());

                        selectedFiles.forEach(function (file, index) {
                            const fileRow = document.createElement("div");
                            fileRow.className = "uploaded-file-entry new-doc p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light";

                                    const fileDetails = document.createElement("div");
        fileDetails.className = "uploaded-file-name-container";
        fileDetails.title = file.name;

        const fileName = document.createElement("strong");
        fileName.className = "uploaded-file-name";
        fileName.textContent = file.name;
        fileDetails.appendChild(fileName);

                            const fileMeta = document.createElement("div");
                            fileMeta.className = "text-muted small mt-1";
                            fileMeta.style.fontSize = "0.75rem";
                            const size = formatFileSize(file.size);
                            const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                            fileMeta.textContent = `${size} • Added at ${time}`;

                            fileDetails.appendChild(fileName);
                            fileDetails.appendChild(fileMeta);

                            const actions = document.createElement("div");
                            actions.className = "uploaded-file-actions d-flex gap-2";

                            const viewBtn = document.createElement("button");
                            viewBtn.type = "button";
                            viewBtn.className = "btn btn-outline-primary btn-sm";
                            viewBtn.innerHTML = '<i class="fas fa-eye"></i>';
                            viewBtn.title = "View";
                            viewBtn.addEventListener('click', function () {
                                const fileURL = URL.createObjectURL(file);
                                window.open(fileURL, "_blank");
                            });

                            const deleteBtn = document.createElement("button");
                            deleteBtn.type = "button";
                            deleteBtn.className = "btn btn-outline-danger btn-sm";
                            deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
                            deleteBtn.title = "Remove";
                            deleteBtn.addEventListener('click', function () {
                                selectedFiles.splice(index, 1);
                                updateFilesDisplay();
                            });

                            actions.appendChild(viewBtn);
                            actions.appendChild(deleteBtn);
                            fileRow.appendChild(fileDetails);
                            fileRow.appendChild(actions);
                            uploadedFilesContainer.appendChild(fileRow);
                        });
                    }

                    function formatFileSize(bytes) {
                        if (bytes < 1024) return `${bytes} B`;
                        else if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
                        else return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
                    }

                    // ---------- Validation Utilities ----------
                            function showFieldError(fieldIdOrName, message, tabName) {
                    if (fieldIdOrName === 'UploadedFiles') {
                        // Place error below upload input group
                        let group = document.getElementById('uploadInputGroup');
                        if (group) {
                            let oldError = group.parentNode.querySelector('.validation-custom-error');
                            if (oldError) oldError.remove();

                            let errorSpan = document.createElement('span');
                            errorSpan.className = 'validation-custom-error text-danger';
                            errorSpan.innerText = message;
                            errorSpan.style.fontSize = '0.98rem';
                            errorSpan.style.fontWeight = '500';
                            errorSpan.style.display = 'block';
                            errorSpan.style.marginTop = '8px';
                            group.parentNode.insertBefore(errorSpan, group.nextSibling);
                        }
                        return;
                    }
                    // Default for other fields
                    let field = document.getElementById(fieldIdOrName) || document.querySelector(`[name='${fieldIdOrName}']`);
                    if (field) {
                        let label = null;
                        if (field.id) {
                            label = document.querySelector(`label[for='${field.id}']`);
                        }
                        if (!label) {
                            let formGroup = field.closest('.form-group');
                            if (formGroup) {
                                label = formGroup.querySelector('label');
                            }
                        }

                        if (label) {
                            let oldError = label.parentNode.querySelector('.validation-custom-error');
                            if (oldError) oldError.remove();

                            let errorSpan = document.createElement('span');
                            errorSpan.className = 'validation-custom-error text-danger ms-2';
                            errorSpan.innerText = message;
                            errorSpan.style.fontSize = '0.98rem';
                            errorSpan.style.fontWeight = '500';
                            label.appendChild(errorSpan);
                        }
                        field.classList.add('field-error-highlight');
                    }
                }

                    function clearAllCustomErrors() {
                        document.querySelectorAll('.validation-custom-error').forEach(e => e.remove());
                        document.querySelectorAll('.field-error-highlight').forEach(e => e.classList.remove('field-error-highlight'));
                    }

                    function clearFieldError(e) {
                        let field = e.target;
                        let label = null;
                        if (field.id) {
                            label = document.querySelector(`label[for='${field.id}']`);
                        }
                        if (!label) {
                            let formGroup = field.closest('.form-group');
                            if (formGroup) {
                                label = formGroup.querySelector('label');
                            }
                        }
                        if (label) {
                            let oldError = label.parentNode.querySelector('.validation-custom-error');
                            if (oldError) oldError.remove();
                        }
                        field.classList.remove('field-error-highlight');
                    }

                    // Add event listeners for clearing errors on input
                    document.querySelectorAll('input, textarea, select').forEach(e => {
                        e.addEventListener('input', clearFieldError);
                        e.addEventListener('change', clearFieldError);
                    });

                    // ---------- Form Submission Logic ----------
                    window.submitForm = function() {
                        const saveBtn = document.getElementById('continueBtn');

                        // Prevent multiple submissions
                        if (saveBtn.classList.contains('loading')) {
                            return;
                        }

                        // Add loading state
                        saveBtn.classList.add('loading');
                        saveBtn.innerHTML = 'Saving<span class="loading-dots"></span>';
                        saveBtn.disabled = true;

                        clearAllCustomErrors();

                        // VALIDATION SECTION
                        let errors = [];
                        let errorFields = [];
                        let errorTabs = [];

                        // Required fields validation
                        let tenderType = document.querySelector('input[name="TenderType"]:checked');
                        let tenderNumber = document.querySelector('input[name="TenderNumber"]');
                        let closingDate = document.querySelector('input[name="ClosingDate"]');
                        let closingTime = document.querySelector('input[name="ClosingTime"]');
                        let title = document.querySelector('input[name="Title"]');
                        let description = document.querySelector('textarea[name="Description"]');
                        let status = document.getElementById('StatusDropdown').value;

                        if (!tenderType) {
                            errors.push({field: 'TenderType', message: 'Please select a Tender Type', tab: 'details'});
                            errorFields.push('TenderType'); errorTabs.push('details');
                        }
                        if (!tenderNumber.value.trim()) {
                            errors.push({field: 'TenderNumber', message: 'Tender Number is required', tab: 'details'});
                            errorFields.push('TenderNumber'); errorTabs.push('details');
                        }
                        if (!closingDate.value.trim()) {
                            errors.push({field: 'ClosingDate', message: 'Closing Date is required', tab: 'details'});
                            errorFields.push('ClosingDate'); errorTabs.push('details');
                        }
                        if (!closingTime.value.trim()) {
                            errors.push({field: 'ClosingTime', message: 'Closing Time is required', tab: 'details'});
                            errorFields.push('ClosingTime'); errorTabs.push('details');
                        }
                        if (!title.value.trim()) {
                            errors.push({field: 'Title', message: 'Tender Title is required', tab: 'details'});
                            errorFields.push('Title'); errorTabs.push('details');
                        }
                        if (!description.value.trim()) {
                            errors.push({field: 'Description', message: 'Tender Description is required', tab: 'details'});
                            errorFields.push('Description'); errorTabs.push('details');
                        }
                        if (!status) {
                            errors.push({field: 'StatusDropdown', message: 'Tender Status is required', tab: 'details'});
                            errorFields.push('StatusDropdown'); errorTabs.push('details');
                        }

                        // Scheduling validation
                        const isScheduled = document.getElementById('IsScheduled').checked;
                        if (isScheduled) {
                            const scheduledDate = document.getElementById('ScheduledDate');
                            const scheduledTime = document.getElementById('ScheduledTime');

                            if (!scheduledDate.value.trim()) {
                                errors.push({field: 'ScheduledDate', message: 'Scheduled Date is required when scheduling is enabled', tab: 'details'});
                                errorFields.push('ScheduledDate'); errorTabs.push('details');
                            }
                            if (!scheduledTime.value.trim()) {
                                errors.push({field: 'ScheduledTime', message: 'Scheduled Time is required when scheduling is enabled', tab: 'details'});
                                errorFields.push('ScheduledTime'); errorTabs.push('details');
                            }
                        }

                        // Document validation - count existing (not marked for deletion) + new uploads
                              // Document validation - count existing (not marked for deletion and not hidden) + new uploads
                const existingDocsCount =
                    Array.from(uploadedFilesContainer.querySelectorAll('.uploaded-file-entry.existing-doc'))
                        .filter(div => {
                            // Check if element is visually hidden
                            if (div.style.display === 'none') {
                                return false;
                            }

                            const docId = div.getAttribute('data-doc-id');
                            const delCheckbox = document.querySelector(`input[name="DocumentsToDelete"][value="${docId}"]`);
                            return !(delCheckbox && delCheckbox.checked);
                        }).length
                    + selectedFiles.length;

                        if (existingDocsCount === 0) {
                            errors.push({field: 'UploadedFiles', message: 'You must upload at least one supporting document.', tab: 'documents'});
                            errorFields.push('UploadedFiles'); errorTabs.push('documents');
                        }

                        // Show all errors
                        if (errors.length > 0) {
                            // Remove loading state if validation fails
                            saveBtn.classList.remove('loading');
                            saveBtn.innerHTML = 'Save Changes <span class="arrow-icon"></span>';
                            saveBtn.disabled = false;

                            errors.forEach(function(err) {
                                showFieldError(err.field, err.message, err.tab);
                            });

                            // Switch to first errored tab and focus field
                            showTab(errors[0].tab);
                            let firstField = document.getElementById(errors[0].field) || document.querySelector(`[name='${errors[0].field}']`);
                            if (firstField) {
                                firstField.scrollIntoView({behavior: "smooth", block: "center"});
                                firstField.focus();
                            }
                            return;
                        }

                        // Get form and prepare FormData
                        let form = document.querySelector('form[asp-action="EditScheduled"]') || document.querySelector('form[action*="EditScheduled"]');
                        if (!form) {
                            alert("Form not found!");
                            saveBtn.classList.remove('loading');
                            saveBtn.innerHTML = 'Save Changes <span class="arrow-icon"></span>';
                            saveBtn.disabled = false;
                            return;
                        }

                        let formData = new FormData(form);

                        // Remove any existing files from input (to avoid duplicates)
                        formData.delete('UploadedFiles');

                        // Append all selected files
                        selectedFiles.forEach(function(file) {
                            formData.append('UploadedFiles', file, file.name);
                        });

                        // Submit with authentication-friendly headers
                        fetch(form.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                            }
                        })
                        .then(async response => {
                            const contentType = response.headers.get("content-type");
                       if (contentType && contentType.includes("application/json")) {
            const data = await response.json();
            if (data.success) {
                // Set the green tender number heading
                const tenderNumber = data.tenderNumber || document.querySelector('input[name="TenderNumber"]').value || '';
                document.getElementById('successModalTenderNumber').textContent = tenderNumber;

                // Show success modal
                var successModal = new bootstrap.Modal(document.getElementById('successModal'));
                successModal.show();

                // On OK button click, redirect
                document.getElementById('successOkBtn').onclick = function () {
                    window.location.href = data.redirectUrl || '/TenderAdmin/ScheduledIndex';
                };
            } else {
                alert("Failed to save changes: " + (data.message || "Unknown error"));
            }
        } else if (response.redirected) {
                                // Preserve authentication state on redirect
                                window.location.href = response.url;
                            } else {
                                // Replace content while preserving session
                                response.text().then(html => {
                                    document.body.innerHTML = html;
                                    window.scrollTo(0, 0);
                                });
                            }
                        })
                        .catch(error => {
                            console.error('Submission error:', error);
                            alert("An error occurred while saving changes.");
                        })
                        .finally(() => {
                            // Remove loading state
                            saveBtn.classList.remove('loading');
                            saveBtn.innerHTML = 'Save Changes <span class="arrow-icon"></span>';
                            saveBtn.disabled = false;
                        });
                    };

                    // Initialize tab display
                    showTab(currentTab);



                });
    </script>
}

