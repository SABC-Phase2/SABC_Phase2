                <td><button class="edit-btn"><i class="fas fa-edit"></i> Edit</button></td>
            </tr>
            <tr>
                <td><img src="~/lib/Images/logoblack.png" class="tender-thumbnail" alt="SABC Logo" /></td>
                <td class="tender-title">RFQ/RIS/2023/14 : APPOINTMENT OF A SERVICE PROVIDER TO ASSIST SABC WITH IMPLEMENTATION OF BUSINESS CONTINUITY MANAGEMENT (BCM) AS ONCE OFF PROJECT</td>
                <td class="tender-status">Open Tender</td>
