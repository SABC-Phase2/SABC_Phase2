</div>

@{
    int currentPage = 1;
    int totalPages = 78;
}
<div class="custom-pagination">
    <ul class="pagination-list">
        @if (currentPage > 1)
        {
            <li class="page-item"><span>@(currentPage - 1)</span></li>
        }

        <li class="page-item active"><span data-page="@currentPage">@currentPage</span></li>

        <li class="page-item"><span>@(currentPage + 1)</span></li>
        <li class="page-item dots"><span>....</span></li>
        <li class="page-item"><span>76</span></li>
        <li class="page-item"><span>78</span></li>
        <li class="page-item next"><span>Next</span></li>
    </ul>
</div>