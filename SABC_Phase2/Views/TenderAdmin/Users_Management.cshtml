@section Scripts {
    <script>
        let searchTimeout;
        let selectedAdUser = null;
        let securityData = null;
        let originalFormData = {};
        let tamperCheckInterval = null;
        let tamperDetectionActive = false;
        let currentDeleteUserId = null;
        let currentDeleteUserRole = null;
        let currentReactivateUserId = null;
        let currentReactivateUserRole = null;

        const generatePasswordBtn = document.getElementById("generatePasswordBtn");
        const passwordInput = document.getElementById("password");
        const togglePasswordBtn = document.getElementById("togglePassword");
        const copyPasswordBtn = document.getElementById("copyPasswordBtn");

        // Security functions
        function generateSecurityData(userData) {
            return fetch('@Url.Action("GenerateSecureFormData")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(userData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    securityData = {
                        hash: data.hash,
                        nonce: data.nonce,
                        timestamp: data.timestamp
                    };

                    // Set hidden form fields
                    document.getElementById('dataHash').value = data.hash;
                    document.getElementById('nonce').value = data.nonce;
                    document.getElementById('timestamp').value = data.timestamp;

                    startTamperDetection();
                    return true;
                } else {
                    console.error('Failed to generate security data');
                    return false;
                }
            });
        }

        function startTamperDetection() {
            originalFormData = {
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                email: document.getElementById('email').value,
                azureAdId: document.getElementById('azureAdId').value
            };

            const readOnlyFields = ['firstName', 'lastName', 'email', 'azureAdId'];
            readOnlyFields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                field.readOnly = true;
            });

            tamperDetectionActive = true;
            tamperCheckInterval = setInterval(checkForTampering, 2000);
        }

        function checkForTampering() {
            if (!tamperDetectionActive) return;

            const currentFormData = {
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                email: document.getElementById('email').value,
                azureAdId: document.getElementById('azureAdId').value
            };

            if (JSON.stringify(originalFormData) !== JSON.stringify(currentFormData)) {
                showTamperDetectedModal('FORM_FIELD_MODIFIED', 'Hidden form fields have been modified using developer tools.');
                return;
            }

            const readOnlyFields = ['firstName', 'lastName', 'email', 'azureAdId'];
            for (const fieldId of readOnlyFields) {
                const field = document.getElementById(fieldId);
                if (field && originalFormData[fieldId] && !field.readOnly) {
                    showTamperDetectedModal('READONLY_REMOVED', 'Read-only attributes have been tampered with.');
                    return;
                }
            }

            if (securityData) {
                const currentHash = document.getElementById('dataHash').value;
                const currentNonce = document.getElementById('nonce').value;
                const currentTimestamp = document.getElementById('timestamp').value;

                if (currentHash !== securityData.hash ||
                    currentNonce !== securityData.nonce ||
                    currentTimestamp !== securityData.timestamp.toString()) {
                    showTamperDetectedModal('SECURITY_DATA_MODIFIED', 'Security validation data has been tampered with.');
                    return;
                }
            }
        }

        function showTamperDetectedModal(tamperType, message) {
            tamperDetectionActive = false;
            clearInterval(tamperCheckInterval);

            const modal = document.getElementById('tamperDetectedModal');
            const messageEl = document.getElementById('tamperMessage');
            const timestampEl = document.getElementById('tamperTimestamp');
            const typeEl = document.getElementById('tamperType');

            messageEl.textContent = message;
            timestampEl.textContent = new Date().toLocaleString();
            typeEl.textContent = tamperType;

            modal.style.display = 'flex';

            const submitBtn = document.querySelector('#newUserForm button[type="submit"]');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Form Tampered - Cannot Submit';
                submitBtn.style.background = '#dc3545';
            }
        }

        function generatePassword() {
            const minLength = 8;
            const maxLength = 15;
            const length = Math.floor(Math.random() * (maxLength - minLength + 1)) + minLength;

            const lowers = "abcdefghijklmnopqrstuvwxyz";
            const uppers = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            const numbers = "0123456789";
            const specials = "!@@#$%^&*()_+";
            const allChars = lowers + uppers + numbers + specials;

            let password = [
                lowers[Math.floor(Math.random() * lowers.length)],
                uppers[Math.floor(Math.random() * uppers.length)],
                numbers[Math.floor(Math.random() * numbers.length)],
                specials[Math.floor(Math.random() * specials.length)]
            ];

            while (password.length < length) {
                password.push(allChars[Math.floor(Math.random() * allChars.length)]);
            }

            for (let i = password.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [password[i], password[j]] = [password[j], password[i]];
            }

            return password.join('');
        }

        // Delete user function
        function deleteUser(userId, role) {
            fetch('@Url.Action("DeleteUser")', {
                method: 'POST',
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ id: userId, type: role })
            })
            .then(resp => resp.json())
            .then(data => {
                if(data.success) {
                    showSuccessPopup(data.message || 'User deleted successfully');
                    submitUserForm(true);
                } else {
                    showErrorPopup('Delete failed: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('Delete error:', error);
                showErrorPopup('Delete failed: Network error');
            });
        }

        // Reactivate user function
        function reactivateUser(userId, role) {
