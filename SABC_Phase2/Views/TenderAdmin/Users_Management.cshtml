@model List<SABC_Phase2.Models.Tender.AdminUserRowViewModel>
@{
    ViewData["BannerText"] = "User Management";
    string search = Context.Request.Query["search"];
    string roleFilter = Context.Request.Query["roleFilter"];
    string statusFilter = Context.Request.Query["statusFilter"];
    bool isOvrsUser = ViewBag.IsOVRSUser == true;
}
<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />

<div class="breadcrumb-custom">
    <span class="breadcrumb-active">Home</span>
    <span class="breadcrumb-arrow">&#x2794;</span>
    <span>User Management</span>
</div>

<div class="user-action-bar">
    <form method="get" id="userFilterForm" style="display: flex; align-items: center; gap: 16px;">
        <span class="search-wrapper" style="position: relative; display: flex; align-items: center;">
            <i class="fas fa-search" style="position:absolute; left:12px; color:#ccc; font-size:1rem;"></i>
            <input type="text" name="search" class="search-input"
                   value="@search"
                   placeholder="Search users"
                   autocomplete="off"
                   style="padding-left: 38px;" />
        </span>
        <select name="roleFilter" class="filter-dropdown">
            <option value="Administrator" selected="@(roleFilter == "Administrator" ? "selected" : null)">SABC USER</option>
            <option value="OVRS_User" selected="@(roleFilter == "OVRS_User" ? "selected" : null)">OVRS USER</option>
        </select>
        <button type="submit" class="refresh-btn"
                title="Clear search and filters"
                style="margin-left: 0;">
            <i class="fas fa-sync-alt"></i>
        </button>

        <!-- Button group aligned right -->
        <span style="display: flex; gap: 16px; margin-left: auto;">
            <button type="button" class="big-newuser-btn" title="Add New User">
                <i class="fas fa-user-plus"></i> New User
            </button>
            <button type="button" class="big-delete-btn" title="Delete Selected Users">
                <i class="fas fa-trash-alt"></i> Delete
            </button>
        </span>
    </form>
</div>

<div class="table-container">
    <div class="user-table-card">
        <div style="display: flex; justify-content: space-between; align-items: center;"></div>
        <div class="table-scroll-container">
            <table class="user-table">
                <thead>
                    <tr>
                        <th style="width: 40px;">Selected</th>
                        <th>FULL NAME</th>
                        @if (isOvrsUser)
                        {
                            <th>COMPANY NAME</th>
                        }
                        <th>EMAIL</th>
                        <th>TYPE OF USER</th>
                        <th>STATUS</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" name="selectedUserIds" value="@user.Id" data-role="@user.Role" />
                            </td>
                            <td>@user.FullName</td>
                            @if (isOvrsUser)
                            {
                                <td>@user.CompanyName</td>
                            }
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>@user.Status</td>
                            <td>
                                <div class="action-menu-container">
                                    <button class="action-menu-btn" data-user-id="@user.Id" title="More actions">
                                        <i class="fas fa-ellipsis-h" style="color: #222;"></i>
                                    </button>
                                    <div class="action-dropdown">

                                        @if (user.Status == "Active")
                                        {
                                            <button class="action-dropdown-item delete-user-btn delete-option"
                                                    data-user-id="@user.Id"
                                                    data-role="@user.Role">
                                                <i class="fas fa-trash-alt"></i> Delete User
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="action-dropdown-item reactivate-user-btn"
                                                    data-user-id="@user.Id"
                                                    data-role="@user.Role">
                                                <i class="fas fa-undo"></i> Reactivate User
                                            </button>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- New User Modal -->
<div id="newUserModal" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100vw; height:100vh; background:rgba(0,0,0,0.4); align-items:center; justify-content:center;">
    <div class="modal-content" style="background:#fff; border-radius:8px; padding:32px 24px; min-width:350px; max-width:95vw; margin:auto; position:relative;">
        <span class="close-modal" style="position:absolute; right:18px; top:10px; font-size:2rem; font-weight:bold; color:#333; cursor:pointer;">&times;</span>
        <h2 style="margin-bottom: 24px;">Add New User</h2>
        <form id="newUserForm">
            <!-- 🔒 SECURITY: Hidden field to store Azure AD ID for server validation -->
            <input type="hidden" id="azureAdId" name="azureAdId" value="" />
            <input type="hidden" id="dataHash" name="dataHash" value="" />
            <input type="hidden" id="nonce" name="nonce" value="" />
            <input type="hidden" id="timestamp" name="timestamp" value="" />

            <!-- Search Bar with Dropdown -->
            <div id="searchSection" style="margin-bottom:24px; position: relative;">
                <label for="adUserSearch" style="font-weight:500; margin-bottom:8px; display:block;">Search for Azure AD User</label>
                <input type="text" id="adUserSearch" placeholder="Search Azure AD users..."
                       class="form-control"
                       style="width:100%; padding:10px 12px; border-radius:6px; border:1px solid #ccc;" />
                <div id="searchResults" style="display:none; position:absolute; top:100%; left:0; right:0; background:#fff; border:1px solid #ccc; border-top:none; border-radius:0 0 6px 6px; max-height:200px; overflow-y:auto; z-index:1000;">
                    <!-- Search results will be populated here -->
                </div>
                <div id="searchSpinner" style="display:none; position:absolute; right:12px; top:38px;">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
            </div>

            <!-- 🔒 SECURITY: User Info Display (Completely Read-Only) -->
            <div id="userInfoDisplay" style="display:none; margin-bottom:20px; padding:15px; background:#f8f9fa; border-radius:6px; border:2px solid #28a745;">
                <h4 style="margin:0 0 10px; color:#28a745;">✅ Selected User Information</h4>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
                    <div><strong>First Name:</strong> <span id="displayFirstName">-</span></div>
                    <div><strong>Last Name:</strong> <span id="displayLastName">-</span></div>
                    <div style="grid-column: 1 / -1;"><strong>Email:</strong> <span id="displayEmail">-</span></div>
                </div>
                <button type="button" id="changeUserBtn" style="margin-top:10px; padding:5px 10px; background:#007bff; color:#fff; border:none; border-radius:4px; cursor:pointer;">
                    Change User Selection
                </button>
            </div>

            <!-- 🔒 SECURITY: Hidden inputs that store the validated data -->
            <input type="hidden" id="firstName" name="firstName" value="" />
            <input type="hidden" id="lastName" name="lastName" value="" />
            <input type="hidden" id="email" name="email" value="" />

            <!-- Role Selection (Only user-editable field) -->
            <div id="roleSection" style="display:none; margin-bottom:20px;">
                <label for="role" style="font-weight:500;">User Role</label>
                <select id="role" name="role" class="form-control" style="width:100%;" required>
                    <option value="">Select Role</option>
                    <option value="IT_Admin">IT ADMIN</option>
                    <option value="Tender_Administrator">TENDER ADMIN</option>
                    <option value="Vendor_Administrator">VENDOR ADMIN</option>
                </select>
            </div>

            <!-- Password Generation Field (initially hidden) -->
            <div id="passwordSection" style="display: none;">
                <label for="password" style="font-weight:500;">Generated Password</label>
                <div style="display:flex; align-items:center; gap:8px;">
                    <div style="flex:1; position:relative;">
                        <input id="password" name="password" type="password" class="form-control"
                               style="width:100%; padding:10px 45px 10px 12px; border-radius:6px; border:1px solid #ccc;"
                               readonly />
                        <button type="button" id="togglePassword"
                                style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:#666;"
                                title="Toggle password visibility">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <button type="button" id="generatePasswordBtn" class="btn"
                            style="background:#007bff; color:#fff; border:none; border-radius:6px; padding:10px 16px; white-space:nowrap; font-weight:500;">
                        Generate Password
                    </button>
                    <button type="button" id="copyPasswordBtn" class="btn" title="Copy to clipboard"
                            style="background:#28a745; color:#fff; border:none; border-radius:6px; padding:10px 12px;">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>
            </div>

            <!-- Create Account Button -->
            <div id="submitSection" style="display:none; justify-content:center; margin-top: 24px;">
                <button type="submit" class="btn"
                        style="background:#28a745; color:#fff; font-weight:bold; border:none; border-radius:6px; padding:12px 36px; font-size:1.1rem; cursor:pointer;">
                    Create Account
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Add the tamper detection modal before your existing modals -->
<div id="tamperDetectedModal" style="
    display:none;
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    background:rgba(0,0,0,0.6);
    z-index:10001;
    align-items:center;
    justify-content:center;
">
    <div style="
        background:#fff;
        border-radius:12px;
        padding:40px;
        text-align:center;
        box-shadow:0 8px 20px rgba(0,0,0,0.3);
        max-width:500px;
        width:90%;
        border:3px solid #dc3545;
    ">
        <i class="fas fa-shield-alt" style="color:#dc3545; font-size:4rem; margin-bottom:20px;"></i>
        <h2 style="margin:0 0 15px; color:#dc3545;">🚨 SECURITY ALERT 🚨</h2>
        <h3 style="margin:0 0 15px; color:#333;">Form Tampering Detected!</h3>
        <p id="tamperMessage" style="margin:0 0 20px; color:#666; font-size:1.1rem;">
            The form has been tampered with using developer tools or other methods.
        </p>
        <div style="background:#fff3cd; border:1px solid #ffeaa7; border-radius:6px; padding:15px; margin:20px 0; text-align:left;">
            <strong>⚠️ This incident has been logged for security purposes.</strong><br>
            <span style="font-size:0.9em; color:#856404;">
                Timestamp: <span id="tamperTimestamp"></span><br>
                Type: <span id="tamperType"></span>
            </span>
        </div>
        <button id="closeTamperModal" style="
            background:#dc3545;
            color:#fff;
            border:none;
            border-radius:6px;
            padding:12px 25px;
            font-size:1.1rem;
            cursor:pointer;
            font-weight:bold;
        ">
            Understood - Refresh Form
        </button>
    </div>
</div>

<!-- Error Popup -->
<div id="errorPopup" style="
    display:none;
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    background:rgba(0,0,0,0.4);
    z-index:10000;
    align-items:center;
    justify-content:center;
">
    <div style="
        background:#fff;
        border-radius:12px;
        padding:30px 40px;
        text-align:center;
        box-shadow:0 8px 20px rgba(0,0,0,0.2);
        animation: fadeInScale 0.3s ease;
        max-width:400px;
        width:90%;
    ">
        <i class="fas fa-times-circle" style="color:#dc3545; font-size:3rem; margin-bottom:15px;"></i>
        <h3 style="margin:0 0 10px; color:#333;">Cannot Create User!</h3>
        <p id="errorPopupMsg" style="margin:0 0 20px; color:#666;">The account could not be created.</p>
        <button id="closeErrorPopup" style="
            background:#dc3545;
            color:#fff;
            border:none;
            border-radius:6px;
            padding:10px 20px;
            font-size:1rem;
            cursor:pointer;
        ">
            OK
        </button>
    </div>
</div>

<!-- Success Popup -->
<div id="successPopup" style="
    display:none;
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    background:rgba(0,0,0,0.4);
    z-index:10000;
    align-items:center;
    justify-content:center;
">
    <div style="
        background:#fff;
        border-radius:12px;
        padding:30px 40px;
        text-align:center;
        box-shadow:0 8px 20px rgba(0,0,0,0.2);
        animation: fadeInScale 0.3s ease;
        max-width:400px;
        width:90%;
    ">
        <i class="fas fa-check-circle" style="color:#28a745; font-size:3rem; margin-bottom:15px;"></i>
        <h3 style="margin:0 0 10px; color:#333;">User Created!</h3>
        <p style="margin:0 0 20px; color:#666;">The account was created successfully.</p>
        <button id="closeSuccessPopup" style="
            background:#28a745;
            color:#fff;
            border:none;
            border-radius:6px;
            padding:10px 20px;
            font-size:1rem;
            cursor:pointer;
        ">
            OK
        </button>
    </div>
</div>

@section Scripts {
    <script>
        let searchTimeout;
        let selectedAdUser = null;
        let securityData = null;
        let originalFormData = {};
        let tamperCheckInterval = null;
        let tamperDetectionActive = false; // NEW FLAG

        const generatePasswordBtn = document.getElementById("generatePasswordBtn");
        const passwordInput = document.getElementById("password");
        const togglePasswordBtn = document.getElementById("togglePassword");
        const copyPasswordBtn = document.getElementById("copyPasswordBtn");

        // Security functions
        function generateSecurityData(userData) {
            return fetch('@Url.Action("GenerateSecureFormData")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(userData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    securityData = {
                        hash: data.hash,
                        nonce: data.nonce,
                        timestamp: data.timestamp
                    };

                    // Set hidden form fields
                    document.getElementById('dataHash').value = data.hash;
                    document.getElementById('nonce').value = data.nonce;
                    document.getElementById('timestamp').value = data.timestamp;

                    startTamperDetection();
                    return true;
                } else {
                    console.error('Failed to generate security data');
                    return false;
                }
            });
        }

        function startTamperDetection() {
            // Store the CURRENT state as the baseline (after legitimate user selection)
            originalFormData = {
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                email: document.getElementById('email').value,
                azureAdId: document.getElementById('azureAdId').value
            };

            // Set the hidden fields as readonly to prevent tampering
            const readOnlyFields = ['firstName', 'lastName', 'email', 'azureAdId'];
            readOnlyFields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                field.readOnly = true;
            });

            tamperDetectionActive = true; // Enable detection ONLY after legitimate setup
            tamperCheckInterval = setInterval(checkForTampering, 2000); // Check every 2 seconds
        }

        function checkForTampering() {
            if (!tamperDetectionActive) return; // Don't check during legitimate operations

            const currentFormData = {
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                email: document.getElementById('email').value,
                azureAdId: document.getElementById('azureAdId').value
            };

            // Check if hidden fields have been modified
            if (JSON.stringify(originalFormData) !== JSON.stringify(currentFormData)) {
                showTamperDetectedModal('FORM_FIELD_MODIFIED', 'Hidden form fields have been modified using developer tools.');
                return;
            }

            // Check if readonly attributes have been removed from hidden fields
            const readOnlyFields = ['firstName', 'lastName', 'email', 'azureAdId'];
            for (const fieldId of readOnlyFields) {
                const field = document.getElementById(fieldId);
                if (field && originalFormData[fieldId] && !field.readOnly) {
                    showTamperDetectedModal('READONLY_REMOVED', 'Read-only attributes have been tampered with.');
                    return;
                }
            }

            // Check if security data has been tampered with
            if (securityData) {
                const currentHash = document.getElementById('dataHash').value;
                const currentNonce = document.getElementById('nonce').value;
                const currentTimestamp = document.getElementById('timestamp').value;

                if (currentHash !== securityData.hash ||
                    currentNonce !== securityData.nonce ||
                    currentTimestamp !== securityData.timestamp.toString()) {
                    showTamperDetectedModal('SECURITY_DATA_MODIFIED', 'Security validation data has been tampered with.');
                    return;
                }
            }
        }

        function showTamperDetectedModal(tamperType, message) {
            tamperDetectionActive = false; // Stop checking
            clearInterval(tamperCheckInterval);

            const modal = document.getElementById('tamperDetectedModal');
            const messageEl = document.getElementById('tamperMessage');
            const timestampEl = document.getElementById('tamperTimestamp');
            const typeEl = document.getElementById('tamperType');

            messageEl.textContent = message;
            timestampEl.textContent = new Date().toLocaleString();
            typeEl.textContent = tamperType;

            modal.style.display = 'flex';

            console.warn('🚨 TAMPERING DETECTED:', {
                type: tamperType,
                message: message,
                timestamp: new Date().toISOString(),
                originalData: originalFormData,
                currentData: {
                    firstName: document.getElementById('firstName').value,
                    lastName: document.getElementById('lastName').value,
                    email: document.getElementById('email').value,
                    azureAdId: document.getElementById('azureAdId').value
                }
            });

            const submitBtn = document.querySelector('#newUserForm button[type="submit"]');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Form Tampered - Cannot Submit';
                submitBtn.style.background = '#dc3545';
            }
        }

        function generatePassword() {
            const minLength = 8;
            const maxLength = 15;
            const length = Math.floor(Math.random() * (maxLength - minLength + 1)) + minLength;

            const lowers = "abcdefghijklmnopqrstuvwxyz";
            const uppers = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            const numbers = "0123456789";
            const specials = "!@@#$%^&*()_+";
            const allChars = lowers + uppers + numbers + specials;

            let password = [
                lowers[Math.floor(Math.random() * lowers.length)],
                uppers[Math.floor(Math.random() * uppers.length)],
                numbers[Math.floor(Math.random() * numbers.length)],
                specials[Math.floor(Math.random() * specials.length)]
            ];

            while (password.length < length) {
                password.push(allChars[Math.floor(Math.random() * allChars.length)]);
            }

            for (let i = password.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [password[i], password[j]] = [password[j], password[i]];
            }

            return password.join('');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const newUserBtn = document.querySelector('.big-newuser-btn');
            const modal = document.getElementById('newUserModal');
            const closeModal = modal.querySelector('.close-modal');
            const newUserForm = document.getElementById('newUserForm');
            const adUserSearch = document.getElementById('adUserSearch');
            const searchResults = document.getElementById('searchResults');
            const searchSpinner = document.getElementById('searchSpinner');

            // Tamper detection modal handler
            document.getElementById('closeTamperModal').addEventListener('click', function() {
                document.getElementById('tamperDetectedModal').style.display = 'none';
                modal.style.display = 'none';
                resetForm();
                location.reload();
            });

            // Show modal
            newUserBtn.addEventListener('click', function () {
                modal.style.display = 'flex';
                resetForm();
            });

            // Close modal on X
            closeModal.addEventListener('click', function () {
                modal.style.display = 'none';
                resetForm();
            });

            // Close modal when clicking outside
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    modal.style.display = 'none';
                    resetForm();
                }
            });

            // Change user selection button
            document.getElementById('changeUserBtn').addEventListener('click', function() {
                showSearchSection();
                clearUserFields();
            });

            // Azure AD User Search
            adUserSearch.addEventListener('input', function(e) {
                const searchTerm = e.target.value.trim();
                clearTimeout(searchTimeout);

                if (searchTerm.length < 3) {
                    hideSearchResults();
                    return;
                }

                searchSpinner.style.display = 'block';
                searchTimeout = setTimeout(function() {
                    searchAzureAdUsers(searchTerm);
                }, 500);
            });

            // Hide search results when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('#adUserSearch') && !e.target.closest('#searchResults')) {
                    hideSearchResults();
                }
            });


        function isFormTampered() {
            if (!tamperDetectionActive || !originalFormData || !securityData) {
                return null; // Can't validate if not properly initialized
            }

            // Check if any required data is missing
            if (!document.getElementById('firstName').value ||
                !document.getElementById('lastName').value ||
                !document.getElementById('email').value) {
                return {
                    type: 'MISSING_DATA',
                    message: 'Required form data is missing.'
                };
            }

            // Compare hidden field values to their original values
            const currentFormData = {
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                email: document.getElementById('email').value,
                azureAdId: document.getElementById('azureAdId').value
            };

            if (JSON.stringify(originalFormData) !== JSON.stringify(currentFormData)) {
                console.error('Field tampering detected:', {
                    original: originalFormData,
                    current: currentFormData
                });
                return {
                    type: 'FORM_FIELD_MODIFIED',
                    message: 'Form data has been tampered with using developer tools.'
                };
            }

            // Check readonly attributes
            const readOnlyFields = ['firstName', 'lastName', 'email', 'azureAdId'];
            for (const fieldId of readOnlyFields) {
                const field = document.getElementById(fieldId);
                if (field && originalFormData[fieldId] && !field.readOnly) {
                    return {
                        type: 'READONLY_REMOVED',
                        message: 'Form security attributes have been tampered with.'
                    };
                }
            }

            // Check security data integrity
            const currentHash = document.getElementById('dataHash').value;
            const currentNonce = document.getElementById('nonce').value;
            const currentTimestamp = document.getElementById('timestamp').value;

            if (currentHash !== securityData.hash ||
                currentNonce !== securityData.nonce ||
                currentTimestamp !== securityData.timestamp.toString()) {
                return {
                    type: 'SECURITY_DATA_MODIFIED',
                    message: 'Security validation data has been compromised.'
                };
            }

            return null; // No tampering detected
        }




                    // Enhanced form submit handler
        newUserForm.addEventListener('submit', function(e) {
            e.preventDefault(); // Always prevent default first

            // CRITICAL: Run tamper check immediately before submit
            const tamperResult = isFormTampered();
            if (tamperResult) {
                console.error('🚨 TAMPERING DETECTED ON SUBMIT:', tamperResult);
                showTamperDetectedModal(tamperResult.type, tamperResult.message);
                return false; // Explicitly stop execution
            }

            // Additional validation checks
            if (!selectedAdUser) {
                showErrorPopup('Please search and select a user from Azure AD first.');
                return false;
            }

            if (!securityData) {
                showErrorPopup('Security validation failed. Please select a user again.');
                return false;
            }

            const password = document.getElementById('password').value;
            if (!password) {
                showErrorPopup('Please generate a password first.');
                return false;
            }

            const role = document.getElementById('role').value;
            if (!role) {
                showErrorPopup('Please select a role.');
                return false;
            }

            // Proceed with form submission only if all checks pass
            submitFormData();
        });

        // Separate function for actual form submission
        function submitFormData() {
            const formData = {
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                email: document.getElementById('email').value,
                role: document.getElementById('role').value,
                password: document.getElementById('password').value,
                azureAdId: selectedAdUser.Id || selectedAdUser.id,
                dataHash: securityData.hash,
                nonce: securityData.nonce,
                timestamp: securityData.timestamp
            };

            const submitBtn = newUserForm.querySelector('button[type="submit"]');
            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Creating Account...';

            fetch('@Url.Action("CreateUser")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    modal.style.display = 'none';
                    resetForm();
                    showSuccessPopup();
                    resetUserFilters();
                    submitUserForm(true);
                } else if (data.tampered) {
                    // Server detected tampering
                    showTamperDetectedModal(data.tamperType, data.message);
                } else {
                    showErrorPopup(data.message || 'Unknown error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showErrorPopup('Network error occurred. Please try again.');
            })
            .finally(() => {
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
            });
        }

            // Password functions
            generatePasswordBtn.addEventListener("click", function () {
                passwordInput.value = generatePassword();
            });

            togglePasswordBtn.addEventListener("click", function () {
                const icon = this.querySelector("i");
                if (passwordInput.type === "password") {
                    passwordInput.type = "text";
                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");
                } else {
                    passwordInput.type = "password";
                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");
                }
            });

            copyPasswordBtn.addEventListener("click", function () {
                if (!passwordInput.value) {
                    alert("No password to copy!");
                    return;
                }

                navigator.clipboard.writeText(passwordInput.value).then(() => {
                    copyPasswordBtn.innerHTML = '<i class="fas fa-check"></i>';
                    setTimeout(() => {
                        copyPasswordBtn.innerHTML = '<i class="fas fa-copy"></i>';
                    }, 1500);
                }).catch(err => {
                    console.error("Clipboard error:", err);
                    alert("Failed to copy password.");
                });
            });

            // Initialize existing handlers
            document.querySelector('.search-input').addEventListener('input', debouncedUserSubmit);
            document.querySelectorAll('.filter-dropdown').forEach(function(dd) {
                dd.addEventListener('change', () => submitUserForm(false));
            });
            document.querySelector('.refresh-btn').addEventListener('click', function(e) {
                e.preventDefault();
                submitUserForm(true);
            });

            document.addEventListener('click', function(e) {
                if (!e.target.closest('.action-menu-container')) {
                    closeAllDropdowns();
                }
            });

            hookDeleteBtns();
            initActionMenus();
        });

        // Show/hide sections
        function showSearchSection() {
            document.getElementById('searchSection').style.display = 'block';
            document.getElementById('userInfoDisplay').style.display = 'none';
            document.getElementById('roleSection').style.display = 'none';
            document.getElementById('passwordSection').style.display = 'none';
            document.getElementById('submitSection').style.display = 'none';
        }

        function showUserInfoSection() {
            document.getElementById('searchSection').style.display = 'none';
            document.getElementById('userInfoDisplay').style.display = 'block';
            document.getElementById('roleSection').style.display = 'block';
            document.getElementById('passwordSection').style.display = 'block';
            document.getElementById('submitSection').style.display = 'flex';
        }

        function showSuccessPopup() {
            const successPopup = document.getElementById('successPopup');
            const closeBtn = document.getElementById('closeSuccessPopup');

            successPopup.style.display = 'flex';

            closeBtn.onclick = function() {
                successPopup.style.display = 'none';
                resetUserFilters();
                submitUserForm(true);
            };

            successPopup.onclick = function(e) {
                if (e.target === successPopup) {
                    successPopup.style.display = 'none';
                    resetUserFilters();
                    submitUserForm(true);
                }
            };
        }

        function showErrorPopup(message) {
            const errorPopup = document.getElementById('errorPopup');
            const errorMsg = document.getElementById('errorPopupMsg');
            const closeBtn = document.getElementById('closeErrorPopup');
            errorMsg.textContent = message || "The account could not be created.";

            errorPopup.style.display = 'flex';

            closeBtn.onclick = function() {
                errorPopup.style.display = 'none';
            };

            errorPopup.onclick = function(e) {
                if (e.target === errorPopup) {
                    errorPopup.style.display = 'none';
                }
            };
        }

        function resetUserFilters() {
            document.querySelector('.search-input').value = '';
            document.querySelector('select[name="roleFilter"]').value = 'Administrator';
            document.querySelector('select[name="statusFilter"]').value = 'all';
        }

        function searchAzureAdUsers(searchTerm) {
            fetch('@Url.Action("SearchAzureAdUsers")' + '?searchTerm=' + encodeURIComponent(searchTerm))
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    searchSpinner.style.display = 'none';

                    if (data.success && data.users && data.users.length > 0) {
                        displaySearchResults(data.users);
                    } else {
                        displayNoResults(data.message || 'No users found');
                    }
                })
                .catch(error => {
                    searchSpinner.style.display = 'none';
                    console.error('Error searching AD users:', error);
                    displayNoResults('Error searching users. Please try again.');
                });
        }

        function displaySearchResults(users) {
            let resultsHtml = '';

            users.forEach(user => {
                const displayName = user.DisplayName || user.displayName || 'Unknown User';
                const email = user.Email || user.email || user.Mail || user.mail || 'No email available';

                resultsHtml += `
                    <div class="search-result-item" data-user='${JSON.stringify(user)}'
                         style="padding:10px; cursor:pointer; border-bottom:1px solid #eee;">
                        <div style="font-weight:bold;">${displayName}</div>
                        <div style="font-size:0.9em; color:#666;">${email}</div>
                    </div>
                `;
            });

            searchResults.innerHTML = resultsHtml;
            searchResults.style.display = 'block';

            document.querySelectorAll('.search-result-item').forEach(item => {
                item.addEventListener('click', function() {
                    const userData = JSON.parse(this.getAttribute('data-user'));
                    selectUser(userData);
                });

                item.addEventListener('mouseenter', function() {
                    this.style.backgroundColor = '#f5f5f5';
                });

                item.addEventListener('mouseleave', function() {
                    this.style.backgroundColor = 'white';
                });
            });
        }

        function displayNoResults(message) {
            searchResults.innerHTML = `
                <div style="padding:10px; color:#666; text-align:center;">
                    ${message}
                </div>
            `;
            searchResults.style.display = 'block';
        }

        function hideSearchResults() {
            searchResults.style.display = 'none';
            searchSpinner.style.display = 'none';
        }

        function selectUser(user) {
            tamperDetectionActive = false; // Disable detection during legitimate user selection

            selectedAdUser = user;

            const displayName = user.DisplayName || user.displayName || 'Unknown User';
            const firstName = user.FirstName || user.firstName || user.GivenName || user.givenName || '';
            const lastName = user.LastName || user.lastName || user.Surname || user.surname || '';
            const email = user.Email || user.email || user.Mail || user.mail || '';

            // Update display fields
            document.getElementById('displayFirstName').textContent = firstName;
            document.getElementById('displayLastName').textContent = lastName;
            document.getElementById('displayEmail').textContent = email;

            // Populate hidden form fields
            document.getElementById('firstName').value = firstName;
            document.getElementById('lastName').value = lastName;
            document.getElementById('email').value = email;
            document.getElementById('azureAdId').value = user.Id || user.id || '';

            hideSearchResults();

            // Generate security data
            const userData = {
                Id: user.Id || user.id,
                FirstName: firstName,
                LastName: lastName,
                Email: email,
                DisplayName: displayName
            };

            generateSecurityData(userData).then(success => {
                if (success) {
                    showUserInfoSection();
                } else {
                    alert('Security initialization failed. Please try selecting the user again.');
                }
            });
        }

        function clearUserFields() {
            tamperDetectionActive = false; // Disable detection during clearing
            selectedAdUser = null;
            securityData = null;

            if (tamperCheckInterval) {
                clearInterval(tamperCheckInterval);
                tamperCheckInterval = null;
            }

            const fields = ['firstName', 'lastName', 'email', 'azureAdId', 'dataHash', 'nonce', 'timestamp'];
            fields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                field.value = '';
                field.readOnly = false; // Remove readonly during clearing
            });

            document.getElementById('displayFirstName').textContent = '-';
            document.getElementById('displayLastName').textContent = '-';
            document.getElementById('displayEmail').textContent = '-';

            document.getElementById('adUserSearch').value = '';
            document.getElementById('role').value = '';
            document.getElementById('password').value = '';
        }

        function resetForm() {
            tamperDetectionActive = false; // Disable detection during reset

            if (tamperCheckInterval) {
                clearInterval(tamperCheckInterval);
                tamperCheckInterval = null;
            }

            securityData = null;
            originalFormData = {};

            newUserForm.reset();
            clearUserFields();
            hideSearchResults();
            showSearchSection();

            const submitBtn = document.querySelector('#newUserForm button[type="submit"]');
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Create Account';
                submitBtn.style.background = '#28a745';
            }
        }

        // Keep all your existing functions below...
        document.querySelector('.big-delete-btn').addEventListener('click', function (e) {
            e.preventDefault();

            const selected = Array.from(document.querySelectorAll('input[name="selectedUserIds"]:checked'))
                .map(cb => ({
                    id: parseInt(cb.value),
                    type: cb.getAttribute('data-role')
                }));

            if (selected.length === 0) {
                alert("Please select at least one user to delete.");
                return;
            }

            if (!confirm("Are you sure you want to delete the selected users?")) {
                return;
            }

            fetch('@Url.Action("BulkDeleteUsers")', {
                method: 'POST',
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(selected)
            })
            .then(resp => resp.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    submitUserForm(true);
                } else {
                    alert("Delete failed: " + (data.message || "Unknown error"));
                }
            });
        });

        function debounce(fn, delay) {
            let timer = null;
            return function(...args) {
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(this, args), delay);
            };
        }

        function submitUserForm(keepPage = false) {
            const form = document.getElementById('userFilterForm');
            if(!keepPage) {
                let pageInput = document.createElement('input');
                pageInput.type = "hidden";
                pageInput.name = "page";
                pageInput.value = "1";
                form.appendChild(pageInput);
            }
            const data = new URLSearchParams(new FormData(form)).toString() + "&_=" + new Date().getTime();
            fetch('@Url.Action("Users_Management")' + '?' + data, {
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
            .then(resp => resp.text())
            .then(html => {
                document.querySelector('.table-container').innerHTML = html;
                hookDeleteBtns();
                hookReactivateBtns();
                initActionMenus();
            });
        }

        const debouncedUserSubmit = debounce(() => submitUserForm(false), 300);

        function hookDeleteBtns() {
            document.querySelectorAll('.delete-user-btn').forEach(function(btn) {
                btn.onclick = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const userId = parseInt(btn.getAttribute('data-user-id'));
                    const role = btn.getAttribute('data-role');
                    if(confirm('Are you sure you want to delete this user?')) {
                        fetch('@Url.Action("DeleteUser")', {
                            method: 'POST',
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                            },
                            body: JSON.stringify({ id: userId, type: role })
                        })
                        .then(resp => resp.json())
                        .then(data => {
                            if(data.success) {
                                alert(data.message);
                                submitUserForm(true);
                            } else {
                                alert('Delete failed: ' + (data.message || 'Unknown error'));
                            }
                        });
                    }
                    closeAllDropdowns();
                };
            });
        }

        function hookReactivateBtns() {
            document.querySelectorAll('.reactivate-user-btn').forEach(function(btn) {
                btn.onclick = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const userId = parseInt(btn.getAttribute('data-user-id'));
                    const role = btn.getAttribute('data-role');
                    if(confirm('Are you sure you want to reactivate this user?')) {
                        fetch('@Url.Action("ReactivateUser")', {
                            method: 'POST',
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                            },
                            body: JSON.stringify({ id: userId, type: role })
                        })
                        .then(resp => resp.json())
                        .then(data => {
                            if(data.success) {
                                alert(data.message);
                                submitUserForm(true);
                            } else {
                                alert('Reactivation failed: ' + (data.message || 'Unknown error'));
                            }
                        });
                    }
                    closeAllDropdowns();
                };
            });
        }

        function initActionMenus() {
            document.querySelectorAll('.action-menu-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const dropdown = btn.nextElementSibling;
                    const isActive = btn.classList.contains('active');
                    closeAllDropdowns();
                    if (!isActive) {
                        btn.classList.add('active');
                        dropdown.classList.add('show');
                    }
                });
            });

            document.querySelectorAll('.view-user-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const userId = btn.getAttribute('data-user-id');
                    console.log('View user:', userId);
                    alert('View user functionality - User ID: ' + userId);
                    closeAllDropdowns();
                });
            });
        }

        function closeAllDropdowns() {
            document.querySelectorAll('.action-menu-btn').forEach(function(btn) {
                btn.classList.remove('active');
                btn.nextElementSibling.classList.remove('show');
            });
        }
    </script>
}


