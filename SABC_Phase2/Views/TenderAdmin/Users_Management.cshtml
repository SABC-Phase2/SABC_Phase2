@model List<SABC_Phase2.Models.Tender.AdminUserRowViewModel>
@{
    ViewData["BannerText"] = "User Management";
    string search = Context.Request.Query["search"];
    string roleFilter = Context.Request.Query["roleFilter"];
    string statusFilter = Context.Request.Query["statusFilter"];
    bool isOvrsUser = ViewBag.IsOVRSUser == true;
}
<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />

<div class="breadcrumb-custom">
    <span class="breadcrumb-active">Home</span>
    <span class="breadcrumb-arrow">&#x2794;</span>
    <span>User Management</span>
</div>

<div class="user-action-bar">
    <form method="get" id="userFilterForm" style="display: flex; align-items: center; gap: 16px;">
        <span class="search-wrapper" style="position: relative; display: flex; align-items: center;">
            <i class="fas fa-search" style="position:absolute; left:12px; color:#ccc; font-size:1rem;"></i>
            <input type="text" name="search" class="search-input"
                   value="@search"
                   placeholder="Search users"
                   autocomplete="off"
                   style="padding-left: 38px;" />
        </span>
        <select name="roleFilter" class="filter-dropdown">
            <option value="Administrator" selected="@(roleFilter == "Administrator" ? "selected" : null)">Administrator</option>
            <option value="OVRS_User" selected="@(roleFilter == "OVRS_User" ? "selected" : null)">OVRS User</option>
        </select>
        <button type="submit" class="refresh-btn"
                title="Clear search and filters"
                style="margin-left: 0;">
            <i class="fas fa-sync-alt"></i>
        </button>

        <!-- Button group aligned right -->
        <span style="display: flex; gap: 16px; margin-left: auto;">
            <button type="button" class="big-newuser-btn" title="Add New User">
                <i class="fas fa-user-plus"></i> New User
            </button>
            <button type="button" class="big-delete-btn" title="Delete Selected Users">
                <i class="fas fa-trash-alt"></i> Delete
            </button>
        </span>
    </form>
</div>

<div class="table-container">
    <div class="user-table-card">
        <div style="display: flex; justify-content: space-between; align-items: center;"></div>
        <div class="table-scroll-container">
            <table class="user-table">
                <thead>
                    <tr>
                        <th style="width: 40px;">Selected</th>
                        <th>FULL NAME</th>
                        @if (isOvrsUser)
                        {
                            <th>COMPANY NAME</th>
                        }
                        <th>EMAIL</th>
                        <th>TYPE OF USER</th>
                        <th>STATUS</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" name="selectedUserIds" value="@user.Id" data-role="@user.Role" />
                            </td>
                            <td>@user.FullName</td>
                            @if (isOvrsUser)
                            {
                                <td>@user.CompanyName</td>
                            }
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>@user.Status</td>
                            <td>
                                <div class="action-menu-container">
                                    <button class="action-menu-btn" data-user-id="@user.Id" title="More actions">
                                        <i class="fas fa-ellipsis-h" style="color: #222;"></i>
                                    </button>
                                    <div class="action-dropdown">

                                        @if (user.Status == "Active")
                                        {
                                            <button class="action-dropdown-item delete-user-btn delete-option"
                                                    data-user-id="@user.Id"
                                                    data-role="@user.Role">
                                                <i class="fas fa-trash-alt"></i> Delete User
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="action-dropdown-item reactivate-user-btn"
                                                    data-user-id="@user.Id"
                                                    data-role="@user.Role">
                                                <i class="fas fa-undo"></i> Reactivate User
                                            </button>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- New User Modal -->
<div id="newUserModal" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100vw; height:100vh; background:rgba(0,0,0,0.4); align-items:center; justify-content:center;">
    <div class="modal-content" style="background:#fff; border-radius:8px; padding:32px 24px; min-width:350px; max-width:95vw; margin:auto; position:relative;">
        <span class="close-modal" style="position:absolute; right:18px; top:10px; font-size:2rem; font-weight:bold; color:#333; cursor:pointer;">&times;</span>
        <h2 style="margin-bottom: 24px;">Add New User</h2>
        <form id="newUserForm">
            <!-- Search Bar with Dropdown -->
            <div style="margin-bottom:24px; position: relative;">
                <input type="text" id="adUserSearch" placeholder="Search Azure AD users..."
                       class="form-control"
                       style="width:100%; padding:10px 12px; border-radius:6px; border:1px solid #ccc;" />
                <div id="searchResults" style="display:none; position:absolute; top:100%; left:0; right:0; background:#fff; border:1px solid #ccc; border-top:none; border-radius:0 0 6px 6px; max-height:200px; overflow-y:auto; z-index:1000;">
                    <!-- Search results will be populated here -->
                </div>
                <div id="searchSpinner" style="display:none; position:absolute; right:12px; top:12px;">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
            </div>

            <!-- First Name & Last Name -->
            <div style="display:flex; gap:16px; margin-bottom:20px;">
                <div style="flex:1;">
                    <label for="firstName" style="font-weight:500;">First Name</label>
                    <input id="firstName" name="firstName" type="text" class="form-control"
                           style="width:100%;" required readonly />
                </div>
                <div style="flex:1;">
                    <label for="lastName" style="font-weight:500;">Last Name</label>
                    <input id="lastName" name="lastName" type="text" class="form-control"
                           style="width:100%;" required readonly />
                </div>
            </div>

            <!-- Email & Role -->
            <div style="display:flex; gap:16px; margin-bottom:20px;">
                <div style="flex:1;">
                    <label for="email" style="font-weight:500;">Email Address</label>
                    <input id="email" name="email" type="email" class="form-control"
                           style="width:100%;" required readonly />
                </div>
               <div style="flex:1;">
    <label for="role" style="font-weight:500;">User Role</label>
    <select id="role" name="role" class="form-control" style="width:100%;" required>
        <option value="">Select Role</option>
        <option value="IT_Admin">IT ADMIN</option>
        <option value="Tender_Administrator">TENDER ADMIN</option>
        <option value="Vendor_Administrator">VENDOR ADMIN</option>
    </select>
</div>
            </div>

            <!-- Password Generation Field (initially hidden) -->
            <div id="passwordSection" style="display: none;">
                <label for="password" style="font-weight:500;">Generated Password</label>
                <div style="display:flex; align-items:center; gap:8px;">
                    <div style="flex:1; position:relative;">
                        <input id="password" name="password" type="password" class="form-control"
                               style="width:100%; padding:10px 45px 10px 12px; border-radius:6px; border:1px solid #ccc;"
                               readonly />
                        <button type="button" id="togglePassword"
                                style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:#666;"
                                title="Toggle password visibility">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <button type="button" id="generatePasswordBtn" class="btn"
                            style="background:#007bff; color:#fff; border:none; border-radius:6px; padding:10px 16px; white-space:nowrap; font-weight:500;">
                        Generate Password
                    </button>
                    <button type="button" id="copyPasswordBtn" class="btn" title="Copy to clipboard"
                            style="background:#28a745; color:#fff; border:none; border-radius:6px; padding:10px 12px;">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>
            </div>

            <!-- Create Account Button -->
            <div style="display:flex; justify-content:center; margin-top: 24px;">
                <button type="submit" class="btn"
                        style="background:#28a745; color:#fff; font-weight:bold; border:none; border-radius:6px; padding:12px 36px; font-size:1.1rem; cursor:pointer;">
                    Create Account
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>

        let searchTimeout;
        let selectedAdUser = null;
                const generatePasswordBtn = document.getElementById("generatePasswordBtn");
        const passwordInput = document.getElementById("password");
        const togglePasswordBtn = document.getElementById("togglePassword");
        const copyPasswordBtn = document.getElementById("copyPasswordBtn");


         function generatePassword() {
        const minLength = 8;
        const maxLength = 15;

        // Randomly pick length between min and max
        const length = Math.floor(Math.random() * (maxLength - minLength + 1)) + minLength;

        const lowers = "abcdefghijklmnopqrstuvwxyz";
        const uppers = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const numbers = "0123456789";
        const specials = "!@@#$%^&*()_+";
        const allChars = lowers + uppers + numbers + specials;

        // Ensure at least one of each
        let password = [
            lowers[Math.floor(Math.random() * lowers.length)],
            uppers[Math.floor(Math.random() * uppers.length)],
            numbers[Math.floor(Math.random() * numbers.length)],
            specials[Math.floor(Math.random() * specials.length)]
        ];

        // Fill the rest randomly
        while (password.length < length) {
            password.push(allChars[Math.floor(Math.random() * allChars.length)]);
        }

        // Shuffle so it’s not predictable
        for (let i = password.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [password[i], password[j]] = [password[j], password[i]];
        }

        return password.join('');
    }

        document.addEventListener('DOMContentLoaded', function () {
            // Modal elements
            const newUserBtn = document.querySelector('.big-newuser-btn');
            const modal = document.getElementById('newUserModal');
            const closeModal = modal.querySelector('.close-modal');
            const newUserForm = document.getElementById('newUserForm');
            const adUserSearch = document.getElementById('adUserSearch');
            const searchResults = document.getElementById('searchResults');
            const searchSpinner = document.getElementById('searchSpinner');

            // Show modal
            newUserBtn.addEventListener('click', function () {
                modal.style.display = 'flex';
                resetForm();
            });

            // Close modal on X
            closeModal.addEventListener('click', function () {
                modal.style.display = 'none';
                resetForm();
            });

            // Close modal when clicking outside modal-content
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    modal.style.display = 'none';
                    resetForm();
                }
            });

            // Azure AD User Search
            adUserSearch.addEventListener('input', function(e) {
                const searchTerm = e.target.value.trim();

                clearTimeout(searchTimeout);

                if (searchTerm.length < 3) {
                    hideSearchResults();
                    clearUserFields();
                    return;
                }

                searchSpinner.style.display = 'block';

                searchTimeout = setTimeout(function() {
                    searchAzureAdUsers(searchTerm);
                }, 500);
            });

            // Hide search results when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('#adUserSearch') && !e.target.closest('#searchResults')) {
                    hideSearchResults();
                }
            });

                // Form submit handler - REPLACE the existing one
        newUserForm.addEventListener('submit', function(e) {
            e.preventDefault();

            if (!selectedAdUser) {
                alert('Please search and select a user from Azure AD first.');
                return;
            }

            const password = document.getElementById('password').value;
            if (!password) {
                alert('Please generate a password first.');
                return;
            }

            const role = document.getElementById('role').value;
            if (!role) {
                alert('Please select a role.');
                return;
            }

            // Prepare form data - role is already in the correct format from the dropdown
            const formData = {
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                email: document.getElementById('email').value,
                role: role, // This will be the database-ready format (IT_Admin, Tender_Administrator, etc.)
                password: password,
                azureAdId: selectedAdUser.Id || selectedAdUser.id
            };

            // Disable submit button to prevent double submission
            const submitBtn = newUserForm.querySelector('button[type="submit"]');
            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Creating Account...';

            // Submit to server
            fetch('@Url.Action("CreateUser")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('User account created successfully!\n\nPlease provide the user with their login credentials:\nEmail: ' + formData.email + '\nPassword: ' + formData.password);
                    modal.style.display = 'none';
                    resetForm();
                    // Refresh the users table
                    submitUserForm(true);
                } else {
                    alert('Error creating user: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while creating the user account. Please try again.');
            })
            .finally(() => {
                // Re-enable submit button
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
            });
        });

        // Enhanced search function with better error handling
        function searchAzureAdUsers(searchTerm) {
            fetch('@Url.Action("SearchAzureAdUsers")' + '?searchTerm=' + encodeURIComponent(searchTerm))
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    searchSpinner.style.display = 'none';

                    console.log('Search response:', data); // Debug logging

                    if (data.success && data.users && data.users.length > 0) {
                        displaySearchResults(data.users);
                    } else {
                        displayNoResults(data.message || 'No users found');
                    }
                })
                .catch(error => {
                    searchSpinner.style.display = 'none';
                    console.error('Error searching AD users:', error);
                    displayNoResults('Error searching users. Please try again.');
                });
        }
        // Display search results with better null checking and case handling
        function displaySearchResults(users) {
            let resultsHtml = '';

            users.forEach(user => {
                // Handle different possible casings from the server response
                const displayName = user.DisplayName || user.displayName || 'Unknown User';
                const email = user.Email || user.email || user.Mail || user.mail || 'No email available';

                console.log('Processing user:', user); // Debug log to see actual structure

                resultsHtml += `
                    <div class="search-result-item" data-user='${JSON.stringify(user)}'
                         style="padding:10px; cursor:pointer; border-bottom:1px solid #eee;">
                        <div style="font-weight:bold;">${displayName}</div>
                        <div style="font-size:0.9em; color:#666;">${email}</div>
                    </div>
                `;
            });

            searchResults.innerHTML = resultsHtml;
            searchResults.style.display = 'block';

            // Add click handlers to result items
            document.querySelectorAll('.search-result-item').forEach(item => {
                item.addEventListener('click', function() {
                    const userData = JSON.parse(this.getAttribute('data-user'));
                    selectUser(userData);
                });

                item.addEventListener('mouseenter', function() {
                    this.style.backgroundColor = '#f5f5f5';
                });

                item.addEventListener('mouseleave', function() {
                    this.style.backgroundColor = 'white';
                });
            });
        }

            // Display no results message
            function displayNoResults(message) {
                searchResults.innerHTML = `
                    <div style="padding:10px; color:#666; text-align:center;">
                        ${message}
                    </div>
                `;
                searchResults.style.display = 'block';
            }

            // Hide search results
            function hideSearchResults() {
                searchResults.style.display = 'none';
                searchSpinner.style.display = 'none';
            }

            // Select user and populate fields with better case handling
        function selectUser(user) {
            selectedAdUser = user;

            // Handle different possible casings
            const displayName = user.DisplayName || user.displayName || 'Unknown User';
            const firstName = user.FirstName || user.firstName || user.GivenName || user.givenName || '';
            const lastName = user.LastName || user.lastName || user.Surname || user.surname || '';
            const email = user.Email || user.email || user.Mail || user.mail || '';

            console.log('Selected user data:', {
                displayName,
                firstName,
                lastName,
                email,
                rawUser: user
            });

            // Update search input to show selected user
            adUserSearch.value = displayName;

            // Populate form fields and make them read-only
            document.getElementById('firstName').value = firstName;
            document.getElementById('firstName').readOnly = true;
            document.getElementById('firstName').style.backgroundColor = '#f8f9fa';

            document.getElementById('lastName').value = lastName;
            document.getElementById('lastName').readOnly = true;
            document.getElementById('lastName').style.backgroundColor = '#f8f9fa';

            document.getElementById('email').value = email;
            document.getElementById('email').readOnly = true;
            document.getElementById('email').style.backgroundColor = '#f8f9fa';

            hideSearchResults();
                 // Show password generation section
        document.getElementById('passwordSection').style.display = 'block';
        }

            // Clear user fields
                  function clearUserFields() {
            selectedAdUser = null;

            const fields = ['firstName', 'lastName', 'email'];
            fields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                field.value = '';
                // REMOVE the following two lines:
                // field.readOnly = false;
                // field.style.backgroundColor = '';
                // Instead, just clear the value and reset background:
                field.style.backgroundColor = '';
            });

            // Hide password generation section
            document.getElementById('passwordSection').style.display = 'none';
        }

            // Reset form
                  function resetForm() {
            newUserForm.reset();
            adUserSearch.value = '';
            clearUserFields();
            hideSearchResults();
            document.getElementById('role').value = '';
            document.getElementById('passwordSection').style.display = 'none';
        }

            // Existing handlers...
            document.querySelector('.search-input').addEventListener('input', debouncedUserSubmit);
            document.querySelectorAll('.filter-dropdown').forEach(function(dd) {
                dd.addEventListener('change', () => submitUserForm(false));
            });
            document.querySelector('.refresh-btn').addEventListener('click', function(e) {
                e.preventDefault();
                submitUserForm(true);
            });

            document.addEventListener('click', function(e) {
                if (!e.target.closest('.action-menu-container')) {
                    closeAllDropdowns();
                }
            });

            hookDeleteBtns();
            initActionMenus();

              generatePasswordBtn.addEventListener("click", function () {
            passwordInput.value = generatePassword();
        });

         // Toggle password visibility
    togglePasswordBtn.addEventListener("click", function () {
        const icon = this.querySelector("i");
        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            passwordInput.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    });

    // Copy password to clipboard
    copyPasswordBtn.addEventListener("click", function () {
        if (!passwordInput.value) {
            alert("No password to copy!");
            return;
        }

        navigator.clipboard.writeText(passwordInput.value).then(() => {
            // Give quick feedback
            copyPasswordBtn.innerHTML = '<i class="fas fa-check"></i>';
            setTimeout(() => {
                copyPasswordBtn.innerHTML = '<i class="fas fa-copy"></i>';
            }, 1500);
        }).catch(err => {
            console.error("Clipboard error:", err);
            alert("Failed to copy password.");
        });
    });

        });

        // Rest of your existing JavaScript functions remain the same...
        // (keeping the existing delete, reactivate, and other functions)

        document.querySelector('.big-delete-btn').addEventListener('click', function (e) {
            e.preventDefault();

            const selected = Array.from(document.querySelectorAll('input[name="selectedUserIds"]:checked'))
                .map(cb => ({
                    id: parseInt(cb.value),
                    type: cb.getAttribute('data-role')
                }));

            if (selected.length === 0) {
                alert("Please select at least one user to delete.");
                return;
            }

            if (!confirm("Are you sure you want to delete the selected users?")) {
                return;
            }

            fetch('@Url.Action("BulkDeleteUsers")', {
                method: 'POST',
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(selected)
            })
            .then(resp => resp.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    submitUserForm(true);
                } else {
                    alert("Delete failed: " + (data.message || "Unknown error"));
                }
            });
        });

        function debounce(fn, delay) {
            let timer = null;
            return function(...args) {
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(this, args), delay);
            };
        }

        function submitUserForm(keepPage = false) {
            const form = document.getElementById('userFilterForm');
            if(!keepPage) {
                let pageInput = document.createElement('input');
                pageInput.type = "hidden";
                pageInput.name = "page";
                pageInput.value = "1";
                form.appendChild(pageInput);
            }
            const data = new URLSearchParams(new FormData(form)).toString();
            fetch('@Url.Action("Users_Management")' + '?' + data, {
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
            .then(resp => resp.text())
            .then(html => {
                document.querySelector('.table-container').innerHTML = html;
                hookDeleteBtns();
                hookReactivateBtns();
                initActionMenus();
            });
        }

        const debouncedUserSubmit = debounce(() => submitUserForm(false), 300);

        function hookDeleteBtns() {
            document.querySelectorAll('.delete-user-btn').forEach(function(btn) {
                btn.onclick = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const userId = parseInt(btn.getAttribute('data-user-id'));
                    const role = btn.getAttribute('data-role');
                    if(confirm('Are you sure you want to delete this user?')) {
                        fetch('@Url.Action("DeleteUser")', {
                            method: 'POST',
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                            },
                            body: JSON.stringify({ id: userId, type: role })
                        })
                        .then(resp => resp.json())
                        .then(data => {
                            if(data.success) {
                                alert(data.message);
                                submitUserForm(true);
                            } else {
                                alert('Delete failed: ' + (data.message || 'Unknown error'));
                            }
                        });
                    }
                    closeAllDropdowns();
                };
            });
        }

        function hookReactivateBtns() {
            document.querySelectorAll('.reactivate-user-btn').forEach(function(btn) {
                btn.onclick = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const userId = parseInt(btn.getAttribute('data-user-id'));
                    const role = btn.getAttribute('data-role');
                    if(confirm('Are you sure you want to reactivate this user?')) {
                        fetch('@Url.Action("ReactivateUser")', {
                            method: 'POST',
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                            },
                            body: JSON.stringify({ id: userId, type: role })
                        })
                        .then(resp => resp.json())
                        .then(data => {
                            if(data.success) {
                                alert(data.message);
                                submitUserForm(true);
                            } else {
                                alert('Reactivation failed: ' + (data.message || 'Unknown error'));
                            }
                        });
                    }
                    closeAllDropdowns();
                };
            });
        }

        function initActionMenus() {
            document.querySelectorAll('.action-menu-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const dropdown = btn.nextElementSibling;
                    const isActive = btn.classList.contains('active');
                    closeAllDropdowns();
                    if (!isActive) {
                        btn.classList.add('active');
                        dropdown.classList.add('show');
                    }
                });
            });

            document.querySelectorAll('.view-user-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const userId = btn.getAttribute('data-user-id');
                    console.log('View user:', userId);
                    alert('View user functionality - User ID: ' + userId);
                    closeAllDropdowns();
                });
            });
        }

        function closeAllDropdowns() {
            document.querySelectorAll('.action-menu-btn').forEach(function(btn) {
                btn.classList.remove('active');
                btn.nextElementSibling.classList.remove('show');
            });
        }
    </script>
}


