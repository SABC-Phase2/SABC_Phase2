        function debounce(fn, delay) {
            let timer = null;
            return function(...args) {
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(this, args), delay);
            };
        }

        function submitUserForm(keepPage = false) {
            const form = document.getElementById('userFilterForm');
            if(!keepPage) {
                // Remove any existing page input
                let pageInput = form.querySelector('input[name="page"]');
                if (pageInput) pageInput.remove();
                // Add a new page input set to 1
                pageInput = document.createElement('input');
                pageInput.type = "hidden";
                pageInput.name = "page";
                pageInput.value = "1";
                form.appendChild(pageInput);
            }
            const data = new URLSearchParams(new FormData(form)).toString() + "&_=" + new Date().getTime();
            fetch('@Url.Action("Users_Management")' + '?' + data, {
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
            .then(resp => resp.text())
            .then(html => {
                document.querySelector('.table-container').innerHTML = html;
                hookDeleteBtns();
                hookReactivateBtns();
                initActionMenus();
                hookPaginationLinks();
            });
        }

        const debouncedUserSubmit = debounce(() => submitUserForm(false), 300);

        function hookDeleteBtns() {
            document.querySelectorAll('.delete-user-btn').forEach(function(btn) {
                // Remove any existing event listeners first
                btn.replaceWith(btn.cloneNode(true));
            });

            // Re-attach event listeners
            document.querySelectorAll('.delete-user-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const userId = parseInt(btn.getAttribute('data-user-id'));
                    const role = btn.getAttribute('data-role');

                    console.log('Delete button clicked:', userId, role); // Debug log

                    currentDeleteUserId = userId;
                    currentDeleteUserRole = role;
                    document.getElementById('deleteConfirmModal').style.display = 'flex';

                    closeAllDropdowns();
                });
            });
        }

        function hookReactivateBtns() {
            document.querySelectorAll('.reactivate-user-btn').forEach(function(btn) {
                // Remove any existing event listeners first
                btn.replaceWith(btn.cloneNode(true));
            });

            // Re-attach event listeners
            document.querySelectorAll('.reactivate-user-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const userId = parseInt(btn.getAttribute('data-user-id'));
                    const role = btn.getAttribute('data-role');

                    console.log('Reactivate button clicked:', userId, role); // Debug log

                    currentReactivateUserId = userId;
                    currentReactivateUserRole = role;
                    document.getElementById('reactivateConfirmModal').style.display = 'flex';

                    closeAllDropdowns();
                });
            });
        }

        function hookPaginationLinks() {
            document.querySelectorAll('.pagination-list .page-link').forEach(function(link) {
                link.onclick = function(e) {
                    e.preventDefault();
                    var page = parseInt(this.getAttribute('data-page'));
                    var totalPages = parseInt(this.closest('.pagination-list').getAttribute('data-total-pages')) || 1;
                    var currentPage = parseInt(this.closest('.pagination-list').getAttribute('data-current-page')) || 1;
                    if (!isNaN(page) && page > 0 && page <= totalPages && page !== currentPage) {
                        var form = document.getElementById('userFilterForm');
                        var pageInput = form.querySelector('input[name="page"]');
                        if (!pageInput) {
                            pageInput = document.createElement('input');
                            pageInput.type = "hidden";
                            pageInput.name = "page";
                            form.appendChild(pageInput);
                        }
                        pageInput.value = page;
                        form.dispatchEvent(new Event('submit', { cancelable: true }));
                    }
                };
            });
        }

        function initActionMenus() {
            document.querySelectorAll('.action-menu-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const dropdown = btn.nextElementSibling;
                    const isActive = btn.classList.contains('active');
                    closeAllDropdowns();
                    if (!isActive) {
                        btn.classList.add('active');
                        dropdown.classList.add('show');
                    }
                });
            });

            document.querySelectorAll('.view-user-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const userId = btn.getAttribute('data-user-id');
                    console.log('View user:', userId);
                    alert('View user functionality - User ID: ' + userId);
                    closeAllDropdowns();
                });
            });
        }

        function closeAllDropdowns() {
            document.querySelectorAll('.action-menu-btn').forEach(function(btn) {
                btn.classList.remove('active');
                btn.nextElementSibling.classList.remove('show');
            });
        }

        function submitFormData() {
            const formData = {
                firstName: document.getElementById('firstName').value,
                lastName: document.getElementById('lastName').value,
                email: document.getElementById('email').value,
                role: document.getElementById('role').value,
                password: document.getElementById('password').value,
                azureAdId: selectedAdUser.Id || selectedAdUser.id,
                dataHash: securityData.hash,
                nonce: securityData.nonce,
                timestamp: securityData.timestamp
            };

            const submitBtn = document.querySelector('#newUserForm button[type="submit"]');
            const originalText = submitBtn.textContent;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Creating Account...';

            fetch('@Url.Action("CreateUser")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('newUserModal').style.display = 'none';
                    resetForm();
                    showSuccessPopup('User created successfully!');
                    resetUserFilters();
                    submitUserForm(true);
                } else if (data.tampered) {
                    showTamperDetectedModal(data.tamperType, data.message);
                } else {
                    showErrorPopup(data.message || 'Unknown error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showErrorPopup('Network error occurred. Please try again.');
            })
            .finally(() => {
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
            });
        }

        // Initialize everything when DOM is loaded
        document.addEventListener('DOMContentLoaded', function () {
            const newUserBtn = document.querySelector('.big-newuser-btn');
            const modal = document.getElementById('newUserModal');
            const closeModal = modal.querySelector('.close-modal');
            const newUserForm = document.getElementById('newUserForm');
            const adUserSearch = document.getElementById('adUserSearch');
            const searchResults = document.getElementById('searchResults');
            const searchSpinner = document.getElementById('searchSpinner');

            // Modal event handlers
            document.getElementById('closeTamperModal').addEventListener('click', function() {
                document.getElementById('tamperDetectedModal').style.display = 'none';
                modal.style.display = 'none';
                resetForm();
                location.reload();
            });

            // Delete modal handlers
            document.getElementById('deleteCancelBtn').addEventListener('click', function() {
                document.getElementById('deleteConfirmModal').style.display = 'none';
                currentDeleteUserId = null;
                currentDeleteUserRole = null;
            });

            document.getElementById('deleteConfirmBtn').addEventListener('click', function() {
                if (currentDeleteUserId && currentDeleteUserRole) {
                    deleteUser(currentDeleteUserId, currentDeleteUserRole);
                }
                document.getElementById('deleteConfirmModal').style.display = 'none';
            });

            // Reactivate modal handlers
            document.getElementById('reactivateCancelBtn').addEventListener('click', function() {
                document.getElementById('reactivateConfirmModal').style.display = 'none';
                currentReactivateUserId = null;
                currentReactivateUserRole = null;
            });

            document.getElementById('reactivateConfirmBtn').addEventListener('click', function() {
                if (currentReactivateUserId && currentReactivateUserRole) {
                    reactivateUser(currentReactivateUserId, currentReactivateUserRole);
                }
                document.getElementById('reactivateConfirmModal').style.display = 'none';
            });

            // Bulk delete modal handlers
            document.getElementById('bulkDeleteCancelBtn').addEventListener('click', function() {
                document.getElementById('bulkDeleteConfirmModal').style.display = 'none';
            });

            document.getElementById('bulkDeleteConfirmBtn').addEventListener('click', function() {
                bulkDeleteUsers();
                document.getElementById('bulkDeleteConfirmModal').style.display = 'none';
            });

            // No selection modal handler
                 document.getElementById('noSelectionOkBtn').addEventListener('click', function() {
            var modal = bootstrap.Modal.getInstance(document.getElementById('noSelectionModal'));
            if (modal) modal.hide();
        });

            // Bulk delete button handler - MOVE THIS HERE
         document.querySelector('.big-delete-btn').addEventListener('click', function (e) {
            e.preventDefault();
            const selected = document.querySelectorAll('input[name="selectedUserIds"]:checked');
            if (selected.length === 0) {
                var modal = new bootstrap.Modal(document.getElementById('noSelectionModal'));
                modal.show();
            } else {
                document.getElementById('bulkDeleteConfirmModal').style.display = 'flex';
            }
        });

            // Show modal
            newUserBtn.addEventListener('click', function () {
                modal.style.display = 'flex';
                resetForm();
            });

            // Close modal on X
            closeModal.addEventListener('click', function () {
                modal.style.display = 'none';
                resetForm();
            });

            // Close modal when clicking outside
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    modal.style.display = 'none';
                    resetForm();
                }
            });

            // Change user selection button
            document.getElementById('changeUserBtn').addEventListener('click', function() {
                showSearchSection();
                clearUserFields();
            });

            // Azure AD User Search
            adUserSearch.addEventListener('input', function(e) {
                const searchTerm = e.target.value.trim();
                clearTimeout(searchTimeout);

                if (searchTerm.length < 3) {
                    hideSearchResults();
                    return;
                }

                searchSpinner.style.display = 'block';
                searchTimeout = setTimeout(function() {
                    searchAzureAdUsers(searchTerm);
                }, 500);
            });

            // Hide search results when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('#adUserSearch') && !e.target.closest('#searchResults')) {
                    hideSearchResults();
                }
            });

            function isFormTampered() {
                if (!tamperDetectionActive || !originalFormData || !securityData) {
                    return null;
                }

                if (!document.getElementById('firstName').value ||
                    !document.getElementById('lastName').value ||
                    !document.getElementById('email').value) {
                    return {
                        type: 'MISSING_DATA',
                        message: 'Required form data is missing.'
                    };
                }

                const currentFormData = {
                    firstName: document.getElementById('firstName').value,
                    lastName: document.getElementById('lastName').value,
                    email: document.getElementById('email').value,
                    azureAdId: document.getElementById('azureAdId').value
                };

                if (JSON.stringify(originalFormData) !== JSON.stringify(currentFormData)) {
                    console.error('Field tampering detected:', {
                        original: originalFormData,
                        current: currentFormData
                    });
                    return {
                        type: 'FORM_FIELD_MODIFIED',
                        message: 'Form data has been tampered with using developer tools.'
                    };
                }

                const readOnlyFields = ['firstName', 'lastName', 'email', 'azureAdId'];
                for (const fieldId of readOnlyFields) {
                    const field = document.getElementById(fieldId);
                    if (field && originalFormData[fieldId] && !field.readOnly) {
                        return {
                            type: 'READONLY_REMOVED',
                            message: 'Form security attributes have been tampered with.'
                        };
                    }
                }

                const currentHash = document.getElementById('dataHash').value;
                const currentNonce = document.getElementById('nonce').value;
                const currentTimestamp = document.getElementById('timestamp').value;

                if (currentHash !== securityData.hash ||
                    currentNonce !== securityData.nonce ||
                    currentTimestamp !== securityData.timestamp.toString()) {
                    return {
                        type: 'SECURITY_DATA_MODIFIED',
                        message: 'Security validation data has been compromised.'
                    };
                }

                return null;
            }

            // Enhanced form submit handler
            newUserForm.addEventListener('submit', function(e) {
                e.preventDefault();

                const tamperResult = isFormTampered();
                if (tamperResult) {
                    console.error('🚨 TAMPERING DETECTED ON SUBMIT:', tamperResult);
                    showTamperDetectedModal(tamperResult.type, tamperResult.message);
                    return false;
                }

                if (!selectedAdUser) {
                    showErrorPopup('Please search and select a user from Azure AD first.');
                    return false;
                }

                if (!securityData) {
                    showErrorPopup('Security validation failed. Please select a user again.');
                    return false;
                }

                const password = document.getElementById('password').value;
                if (!password) {
                    showErrorPopup('Please generate a password first.');
                    return false;
                }

                const role = document.getElementById('role').value;
                if (!role) {
                    showErrorPopup('Please select a role.');
                    return false;
                }

                submitFormData();
            });

            // Password functions
            generatePasswordBtn.addEventListener("click", function () {
                passwordInput.value = generatePassword();
            });

            togglePasswordBtn.addEventListener("click", function () {
                const icon = this.querySelector("i");
                if (passwordInput.type === "password") {
                    passwordInput.type = "text";
                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");
                } else {
                    passwordInput.type = "password";
                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");
                }
            });

            copyPasswordBtn.addEventListener("click", function () {
                if (!passwordInput.value) {
                    alert("No password to copy!");
                    return;
                }

                navigator.clipboard.writeText(passwordInput.value).then(() => {
                    copyPasswordBtn.innerHTML = '<i class="fas fa-check"></i>';
                    setTimeout(() => {
                        copyPasswordBtn.innerHTML = '<i class="fas fa-copy"></i>';
                    }, 1500);
                }).catch(err => {
                    console.error("Clipboard error:", err);
                    alert("Failed to copy password.");
                });
            });

            // Initialize existing handlers
            document.querySelector('.search-input').addEventListener('input', function() {
                submitUserForm(false);
            });

            document.querySelectorAll('.filter-dropdown').forEach(function(dd) {
                dd.addEventListener('change', () => submitUserForm(false));
            });

        document.querySelector('.refresh-btn').addEventListener('click', function(e) {
            e.preventDefault();

            // Clear all filters
            document.querySelector('.search-input').value = '';
            document.querySelector('select[name="roleFilter"]').value = 'all';

            // Remove any existing page input to reset to page 1
            let pageInput = document.querySelector('input[name="page"]');
            if (pageInput) pageInput.remove();

            // Submit the form to reload the table with cleared filters
            submitUserForm(false); // false = don't keep current page, reset to page 1
        });

            document.addEventListener('click', function(e) {
                if (!e.target.closest('.action-menu-container')) {
                    closeAllDropdowns();
                }
            });

            // Initialize button handlers
            hookDeleteBtns();
            hookReactivateBtns();
            initActionMenus();
        });
    </script>
}


