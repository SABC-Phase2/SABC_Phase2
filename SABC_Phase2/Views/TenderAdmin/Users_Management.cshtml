@model List<SABC_Phase2.Models.Tender.AdminUserRowViewModel>
@{
    ViewData["BannerText"] = "User Management";
    string search = Context.Request.Query["search"];
    string roleFilter = Context.Request.Query["roleFilter"];
    string statusFilter = Context.Request.Query["statusFilter"];
    bool isOvrsUser = ViewBag.IsOVRSUser == true;
    int pageSize = ViewBag.PageSize ?? 7;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalItems = ViewBag.TotalItems ?? Model.Count;
    int totalPages = ViewBag.TotalPages ?? 1;
    int emptyRows = pageSize - Model.Count;
}
<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />

<div class="breadcrumb-custom">
    <span>Home</span>
    <span class="breadcrumb-arrow">&gt;</span>
    <span class="breadcrumb-active">User Management</span>
</div>

<div class="user-action-bar">
    <form method="get" id="userFilterForm" style="display: flex; align-items: center; gap: 16px;">
        <span class="search-wrapper" style="position: relative; display: flex; align-items: center;">
            <i class="fas fa-search" style="position:absolute; left:12px; color:#ccc; font-size:1rem;"></i>
            <input type="text" name="search" class="search-input"
                   value="@search"
                   placeholder="Search users"
                   autocomplete="off"
                   style="padding-left: 38px;" />
        </span>
        <select name="roleFilter" class="filter-dropdown">
            <option value="all" selected="@(string.IsNullOrEmpty(roleFilter) || roleFilter == "all" ? "selected" : null)">SABC USER</option>
            <option value="OVRS_User" selected="@(roleFilter == "OVRS_User" ? "selected" : null)">OVRS USER</option>
        </select>
        <button type="button" class="refresh-btn"
                title="Clear search and filters"
                style="margin-left: 0;">
            <i class="fas fa-sync-alt"></i>
        </button>

        <!-- Button group aligned right -->
        <span style="display: flex; gap: 16px; margin-left: auto;">
            <button type="button" class="big-newuser-btn" title="Add New User">
                <i class="fas fa-user-plus"></i> New User
            </button>
            <button type="button" class="big-delete-btn" title="Delete Selected Users">
                <i class="fas fa-trash-alt"></i> Delete
            </button>
        </span>
    </form>
</div>

<div class="table-container">
    <partial name="_UsersTablePartial" model="Model" />
</div>
@if (totalPages > 1)
{
    <div class="custom-pagination">
        <ul class="pagination-list">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link arrow-link"
                   href="@Url.Action("Users_Management", "TenderAdmin", new { page = currentPage - 1, pageSize, search })"
                   tabindex="@(currentPage == 1 ? "-1" : "0")" aria-label="Previous">
                    <span aria-hidden="true">&#8592;</span>
                </a>
            </li>
            @if (currentPage > 3)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="@Url.Action("Users_Management", "TenderAdmin", new { page = 1, pageSize, search })">1</a>
                </li>
                @if (currentPage > 4)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                if (i == currentPage)
                {
                    <li class="page-item active">
                        <span class="page-link"><span class="page-number">@i</span></span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link"
                           href="@Url.Action("Users_Management", "TenderAdmin", new { page = i, pageSize, search })">@i</a>
                    </li>
                }
            }
            @if (currentPage < totalPages - 2)
            {
                if (currentPage < totalPages - 3)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link"
                       href="@Url.Action("Users_Management", "TenderAdmin", new { page = totalPages, pageSize, search })">@totalPages</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link arrow-link"
                   href="@Url.Action("Users_Management", "TenderAdmin", new { page = currentPage + 1, pageSize, search })"
                   tabindex="@(currentPage == totalPages ? "-1" : "0")" aria-label="Next">
                    <span aria-hidden="true">&#8594;</span>
                </a>
            </li>
        </ul>
    </div>
}
<!-- New User Modal -->
<div id="newUserModal" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100vw; height:100vh; background:rgba(0,0,0,0.4); align-items:center; justify-content:center;">
    <div class="modal-content">
        <div class="modal-header">
            <span>Add New User</span>
            <span class="close-modal">&times;</span>
        </div>
        <form id="newUserForm">
            <!-- 🔒 SECURITY: Hidden field to store Azure AD ID for server validation -->
            <input type="hidden" id="azureAdId" name="azureAdId" value="" />
            <input type="hidden" id="dataHash" name="dataHash" value="" />
            <input type="hidden" id="nonce" name="nonce" value="" />
            <input type="hidden" id="timestamp" name="timestamp" value="" />

            <!-- Search Bar with Dropdown -->
            <div id="searchSection" style="margin-bottom:24px; position: relative;">
                <label for="adUserSearch" style="font-weight:500; margin-bottom:8px; display:block;">Search for Azure AD User</label>
                <input type="text" id="adUserSearch" placeholder="Search Azure AD users..."
                       class="form-control"
                       style="width:100%; padding:10px 12px; border-radius:6px; border:1px solid #ccc;" />
                <div id="searchResults" style="display:none; position:absolute; top:100%; left:0; right:0; background:#fff; border:1px solid #ccc; border-top:none; border-radius:0 0 6px 6px; max-height:200px; overflow-y:auto; z-index:1000;">
                    <!-- Search results will be populated here -->
                </div>
                <div id="searchSpinner" style="display:none; position:absolute; right:12px; top:38px;">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
            </div>

            <!-- 🔒 SECURITY: User Info Display (Completely Read-Only) -->
            <div id="userInfoDisplay" style="display:none; margin-bottom:20px;">
                <div style="display:flex; gap:10px;">
                    <div style="flex:1;">
                        <label for="displayFirstName" style="font-weight:500; margin-bottom:5px; display:block;">First Name</label>
                        <input type="text" id="displayFirstName" readonly style="width:100%; background:#f8f9fa; border:1px solid #ccc; border-radius:6px; padding:10px; color:#333;" value="-" tabindex="-1" />
                    </div>
                    <div style="flex:1;">
                        <label for="displayLastName" style="font-weight:500; margin-bottom:5px; display:block;">Last Name</label>
                        <input type="text" id="displayLastName" readonly style="width:100%; background:#f8f9fa; border:1px solid #ccc; border-radius:6px; padding:10px; color:#333;" value="-" tabindex="-1" />
                    </div>
                </div>
                <div style="margin-top:15px;">
                    <label for="displayEmail" style="font-weight:500; margin-bottom:5px; display:block;">Email Address</label>
                    <input type="text" id="displayEmail" readonly style="width:100%; background:#f8f9fa; border:1px solid #ccc; border-radius:6px; padding:10px; color:#333;" value="-" tabindex="-1" />
                </div>

            </div>

            <!-- 🔒 SECURITY: Hidden inputs that store the validated data -->
            <input type="hidden" id="firstName" name="firstName" value="" />
            <input type="hidden" id="lastName" name="lastName" value="" />
            <input type="hidden" id="email" name="email" value="" />

            <!-- Role Selection (Only user-editable field) -->
            <div id="roleSection" style="display:none; margin-bottom:20px;">
                <label for="role" style="font-weight:500;">User Role</label>
                <select id="role" name="role" class="form-control" style="width:100%;" required>
                    <option value="">Select Role</option>
                    <option value="IT_Admin">IT ADMIN</option>
                    <option value="Tender_Administrator">TENDER ADMIN</option>
                    <option value="Vendor_Administrator">VENDOR ADMIN</option>
                </select>
            </div>

            <!-- Password Generation Field (initially hidden) -->
            <div id="passwordSection" style="display: none;">
                <label for="password" style="font-weight:500;">Generated Password</label>
                <div style="display:flex; align-items:center; gap:8px;">
                    <div style="flex:1; position:relative;">
                        <input id="password" name="password" type="password" class="form-control"
                               style="width:100%; padding:10px 45px 10px 12px; border-radius:6px; border:1px solid #ccc;"
                               readonly />
                        <button type="button" id="togglePassword"
                                style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:#666;"
                                title="Toggle password visibility">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <button type="button" id="generatePasswordBtn" class="btn"
                            style="background:#007bff; color:#fff; border:none; border-radius:6px; padding:10px 16px; white-space:nowrap; font-weight:500;">
                        Generate Password
                    </button>
                    <button type="button" id="copyPasswordBtn" class="btn" title="Copy to clipboard"
                            style="background:#28a745; color:#fff; border:none; border-radius:6px; padding:10px 12px;">
                        <i class="fas fa-copy"></i>
                    </button>
                </div>

            </div>

            <!-- Create Account Button -->
            <div id="submitSection" style="display:flex; justify-content:center; margin-top: 32px; gap:18px;">
                <button type="button" id="changeUserBtn" class="clear-user-btn">
                    <i class="fas fa-times"></i> Clear User
                </button>
                <button type="submit" class="create-account-btn">
                    <i class="fas fa-user-plus"></i> Create Account
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tamper Detection Modal -->
<div id="tamperDetectedModal" style="
    display:none;
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    background:rgba(0,0,0,0.6);
    z-index:10001;
    align-items:center;
    justify-content:center;
">
    <div style="
        background:#fff;
        border-radius:12px;
        padding:40px;
        text-align:center;
        box-shadow:0 8px 20px rgba(0,0,0,0.3);
        max-width:500px;
        width:90%;
        border:3px solid #dc3545;
    ">
        <i class="fas fa-shield-alt" style="color:#dc3545; font-size:4rem; margin-bottom:20px;"></i>
        <h2 style="margin:0 0 15px; color:#dc3545;">🚨 SECURITY ALERT 🚨</h2>
        <h3 style="margin:0 0 15px; color:#333;">Form Tampering Detected!</h3>
        <p id="tamperMessage" style="margin:0 0 20px; color:#666; font-size:1.1rem;">
            The form has been tampered with using developer tools or other methods.
        </p>
        <div style="background:#fff3cd; border:1px solid #ffeaa7; border-radius:6px; padding:15px; margin:20px 0; text-align:left;">
            <strong>⚠️ This incident has been logged for security purposes.</strong><br>
            <span style="font-size:0.9em; color:#856404;">
                Timestamp: <span id="tamperTimestamp"></span><br>
                Type: <span id="tamperType"></span>
            </span>
        </div>
        <button id="closeTamperModal" style="
            background:#dc3545;
            color:#fff;
            border:none;
            border-radius:6px;
            padding:12px 25px;
            font-size:1.1rem;
            cursor:pointer;
            font-weight:bold;
        ">
            Understood - Refresh Form
        </button>
    </div>
</div>

