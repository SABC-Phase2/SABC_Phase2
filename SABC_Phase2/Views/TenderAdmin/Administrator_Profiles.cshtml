@model SABC_Phase2.Models.Tender.AdministratorProfileViewModel
@using Microsoft.AspNetCore.Mvc.ModelBinding

@functions {
    private IEnumerable<ModelError> GetErrors(string key)
    {
        return ViewData.ModelState.ContainsKey(key)
            ? ViewData.ModelState[key].Errors
            : Enumerable.Empty<ModelError>();
    }

    public bool ShouldShowPasswordFields()
    {
        // Show password fields if any were filled, or if there was a password error
        return !string.IsNullOrWhiteSpace(Model.CurrentPassword)
            || !string.IsNullOrWhiteSpace(Model.NewPassword)
            || !string.IsNullOrWhiteSpace(Model.ConfirmPassword)
            || (
                (ViewData.ModelState["CurrentPassword"]?.Errors.Count ?? 0) > 0
                || (ViewData.ModelState["NewPassword"]?.Errors.Count ?? 0) > 0
                || (ViewData.ModelState["ConfirmPassword"]?.Errors.Count ?? 0) > 0
                || (ViewData.ModelState[string.Empty]?.Errors?.Any(e => e.ErrorMessage.Contains("password", StringComparison.OrdinalIgnoreCase)) ?? false)
            );
    }
}

@{
    ViewData["BannerText"] = "PROFILE";
    ViewData["Title"] = "Profile";
}

<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />

<div class="breadcrumb-custom">
    Home<span class="breadcrumb-arrow">&gt;</span> <span class="breadcrumb-active">Profile</span>
</div>

<div class="tab-container">
    <div class="profile-page container-fluid">
        <div class="row">
            <!-- Left section -->
            <div class="col-md-12">
                <form id="changeProfileForm" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <!-- First & Last Name side by side -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.FirstName, new { @class = "" })
                                <span class="text-danger">*</span>
                                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "Enter your first name" })
                                @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.LastName, new { @class = "" })
                                <span class="text-danger">*</span>
                                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Enter your last name" })
                                @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Email (NEW FLOW) -->
                    <div class="form-group d-flex justify-content-between align-items-center">
                        <div>
                            @Html.LabelFor(m => m.Email)
                            <p id="emailStatic" class="form-static mb-0">@Model.Email</p>
                        </div>
                        <a href="javascript:void(0)" class="change-link" id="changeEmailBtn">Change</a>
                    </div>
                    @Html.HiddenFor(m => m.Email) <!-- keep model binding for current email -->

                    <hr />

                    <!-- Password (SAME AS OVRS) -->
                    <div class="form-group">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="mb-0">Password</label>
                            <a href="javascript:void(0)" class="change-link" id="changePasswordBtn">Change</a>
                        </div>

                        <!-- Consolidated error block under label/change-link row -->
                        @if (ViewData.ModelState["CurrentPassword"]?.Errors.Count > 0
                                                || ViewData.ModelState["NewPassword"]?.Errors.Count > 0
                                                || ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0
                                                || ViewData.ModelState[string.Empty]?.Errors.Any(e => e.ErrorMessage.Contains("password", StringComparison.OrdinalIgnoreCase)) == true)
                        {
                            <div class="text-danger mb-2" id="passwordErrorBlock">
                                @foreach (var error in GetErrors("CurrentPassword"))
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                                @foreach (var error in GetErrors("NewPassword"))
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                                @foreach (var error in GetErrors("ConfirmPassword"))
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                                @foreach (var error in GetErrors(string.Empty).Where(e => e.ErrorMessage.Contains("password", StringComparison.OrdinalIgnoreCase)))
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        }

                        <div id="passwordFields" class="@(ShouldShowPasswordFields() ? "" : "d-none")">
                            <div class="mb-2">
                                @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", placeholder = "Enter current password", autocomplete = "current-password" })
                            </div>
                            <div class="mb-2">
                                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Enter new password", autocomplete = "new-password" })
                            </div>
                            <div class="mb-2">
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm new password", autocomplete = "new-password" })
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Save button outside the container, centered on screen -->
                    <div class="save-btn-outer d-flex justify-content-end">
                        <button type="submit" form="changeProfileForm" class="btn btn-save-3d" id="saveBtn">
                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            <span class="btn-text">Save</span>
                        </button>

                    </div>

                    <div class="form-group text-end mt-4">
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Email Change Modal (Updated layout to match screenshot) -->
<div class="modal fade" id="changeEmailModal" tabindex="-1" aria-labelledby="changeEmailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="changeEmailForm" autocomplete="off" onsubmit="return false;">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="changeEmailModalLabel">Change email address</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <!-- Step 1: Email Address -->
                    <div class="mb-5">
                        <label class="form-label fw-bold d-flex align-items-center mb-2">
                            <span class="badge bg-success me-2">1</span> Email Address
                        </label>
                        <input type="email" class="form-control mb-2" id="newEmailInput" name="newEmail" placeholder="Enter your new email address" />
                        <div class="invalid-feedback" id="newEmailError" style="display:block"></div>
                        <div class="d-flex">
                            <button type="button" class="btn btn-success" id="sendOtpBtn" style="min-width:130px;">Get OTP</button>
                        </div>
                    </div>

                    <!-- Step 2: Verify OTP -->
                    <div class="mb-5">
                        <label class="form-label fw-bold d-flex align-items-center mb-2">
                            <span class="badge bg-warning text-dark me-2">2</span> Verify Email Address
                        </label>
                        <div class="d-flex align-items-center mb-3">
                            <a href="javascript:void(0)" id="resendOtpLink" class="me-2">Resend OTP</a>
                            <span class="text-muted">• This OTP will expire after <span id="otpTimer" style="color:#0074d9;">00:05:00</span></span>
                        </div>
                        <div class="d-flex justify-content-start gap-2 mb-3">
                            <input type="text" class="form-control text-center otp-input" maxlength="1" disabled />
                            <input type="text" class="form-control text-center otp-input" maxlength="1" disabled />
                            <input type="text" class="form-control text-center otp-input" maxlength="1" disabled />
                            <input type="text" class="form-control text-center otp-input" maxlength="1" disabled />
                            <input type="text" class="form-control text-center otp-input" maxlength="1" disabled />
                            <input type="text" class="form-control text-center otp-input" maxlength="1" disabled />
                        </div>
                        <div class="d-flex">
                            <button type="button" class="btn btn-success" id="verifyOtpBtn" style="min-width:130px;" disabled>Verify</button>
                        </div>
                        <div class="invalid-feedback" id="otpError" style="display:block"></div>
                        <div class="valid-feedback" id="otpSuccess" style="display:block"></div>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Account Modal -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="deleteAccountForm" method="post" action="@Url.Action("DeleteAccount", "TenderAdmin")">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteAccountModalLabel">Confirm Account Deletion</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to permanently delete your account? This action cannot be undone.</p>
                    <div class="mb-3">
                        <label for="confirmEmail" class="form-label">Your Email Address</label>
                        <input type="email" class="form-control" id="confirmEmail" name="ConfirmEmail"
                               placeholder="Enter your email address" required />
                    </div>
                    <div class="mb-3">
                        <label for="confirmPhrase" class="form-label">
                            To verify, type <strong>"Delete my account"</strong> exactly as it appears
                        </label>
                        <input type="text" class="form-control" id="confirmPhrase" name="ConfirmPhrase" required />
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="confirmDeleteBtn" class="btn btn-danger" disabled>Yes, Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Profile Update Success Modal -->
<div id="profileSuccessModal" class="modal fade" tabindex="-1" aria-labelledby="profileSuccessModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 350px;">
        <div class="modal-content rounded-4 profile-success-modal" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="profileSuccessModalLabel" style="width:100%;text-align:center;"></h5>
                <!-- Tick Box Image (reuse your path) -->
                <img src="~/lib/Images/Tick-Box.png" alt="Success" style="width: 64px; height: 64px; margin: 12px auto 0 auto; display: block;" />
            </div>
            <div class="modal-body">
                <!-- Success in green and bold -->
                <p style="font-size:1.4rem; font-weight:700; color:#16a34a;">Success</p>
                <p style="font-size:1rem; color:#6b7280;">Your changes have been updated successfully</p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" class="btn btn-success px-5" data-bs-dismiss="modal" style="background:#16a34a; min-width:100px;">OK</button>
            </div>
        </div>
    </div>
</div>


<!-- Place this at the bottom of your view, after your other modals -->
<div class="modal fade" id="passwordRequirementsModal" tabindex="-1" aria-labelledby="passwordRequirementsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <!-- Error image and title, both enlarged and centered -->
            <div class="modal-header d-block border-0 text-center" style="background:transparent;">
                <img src="~/lib/Images/X-Box.png" alt="Error"
                     style="width: 96px; height: 96px; margin: 0 auto 12px auto; display: block;" />
                <h5 class="modal-title w-100" id="passwordRequirementsModalLabel"
                    style="color:#e53935; font-weight:900; font-size:2rem; text-align:center;">
                    Error
                </h5>
            </div>
            <div class="modal-body" style="text-align:center;">
                <p class="mb-2" style="font-size:1.2rem; font-weight:600;">Password Requirements:</p>
                <ul class="list-unstyled mb-0" id="passwordRequirementsChecklist" style="display:inline-block; text-align:left;">
                    @{
                        string attemptedPassword = ViewBag.AttemptedPassword ?? Model?.NewPassword ?? "";
                        bool hasLength = attemptedPassword.Length >= 8 && attemptedPassword.Length <= 15;
                        bool hasLower = attemptedPassword.Any(char.IsLower);
                        bool hasUpper = attemptedPassword.Any(char.IsUpper);
                        bool hasDigit = attemptedPassword.Any(char.IsDigit);
                        bool hasSpecial = attemptedPassword.Any(c => "!@#$%^&*()_+-=[]{}|;:,.<>?".Contains(c));
                    }
                    <li>
                        <span class="@(hasLength ? "text-success" : "text-danger")" style="font-size:1.1rem;">
                            <i class="fa-solid @(hasLength ? "fa-check-circle" : "fa-xmark-circle") me-1"></i>
                            Use 8 or more characters
                        </span>
                    </li>
                    <li>
                        <span class="@(hasLower ? "text-success" : "text-danger")" style="font-size:1.1rem;">
                            <i class="fa-solid @(hasLower ? "fa-check-circle" : "fa-xmark-circle") me-1"></i>
                            Use lower case letters (e.g. a)
                        </span>
                    </li>
                    <li>
                        <span class="@(hasUpper ? "text-success" : "text-danger")" style="font-size:1.1rem;">
                            <i class="fa-solid @(hasUpper ? "fa-check-circle" : "fa-xmark-circle") me-1"></i>
                            Use upper case letters (e.g. A)
                        </span>
                    </li>
                    <li>
                        <span class="@(hasDigit ? "text-success" : "text-danger")" style="font-size:1.1rem;">
                            <i class="fa-solid @(hasDigit ? "fa-check-circle" : "fa-xmark-circle") me-1"></i>
                            Use a number (e.g. 123)
                        </span>
                    </li>
                    <li>
                        <span class="@(hasSpecial ? "text-success" : "text-danger")" style="font-size:1.1rem;">
                            <i class="fa-solid @(hasSpecial ? "fa-check-circle" : "fa-xmark-circle") me-1"></i>
                            Use a symbol (e.g. !#$*)
                        </span>
                    </li>
                </ul>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal" id="closePasswordReqModalBtn">Close</button>
            </div>
        </div>
    </div>
</div>


<script>
         document.addEventListener('DOMContentLoaded', function () {
        // ---- EMAIL CHANGE FLOW ----
        var changeEmailBtn = document.getElementById('changeEmailBtn');
        var sendOtpBtn = document.getElementById('sendOtpBtn');
        var verifyOtpBtn = document.getElementById('verifyOtpBtn');
        var newEmailInput = document.getElementById('newEmailInput');
        var otpInputs = document.querySelectorAll('.otp-input');
        var resendOtpLink = document.getElementById('resendOtpLink');
        var otpTimer = document.getElementById('otpTimer');
        var newEmailError = document.getElementById('newEmailError');
        var otpError = document.getElementById('otpError');
        var otpSuccess = document.getElementById('otpSuccess');

        // Add spinner inside buttons
        if (sendOtpBtn) {
            sendOtpBtn.innerHTML = '<span class="spinner-border spinner-border-sm d-none" role="status" id="sendOtpSpinner"></span> <span class="btn-text">Get OTP</span>';
        }
        if (verifyOtpBtn) {
            verifyOtpBtn.innerHTML = '<span class="spinner-border spinner-border-sm d-none" role="status" id="verifyOtpSpinner"></span> <span class="btn-text">Verify</span>';
        }

        var sendOtpSpinner = document.getElementById('sendOtpSpinner');
        var verifyOtpSpinner = document.getElementById('verifyOtpSpinner');

        let countdownInterval;
        let otpTimeLeft = 300; // 5 minutes
        let resendCooldownTime = 60;
        let resendCooldownLeft = 0;
        let resendCooldownInterval = null;

    // Start cooldown
    function startResendCooldown(seconds) {
        resendCooldownLeft = seconds;
        updateResendLinkState();

        if (resendCooldownInterval) clearInterval(resendCooldownInterval);
        resendCooldownInterval = setInterval(() => {
            resendCooldownLeft--;
            updateResendLinkState();
            if (resendCooldownLeft <= 0) {
                clearInterval(resendCooldownInterval);
            }
        }, 1000);
    }
    // Helper to update resend link text/state
    function updateResendLinkState() {
        if (!resendOtpLink) return;

        if (resendCooldownLeft > 0) {
            // During cooldown
            resendOtpLink.classList.add('disabled');
            resendOtpLink.style.pointerEvents = 'none';
            resendOtpLink.textContent = `Resend OTP (${resendCooldownLeft}s)`;
        } else {
            // Cooldown finished → enable
            resendOtpLink.classList.remove('disabled');
            resendOtpLink.style.pointerEvents = '';
            resendOtpLink.textContent = 'Resend OTP';
        }
    }

        // Reset OTP UI and disable resend link initially (when entering modal or after failed OTP)
        function resetOtpUI() {
            otpInputs.forEach(i => { i.value = ''; i.disabled = true; });
            verifyOtpBtn.disabled = true;
            otpError.textContent = '';
            otpSuccess.textContent = '';
            clearInterval(countdownInterval);
            if (otpTimer) otpTimer.textContent = "00:05:00";
            resendCooldownLeft = resendCooldownTime;
            updateResendLinkState();
        }

        // When opening modal
        if (changeEmailBtn) {
            changeEmailBtn.addEventListener('click', function () {
                newEmailInput.value = '';
                newEmailInput.classList.remove('is-invalid', 'is-valid');
                newEmailError.textContent = '';
                newEmailInput.removeAttribute('readonly');
                sendOtpBtn.disabled = false;
                sendOtpBtn.querySelector('.btn-text').textContent = 'Get OTP';
                resetOtpUI();

                var modal = new bootstrap.Modal(document.getElementById('changeEmailModal'));
                modal.show();
            });
        }

        // Send Email OTP
        if (sendOtpBtn) {
            sendOtpBtn.addEventListener('click', async function () {
                var newEmail = newEmailInput.value.trim();
                newEmailInput.classList.remove('is-invalid', 'is-valid');
                newEmailError.textContent = "";

                if (!newEmail) {
                    newEmailError.textContent = "Please enter email.";
                    newEmailInput.classList.add('is-invalid');
                    return;
                }

                sendOtpSpinner.classList.remove('d-none');
                sendOtpBtn.disabled = true;

                try {
                    var token = document.querySelector('input[name="__RequestVerificationToken"]');
                    var headers = { 'Content-Type': 'application/json' };
                    if (token) {
                        headers['RequestVerificationToken'] = token.value;
                    }

                    let res = await fetch('/TenderAdmin/SendAdminEmailOtp', {
                        method: 'POST',
                        headers: headers,
                        body: JSON.stringify(newEmail)
                    });

                    let data = await res.json();
                    if (data.success) {
                        newEmailError.textContent = '';
                        newEmailInput.classList.remove('is-invalid');
                        newEmailInput.classList.add('is-valid');
                        newEmailInput.setAttribute('readonly', true);
                        sendOtpBtn.querySelector('.btn-text').textContent = 'OTP Sent';

                        // Enable OTP inputs
                        otpInputs.forEach(i => i.disabled = false);
                        verifyOtpBtn.disabled = false;
                        otpInputs[0].focus();

                        // Start countdown
                        otpTimeLeft = 300;
                        startCountdown();

                        // Enable resend link and start cooldown
                        startResendCooldown(resendCooldownTime);
                        updateResendLinkState();
                    } else {
                        newEmailError.textContent = data.message;
                        newEmailInput.value = '';
                        newEmailInput.classList.remove('is-valid');
                        newEmailInput.classList.add('is-invalid');
                        newEmailInput.focus();
                        sendOtpBtn.disabled = false;
                        sendOtpBtn.querySelector('.btn-text').textContent = 'Get OTP';
                        resetOtpUI();

                        // If rate-limited from server, optionally use secondsLeft property
                        if (data.message && data.message.includes('Please wait before requesting')) {
                            let secondsLeft = resendCooldownTime;
                            if (typeof data.secondsLeft === "number" && data.secondsLeft > 0) {
                                secondsLeft = data.secondsLeft;
                            }
                            startResendCooldown(secondsLeft);
                            updateResendLinkState();
                        }
                    }
                } catch (err) {
                    console.error('Detailed error:', err);
                    newEmailError.textContent = "Error sending OTP. Please try again.";
                    newEmailInput.value = '';
                    newEmailInput.classList.remove('is-valid');
                    newEmailInput.classList.add('is-invalid');
                    newEmailInput.focus();
                    sendOtpBtn.disabled = false;
                    sendOtpBtn.querySelector('.btn-text').textContent = 'Get OTP';
                    resetOtpUI();
                } finally {
                    sendOtpSpinner.classList.add('d-none');
                }
            });
        }

        // OTP input behavior
        otpInputs.forEach((input, index) => {
            input.addEventListener('input', () => {
                if (input.value.length === 1 && index < otpInputs.length - 1) {
                    otpInputs[index + 1].focus();
                }
            });
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && index > 0) {
                    otpInputs[index - 1].focus();
                }
            });
        });

        // Verify Email OTP
        if (verifyOtpBtn) {
            verifyOtpBtn.addEventListener('click', async function () {
                let otpCode = Array.from(otpInputs).map(i => i.value).join('');

                if (!otpCode || otpCode.length < 6) {
                    otpError.textContent = "Please enter full 6-digit OTP.";
                    return;
                }

                verifyOtpSpinner.classList.remove('d-none');
                verifyOtpBtn.disabled = true;

                try {
                    var token = document.querySelector('input[name="__RequestVerificationToken"]');
                    var headers = { 'Content-Type': 'application/json' };
                    if (token) {
                        headers['RequestVerificationToken'] = token.value;
                    }

                    let res = await fetch('/TenderAdmin/VerifyAdminEmailOtp', {
                        method: 'POST',
                        headers: headers,
                        body: JSON.stringify({ otp: otpCode })
                    });

                    let data = await res.json();
                    if (data.success) {
                        otpError.textContent = '';
                        otpSuccess.textContent = data.message;
                        document.getElementById('emailStatic').textContent = newEmailInput.value;

                        setTimeout(() => {
                            var modal = bootstrap.Modal.getInstance(document.getElementById('changeEmailModal'));
                            modal.hide();
                        }, 1500);
                    } else {
                        otpError.textContent = data.message;
                        verifyOtpBtn.disabled = false;
                    }
                } catch (err) {
                    console.error('Verify OTP error:', err);
                    otpError.textContent = "Error verifying OTP.";
                    verifyOtpBtn.disabled = false;
                } finally {
                    verifyOtpSpinner.classList.add('d-none');
                }
            });
        }

        // Resend OTP
        if (resendOtpLink) {
            resendOtpLink.addEventListener('click', function () {
                if (resendCooldownLeft > 0 || otpInputs[0].disabled) return; // Prevent click during cooldown or when not ready

                resetOtpUI();
                if (sendOtpBtn) {
                    sendOtpBtn.disabled = false;
                    sendOtpBtn.click(); // auto resend using existing flow
                    startResendCooldown(resendCooldownTime);
                    updateResendLinkState();
                }
            });
        }

        // Countdown for OTP validity
        function startCountdown() {
            clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
                if (otpTimeLeft <= 0) {
                    clearInterval(countdownInterval);
                    otpTimer.textContent = "Expired";
                    verifyOtpBtn.disabled = true;
                    return;
                }
                otpTimeLeft--;
                let minutes = String(Math.floor(otpTimeLeft / 60)).padStart(2, "0");
                let seconds = String(otpTimeLeft % 60).padStart(2, "0");
                otpTimer.textContent = `00:${minutes}:${seconds}`;
            }, 1000);
        }

        // ---- PASSWORD VALIDATION HIDING ON INPUT ----
        const passwordFieldNames = ['CurrentPassword', 'NewPassword', 'ConfirmPassword'];

        passwordFieldNames.forEach(function (fieldName) {
            const input = document.querySelector(`[name="${fieldName}"]`);
            if (input) {
                input.addEventListener('input', function () {
                    const passwordErrorBlock = document.getElementById('passwordErrorBlock');
                    if (passwordErrorBlock) {
                        passwordErrorBlock.style.display = 'none';
                    }

                    const fieldValidationSpan = input.parentElement.querySelector('.text-danger');
                    if (fieldValidationSpan) {
                        fieldValidationSpan.style.display = 'none';
                    }

                    const generalErrors = document.querySelectorAll('.text-danger');
                    generalErrors.forEach(function (errorElement) {
                        if (errorElement.textContent &&
                            errorElement.textContent.toLowerCase().includes('password')) {
                            errorElement.style.display = 'none';
                        }
                    });
                });
            }
        });

        // ---- FORM SUBMISSION HANDLING (Simplified) ----
        const form = document.querySelector('form[method="post"]');
        const saveBtn = document.getElementById('saveBtn');
        const deleteBtn = document.getElementById('showDeleteAccountModalBtn');

        if (form) {
            form.addEventListener('submit', function (e) {
                // Disable buttons to prevent double submission
                if (saveBtn) {
                    const spinner = saveBtn.querySelector('.spinner-border');
                    const btnText = saveBtn.querySelector('.btn-text');

                    if (spinner && btnText) {
                        spinner.classList.remove('d-none');
                        btnText.textContent = 'Saving...';
                    }

                    saveBtn.disabled = true;
                    saveBtn.classList.add('btn-disabled-saving');
                }

                if (deleteBtn) {
                    deleteBtn.disabled = true;
                    deleteBtn.classList.add('btn-disabled-saving');
                }
            });
        }

        // ---- PASSWORD CHANGE TOGGLE ----
        var changePasswordBtn = document.getElementById('changePasswordBtn');
        var passwordFieldsContainer = document.getElementById('passwordFields');

        if (changePasswordBtn) {
            changePasswordBtn.addEventListener('click', function () {
                if (passwordFieldsContainer.classList.contains('d-none')) {
                    passwordFieldsContainer.classList.remove('d-none');
                } else {
                    passwordFieldsContainer.classList.add('d-none');

                    // Clear input values
                    var currentPwField = document.querySelector('[name="CurrentPassword"]');
                    var newPwField = document.querySelector('[name="NewPassword"]');
                    var confirmPwField = document.querySelector('[name="ConfirmPassword"]');

                    if (currentPwField) currentPwField.value = '';
                    if (newPwField) newPwField.value = '';
                    if (confirmPwField) confirmPwField.value = '';

                    // Hide error blocks
                    var passwordErrorBlock = document.getElementById('passwordErrorBlock');
                    if (passwordErrorBlock) passwordErrorBlock.style.display = 'none';

                    // Hide individual field errors
                    document.querySelectorAll('#passwordFields .text-danger').forEach(function (span) {
                        span.style.display = 'none';
                    });
                }
            });
        }

        // ---- DELETE ACCOUNT MODAL ----
        const deleteBtnModal = document.getElementById('showDeleteAccountModalBtn');
        const deleteModal = document.getElementById('deleteAccountModal');
        if (deleteBtnModal && deleteModal) {
            deleteBtnModal.addEventListener('click', function () {
                var modal = new bootstrap.Modal(deleteModal);
                modal.show();
            });
        }

        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        const confirmEmail = document.getElementById('confirmEmail');
        const confirmPhrase = document.getElementById('confirmPhrase');

        function validateDeleteFields() {
            if (
                confirmEmail && confirmPhrase &&
                confirmEmail.value.trim() &&
                confirmPhrase.value.trim() === 'Delete my account'
            ) {
                confirmDeleteBtn.disabled = false;
            } else {
                confirmDeleteBtn.disabled = true;
            }
        }

        if (confirmEmail && confirmPhrase) {
            confirmEmail.addEventListener('input', validateDeleteFields);
            confirmPhrase.addEventListener('input', validateDeleteFields);
        }

        if (deleteModal) {
            deleteModal.addEventListener('hidden.bs.modal', function () {
                if (confirmEmail) confirmEmail.value = '';
                if (confirmPhrase) confirmPhrase.value = '';
                if (confirmDeleteBtn) confirmDeleteBtn.disabled = true;
            });
        }

        // Optional: Clear password fields when closing the modal
        document.getElementById('passwordRequirementsModal')?.addEventListener('hidden.bs.modal', function () {
            document.querySelector('[name="NewPassword"]')?.focus();
        });

        // Razor/CSHTML modal logic (success, password requirements) should remain in your view
    });
</script>




