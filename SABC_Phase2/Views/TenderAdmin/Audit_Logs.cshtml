@model IEnumerable<SABC_Phase2.Models.Tender.AuditLog>
@{
    ViewData["BannerText"] = "Audit Logs";
}
@{
    ViewBag.Title = "Audit Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />

<!-- Breadcrumb -->
<div class="container-fluid" style="margin-top: 10px;">
    <div class="row">
        <div class="col-12">
            <a style="color:#888; text-decoration:none;">Reports</a>
            <span style="color:#888;"> &gt; </span>
            <a href="#" style="color:#17994d; text-decoration:none;">Audit Logs</a>
        </div>
    </div>
</div>

<!-- Card Section -->
<div class="audit-section" style="margin-top: 1.5rem;">
    <div class="audit-card-outer">
        <div class="audit-toggle" id="auditToggle" style="background: #17994d; border-radius: 8px 8px 0 0; border-bottom: 1px solid #e0e0e0;">
            <span style="display: flex; align-items: center;">
                <i class="fa fa-list" style="font-size: 1.5em; margin-right: 0.7em; color: #fff;"></i>
                <span class="audit-title" style="color: #fff; font-size: 1.2em;">Time Range</span>
            </span>
            <span class="toggle-arrow" id="toggleArrow" style="color: #fff;">&#9650;</span>
        </div>
        <div class="audit-card" id="auditCard" style="display: block;">
            <form id="auditFilterForm" autocomplete="off">
                <div class="audit-filter-heading" style="color: #17994d; font-size: 2em; font-weight: 500; margin-bottom: 0.2em;">Date Picker</div>
                <div class="audit-filter-underline" style="background: #17994d; height: 2px; width: 100%; margin-bottom: 2em;"></div>
                <div class="audit-filter-radios" style="margin-bottom: 2em;">
                    <label style="display: flex; align-items: center; font-size: 1.1em; margin-bottom: 1em;">
                        <input type="radio" name="dateRange" value="7" checked style="margin-right: 0.7em;" /> Last 7 days
                    </label>
                    <label style="display: flex; align-items: center; font-size: 1.1em; margin-bottom: 1em;">
                        <input type="radio" name="dateRange" value="30" style="margin-right: 0.7em;" /> Last 30 days
                    </label>
                    <label style="display: flex; align-items: center; font-size: 1.1em; margin-bottom: 1em;">
                        <input type="radio" name="dateRange" value="60" style="margin-right: 0.7em;" /> Last 60 days
                    </label>
                    <label style="display: flex; align-items: center; font-size: 1.1em;">
                        <input type="radio" name="dateRange" value="custom" id="customDateRadio" style="margin-right: 0.7em;" /> Custom date
                    </label>
                </div>
                <div class="audit-filter-calendar" style="max-width: 350px;">
                    <div style="margin-bottom: 1.5em;">
                        <label for="fromDate" style="font-size: 1em; color: #888; display: block; margin-bottom: 0.3em;">From Date *</label>
                        <input type="date" name="fromDate" id="fromDate" class="calendar-input" disabled style="width: 100%; background: #f5f5f5; color: #bbb; border: 1px solid #e0e0e0; border-radius: 5px; padding: 0.7em 1em; font-size: 1em;" />
                    </div>
                    <div>
                        <label for="toDate" style="font-size: 1em; color: #888; display: block; margin-bottom: 0.3em;">To Date *</label>
                        <input type="date" name="toDate" id="toDate" class="calendar-input" disabled style="width: 100%; background: #f5f5f5; color: #bbb; border: 1px solid #e0e0e0; border-radius: 5px; padding: 0.7em 1em; font-size: 1em;" />
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div id="generateReportWrapper" style="display: flex; justify-content: center; align-items: center; margin: 2.5rem 0 0 0;">
        <button type="button" class="generate-report-btn" style="background: #17994d; color: #fff; border: none; padding: 0.8em 3em; font-size: 1.2em; font-weight: 500; border-radius: 6px; box-shadow: 0 2px 6px rgba(23,153,77,0.12); cursor: pointer; transition: background 0.2s, box-shadow 0.2s;">Generate Report</button>
    </div>
</div>

<script>
    // Toggle card open/close
    document.getElementById("auditToggle").addEventListener("click", function () {
        var card = document.getElementById("auditCard");
        var arrow = document.getElementById("toggleArrow");
        if (card.style.display === "none" || card.style.display === "") {
            card.style.display = "block";
            arrow.innerHTML = "&#9650;";
        } else {
            card.style.display = "none";
            arrow.innerHTML = "&#9660;";
        }
    });

    // Enable/disable custom calendar fields
    function updateCalendarState() {
        var customRadio = document.getElementById("customDateRadio");
        var fromDate = document.getElementById("fromDate");
        var toDate = document.getElementById("toDate");
        if (customRadio.checked) {
            fromDate.disabled = false;
            toDate.disabled = false;
            fromDate.style.background = "#fff";
            fromDate.style.color = "#222";
            fromDate.style.border = "1px solid #17994d";
            toDate.style.background = "#fff";
            toDate.style.color = "#222";
            toDate.style.border = "1px solid #17994d";
        } else {
            fromDate.disabled = true;
            toDate.disabled = true;
            fromDate.value = "";
            toDate.value = "";
            fromDate.style.background = "#f5f5f5";
            fromDate.style.color = "#bbb";
            fromDate.style.border = "1px solid #e0e0e0";
            toDate.style.background = "#f5f5f5";
            toDate.style.color = "#bbb";
            toDate.style.border = "1px solid #e0e0e0";
        }
    }

    document.querySelectorAll('input[name="dateRange"]').forEach(function (radio) {
        radio.addEventListener('change', updateCalendarState);
    });

    // Initial state
    updateCalendarState();

    // Generate report button logic (unchanged)
    document.querySelector(".generate-report-btn").addEventListener("click", function () {
        var radio = document.querySelector('input[name="dateRange"]:checked');
        var dateRange = radio ? radio.value : null;
        var fromDate = document.getElementById("fromDate").value;
        var toDate = document.getElementById("toDate").value;

        if (dateRange === "custom" && (!fromDate || !toDate)) {
            alert("Please specify both From and To dates.");
            return;
        }
        if (dateRange !== "custom" && !dateRange) {
            alert("Please select a date range.");
            return;
        }

        var button = this;
        var originalText = button.textContent;
        button.textContent = "Generating...";
        button.disabled = true;

        var formData = new FormData();
        if (dateRange && dateRange !== "custom") formData.append("dateRange", dateRange);
        if (dateRange === "custom") {
            formData.append("fromDate", fromDate);
            formData.append("toDate", toDate);
        }

        fetch('@Url.Action("GenerateAuditLogReport", "TenderAdmin")', {
            method: 'POST',
            body: formData
        })
            .then(response => {
                if (!response.ok) {
                    return response.text().then(text => {
                        throw new Error(`Server error (${response.status}): ${text}`);
                    });
                }
                return response.blob();
            })
            .then(blob => {
                if (blob.size === 0) {
                    throw new Error("Generated PDF is empty. Please check your date range.");
                }
                var link = document.createElement('a');
                link.href = window.URL.createObjectURL(blob);
                link.download = `AuditLogReport_${new Date().toISOString().slice(0, 10)}.pdf`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                window.URL.revokeObjectURL(link.href);
            })
            .catch(error => {
                alert("Failed to generate report: " + error.message);
            })
            .finally(() => {
                button.textContent = originalText;
                button.disabled = false;
            });
    });
</script>

<style>
    .audit-card-outer {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 0 0 3px #2196f3, 0 2px 10px rgba(0,0,0,0.08);
        margin: 2rem auto 0 auto;
        max-width: 1100px;
        border: 1px solid #e0e0e0;
        padding: 0;
    }

    .audit-card {
        background: #fff;
        border-radius: 0 0 8px 8px;
        box-shadow: none;
        padding: 3rem 3.5rem 2rem 3.5rem;
        margin: 0;
        max-width: 100%;
        display: block;
    }

    .audit-toggle {
        padding: 1.2rem 2.5rem;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        user-select: none;
    }

    .toggle-arrow {
        font-size: 1.5em;
        color: #fff;
        transition: transform 0.2s;
    }

    .audit-title {
        font-size: 1.2em;
        font-weight: 500;
        color: #fff;
        letter-spacing: 1px;
    }

    .generate-report-btn:hover,
    .generate-report-btn:focus {
        background: #117838 !important;
        box-shadow: 0 4px 16px rgba(23,153,77,0.18);
    }
    /* Remove default focus outline for date fields */
    .calendar-input:focus {
        outline: none;
        box-shadow: 0 0 0 2px #2196f3;
    }
    /* Responsive */
    @@media (max-width: 700px) {
        .audit-card {
            padding: 1.5rem 1rem 1rem 1rem;
        }

        .audit-card-outer {
            margin: 1rem 0.2rem 0 0.2rem;
        }
    }
</style>