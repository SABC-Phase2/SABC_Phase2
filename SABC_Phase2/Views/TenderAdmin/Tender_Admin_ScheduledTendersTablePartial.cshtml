@model List<SABC_Phase2.Models.Tender.ScheduledTender>
@{
    int pageSize = ViewBag.PageSize ?? 7;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalItems = ViewBag.TotalItems ?? Model.Count;
    int totalPages = ViewBag.TotalPages ?? 1;
    int emptyRows = pageSize - Model.Count;
    string search = ViewBag.Search ?? "";
    string type = ViewBag.Type ?? "";

    var saTimeZone = TimeZoneInfo.FindSystemTimeZoneById("South Africa Standard Time");
}
<div class="table-container">
    <div class="table-scroll-container">
        <table class="tender-table">
            <thead>
                <tr>
                    <th>THUMBNAILS</th>
                    <th>TITLES</th>
                    <th>TENDER STATUS</th>
                    <th>SCHEDULED PUBLISH <i class="fas fa-sort"></i></th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var tender in Model)
                    {
                        var localTime = TimeZoneInfo.ConvertTimeFromUtc(tender.ScheduledPublishDateTime, saTimeZone);
                        <tr>
                            <td>
                                <img src="~/lib/Images/logoblack.png" class="tender-thumbnail" alt="SABC Logo" />
                            </td>
                            <td>
                                <div class="tender-title-block" title="@($"{tender.TenderNumber} : {tender.Title}")">
                                    <strong class="tender-number">@tender.TenderNumber</strong>
                                    <span class="tender-title">: @tender.Title</span>
                                </div>
                            </td>
                            <td>
                                <span class="tender-status tender-status-scheduled">
                                    @tender.Status
                                </span>
                            </td>
                            <td>@localTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <a asp-controller="TenderAdmin" asp-action="EditScheduled" asp-route-id="@tender.Id" class="edit-btn">Edit <i class="fas fa-edit"></i></a>
                                <button class="delete-scheduled-btn" data-scheduled-id="@tender.Id" title="Delete Scheduled Tender">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    for (int i = 0; i < emptyRows; i++)
                    {
                        <tr>
                            <td colspan="5" style="background:transparent; border:none;"></td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="no-tenders-row">
                        <td colspan="5" style="text-align:center; color:#888; font-style:italic;">
                            No scheduled tenders found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (totalPages > 1)
{
    <div class="custom-pagination">
        <ul class="pagination-list">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link arrow-link"
                   href="@Url.Action("ScheduledIndex", "TenderAdmin", new { page = currentPage - 1, pageSize, search, type })"
                   tabindex="@(currentPage == 1 ? "-1" : "0")"
                   aria-label="Previous">
                    <span aria-hidden="true">&#8592;</span>
                </a>
            </li>
            @if (currentPage > 3)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("ScheduledIndex", "TenderAdmin", new { page = 1, pageSize, search, type })">1</a>
                </li>
                @if (currentPage > 4)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                if (i == currentPage)
                {
                    <li class="page-item active">
                        <span class="page-link"><span class="page-number">@i</span></span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("ScheduledIndex", "TenderAdmin", new { page = i, pageSize, search, type })">@i</a>
                    </li>
                }
            }
            @if (currentPage < totalPages - 2)
            {
                if (currentPage < totalPages - 3)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("ScheduledIndex", "TenderAdmin", new { page = totalPages, pageSize, search, type })">@totalPages</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link arrow-link"
                   href="@Url.Action("ScheduledIndex", "TenderAdmin", new { page = currentPage + 1, pageSize, search, type })"
                   tabindex="@(currentPage == totalPages ? "-1" : "0")"
                   aria-label="Next">
                    <span aria-hidden="true">&#8594;</span>
                </a>
            </li>
        </ul>
    </div>
}