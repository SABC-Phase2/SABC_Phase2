                flex-wrap: wrap;
            }

        .icon-btn {
            min-width: 38px;
            width: 38px;
            height: 38px;
            font-size: 1.1rem;
            margin-left: 0;
            margin-right: 8px;
            margin-bottom: 4px;
        }

        .pdf-filename-cell,
        .filename-ellipsis {
            cursor: pointer;
        }

            .pdf-filename-cell:hover,
            .filename-ellipsis:hover {
                cursor: pointer;
            }


