@model SABC_Phase2.Models.Tender.Tender

@{
    ViewData["Title"] = "Awarded Tender Details";
    bool isAuthenticated = User.Identity.IsAuthenticated;
    var tenderStatus = Model.Status?.ToLower() ?? "";
    bool isOpen = tenderStatus == "open tender";
    bool isClosed = tenderStatus == "closed tender";
    bool isAwarded = tenderStatus == "awarded tender";
    bool isCancelled = tenderStatus == "cancelled tender";
    bool showGreyButton = isClosed || isAwarded || isCancelled;

    bool alreadyApplied = ViewBag.AlreadyApplied != null && (bool)ViewBag.AlreadyApplied;
    string awardedCompanyName = ViewBag.AwardedCompanyName as string;
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

<!-- Breadcrumb -->
<div class="breadcrumb-custom">
    <span>Home</span>
    <span>&gt;</span>
    <span>Tenders</span>
    <span>&gt;</span>
    <span class="breadcrumb-active">Details of Awarded Tenders</span>
</div>

<!-- Main Card -->
<div class="tender-details-card">
    <!-- Details Section Header -->
    <div class="details-header">
        <a class="back-arrow" href="javascript:history.back()">
            <i class="fas fa-arrow-left"></i>
        </a>
        <span class="details-title">
            @if (!string.IsNullOrEmpty(awardedCompanyName))
            {
                @awardedCompanyName
            }
            else
            {
                @Model.TenderNumber
            }
        </span>
    </div>
    <div class="upload-label-underline"></div>
    <br />
    <div class="tender-main-info">
        <div class="tender-title">
            <b>
                @($"{Model.TenderNumber}: {Model.Title}")
            </b>
        </div>
        <br />
        <div class="tender-meta">
            <span>@Model.TenderType</span>,
            <span>Published: @Model.DatePublished.ToString("dd MMM yyyy")</span>
        </div>
        <div class="tender-closing">
            <span>
                <b>CLOSING DATE & TIME</b>
                @Model.ClosingDate.ToString("dd MMM yyyy")
                @if (Model.ClosingTime.HasValue)
                {
                    @($" @ {Model.ClosingTime.Value:hh\\:mm}")
                }
            </span>
        </div>
        @if (!string.IsNullOrEmpty(awardedCompanyName))
        {
            <div class="tender-awarded-to" style="margin-top:10px;">
                <label>
                    <b>Tender Awarded to:</b> @awardedCompanyName
                </label>
            </div>
        }
    </div>

    <div class="tender-description" style="margin-top: 22px;">
        @Model.Description
    </div>

    <!-- Main Attachments -->
    @if (Model.Documents != null && Model.Documents.Any(d => d.AwardedTenderId == null))
    {
        <div class="tender-attachments main-attachments">
            <h4><i class="fas fa-paperclip"></i> Main Attachments</h4>
            <table>
                <tbody>
                    @foreach (var doc in Model.Documents.Where(d => d.AwardedTenderId == null))
                    {
                        <tr>
                            <td style="width:36px;">
                                <img src="~/lib/Images/pdficon.png" style="width:32px;" />
                            </td>
                            <td>
                                @doc.FileName
                            </td>
                            <td class="action-buttons">
                                <a href="@doc.SharePointPath" target="_blank" class="icon-btn view-btn" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@doc.SharePointPath" download class="icon-btn download-btn" title="Download">
                                    <i class="fas fa-download"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Awarded Tender Attachments -->
    @if (Model.AwardedTender != null && Model.AwardedTender.Documents != null && Model.AwardedTender.Documents.Any())
    {
        <div class="tender-attachments awarded-attachments">
            <h4><i class="fas fa-trophy"></i> Awarded Tender Attachments</h4>
            <table>
                <tbody>
                    @foreach (var doc in Model.AwardedTender.Documents)
                    {
                        <tr>
                            <td style="width:36px;">
                                <img src="~/lib/Images/pdficon.png" style="width:32px;" />
                            </td>
                            <td>
                                @doc.FileName
                            </td>
                            <td class="action-buttons">
                                <a href="@doc.SharePointPath" target="_blank" class="icon-btn view-btn" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="@doc.SharePointPath" download class="icon-btn download-btn" title="Download">
                                    <i class="fas fa-download"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Respond Button -->
<div class="tender-respond-row">
    @if (isOpen)
    {
        @if (isAuthenticated)
        {
            if (alreadyApplied)
            {
                <button type="button" class="respond-btn disabled-respond" disabled title="You have already applied for this tender.">
                    <i class="fas fa-check-circle"></i> Already Applied
                </button>
            }
            else
            {
                <a href="@Url.Action("Tender_Application", "OVRS_User", new { id = Model.Id })" class="respond-btn">
                    <i class="fas fa-paper-plane"></i> Respond
                </a>
            }
        }
        else
        {
            <button type="button" class="respond-btn" onclick="showLoginModal()">
                <i class="fas fa-sign-in-alt"></i> Respond
            </button>
        }
    }
    else if (showGreyButton)
    {
        <button type="button" class="respond-btn disabled-respond" disabled title="You cannot respond to this tender.">
            <i class="fas fa-ban"></i> Respond
        </button>
    }
</div>

<!-- Modal Popup -->
<div id="loginModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close" onclick="closeLoginModal()">&times;</span>
        <h2 style="color:#e74c3c;"><i class="fas fa-exclamation-circle"></i> Error</h2>
        <p>Please login in order to respond to this tender.</p>
        <a href="@Url.Action("Login", "Account")" class="modal-btn">
            <i class="fas fa-sign-in-alt"></i> Login / Register
        </a>
    </div>
</div>

<script>
    // Script to handle modal popup
    function showLoginModal() {
        document.getElementById("loginModal").style.display = "block";
    }
    function closeLoginModal() {
        document.getElementById("loginModal").style.display = "none";
    }
    // Close modal when clicking outside content
    window.onclick = function(event) {
        var modal = document.getElementById("loginModal");
        if (event.target == modal) modal.style.display = "none";
    }
</script>

<style>
    /* ------------------------------------------------------ */
    /* Modal Popup styles */
    .modal {
        display: none; /* Hidden by default */
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.4);
    }

    .modal-content {
        background-color: #fff;
        margin: 12% auto;
        padding: 30px;
        border: 1px solid #888;
        width: 340px;
        border-radius: 8px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        text-align: center;
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        position: absolute;
        top: 16px;
        right: 20px;
        cursor: pointer;
    }

    .modal-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 24px;
        padding: 10px 32px;
        background-color: #f5c012;
        color: #222;
        font-weight: bold;
        border-radius: 6px;
        text-decoration: none;
        font-size: 1.05em;
        transition: all 0.2s;
    }

        .modal-btn:hover {
            background-color: #fbbd08;
            color: #000;
            transform: translateY(-1px);
        }

    /* ------------------------------------------------------------------------- */
    /* Respond button styles */
    .respond-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: #1a7f37;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 12px 32px;
        font-size: 1.05em;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        margin-top: 24px;
    }

        .respond-btn:hover {
            background: #0e5222;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .respond-btn.disabled-respond,
        .respond-btn:disabled {
            background-color: #aaa !important;
            color: #fff !important;
            cursor: not-allowed !important;
            border: none !important;
            opacity: 0.7;
            pointer-events: none;
            transform: none !important;
            box-shadow: none !important;
        }

    /* ------------------------------------------------------------------------------------ */
    /* Attachment sections styling */
    .tender-attachments {
        margin-left: 42px;
        margin-top: 24px;
        border-radius: 8px;
        padding: 16px;
    }

    .main-attachments {
        background-color: #f8f9fa;
        border: 1px solid #e1e4e8;
    }

    .awarded-attachments {
        background-color: #f0f7f0;
        border: 1px solid #c3e6c3;
        margin-top: 16px;
    }

    .tender-attachments h4 {
        margin-bottom: 12px;
        font-size: 1.07rem;
        color: #333;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tender-attachments table {
        width: 100%;
        border-collapse: collapse;
    }

    .tender-attachments td {
        padding: 10px 12px 10px 0;
        vertical-align: middle;
        border-bottom: 1px solid #eee;
    }

    .action-buttons {
        white-space: nowrap;
        text-align: right;
        width: 100px;
    }

    /* Icon buttons */
    .icon-btn {
        background: #fff;
        color: #00a651;
        border: 1px solid #00a651;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        margin-left: 6px;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,166,81,0.10);
        transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.1s;
        text-decoration: none;
    }



        .icon-btn:hover {
            background: #f4fff9;
            color: #007a3d;
            border-color: #007a3d;
            transform: translateY(2px);
        }


    /* ------------------------------------------------------------------------------------ */
    /* General styles */
    .upload-label-underline {
        width: 100%;
        height: 2px;
        background: #1a7f37;
        margin-bottom: 16px;
        border-radius: 2px;
    }

    .breadcrumb-custom {
        color: #888;
        font-size: 1.00rem;
        font-weight: 500;
        margin: 18px 0 12px 0;
        letter-spacing: 0.01em;
        display: flex;
        align-items: center;
        gap: 0.2em;
    }

    .breadcrumb-active {
        color: #1a7f37;
        font-weight: 500;
    }

    .tender-details-card {
        background: #fff;
        border-radius: 10px;
        margin: 0 auto;
        max-width: 800px;
        margin-top: 18px;
        padding: 38px 34px 30px 34px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.09);
        position: relative;
    }

    .back-arrow {
        color: #1a7f37;
        font-size: 1.5rem;
        text-decoration: none;
        margin-right: 10px;
        display: flex;
        align-items: center;
    }

    .details-header {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
    }

    .details-title {
        font-size: 1.45rem !important;
        font-weight: 600 !important;
        color: #1a7f37 !important;
    }

    .tender-main-info {
        margin-left: 42px;
    }

    .tender-title {
        font-size: 1.13rem;
        margin-bottom: 7px;
    }

    .tender-meta {
        color: #444;
        font-size: 1.02rem;
        margin-bottom: 5px;
    }

    .tender-closing {
        color: #e74c3c;
        font-weight: 500;
        font-size: 1.04rem;
    }

    .tender-description {
        margin-left: 42px;
        color: #222;
        font-size: 1.04rem;
        margin-bottom: 22px;
        line-height: 1.6;
    }

    .tender-respond-row {
        display: flex;
        justify-content: center;
        margin-top: 28px;
        margin-bottom: 20px;
    }
</style>