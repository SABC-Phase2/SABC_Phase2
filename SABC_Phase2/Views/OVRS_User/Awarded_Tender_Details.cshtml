        line-height: 1.6;
    }

    .tender-respond-row {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        margin-top: 32px;
        margin-left: 0 !important;
        margin-right: 0 !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    /* Mobile responsiveness */
    @@media (max-width: 767px) {
        /* Card container should fit screen */
        .tender-details-card {
            padding: 22px 18px;
            margin: 12px;
            max-width: 100%;
        }
        /* Breadcrumb */
        .breadcrumb-custom {
            font-size: 0.9rem;
            flex-wrap: wrap;
        }
        /* Back arrow + title */
        .details-header {
            flex-direction: row;
            justify-content: flex-start;
        }

        .details-title {
            font-size: 1.2rem !important;
        }

        .back-arrow {
            font-size: 1.2rem;
            margin-right: 6px;
        }
        /* Remove large left indents */
        .tender-number,
        .tender-main-info,
        .tender-description,
        .tender-attachments {
            margin-left: 0 !important;
        }

        .tender-title b {
            display: block;
            margin-bottom: 8px;
        }

        .tender-meta span,
        .tender-closing span {
            display: block;
            margin-bottom: 3px;
        }

        .tender-main-info,
        .tender-title,
        .tender-meta,
        .tender-closing,
        .tender-description,
        .tender-awarded-to {
            display: block;
            width: 100%;
            white-space: normal;
            word-break: break-word;
            overflow-wrap: break-word;
        }

        .tender-title {
            font-size: 1rem;
            line-height: 1.4;
        }

        .tender-meta,
        .tender-closing,
        .tender-description {
            font-size: 0.95rem;
        }
        /* Attachments table */
        .tender-attachments-table {
            padding: 12px 14px;
        }

            .tender-attachments-table table,
            .tender-attachments-table tbody,
            .tender-attachments-table tr,
            .tender-attachments-table td {
                display: block;
                width: 100%;
            }

            .tender-attachments-table td {
                padding: 6px 0;
                text-align: left !important;
            }

        .attachment-actions {
            justify-content: flex-start;
            margin-top: 6px;
        }
        /* Respond button */
        .tender-respond-row {
            margin-top: 22px;
        }

        .respond-btn {
            width: 100%;
            font-size: 1.1rem;
            padding: 12px 109px;
        }
        /* Modals scale down */
        .modal-content,
        .already-applied-modal-content {
            width: 90% !important;
            margin: 20% auto !important;
            padding: 22px !important;
        }

        .modal-error-title {
            font-size: 1.4rem;
        }

        .modal-message {
            font-size: 1rem;
        }

        .modal-ok-btn,
        .modal-login-btn {
            font-size: 0.95rem;
            padding: 10px 22px;
        }
    }

    /* Adjust content spacing when sidebar is visible */
    @@media (min-width: 768px) {
        body .tender-details-card, body .breadcrumb-custom, body .tender-respond-row {
            margin-left: 260px; /* match your sidebar width */
        }
    }

    /* On mobile, reset so it's centered */
    @@media (max-width: 767px) {
        body .tender-details-card, body .breadcrumb-custom, body .tender-respond-row {
            margin-left: 60px;
        }
    }
    /* Desktop only: move respond button more left inside card */
    @@media (min-width: 768px) {
        .tender-respond-row {
            justify-content: center; /* align button to the left */
            padding-right: 0; /* optional spacing from card edge */
