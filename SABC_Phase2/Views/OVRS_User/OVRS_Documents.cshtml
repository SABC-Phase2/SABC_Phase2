@{
    ViewBag.Title = "My Documents";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Adjust if your layout file is different
}

<!-- Main Container -->
<div class="container-fluid my-documents-container" style="padding:0;">
    <!-- Breadcrumb -->
    <div class="row" style="margin:0;">
        <div class="col-12" style="background-color:transparent; padding:10px 40px;">
            <a href="@Url.Action("Index", "Home")" style="color:#17994d; text-decoration:none;">Home</a>
            <span style="color:#888;"> &gt; </span>
            <span style="color:#17994d;">My Documents</span>
        </div>
    </div>



    <!-- Cards Section -->
    <div class="row justify-content-center" style="margin:0; padding:40px 0 80px 0; background: transparent;">
        <div class="col-md-3 col-10 mb-4 d-flex justify-content-center">
            <a href="@Url.Action("OVRS_Submissions_Drafts", "OVRS_User", new { section = "drafts" })" class="document-card">
                <div class="card tile-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <img src="~/lib/Images/draft-responses-icon.png" alt="Draft Responses" class="tile-icon" />
                        <div class="tile-title">Draft Responses</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-10 mb-4 d-flex justify-content-center">
            <a href="@Url.Action("OVRS_Submissions_Drafts", "OVRS_User", new { section = "submissions" })" class="document-card">
                <div class="card tile-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <img src="~/lib/Images/submissions-icon.png" alt="Submissions" class="tile-icon" />
                        <div class="tile-title">Submissions</div>
                    </div>
                </div>
            </a>
        </div>
    </div>


    <style>
        .document-card {
            width: 100%;
            max-width: 360px;
            text-decoration: none;
        }

        .tile-card {
            border: none;
            border-radius: 16px;
            background: #fff;
            height: 340px; /* You can increase or decrease this */
           
            transition: box-shadow 0.2s, transform 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .tile-card:hover {
                box-shadow: 0 8px 32px rgba(34, 34, 34, 0.19);
                transform: translateY(-4px) scale(1.03);
            }

        .tile-icon {
            width: 115px; /* Adjust as needed */
            height: 110px;
            margin-bottom: 24px;
        }


        .tile-title {
            font-size: 1.4rem;
            font-weight: 600;
            color: #222;
            text-align: center;
        }

        .card-body {
            width: 100%;
            height: 100%;
            padding: 24px;
        }

        .my-documents-container h1 {
            font-size: 2rem;
            letter-spacing: 0.02em;
        }
    </style>
