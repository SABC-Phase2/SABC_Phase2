@{
    ViewBag.Title = "My Documents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Main Container -->
<div class="container-fluid my-documents-container" style="padding:0;">
    <!-- Breadcrumb -->
    <div class="row" style="margin:0;">
        <div class="col-12 breadcrumb-wrapper">
            <a href="@Url.Action("Index", "OVRS_User")" class="breadcrumb-link">Home</a>
            <span class="breadcrumb-separator"> &gt; </span>
            <span class="breadcrumb-current">My Documents</span>
        </div>
    </div>

    <!-- Cards Section -->
    <div class="row justify-content-center cards-section">
        <div class="col-md-3 col-10 mb-4 d-flex justify-content-center">
            <a href="@Url.Action("OVRS_Submissions_Drafts", "OVRS_User", new { section = "drafts" })" class="document-card">
                <div class="card tile-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <img src="~/lib/Images/draft-responses-icon.png" alt="Draft Responses" class="tile-icon" />
                        <div class="tile-title">Draft Responses</div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-10 mb-4 d-flex justify-content-center">
            <a href="@Url.Action("OVRS_Submissions_Drafts", "OVRS_User", new { section = "submissions" })" class="document-card">
                <div class="card tile-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <img src="~/lib/Images/submissions-icon.png" alt="Submissions" class="tile-icon" />
                        <div class="tile-title">Submissions</div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    /* Breadcrumb styling */
    .breadcrumb-wrapper {
        padding: 10px 40px;
    }

    .breadcrumb-link {
        color: #888;
        text-decoration: none;
    }

    .breadcrumb-separator {
        color: #888;
        margin: 0 4px;
    }

    .breadcrumb-current {
        color: #17994d;
        font-weight: 600;
    }

    /* Card wrapper */
    .document-card {
        width: 100%;
        max-width: 360px;
        text-decoration: none;
    }

    .tile-card {
        border: none;
        border-radius: 16px;
        background: #fff;
        height: 340px;
        transition: box-shadow 0.2s, transform 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .tile-card:hover {
            box-shadow: 0 8px 32px rgba(34, 34, 34, 0.19);
            transform: translateY(-4px) scale(1.03);
        }

    .tile-icon {
        width: 115px;
        height: 110px;
        margin-bottom: 24px;
    }

    .tile-title {
        font-size: 1.4rem;
        font-weight: 600;
        color: #222;
        text-align: center;
    }

    .card-body {
        width: 100%;
        height: 100%;
        padding: 24px;
    }

    /* Responsive tweaks */
    @@media (max-width: 767px) {
        .breadcrumb-wrapper {
            padding: 10px 15px;
            font-size: 0.9rem;
        }

        .cards-section {
            padding: 20px 0 60px 20px; /* add left padding */
        }

        .document-card {
            margin-left: 10px; /* shift each card slightly */
        }

        .tile-card {
            height: 280px; /* smaller height for mobile */
        }

        .tile-icon {
            width: 90px;
            height: 85px;
            margin-bottom: 16px;
        }

        .tile-title {
            font-size: 1.1rem;
        }
    }

    @@media (max-width: 480px) {
        .breadcrumb-wrapper {
            text-align: center;
            font-size: 0.85rem;
        }

        .cards-section {
            padding: 15px 0 40px 25px;
        }

        .document-card {
            margin-left: 12px;
        }

        .tile-card {
            height: 240px;
            border-radius: 12px;
        }

        .tile-icon {
            width: 70px;
            height: 65px;
            margin-bottom: 12px;
        }

        .tile-title {
            font-size: 1rem;
        }
    }</style>

