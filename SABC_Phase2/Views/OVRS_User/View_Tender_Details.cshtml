@model SABC_Phase2.Models.Tender.Tender

@{
    ViewData["Title"] = "Tender Details";
    bool isAuthenticated = User.Identity.IsAuthenticated;
    var tenderStatus = Model.Status?.ToLower() ?? "";
    bool isOpen = tenderStatus == "open tender";
    bool isClosed = tenderStatus == "closed tender";
    bool isAwarded = tenderStatus == "awarded tender";
    bool isCancelled = tenderStatus == "cancelled tender";
    bool showGreyButton = isClosed || isAwarded || isCancelled;
    bool alreadyApplied = ViewBag.AlreadyApplied ?? false;
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

<!-- Breadcrumb -->
<div class="breadcrumb-custom">
    <span>Home</span>
    <span>&gt;</span>
    <span>Tenders</span>
    <span>&gt;</span>
    <span class="breadcrumb-active">Details of Tenders</span>
</div>

<!-- Main Card -->
<div class="tender-details-card">
    <!-- Details Section Header -->
    <div class="details-header">
        <a class="back-arrow" href="javascript:history.back()">
            <i class="fas fa-arrow-left"></i>
        </a>
        <span class="details-title">@Model.TenderNumber</span>
    </div>
    <div class="upload-label-underline"></div>
    <br />
    <div class="tender-main-info">
        <div class="tender-title">
            <b>@Model.TenderNumber: @Model.Title</b>
        </div>
        <br />
        <div class="tender-meta">
            <span>@Model.TenderType</span>,
            <span>Published: @Model.DatePublished.ToString("dd MMM yyyy")</span>
        </div>
        <div class="tender-closing">
            <span>
                <b>CLOSING DATE & TIME</b>
                @Model.ClosingDate.ToString("dd MMM yyyy")
                @if (Model.ClosingTime.HasValue)
                {
                    @($" @ {Model.ClosingTime.Value:hh\\:mm}")
                }
            </span>
        </div>
    </div>

    <div class="tender-description" style="margin-top: 22px;">
        @Model.Description
    </div>

    <!-- Attachments -->
    @if (Model.Documents != null && Model.Documents.Any())
    {
        <div class="tender-attachments">
            <h4>Attachments</h4>
            <div class="tender-attachments-table">
                <table>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td style="width:36px;">
                                    <img src="~/lib/Images/pdficon.png" style="width:32px;" />
                                </td>
                                <td>
                                    @doc.FileName
                                </td>
                                <td colspan="2" style="text-align: right;">
                                    <div class="attachment-actions">
                                        <a href="@doc.SharePointPath" target="_blank" class="icon-btn" title="View">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@doc.SharePointPath" download class="icon-btn" title="Download">
                                            <i class="fas fa-download"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

<!-- Respond Button always visible, but may be disabled/greyed out -->
<div class="tender-respond-row">
    @if (isOpen)
    {
        if (isAuthenticated)
        {
            if (alreadyApplied)
            {
                // Show a button that triggers the modal
                <button type="button" class="respond-btn" onclick="showAlreadyAppliedModal()">Respond</button>
            }
            else
            {
                // Normal respond link
                <a href="@Url.Action("Tender_Application", "OVRS_User", new { id = Model.Id })" class="respond-btn">Respond</a>
            }
        }
        else
        {
            <button type="button" class="respond-btn" onclick="showLoginModal()">Respond</button>
        }
    }
    else if (showGreyButton)
    {
        <button type="button" class="respond-btn disabled-respond" disabled title="You cannot respond to this tender.">Respond</button>
    }
</div>

<!-- Login To Respond to Tender Popup -->
<div id="loginModal" class="modal" style="display:none;">
    <div class="modal-content">
        <span class="close" onclick="closeLoginModal()">&times;</span>
        <!-- X cross image -->
        <img src="~/lib/Images/X-Box.png" alt="Error" style="width: 60px; height: 60px; margin: 0 auto 18px auto; display: block;" />
        <!-- Error in red -->
        <div style="font-size:1.5rem; font-weight:700; color:#ef4444; margin-bottom: 6px;">Error</div>
        <!-- Grey message -->
        <div style="font-size:1.1rem; color:#888;">Please login to respond to a tender</div>
        <!-- Close button (optional, can use the X in top right if needed) -->
        <div class="modal-btn-container">
            <a href="@Url.Action("Login", "Account")" class="modal-login-btn">
              Login
            </a>
        </div>
    </div>
</div>

<!-- Already Applied Modal -->
<div id="alreadyAppliedModal" class="modal" style="display:none;">
    <div class="modal-content already-applied-modal-content">
        <span class="close" onclick="closeAlreadyAppliedModal()">&times;</span>
        <div class="modal-icon-container">
            <div class="error-icon-circle">
                <i class="fas fa-info-circle"></i>
            </div>
        </div>
        <h2 class="modal-error-title">Already Applied</h2>
        <p class="modal-message">You have already applied for this tender. Only one submission is allowed per tender.</p>
        <div class="modal-btn-container">
            <button class="modal-ok-btn" onclick="closeAlreadyAppliedModal()">
                <i class="fas fa-check"></i> OK
            </button>
        </div>
    </div>
</div>

<script>
    // Script to handle modal popup
    function showLoginModal() {
        document.getElementById("loginModal").style.display = "block";
    }
    function closeLoginModal() {
        document.getElementById("loginModal").style.display = "none";
    }
    // Close modal when clicking outside content
    window.onclick = function(event) {
        var modal = document.getElementById("loginModal");
        if (event.target == modal) modal.style.display = "none";
    }

        // Already Applied Modal logic
    function showAlreadyAppliedModal() {
        document.getElementById("alreadyAppliedModal").style.display = "block";
    }
    function closeAlreadyAppliedModal() {
        document.getElementById("alreadyAppliedModal").style.display = "none";
    }
      // Optional: close on outside click
    window.addEventListener('click', function(event) {
        var modal = document.getElementById("alreadyAppliedModal");
        if (event.target == modal) modal.style.display = "none";
    });
</script>

