@model List<SABC_Phase2.Models.Tender.Tender>
@{
    int pageSize = ViewBag.PageSize ?? 7;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalItems = ViewBag.TotalItems ?? Model.Count;
    int totalPages = ViewBag.TotalPages ?? 1;
    int emptyRows = pageSize - Model.Count;
    string search = ViewBag.Search ?? "";
    string status = ViewBag.Status ?? "";
    string type = ViewBag.Type ?? "";
}
<div class="table-container">
    <div class="table-scroll-container">
        <table class="tender-table">
            <thead>
                <tr>
                    <th>THUMBNAILS</th>
                    <th>TITLES</th>
                    <th>TENDER STATUS</th>
                    <th>DATE PUBLISHED <i class="fas fa-sort"></i></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tender in Model)
                {
                    var tenderStatus = tender.Status?.ToLower();
                    string detailsUrl = tenderStatus == "awarded tender"
                    ? Url.Action("Awarded_Tender_Details", "OVRS_User", new { id = tender.Id })
                    : Url.Action("View_Tender_Details", "OVRS_User", new { id = tender.Id });

                    <tr class="clickable-row"
                        data-url="@detailsUrl"
                        style="cursor:pointer;">
                        <td>
                            <img src="~/lib/Images/logoblack.png" class="tender-thumbnail" alt="SABC Logo" />
                        </td>
                        <td>
                            @{
                                var tenderText = !string.IsNullOrWhiteSpace(tender.TenderNumber)
                                ? tender.TenderNumber + (string.IsNullOrWhiteSpace(tender.Title) ? "" : ": " + tender.Title)
                                : "(No Tender Number)" + (string.IsNullOrWhiteSpace(tender.Title) ? "" : ": " + tender.Title);
                            }

                            <div class="tender-title-block truncate-text" title="@tenderText">
                                @if (!string.IsNullOrWhiteSpace(tender.TenderNumber))
                                {
                                    <strong class="tender-number">@tender.TenderNumber</strong>
                                }
                                else
                                {
                                    <strong class="tender-number">(No Tender Number)</strong>
                                }

                                @if (!string.IsNullOrWhiteSpace(tender.Title))
                                {
                                    @(": " + tender.Title)
                                }
                        </div>
                    </td>

                    <td>
                        <span class="tender-status
                                    @(tenderStatus == "open tender" ? "tender-status-open" :
                                                                                                                                tenderStatus == "closed tender" ? "tender-status-closed" :
                                                                                                                                tenderStatus == "awarded tender" ? "tender-status-awarded" :
                                                                                                                                tenderStatus == "cancelled tender" ? "tender-status-cancelled" : "")">
                            @tender.Status
                        </span>
                    </td>
                    <td>@tender.DatePublished.ToString("yyyy-MM-dd")</td>
                </tr>
                                }
                @for (int i = 0; i < emptyRows; i++)
                {
                    <tr>
                        <td colspan="4" style="background:transparent; border:none;"></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@if (totalPages > 1)
{
    <div class="custom-pagination">
        <ul class="pagination-list">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link arrow-link" href="@Url.Action("Index", new { page = currentPage - 1, pageSize, search, status, type })" tabindex="@(currentPage == 1 ? "-1" : "0")" aria-label="Previous">
                    <span aria-hidden="true">&#8592;</span>
                </a>
            </li>
            @if (currentPage > 3)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { page = 1, pageSize, search, status, type })">1</a>
                </li>
                @if (currentPage > 4)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
            }
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
            {
                if (i == currentPage)
                {
                    <li class="page-item active">
                        <span class="page-link"><span class="page-number">@i</span></span>
                    </li>
                }
                else
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize, search, status, type })">@i</a>
                    </li>
                }
            }
            @if (currentPage < totalPages - 2)
            {
                if (currentPage < totalPages - 3)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { page = totalPages, pageSize, search, status, type })">@totalPages</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link arrow-link" href="@Url.Action("Index", new { page = currentPage + 1, pageSize, search, status, type })" tabindex="@(currentPage == totalPages ? "-1" : "0")" aria-label="Next">
                    <span aria-hidden="true">&#8594;</span>
                </a>
            </li>
        </ul>
    </div>
}
<script>
    // Make each row clickable and navigate to details (needed for AJAX updates)
    document.querySelectorAll('.clickable-row').forEach(function(row) {
        row.onclick = function() {
            var url = row.getAttribute('data-url');
            if (url) window.location.href = url;
        };
    });
</script>

<style>

    .truncate-text {
        display: inline-block;
        max-width: 220px; /* adjust width as needed */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
    }

    .tender-title {
        max-width: 240px;
        font-weight: bold;
    }
</style>