@model SABC_Phase2.ViewModels.TenderApplicationViewModel

@{
    ViewData["BannerText"] = "Tender Application";
    ViewBag.Title = "Tender Application";
    var draft = Model.Draft;
}

<!-- Breadcrumb -->
<div class="breadcrumb-custom" style="margin-top: 12px;">
    Home <span class="breadcrumb-arrow">&#x2794;</span>
    Tenders <span class="breadcrumb-arrow">&#x2794;</span>
    Details of Tenders <span class="breadcrumb-arrow">&#x2794;</span>
    <span class="breadcrumb-active">Tender Application</span>
</div>

<div class="tender-app-card">

    <!-- Details Section -->
    <div class="details-header">
        <a class="back-arrow" href="javascript:history.back()">
            <i class="fas fa-arrow-left"></i>
        </a>
        <span class="details-title">Details of Tender</span>
    </div>
    <div class="details-underline"></div>

    <form id="tenderAppForm" asp-action="SubmitTenderApplication" enctype="multipart/form-data" method="post" autocomplete="off">
        <div class="tender-details-form">
            <div class="form-row">
                <!-- Keep these hidden in form -->
                <input type="hidden" name="LegacyUserId" value="@(Model.LegacyUserId?.ToString() ?? "")" />
                @if (draft != null && draft.DraftId != Guid.Empty)
                {
                    <input type="hidden" name="DraftId" value="@draft.DraftId" />
                }
                <input type="hidden" name="TenderId" value="@Model.Tender.Id" />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Tender Type</label>
                    <input type="text" class="form-control" readonly value="@Model.Tender.TenderType" />
                </div>
                <div class="form-group">
                    <label>Tender Title</label>
                    <input type="text" class="form-control" readonly value="@Model.Tender.Title" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Tender Number</label>
                    <input type="text" class="form-control" readonly value="@Model.Tender.TenderNumber" />
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" class="form-control" readonly value="@Model.CompanyEmail" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Company Name</label>
                    <input type="text" class="form-control" readonly value="@Model.CompanyName" />
                </div>
                <div class="form-group">
                    <label>Closing Date &amp; Time</label>
                    <input type="text" class="form-control" readonly style="color:#d32f2f;"
                           value="@Model.Tender.ClosingDate.ToString("dd MMMM yyyy")@(Model.Tender.ClosingTime.HasValue ? $" @ {Model.Tender.ClosingTime.Value:hh\\:mm}" : "")" />
                </div>
            </div>
        </div>

        <div class="upload-header">
            <span class="upload-title">Upload Documents</span>
            <div class="details-underline" style="margin-bottom:10px;"></div>
            <div style="color:#d32f2f;font-size:0.95rem;font-weight:500;margin-bottom:10px;">
                *This section has a maximum upload limit of 100MB!
            </div>
        </div>

        <div id="uploadedFilesScrollWrapper" style="max-height: 280px; overflow-y: auto;">
            <div id="uploadedFilesContainer" class="mt-3">
                @if (draft != null && draft.Documents != null && draft.Documents.Any())
                {
                    foreach (var doc in draft.Documents)
                    {
                        <div class="uploaded-file-entry existing-doc p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light" data-doc-id="@doc.Id">
                            <div>
                                <strong>@doc.FileName</strong>
                                <div class="text-muted small mt-1" style="font-size:0.75rem;">
                                    <a href="@Url.Action("ViewDocument", "OVRS_User", new { id = doc.Id })" target="_blank">View</a>
                                    <a href="#" class="delete-doc-link" data-doc-id="@doc.Id">Delete</a>
                                </div>
                               
                            </div>
                        </div>
                    }
                }
             </div>
          
        </div>

        <div id="uploadInputGroup" class="d-flex align-items-center justify-content-between mt-3">
            <label class="supporting-label mb-0">
                <i class="fas fa-file-pdf text-danger me-1"></i> Supporting Document
            </label>
            <label class="btn btn-success btn-sm d-flex align-items-center gap-1 mb-0">
                <i class="fas fa-upload"></i> Upload
                <input type="file" id="UploadedFiles" name="UploadedFiles" multiple accept=".pdf" hidden />
            </label>
        </div>

        <div class="app-action-buttons" style="margin-top: 36px;">
            <button type="button" class="app-btn draft-btn" onclick="saveAsDraft()">Save as draft</button>
            <button type="button" class="app-btn submit-btn" id="submitBtn">Submit <span class="arrow-icon"></span></button>
        </div>
    </form>
</div>

<!-- Modal Popups -->
<div id="applicationSuccessModal" class="modal fade" tabindex="-1" aria-labelledby="applicationSuccessModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="applicationSuccessModalLabel" style="width:100%;text-align:center; color:#1a7f37;">

                    Application Submitted
                </h5>
                <img src="~/lib/Images/Tick-Box.png" alt="Success" style="width: 74px; height: 74px; margin: 12px auto 0 auto; display: block;" />
            </div>
            <div class="modal-body">
                <p style="font-size:1.35rem; font-weight:600; color:#1a7f37;">Your tender application was submitted successfully!</p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="applicationSuccessModalCloseBtn" class="btn btn-primary" style="min-width:100px;">Close</button>
            </div>
        </div>
    </div>
</div>

<div id="submissionErrorModal" class="modal fade" tabindex="-1" aria-labelledby="submissionErrorModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="submissionErrorModalLabel" style="width:100%;text-align:center; color:#e11d48;">

                    Submission Error
                </h5>
            </div>
            <div class="modal-body">
                <i class="fas fa-exclamation-circle" style="font-size:3.5rem; color:#e11d48; margin-bottom:16px;"></i>
                <p style="font-size:1.15rem; font-weight:500; color:#1a7f37; margin-top:12px;">

                    Please upload a document to submit your response.
                </p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="submissionErrorModalCloseBtn" class="btn btn-primary" style="min-width:100px;">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Popup for Draft Save Success (OVRS User) -->
<div id="ovrsDraftSavedModal" class="modal fade" tabindex="-1" aria-labelledby="ovrsDraftSavedModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="ovrsDraftSavedModalLabel" style="width:100%;text-align:center;">
                    <span id="ovrsDraftModalTenderNumber" style="font-weight:bold;"></span>
                </h5>
                <img src="~/lib/Images/Tick-Box.png" alt="Success" style="width: 64px; height: 64px; margin: 12px auto 0 auto; display: block;" />
            </div>
            <div class="modal-body">
                <p style="font-size:1.25rem; font-weight:600;">Draft saved</p>
                <div style="font-size:0.95rem; color: #222; margin-top:10px;">

                    Your draft has been saved to
                    <a href="#" id="ovrsDraftResponsesLink" style="color:#222; text-decoration:underline; font-weight:500;">draft responses</a>
                </div>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="ovrsDraftModalCloseBtn" class="btn btn-primary" style="min-width:100px;">Close</button>
            </div>
        </div>
    </div>
</div>

<div id="tenderClosedModal" class="modal fade" tabindex="-1" aria-labelledby="tenderClosedModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="tenderClosedModalLabel" style="width:100%;text-align:center; color:#e11d48;">

                    Submission Error
                </h5>
            </div>
            <div class="modal-body">
                <i class="fas fa-exclamation-circle" style="font-size:3.5rem; color:#e11d48; margin-bottom:16px;"></i>
                <p style="font-size:1.15rem; font-weight:500; color:#1a7f37; margin-top:12px;">

                    Unfortunately, you have missed the deadline.
                </p>
                <div id="tenderClosedDateTime" style="font-size:1.05rem; color:#222; margin-top:8px;"></div>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="tenderClosedModalCloseBtn" class="btn btn-primary" style="min-width:100px;">Close</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        const MAX_TOTAL_SIZE = 100 * 1024 * 1024;
        let storedFiles = [];

        const fileInput = document.getElementById("UploadedFiles");
        const uploadedFilesContainer = document.getElementById("uploadedFilesContainer");
        const uploadInputGroup = document.getElementById("uploadInputGroup");
        const form = document.getElementById("tenderAppForm");
        const submitBtn = document.getElementById("submitBtn");

        function formatFileSize(bytes) {
            if (bytes < 1024) return `${bytes} B`;
            else if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
            else return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
        }

        // Handle file selection
        fileInput.addEventListener("change", function () {
            let totalSize = storedFiles.reduce((sum, f) => sum + f.file.size, 0);
            for (const file of fileInput.files) {
                if (!file.name.endsWith(".pdf")) {
                    alert(`${file.name} is not a PDF.`);
                    continue;
                }
                if (storedFiles.some(f => f.name === file.name && f.size === file.size)) {
                    continue;
                }
                if (totalSize + file.size > MAX_TOTAL_SIZE) {
                    alert(`Cannot add "${file.name}". Upload limit of 100MB will be exceeded.`);
                    continue;
                }
                storedFiles.push({ file: file, uploadedAt: new Date(), name: file.name, size: file.size });
                totalSize += file.size;
            }
            renderUploadedFiles();
            fileInput.value = "";
            // NO autosave here!
        });

        function renderUploadedFiles() {
            const existingDocs = Array.from(uploadedFilesContainer.querySelectorAll('.existing-doc'));
            uploadedFilesContainer.innerHTML = "";
            existingDocs.forEach(doc => uploadedFilesContainer.appendChild(doc));
            storedFiles.forEach((fileInfo, index) => {
                const { file, uploadedAt } = fileInfo;
                const fileRow = document.createElement("div");
                fileRow.className = "uploaded-file-entry p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light";
                const fileDetails = document.createElement("div");
                const fileName = document.createElement("strong");
                fileName.textContent = file.name;
                const fileMeta = document.createElement("div");
                fileMeta.className = "text-muted small mt-1";
                fileMeta.style.fontSize = "0.75rem";
                const size = formatFileSize(file.size);
                const time = uploadedAt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                fileMeta.textContent = `${size} • Uploaded at ${time}`;
                fileDetails.appendChild(fileName);
                fileDetails.appendChild(fileMeta);
                const actions = document.createElement("div");
                actions.className = "uploaded-file-actions d-flex";
                const viewBtn = document.createElement("button");
                viewBtn.type = "button";
                viewBtn.className = "btn btn-outline-primary btn-sm me-2";
                viewBtn.innerHTML = '<i class="fas fa-eye"></i>';
                viewBtn.onclick = () => {
                    const fileURL = URL.createObjectURL(file);
                    window.open(fileURL, "_blank");
                };
                const deleteBtn = document.createElement("button");
                deleteBtn.type = "button";
                deleteBtn.className = "btn btn-outline-danger btn-sm";
                deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
                deleteBtn.onclick = () => {
                    storedFiles.splice(index, 1);
                    renderUploadedFiles();
                    // NO autosave here!
                };
                actions.appendChild(viewBtn);
                actions.appendChild(deleteBtn);
                fileRow.appendChild(fileDetails);
                fileRow.appendChild(actions);
                uploadedFilesContainer.appendChild(fileRow);
            });
        }

          submitBtn.addEventListener("click", function (e) {
            // Check if any files are uploaded (either new or existing)
            const hasNewFiles = storedFiles.length > 0;
            const hasExistingDocs = document.querySelectorAll('.existing-doc').length > 0;
            if (!hasNewFiles && !hasExistingDocs) {
                showSubmissionErrorModal();
                return;
            }

            // ...rest of your existing submit logic...
            const formData = new FormData(form);
            storedFiles.forEach(fileInfo => {
                formData.append("UploadedFiles", fileInfo.file);
            });

            submitBtn.disabled = true;
            submitBtn.innerHTML = 'Submitting... <span class="arrow-icon"></span>';

            fetch(form.action, {
                method: "POST",
                body: formData,
                headers: {}
            })
            .then(response => {
                if (response.headers.get("content-type")?.includes("application/json")) {
                    return response.json().then(data => {
                        if (data.success) {
                            showApplicationSuccessModal();
                        } else {
                            alert(data.message || "Submission failed.");
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = 'Submit <span class="arrow-icon"></span>';
                        }
                    });
                } else if (response.redirected) {
                    window.location.href = response.url;
                } else {
                    return response.text().then(html => {
                        document.body.innerHTML = html;
                    });
                }
            })
            .catch(error => {
                alert("Error submitting application.");
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Submit <span class="arrow-icon"></span>';
            });
        });

        function showApplicationSuccessModal() {
            const modal = document.getElementById('applicationSuccessModal');
            modal.classList.add('show');
            modal.style.display = 'flex';
            document.getElementById('applicationSuccessModalCloseBtn').onclick = function() {
                modal.classList.remove('show');
                modal.style.display = 'none';
                window.location.href = '/OVRS_User/Index'; // Or another relevant page
            };
        }
                function showSubmissionErrorModal() {
            const modal = document.getElementById('submissionErrorModal');
            modal.classList.add('show');
            modal.style.display = 'flex';
            document.getElementById('submissionErrorModalCloseBtn').onclick = function() {
                modal.classList.remove('show');
                modal.style.display = 'none';
            };
        }

        function showOvrDraftSavedModal(tenderNumber, draftResponsesUrl) {
            document.getElementById('ovrsDraftModalTenderNumber').innerText = tenderNumber || '';
            document.getElementById('ovrsDraftResponsesLink').href = draftResponsesUrl || '#';
            document.getElementById('ovrsDraftSavedModal').classList.add('show');
            document.getElementById('ovrsDraftSavedModal').style.display = 'flex';
            document.getElementById('ovrsDraftModalCloseBtn').onclick = function() {
                document.getElementById('ovrsDraftSavedModal').classList.remove('show');
                document.getElementById('ovrsDraftSavedModal').style.display = 'none';
            };
        }

                function showTenderClosedModal(closingDateTime) {
            document.getElementById('tenderClosedDateTime').innerText = closingDateTime
                ? `Closed on: ${closingDateTime}`
                : '';
            const modal = document.getElementById('tenderClosedModal');
            modal.classList.add('show');
            modal.style.display = 'flex';
            document.getElementById('tenderClosedModalCloseBtn').onclick = function() {
                modal.classList.remove('show');
                modal.style.display = 'none';
            };
        }
        function saveAsDraft(isAuto = false) {
            const form = document.getElementById("tenderAppForm");
            const formData = new FormData(form);
            storedFiles.forEach(fileInfo => {
                formData.append("UploadedFiles", fileInfo.file);
            });

            const draftIdField = form.querySelector("input[name='DraftId']");
            if (draftIdField && draftIdField.value) {
                formData.append("DraftId", draftIdField.value);
            }

            let completed = false;
            if (isAuto && window.event && window.event.type === "beforeunload") {
                try {
                    const xhr = new XMLHttpRequest();
                    xhr.open("POST", '/OVRS_User/SaveTenderApplicationDraft', false);
                    xhr.send(formData);
                    completed = true;
                } catch (err) {
                    // Ignore, fallback below
                }
            }
            if (!completed) {
                fetch('/OVRS_User/SaveTenderApplicationDraft', {
                    method: "POST",
                    body: formData,
                    headers: {}
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        if (!isAuto) {
                            // Use the tender number and draft responses URL if available
                            const tenderNumber = form.querySelector("input[name='TenderNumber']")?.value || "";
                            const draftResponsesUrl = "/OVRS_User/OVRS_Submissions_Drafts";
                            showOvrDraftSavedModal(tenderNumber, draftResponsesUrl);
                        }
                        if (data.draftId && !draftIdField) {
                            let input = document.createElement("input");
                            input.type = "hidden";
                            input.name = "DraftId";
                            input.value = data.draftId;
                            form.appendChild(input);
                        } else if (data.draftId) {
                            draftIdField.value = data.draftId;
                        }
                    } else {
                        if (!isAuto) alert(data.message || "Failed to save draft.");
                    }
                })
                .catch(error => {
                    if (!isAuto) alert("Error saving draft.");
                    console.error(error);
                });
            }
        }

        $(document).on('click', '.delete-doc-link', function (e) {
            e.preventDefault();
            var docId = $(this).data('doc-id');
            if (confirm("Are you sure you want to delete this document?")) {
                $.ajax({
                    url: '/OVRS_User/DeleteDocument/' + docId,
                    type: 'POST',
                    success: function (data) {
                        if (data.success) {
                            $('div[data-doc-id="' + docId + '"]').remove();
                            // NO autosave here!
                        } else {
                            alert(data.message || "Failed to delete document.");
                        }
                    },
                    error: function () {
                        alert("Error deleting document.");
                    }
                });
            }
        });

        // NO autoSaveTimeout, NO scheduleDraftAutoSave, NO input/change event listeners

        window.addEventListener('beforeunload', function (e) {
            if (storedFiles.length > 0 || form.checkValidity()) {
                window.event = e;
                saveAsDraft(true);
            }
        });

        // Optional: Explicit "Save Draft" button handler
        const saveDraftBtn = document.getElementById("saveDraftBtn");
        if (saveDraftBtn) {
            saveDraftBtn.addEventListener('click', function(e){
                e.preventDefault();
                saveAsDraft(false);
            });
        }
    </script>
    }


<style>
