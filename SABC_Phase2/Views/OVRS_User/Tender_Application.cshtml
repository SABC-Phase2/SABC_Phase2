            display: flex !important;
            align-items: center;
            justify-content: center;
        }

    .tender-app-card {
        background: #fff;
        border-radius: 12px;
        margin: 0 auto;
        max-width: 780px;
        margin-top: 24px;
        padding: 38px 36px 26px 36px;
