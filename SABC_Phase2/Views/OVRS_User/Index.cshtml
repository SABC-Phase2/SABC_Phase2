@model List<SABC_Phase2.Models.Tender.Tender>
@{
    ViewData["BannerText"] = "Tenders";
    int pageSize = ViewBag.PageSize ?? 7;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? (Model?.Count ?? 0);
    string search = ViewBag.Search as string ?? "";
    string statusFilter = ViewBag.Status as string ?? "";
    string typeFilter = ViewBag.Type as string ?? "";
}

<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />

<div class="breadcrumb-custom">
    <span class="breadcrumb-active">Home</span>
</div>

<div class="tender-action-bar">
    <form method="get" id="filterForm" style="display: flex; align-items: center; gap: 16px;">
        <input type="hidden" name="status" value="@statusFilter" />
        <span class="search-wrapper" style="position: relative; display: flex; align-items: center;">
            <i class="fas fa-search" style="position:absolute; left:12px; color:#ccc; font-size:1rem;"></i>
            <input type="text" name="search" class="search-input"
                   value="@search"
                   placeholder="Search keyword"
                   autocomplete="off"
                   style="padding-left: 38px;" />
        </span>
        <select name="type" class="filter-dropdown" id="tenderTypeDropdown">
            <option value="" selected="@(string.IsNullOrEmpty(typeFilter) ? "selected" : null)">ALL TENDER TYPES</option>
            <option value="rfq" selected="@(typeFilter == "rfq" ? "selected" : null)">RFQ</option>
            <option value="rfp" selected="@(typeFilter == "rfp" ? "selected" : null)">RFP</option>
            <option value="rfi" selected="@(typeFilter == "rfi" ? "selected" : null)">RFI</option>
            <option value="rfo" selected="@(typeFilter == "rfo" ? "selected" : null)">RFO</option>
        </select>
        <button type="button" class="refresh-btn"
                title="Refresh table"
                style="margin-left: 0;">
            <i class="fas fa-sync-alt"></i>
        </button>
    </form>
</div>

<div id="tenders-table">
    @await Html.PartialAsync("OVRS_TendersTablePartial_Index", Model)
</div>

<script>
    // Debounce utility for search input
    function debounce(fn, delay) {
        let timer = null;
        return function(...args) {
            clearTimeout(timer);
            timer = setTimeout(() => fn.apply(this, args), delay);
        };
    }

    // AJAX form submission for search/filter/pagination
    function submitForm(keepPage = false) {
        const form = document.getElementById('filterForm');
        // If not keepPage, reset to page=1 for a new search
        if (!keepPage) {
            let pageInput = document.createElement('input');
            pageInput.type = "hidden";
            pageInput.name = "page";
            pageInput.value = "1";
            form.appendChild(pageInput);
        }
        const data = new URLSearchParams(new FormData(form)).toString();
        fetch('@Url.Action("Index", "OVRS_User")' + '?' + data, {
            headers: { "X-Requested-With": "XMLHttpRequest" }
        })
        .then(resp => resp.text())
        .then(html => {
            document.getElementById('tenders-table').innerHTML = html;
            // Restore filter values after AJAX update
            const params = new URLSearchParams(new FormData(document.getElementById('filterForm')));
            document.querySelector('#tenderTypeDropdown').value = params.get('type') ?? '';
            document.querySelector('.search-input').value = params.get('search') ?? '';
            hookRowClicks();
            hookPaginationLinks();
                    hookSortIcon();

        });
    }

    const debouncedSubmit = debounce(() => submitForm(false), 300);

    // Make table rows clickable
    function hookRowClicks() {
        document.querySelectorAll('.clickable-row').forEach(function(row) {
            row.onclick = function() {
                var url = row.getAttribute('data-url');
                if (url) window.location.href = url;
            };
        });
    }

    // AJAX pagination
    function hookPaginationLinks() {
        document.querySelectorAll('.pagination-list a.page-link').forEach(function(link) {
            link.onclick = function(e) {
                e.preventDefault();
                const url = new URL(link.href);
                const params = new URLSearchParams(url.search);
                document.querySelector('#tenderTypeDropdown').value = params.get('type') ?? '';
                document.querySelector('.search-input').value = params.get('search') ?? '';
                fetch(link.href, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                .then(resp => resp.text())
                .then(html => {
                    document.getElementById('tenders-table').innerHTML = html;
                    document.querySelector('#tenderTypeDropdown').value = params.get('type') ?? '';
                    document.querySelector('.search-input').value = params.get('search') ?? '';
                    hookRowClicks();
                    hookPaginationLinks();
                            hookSortIcon();

                });
            };
        });
    }

        function updateTenderTypeOptionText() {
        var select = document.getElementById('tenderTypeDropdown');
        if (!select) return;
        var option = select.options[0];
        if (window.innerWidth <= 600) {
            option.text = 'All';
        } else {
            option.text = 'ALL TENDER TYPES';
        }
    }
    window.addEventListener('resize', updateTenderTypeOptionText);
    window.addEventListener('DOMContentLoaded', updateTenderTypeOptionText);
            function hookSortIcon() {
        const table = document.querySelector('.tender-table');
        if (!table) return;

        // Find the header with "DATE PUBLISHED"
        const sortTh = [...table.querySelectorAll('th')]
            .find(th => th.textContent.toLowerCase().includes('date published'));
        if (!sortTh) return;

        const sortIcon = sortTh.querySelector('i.fas');
        if (!sortIcon) return;

        let asc = true; // default direction
        sortIcon.style.cursor = "pointer";
        sortIcon.title = "Sort by date published";

        sortIcon.onclick = function () {
            const tbody = table.querySelector('tbody');
            const rows = Array.from(tbody.querySelectorAll('tr'))
                .filter(row => row.querySelector('td') && row.cells[3]); // 4th col = date

            rows.sort((a, b) => {
                const dateA = new Date(a.cells[3].innerText.trim());
                const dateB = new Date(b.cells[3].innerText.trim());
                return asc ? dateA - dateB : dateB - dateA;
            });

            rows.forEach(row => tbody.appendChild(row));

            // Toggle direction + update icon
            asc = !asc;
            sortIcon.className = asc ? "fas fa-sort-up" : "fas fa-sort-down";
        };
    }
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelector('.search-input').addEventListener('input', debouncedSubmit);
        document.querySelector('#tenderTypeDropdown').addEventListener('change', () => submitForm(false));
        document.querySelector('.refresh-btn').addEventListener('click', function(e) {
            e.preventDefault();
            document.querySelector('.search-input').value = '';
            document.querySelector('#tenderTypeDropdown').value = '';
            submitForm(true);
        });
        hookRowClicks();
        hookPaginationLinks();
                hookSortIcon();

    });
</script>
<!--
    Styles for the OVRS User Index page.
    These styles ensure a consistent, professional look and feel,
    following enterprise UI/UX and accessibility best practices.
-->
<style>
    /* Container for table with margin, padding, and shadow for separation */
    .table-container {
        margin-top: 35px;
        margin-bottom: 120px;
        padding: 30px;
        background-color: #fff;
        border-radius: 8px;
        overflow-x: auto;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    /* Table styling: spacing and font */
    .tender-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
        font-family: 'Segoe UI', sans-serif;
    }

        .tender-table td {
            word-wrap: break-word; /* Allow wrapping */
            overflow-wrap: anywhere; /* Modern browsers */
            white-space: normal; /* Let text wrap normally */
            padding: 16px;
            vertical-align: middle;
            text-align: center;
        }

    /* Specifically for tender title & number cells */
    .tender-title,
    .tender-number {
        display: -webkit-box;
        -webkit-line-clamp: 2; /* Limit to 2 lines */
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        word-break: break-word;
        white-space: normal; /* Multi-line truncation */
        line-height: 1.3;
    }
    /* Table header with background and rounded corners */
    .tender-table thead th {
        background-color: #f5c012;
        color: #fff;
        padding: 12px;
        text-align: center;
        font-weight: bold;
        border-radius: 0;
    }

        .tender-table thead th:nth-child(2), /* TITLES */
        .tender-table thead th:nth-child(4) { /* DATE PUBLISHED */
            background-color: #333;
        }

        .tender-table thead th:first-child {
            border-top-left-radius: 6px;
        }

        .tender-table thead th:last-child {
            border-top-right-radius: 6px;
            /* No background-color here */
        }

        .tender-table thead th:nth-child(4) i {
            margin-left: 8px;
            font-size: 0.9rem;
        }

    /* Table body rows and hover effect */
    .tender-table tbody tr {
        background-color: #f9f9f9;
        border-radius: 6px;
        transition: background 0.2s ease-in-out;
    }

        .tender-table tbody tr:hover {
            background-color: #f1f1f1;
        }

    .tender-table td {
        padding: 16px;
        vertical-align: middle;
        text-align: center;
    }

    /* Thumbnail image styling */
    .tender-thumbnail {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
    }

    /* Status and title cell styling */
    .tender-title {
        font-size: 0.95rem;
        color: #333;
    }

    .tender-status {
        font-weight: 600;
        color: #00a651;
    }

    /* Table row separation */
    .tender-table tbody tr:not(:last-child) {
        border-bottom: 2px solid #333;
    }

    /* Action bar (search, filter, refresh) styling */
    .tender-action-bar {
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 25px 0;
        margin-top: 45px;
        flex-wrap: wrap;
    }

    /* Search bar styling */
    .search-wrapper {
        position: relative;
        width: 250px;
    }

        .search-wrapper i {
            position: absolute;
            top: 50%;
            left: 12px;
            transform: translateY(-50%);
            color: #ccc;
            font-size: 1rem;
        }

    .search-input {
        width: 100%;
        padding: 12px 12px 12px 38px;
        border: none;
        border-radius: 4px;
        background-color: #333;
        color: #fff;
        font-family: 'Segoe UI', sans-serif;
        font-size: 1rem;
    }

        .search-input::placeholder {
            color: #ccc;
        }

    /* Filter dropdown styling */
    .filter-dropdown {
        padding: 12px 36px 12px 12px;
        border: none;
        border-radius: 4px;
        background-color: #333;
        color: #fff;
        font-family: 'Segoe UI', sans-serif;
        font-size: 1rem;
        min-width: 180px;
        appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF8,%3Csvg viewBox='0 0 10 6' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 0l5 6 5-6z' fill='%23ccc'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 12px center;
        background-size: 10px;
    }

    /* Refresh button styling */
    .refresh-btn {
        background-color: #333;
        color: #fff;
        border: none;
        border-radius: 4px;
        padding: 12px 14px;
        font-size: 1.1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Breadcrumb style for navigation context */
    .breadcrumb-custom {
        color: #888;
        font-size: 1.00rem;
        font-weight: 500;
        margin-bottom: 8px;
        margin-top: 18px;
        letter-spacing: 0.01em;
        display: flex;
        align-items: center;
        gap: 0.2em;
    }

    .breadcrumb-active {
        color: #1a7f37;
        font-weight: 500;
    }

    /* Custom pagination styles */
    .custom-pagination {
        display: flex;
        justify-content: center;
        margin-top: -90px; /* Pull up closer to card */
        z-index: 1;
    }

    .pagination-list {
        list-style: none;
        display: flex;
        gap: 18px;
        background: #fff;
        padding: 10px 20px;
        border-radius: 10px;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
        font-family: 'Segoe UI', sans-serif;
    }

    /* Pagination button styling */
    .page-item span {
        cursor: pointer;
        font-size: 1rem;
        color: #333;
    }

    .page-item.active span {
        background-color: #000;
        color: #fff;
        padding: 8px 14px;
        border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
        display: inline-block;
        width: 32px;
        height: 32px;
        text-align: center;
        line-height: 16px;
        transform: rotate(45deg);
        position: relative;
    }

        .page-item.active span::before {
            content: attr(data-page);
            transform: rotate(-45deg);
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
        }



    .page-item.next span {
        font-weight: 500;
    }

    /* Status color coding for quick recognition */
    .tender-status-open {
        color: #00a651;
    }

    .tender-status-closed {
        color: #e74c3c;
    }

    .tender-status-awarded {
        color: #f5c012;
    }

    .tender-status-cancelled {
        color: #00bfff;
    }

    /* Scrollbar and sticky headers for table usability */
    .table-scroll-container {
        max-height: 700px;
        overflow-y: auto;
        margin-bottom: 20px;
        border-radius: 8px;
    }

    .tender-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-family: 'Segoe UI', sans-serif;
    }

        .tender-table thead {
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .tender-table tbody tr:first-child td {
            border-top: none;
        }

    /* Custom scrollbar appearance */
    .table-scroll-container::-webkit-scrollbar {
        width: 8px;
    }

    .table-scroll-container::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .table-scroll-container::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 10px;
    }

        .table-scroll-container::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    /* Pagination container styling */
    .pagination-container {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

    .pagination {
        display: flex;
        list-style: none;
        padding: 0;
        margin: 0;
        gap: 5px;
    }

    .page-item {
        margin: 0 2px;
    }

    .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #fff;
        color: #333;
        border: 1px solid #ddd;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .page-item.active .page-link {
        background-color: #00a651;
        color: white;
        border-color: #00a651;
    }

    .page-item.disabled .page-link {
        color: #ccc;
        pointer-events: none;
    }

    .page-link:hover:not(.active) {
        background-color: #f1f1f1;
    }

    .page-item:first-child .page-link,
    .page-item:last-child .page-link {
        border-radius: 50%;
    }


    /* Pagination */

    .custom-pagination {
        display: flex;
        justify-content: center;
        margin-top: -90px; /* Pull up closer to card */
        z-index: 1;
    }

    .pagination-list {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 18px;
        background: #fff;
        padding: 8px 20px;
        border-radius: 15px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
    }

    .page-item {
        margin: 0;
    }

    .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: #fff;
        color: #333;
        border: 1px solid #ddd;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

    .page-item.active .page-link {
        background-color: #000;
        color: white;
        border-color: #000;
        font-weight: 700;
        transform: rotate(45deg);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        padding: 0;
        transition: background 0.2s, color 0.2s;
        cursor: pointer;
    }

        .page-item.active .page-link .page-number {
            display: inline-block;
            transform: rotate(-45deg);
            font-size: 1rem;
            width: 100%;
            text-align: center;
            color: white;
            transition: color 0.2s;
        }

        .page-item.active .page-link:hover,
        .page-item.active .page-link:focus {
            background: #fff;
            color: #000;
            border-color: #000;
        }

            .page-item.active .page-link:hover .page-number,
            .page-item.active .page-link:focus .page-number {
                color: #000 !important;
                background: none !important;
            }

    .page-link.arrow-link {
        font-size: 1.5rem;
        font-weight: bold;
        background: #f5f5f5;
        color: #000;
        text-decoration: none;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        transition: background 0.2s, color 0.2s, border 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

        .page-link.arrow-link:hover:not(.disabled) {
            background: #000;
            color: #fff;
            border-color: #000;
        }

    .page-item.active .page-link span {
        transform: rotate(-45deg);
        display: inline-block;
    }


    .page-item.disabled .page-link {
        color: #ccc !important;
        pointer-events: none;
        background: #f5f5f5 !important;
        border-color: #eee !important;
    }

    .page-link:hover:not(.active):not(.disabled) {
