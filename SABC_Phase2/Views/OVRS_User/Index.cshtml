        color: #000;
        border-color: #000;
    }

    /* ========== MOBILE RESPONSIVE FIXES ========== */
    @@media (max-width: 992px) {
        /* Action bar */
        .tender-action-bar {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .search-wrapper {
            width: 100%;
        }

        .filter-dropdown {
            width: 100%;
            min-width: unset;
        }

        .refresh-btn {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 768px) {
        /* Table container scroll padding */
        .table-container {
            padding: 15px;
        }

        .table-scroll-container {
            overflow-x: auto;
        }
        /* Responsive table: stack cells */
        .tender-table thead {
            display: none; /* hide header */
        }

        .tender-table,
        .tender-table tbody,
        .tender-table tr,
        .tender-table td {
            display: block;
            width: 100%;
        }

            .tender-table tr {
                margin-bottom: 15px;
                border: 1px solid #ddd;
                border-radius: 6px;
                padding: 12px;
                background: #fff;
                box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            }

            .tender-table td {
                text-align: left;
                padding: 8px 0;
                border: none !important;
            }

                .tender-table td:before {
                    content: attr(data-label);
                    display: block;
                    font-weight: bold;
                    color: #555;
                    margin-bottom: 4px;
                }

        .tender-thumbnail {
            width: 40px;
            height: 40px;
        }

        .tender-title {
            font-size: 1rem;
            font-weight: 600;
        }
        /* Pagination */
        .custom-pagination {
            margin-top: 20px;
        }

        .pagination-list {
            flex-wrap: wrap;
            gap: 10px;
            padding: 10px;
        }

        .page-link {
            width: 32px;
            height: 32px;
            font-size: 0.9rem;
        }
    }

    @@media (max-width: 480px) {
        .tender-table tr {
            padding: 10px;
        }

        .tender-table td {
            font-size: 0.85rem;
        }

        .tender-title {
            font-size: 0.9rem;
        }

        .search-input,
        .filter-dropdown,
        .refresh-btn {
            font-size: 0.9rem;
            padding: 10px;
        }
    }
    /* Fix for sidebar overlap on smaller screens */
    @@media (max-width: 1024px) {
        .breadcrumb-custom, .tender-action-bar, .table-container, .custom-pagination {
            margin-left: 50px; /* push content right */
            margin-right: 10px; /* add breathing room */
        }
    }

    @@media (max-width: 768px) {
        .breadcrumb-custom, .tender-action-bar, .table-container, .custom-pagination {
            margin-left: 55px; /* push more on mobile */
            margin-right: 15px;
        }
    }
</style>


