@model SABC_Phase2.ViewModels.TenderApplicationViewModel

@{
    ViewData["BannerText"] = "Tender Application";
    ViewBag.Title = "Tender Application";
    var draft = Model.Draft;
    var documents = ViewBag.Documents as IEnumerable<SABC_Phase2.Models.OVRS.ApplicationDocument>;
}

<div class="tender-app-card">
    <div class="details-header">
        <a class="back-arrow" href="javascript:history.back()">
            <i class="fas fa-arrow-left"></i>
        </a>
        <span class="details-title">Details of Tender</span>
    </div>
    <div class="details-underline"></div>

    <form id="editTenderForm" asp-action="UpdateTenderSubmission" enctype="multipart/form-data" method="post" autocomplete="off">
        <div class="tender-details-form">
            <input type="hidden" name="LegacyUserId" value="@(Model.LegacyUserId?.ToString() ?? "")" />
            <input type="hidden" name="TenderId" value="@Model.Tender.Id" />
            @if (draft != null && draft.DraftId != Guid.Empty)
            {
                <input type="hidden" name="DraftId" value="@draft.DraftId" />
            }
            <div class="form-row">
                <div class="form-group">
                    <label class="readonly-label">Tender Type</label>
                    <input type="text" class="form-control readonly-input" readonly value="@Model.Tender.TenderType" />
                </div>
                <div class="form-group">
                    <label class="readonly-label">Tender Title</label>
                    <input type="text" class="form-control readonly-input ellipsis-input" readonly value="@Model.Tender.Title" title="@Model.Tender.Title" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="readonly-label">Tender Number</label>
                    <input type="text" class="form-control readonly-input" readonly value="@Model.Tender.TenderNumber" />
                </div>
                <div class="form-group">
                    <label class="readonly-label">Email</label>
                    <input type="email" class="form-control readonly-input" readonly value="@Model.CompanyEmail" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="readonly-label">Company Name</label>
                    <input type="text" class="form-control readonly-input" readonly value="@Model.CompanyName" />
                </div>
                <div class="form-group">
                    <label class="readonly-label red-label">Closing Date &amp; Time</label>
                    <input type="text" class="form-control readonly-input" readonly style="color:#d32f2f;"
                           value="@Model.Tender.ClosingDate.ToString("dd MMMM yyyy")@(Model.Tender.ClosingTime.HasValue ? $" @ {Model.Tender.ClosingTime.Value:hh\\:mm}" : "")" />
                </div>
            </div>
        </div>
        <div class="upload-header">
            <span class="upload-title">Uploaded Documents</span>
            <div class="details-underline" style="margin-bottom:10px;"></div>
            <div style="color:#d32f2f;font-size:0.95rem;font-weight:500;margin-bottom:10px;">
                *This section has a maximum upload limit of 100MB!
            </div>
        </div>

        <!-- Update your HTML to remove the checkbox delete option -->
        <div id="uploadedFilesContainer" class="mt-3">
            @if (documents != null && documents.Any())
            {
                foreach (var doc in documents)
                {
                    <div class="uploaded-file-entry existing-doc p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light" data-doc-id="@doc.Id">
                        <div>
                            <strong>@doc.FileName</strong>
                            @*  <div class="text-muted small mt-1" style="font-size:0.75rem;">
                                @(doc.FileSize > 0 ? $"{FormatFileSize(doc.FileSize)} • " : "")Uploaded @doc.CreatedDate.ToString("dd MMM yyyy HH:mm")
                            </div> *@
                        </div>
                        <div class="uploaded-file-actions d-flex">
                            <a href="@Url.Action("ViewDocument", "TenderAdmin", new { id = doc.Id })"
                               target="_blank"
                               class="btn btn-outline-primary btn-sm me-2"
                               title="View Document">
                                <i class="fas fa-eye"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm delete-existing-doc"
                                    data-doc-id="@doc.Id"
                                    title="Delete Document">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

        @functions {
            // Helper function to format file size
            public static string FormatFileSize(long bytes)
            {
                if (bytes < 1024) return $"{bytes} B";
                else if (bytes < 1024 * 1024) return $"{(bytes / 1024).ToString("0.0")} KB";
                else return $"{(bytes / (1024 * 1024)).ToString("0.0")} MB";
            }
        }

        <div class="d-flex align-items-center justify-content-between mt-3">
            <label class="supporting-label mb-0">
                <i class="fas fa-file-pdf text-danger me-1"></i> Add Supporting Document
            </label>
            <label class="btn btn-success btn-sm d-flex align-items-center gap-1 mb-0">
                <i class="fas fa-upload"></i> Upload
                <input type="file" id="UploadedFiles" name="UploadedFiles" multiple accept=".pdf" hidden />
            </label>
        </div>

        <div class="app-action-buttons" style="margin-top: 36px;">
            <button type="submit" class="app-btn submit-btn">Update Submission <span class="arrow-icon"></span></button>
        </div>
    </form>
</div>

<!-- Add these modals to your HTML (place with other modals) -->
<div id="errorModal" class="modal fade" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="errorModalLabel" style="width:100%;text-align:center; color:#e11d48;">
                    Error
                </h5>
                <i class="fas fa-exclamation-circle" style="font-size:3.5rem; color:#e11d48; margin-bottom:16px;"></i>
            </div>
            <div class="modal-body">
                <p id="errorModalMessage" style="font-size:1.15rem; font-weight:500; color:#1a7f37; margin-top:12px;"></p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="errorModalCloseBtn" class="btn btn-primary" style="min-width:100px;">OK</button>
            </div>
        </div>
    </div>
</div>

<div id="validationErrorModal" class="modal fade" tabindex="-1" aria-labelledby="validationErrorModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="validationErrorModalLabel" style="width:100%;text-align:center; color:#e11d48;">
                    Validation Error
                </h5>
                <i class="fas fa-exclamation-triangle" style="font-size:3.5rem; color:#e11d48; margin-bottom:16px;"></i>
            </div>
            <div class="modal-body">
                <p id="validationErrorModalMessage" style="font-size:1.15rem; font-weight:500; color:#1a7f37; margin-top:12px;"></p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="validationErrorModalCloseBtn" class="btn btn-primary" style="min-width:100px;">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ======= Modal Functions =======
        function showErrorModal(message) {
            const modal = document.getElementById('errorModal');
            document.getElementById('errorModalMessage').textContent = message;
            modal.classList.add('show');
            modal.style.display = 'flex';

            document.getElementById('errorModalCloseBtn').onclick = function() {
                modal.classList.remove('show');
                modal.style.display = 'none';
            };
        }

        function showValidationError(message) {
            const modal = document.getElementById('validationErrorModal');
            document.getElementById('validationErrorModalMessage').textContent = message;
            modal.classList.add('show');
            modal.style.display = 'flex';

            document.getElementById('validationErrorModalCloseBtn').onclick = function() {
                modal.classList.remove('show');
                modal.style.display = 'none';
            };
        }

        // ======= PDF Upload Logic =======
        const MAX_TOTAL_SIZE = 100 * 1024 * 1024; // 100MB
        let storedFiles = [];

        const fileInput = document.getElementById("UploadedFiles");
        const uploadedFilesContainer = document.getElementById("uploadedFilesContainer");
        const editForm = document.getElementById("editTenderForm");

        function formatFileSize(bytes) {
            if (bytes < 1024) return `${bytes} B`;
            else if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
            else return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
        }

        function validateDocumentCount() {
            const existingDocs = Array.from(document.querySelectorAll('.existing-doc'));
            const docsToDelete = Array.from(document.querySelectorAll('input[name="DocumentsToDelete"]:checked'));
            const remainingExistingDocs = existingDocs.length - docsToDelete.length;
            const newFilesCount = storedFiles.length;
            return (remainingExistingDocs + newFilesCount) > 0;
        }

        function validateDocumentCountAfterDelete(indexToRemove) {
            const tempFiles = [...storedFiles];
            tempFiles.splice(indexToRemove, 1);

            const existingDocs = Array.from(document.querySelectorAll('.existing-doc'));
            const docsToDelete = Array.from(document.querySelectorAll('input[name="DocumentsToDelete"]:checked'));
            const remainingExistingDocs = existingDocs.length - docsToDelete.length;

            return (remainingExistingDocs + tempFiles.length) > 0;
        }

        // Handle file selection and preview logic
        fileInput.addEventListener("change", function () {
            let totalSize = storedFiles.reduce((sum, f) => sum + f.file.size, 0);
            for (const file of fileInput.files) {
                if (!file.name.endsWith(".pdf")) {
                    showValidationError(`${file.name} is not a PDF. Only PDF files are allowed.`);
                    continue;
                }
                if (storedFiles.some(f => f.name === file.name && f.size === file.size)) {
                    continue;
                }
                if (totalSize + file.size > MAX_TOTAL_SIZE) {
                    showValidationError(`Cannot add "${file.name}". The total upload size would exceed the 100MB limit.`);
                    continue;
                }
                storedFiles.push({ file: file, uploadedAt: new Date(), name: file.name, size: file.size });
                totalSize += file.size;
            }
            renderUploadedFiles();
            fileInput.value = ""; // Reset for next upload
        });

        // Render uploaded PDFs preview (updated version)
        function renderUploadedFiles() {
            // Keep server-side docs (already rendered by Razor)
            const existingDocs = Array.from(uploadedFilesContainer.querySelectorAll('.existing-doc'));
            uploadedFilesContainer.innerHTML = "";
            existingDocs.forEach(doc => uploadedFilesContainer.appendChild(doc));

            // Render client-side PDFs
            storedFiles.forEach((fileInfo, index) => {
                const { file, uploadedAt } = fileInfo;
                const fileRow = document.createElement("div");
                fileRow.className = "uploaded-file-entry p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light";

                const fileDetails = document.createElement("div");
                const fileName = document.createElement("strong");
                fileName.textContent = file.name;

                const fileMeta = document.createElement("div");
                fileMeta.className = "text-muted small mt-1";
                fileMeta.style.fontSize = "0.75rem";
                fileMeta.textContent = `${formatFileSize(file.size)} • Uploaded at ${uploadedAt.toLocaleTimeString()}`;

                fileDetails.appendChild(fileName);
                fileDetails.appendChild(fileMeta);

                const actions = document.createElement("div");
                actions.className = "uploaded-file-actions d-flex";

                // View button
                const viewBtn = document.createElement("button");
                viewBtn.type = "button";
                viewBtn.className = "btn btn-outline-primary btn-sm me-2";
                viewBtn.title = "View Document";
                viewBtn.innerHTML = '<i class="fas fa-eye"></i>';
                viewBtn.onclick = () => {
                    const fileURL = URL.createObjectURL(file);
                    window.open(fileURL, "_blank");
                };

                // Delete button
                const deleteBtn = document.createElement("button");
                deleteBtn.type = "button";
                deleteBtn.className = "btn btn-outline-danger btn-sm";
                deleteBtn.title = "Delete Document";
                deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
                deleteBtn.onclick = () => {
                    if (!validateDocumentCountAfterDelete(index)) {
                        showValidationError("You must keep at least one document. Please upload a replacement before deleting this file.");
                        return;
                    }
                    storedFiles.splice(index, 1);
                    renderUploadedFiles();
                };

                actions.appendChild(viewBtn);
                actions.appendChild(deleteBtn);
                fileRow.appendChild(fileDetails);
                fileRow.appendChild(actions);
                uploadedFilesContainer.appendChild(fileRow);
            });
        }

        // Form submission handler
        editForm.addEventListener("submit", function (e) {
            if (!validateDocumentCount()) {
                e.preventDefault();
                showValidationError("You must keep at least one document.\n\n" +
                    "• Keep at least one existing document, or\n" +
                    "• Upload at least one new document");
                return;
            }

            const submitBtn = editForm.querySelector('.submit-btn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';

            if (storedFiles.length > 0) {
                e.preventDefault();
                const formData = new FormData(editForm);
                storedFiles.forEach(fileInfo => formData.append("UploadedFiles", fileInfo.file));

                fetch(editForm.action, {
                    method: "POST",
                    body: formData,
                    headers: {}
                })
                .then(response => {
                    if (response.redirected) {
                        window.location.href = response.url;
                    } else if (response.headers.get("content-type")?.includes("application/json")) {
                        return response.json().then(data => {
                            if (data.success && data.redirectUrl) {
                                window.location.href = data.redirectUrl;
                            } else {
                                showErrorModal(data.message || "Update succeeded but no redirect URL was provided.");
                                resetSubmitButton();
                            }
                        });
                    }
                    return response.text().then(html => document.body.innerHTML = html);
                })
                .catch(error => {
                    showErrorModal("An error occurred while updating your submission. Please try again.");
                    resetSubmitButton();
                });
            }

            function resetSubmitButton() {
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Update Submission <span class="arrow-icon"></span>';
            }
        });

        // Existing document delete checkbox handler
        $(document).on('change', 'input[name="DocumentsToDelete"]', function() {
            if (!validateDocumentCount()) {
                showValidationError("You must keep at least one document. Please upload a new document before deleting this one.");
                this.checked = false;
            }
        });

        // Handle delete for existing documents
         $(document).on('click', '.delete-existing-doc', function (e) {
             e.preventDefault();
             const docId = $(this).data('doc-id');
             const docElement = $(this).closest('.existing-doc');

             if (!validateDocumentCountAfterDeleteExisting(docId)) {
                 showValidationError("You must keep at least one document. Please upload a new document before deleting this one.");
                 return;
             }

             if (confirm("Are you sure you want to delete this document?")) {
                 $.ajax({
                     url: '/OVRS_User/DeleteDocument/' + docId,
                     type: 'POST',
                     success: function (data) {
                         if (data.success) {
                             docElement.remove();
                         } else {
                             showErrorModal(data.message || "Failed to delete document.");
                         }
                     },
                     error: function () {
                         showErrorModal("Error deleting document.");
                     }
                 });
             }
         });

              // Special validation for existing doc delete operations
        function validateDocumentCountAfterDeleteExisting(docIdToRemove) {
            const existingDocs = Array.from(document.querySelectorAll('.existing-doc'))
                .filter(doc => doc.dataset.docId !== docIdToRemove.toString());
            const newFilesCount = storedFiles.length;
            return (existingDocs.length + newFilesCount) > 0;
        }
    </script>
}
