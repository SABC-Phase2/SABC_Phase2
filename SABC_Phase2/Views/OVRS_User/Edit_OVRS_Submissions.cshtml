@model SABC_Phase2.ViewModels.TenderApplicationViewModel

@{
    ViewData["BannerText"] = "Tender Application";
    ViewBag.Title = "Tender Application";
    var draft = Model.Draft;
    var documents = ViewBag.Documents as IEnumerable<SABC_Phase2.Models.OVRS.ApplicationDocument>;
}

<div class="tender-app-card">
    <div class="details-header">
        <a class="back-arrow" href="javascript:history.back()">
            <i class="fas fa-arrow-left"></i>
        </a>
        <span class="details-title">Details of Tender</span>
    </div>
    <div class="details-underline"></div>

    <form id="editTenderForm" asp-action="UpdateTenderSubmission" enctype="multipart/form-data" method="post" autocomplete="off">
        <div class="tender-details-form">
            <input type="hidden" name="LegacyUserId" value="@(Model.LegacyUserId?.ToString() ?? "")" />
            <input type="hidden" name="TenderId" value="@Model.Tender.Id" />
            @if (draft != null && draft.DraftId != Guid.Empty)
            {
                <input type="hidden" name="DraftId" value="@draft.DraftId" />
            }

            <!-- Hidden input to track documents marked for deletion -->
            <input type="hidden" id="documentsToDeleteInput" name="DocumentsToDelete" value="" />

            <div class="form-row">
                <div class="form-group">
                    <label class="readonly-label">Tender Type</label>
                    <input type="text" class="form-control readonly-input" readonly value="@Model.Tender.TenderType" />
                </div>
                <div class="form-group">
                    <label class="readonly-label">Tender Title</label>
                    <input type="text" class="form-control readonly-input ellipsis-input" readonly value="@Model.Tender.Title" title="@Model.Tender.Title" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="readonly-label">Tender Number</label>
                    <input type="text" class="form-control readonly-input" readonly value="@Model.Tender.TenderNumber" />
                </div>
                <div class="form-group">
                    <label class="readonly-label">Email</label>
                    <input type="email" class="form-control readonly-input" readonly value="@Model.CompanyEmail" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="readonly-label">Company Name</label>
                    <input type="text" class="form-control readonly-input" readonly value="@Model.CompanyName" />
                </div>
                <div class="form-group">
                    <label class="readonly-label red-label">Closing Date &amp; Time</label>
                    <input type="text" class="form-control readonly-input" readonly style="color:#d32f2f;"
                           value="@Model.Tender.ClosingDate.ToString("dd MMMM yyyy")@(Model.Tender.ClosingTime.HasValue ? $" @ {Model.Tender.ClosingTime.Value:hh\\:mm}" : "")" />
                </div>
            </div>
        </div>
        <div class="upload-header">
            <span class="upload-title">Uploaded Documents</span>
            <div class="details-underline" style="margin-bottom:10px;"></div>
            <div style="color:#d32f2f;font-size:0.95rem;font-weight:500;margin-bottom:10px;">
                *This section has a maximum upload limit of 100MB!
            </div>
            <!-- Add inline validation message -->
            <div id="documentValidationError" style="color:#d32f2f;font-size:0.95rem;font-weight:500;margin-bottom:10px;display:none;">
                <i class="fas fa-exclamation-circle"></i> Please upload at least 1 document to proceed.
            </div>
        </div>

        <!-- Updated HTML - removed marked for deletion indicators since documents will be completely hidden -->
        <div id="uploadedFilesContainer" class="mt-3 pdf-scroll-container">
            @if (documents != null && documents.Any())
            {
                foreach (var doc in documents)
                {
                    <div class="uploaded-file-entry existing-doc p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light" data-doc-id="@doc.Id">
                        <div>
                            <strong class="document-name">@doc.FileName</strong>
                        </div>
                        <div class="uploaded-file-actions d-flex">
                            <a href="@Url.Action("ViewDocument", "OVRS_User", new { id = doc.Id })"
                               target="_blank"
                               class="btn btn-outline-primary btn-sm me-2 view-doc-btn"
                               title="View Document">
                                <i class="fas fa-eye"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm delete-existing-doc"
                                    data-doc-id="@doc.Id"
                                    data-doc-name="@doc.FileName"
                                    title="Delete Document">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

        @functions {
            // Helper function to format file size
            public static string FormatFileSize(long bytes)
            {
                if (bytes < 1024) return $"{bytes} B";
                else if (bytes < 1024 * 1024) return $"{(bytes / 1024).ToString("0.0")} KB";
                else return $"{(bytes / (1024 * 1024)).ToString("0.0")} MB";
            }
        }

        <div class="d-flex align-items-center justify-content-between mt-3">
            <label class="supporting-label mb-0">
                <i class="fas fa-file-pdf text-danger me-1"></i> Add Supporting Document
            </label>
            <label class="btn btn-success btn-sm d-flex align-items-center gap-1 mb-0">
                <i class="fas fa-upload"></i> Upload
                <input type="file" id="UploadedFiles" name="UploadedFiles" multiple accept=".pdf" hidden />
            </label>
        </div>

        <div class="app-action-buttons" style="margin-top: 36px;">
            <button type="submit" class="app-btn submit-btn">Update Submission <span class="arrow-icon"></span></button>
        </div>
    </form>
</div>

<!-- Add these modals to your HTML (place with other modals) -->
<div id="errorModal" class="modal fade" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="errorModalLabel" style="width:100%;text-align:center; color:#e11d48;">
                    Error
                </h5>
                <i class="fas fa-exclamation-circle" style="font-size:3.5rem; color:#e11d48; margin-bottom:16px;"></i>
            </div>
            <div class="modal-body">
                <p id="errorModalMessage" style="font-size:1.15rem; font-weight:500; color:#1a7f37; margin-top:12px;"></p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="errorModalCloseBtn" class="btn btn-primary" style="min-width:100px;">OK</button>
            </div>
        </div>
    </div>
</div>

<div id="validationErrorModal" class="modal fade" tabindex="-1" aria-labelledby="validationErrorModalLabel" aria-hidden="true" style="display:none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center;">
            <div class="modal-header d-block border-0">
                <h5 class="modal-title w-100" id="validationErrorModalLabel" style="width:100%;text-align:center; color:#e11d48;">
                    Validation Error
                </h5>
                <i class="fas fa-exclamation-triangle" style="font-size:3.5rem; color:#e11d48; margin-bottom:16px;"></i>
            </div>
            <div class="modal-body">
                <p id="validationErrorModalMessage" style="font-size:1.15rem; font-weight:500; color:#1a7f37; margin-top:12px;"></p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" id="validationErrorModalCloseBtn" class="btn btn-primary" style="min-width:100px;">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Unified Delete Confirmation Modal for Document Deletion -->
<div id="deleteDocumentModal" class="modal fade" tabindex="-1" aria-labelledby="deleteDocumentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:410px;">
        <div class="modal-content" style="text-align:center; border-radius:12px; overflow:hidden;">
            <!-- Dark Green Header, full width -->
            <div class="modal-header border-0 justify-content-center" style="background:#14532d; width:100%; padding:1.1rem 0;">
                <h5 class="modal-title w-100" id="deleteDocumentModalLabel" style="color:#fff; font-weight:700; letter-spacing:1px;">Delete Confirmation</h5>
            </div>
            <div class="modal-body" style="padding:2rem 1.5rem 1rem 1.5rem;">
                <p style="font-size:1.13rem; font-weight:500; color:#222;">Are you sure you want to delete this document?</p>
                <p class="text-muted" id="documentToDeleteInfo" style="margin-top:8px; margin-bottom:0;"></p>
                <!-- Spinner (hidden by default) -->
                <div id="deleteDocLoading" style="display:none; text-align:center; margin:20px 0 10px 0;">
                    <div style="display:inline-block; width:24px; height:24px; border:3px solid #f3f3f3; border-top:3px solid #991b1b; border-radius:50%; animation:spin 1s linear infinite;"></div>
                    <p style="margin:12px 0 0 0; color:#666; font-size:14px;">Deleting document...</p>
                </div>
            </div>
            <div id="docModalButtons" class="modal-footer border-0 d-flex justify-content-center gap-3" style="background:none; padding-bottom:2rem;">
                <button type="button"
                        class="btn"
                        id="cancelDeleteDocumentBtn"
                        style="background:#14532d; color:#fff; min-width:110px; font-weight:600; border:none;"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button"
                        class="btn"
                        id="confirmDeleteDocumentBtn"
                        style="background:#991b1b; color:#fff; min-width:110px; font-weight:600; border:none;">
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="modal fade" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="text-align:center; border-radius: 12px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
            <div class="modal-header border-0" style="padding: 30px 30px 10px 30px;">
                <!-- Green Tick Icon -->
                <img src="~/lib/Images/Tick-Box.png" alt="Success" style="width: 80px; height: 80px; margin: 0 auto; display: block;" />
            </div>
            <div class="modal-body" style="padding: 10px 30px 30px 30px;">
                <!-- Main Title -->
                <h4 id="successTitle" style="font-size: 1.5rem; font-weight: 700; color: #16a34a; margin-bottom: 15px;">
                    Submission Updated
                </h4>
                <!-- Secondary Message -->
                <p id="successMessage" style="font-size: 1rem; font-weight: 400; color: #666; margin-bottom: 25px; line-height: 1.4;">
                    Your submission for <span id="tenderNumberSpan" style="font-weight: 600; color: #333;"></span> was updated successfully.
                </p>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center" style="padding: 0 30px 30px 30px;">
                <button type="button" id="successOkBtn" class="btn btn-success" style="min-width: 120px; padding: 12px 24px; font-weight: 600; border-radius: 8px; background-color: #16a34a; border-color: #16a34a;">
                    OK
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ======= Modal Functions =======
        function showErrorModal(message) {
            const modal = document.getElementById('errorModal');
            document.getElementById('errorModalMessage').textContent = message;
            modal.classList.add('show');
            modal.style.display = 'flex';

            document.getElementById('errorModalCloseBtn').onclick = function() {
                modal.classList.remove('show');
                modal.style.display = 'none';
            };
        }

        function showValidationError(message) {
            const modal = document.getElementById('validationErrorModal');
            document.getElementById('validationErrorModalMessage').textContent = message;
            modal.classList.add('show');
            modal.style.display = 'flex';

            document.getElementById('validationErrorModalCloseBtn').onclick = function() {
                modal.classList.remove('show');
                modal.style.display = 'none';
            };
        }

        // ✅ Updated Success Modal Function
        function showSuccessModal(tenderNumber, redirectUrl) {
            const modal = document.getElementById('successModal');

            // Set the tender number in the message
            document.getElementById('tenderNumberSpan').textContent = tenderNumber || 'this tender';

            // Show modal using Bootstrap
            var successModal = new bootstrap.Modal(modal);
            successModal.show();

            // Handle OK button click
            document.getElementById('successOkBtn').onclick = function() {
                successModal.hide();
                if (redirectUrl) {
                    window.location.href = redirectUrl;
                }
            };
        }

        // ======= Inline Validation Functions =======
        function showInlineValidation() {
            const errorDiv = document.getElementById('documentValidationError');
            errorDiv.style.display = 'block';
            errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function hideInlineValidation() {
            const errorDiv = document.getElementById('documentValidationError');
            errorDiv.style.display = 'none';
        }

        // ======= Document Deletion Logic =======
        let documentsMarkedForDeletion = new Set();
        let currentDocumentToDelete = null;

        function updateDocumentsToDeleteInput() {
            document.getElementById('documentsToDeleteInput').value = Array.from(documentsMarkedForDeletion).join(',');
        }

        function removeDocumentFromView(docId) {
            const docElement = document.querySelector(`[data-doc-id="${docId}"]`);
            if (docElement) {
                // Add to deletion list
                documentsMarkedForDeletion.add(docId);
                updateDocumentsToDeleteInput();

                // Completely remove from view with a smooth animation
                docElement.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                docElement.style.opacity = '0';
                docElement.style.transform = 'translateX(-100%)';

                setTimeout(() => {
                    docElement.remove();
                    hideInlineValidation(); // Hide any existing validation errors
                }, 300);
            }
        }

        // ======= PDF Upload Logic =======
        const MAX_TOTAL_SIZE = 100 * 1024 * 1024; // 100MB
        let storedFiles = [];

        const fileInput = document.getElementById("UploadedFiles");
        const uploadedFilesContainer = document.getElementById("uploadedFilesContainer");
        const editForm = document.getElementById("editTenderForm");

        function formatFileSize(bytes) {
            if (bytes < 1024) return `${bytes} B`;
            else if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
            else return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
        }

        // Updated to only check document count, no automatic inline validation
        function hasValidDocumentCount() {
            const existingDocs = Array.from(document.querySelectorAll('.existing-doc')).length;
            const newFilesCount = storedFiles.length;
            return (existingDocs + newFilesCount) > 0;
        }

        // Handle file selection and preview logic
        fileInput.addEventListener("change", function () {
            let totalSize = storedFiles.reduce((sum, f) => sum + f.file.size, 0);
            for (const file of fileInput.files) {
                if (!file.name.endsWith(".pdf")) {
                    showValidationError(`${file.name} is not a PDF. Only PDF files are allowed.`);
                    continue;
                }
                if (storedFiles.some(f => f.name === file.name && f.size === file.size)) {
                    continue;
                }
                if (totalSize + file.size > MAX_TOTAL_SIZE) {
                    showValidationError(`Cannot add "${file.name}". The total upload size would exceed the 100MB limit.`);
                    continue;
                }
                storedFiles.push({ file: file, uploadedAt: new Date(), name: file.name, size: file.size });
                totalSize += file.size;
            }
            renderUploadedFiles();
            // Hide validation error when files are added
            hideInlineValidation();
            fileInput.value = "";
        });

        // Render uploaded PDFs preview
        function renderUploadedFiles() {
            const existingDocs = Array.from(uploadedFilesContainer.querySelectorAll('.existing-doc'));
            uploadedFilesContainer.innerHTML = "";
            existingDocs.forEach(doc => uploadedFilesContainer.appendChild(doc));

            storedFiles.forEach((fileInfo, index) => {
                const { file, uploadedAt } = fileInfo;
                const fileRow = document.createElement("div");
                fileRow.className = "uploaded-file-entry p-2 rounded d-flex justify-content-between align-items-start mb-2 bg-light";

                const fileDetails = document.createElement("div");
                const fileName = document.createElement("strong");
                fileName.textContent = file.name;

                const fileMeta = document.createElement("div");
                fileMeta.className = "text-muted small mt-1";
                fileMeta.style.fontSize = "0.75rem";
                fileMeta.textContent = `${formatFileSize(file.size)} • Uploaded at ${uploadedAt.toLocaleTimeString()}`;

                fileDetails.appendChild(fileName);
                fileDetails.appendChild(fileMeta);

                const actions = document.createElement("div");
                actions.className = "uploaded-file-actions d-flex";

                const viewBtn = document.createElement("button");
                viewBtn.type = "button";
                viewBtn.className = "btn btn-outline-primary btn-sm me-2";
                viewBtn.title = "View Document";
                viewBtn.innerHTML = '<i class="fas fa-eye"></i>';
                viewBtn.onclick = () => {
                    const fileURL = URL.createObjectURL(file);
                    window.open(fileURL, "_blank");
                };

                const deleteBtn = document.createElement("button");
                deleteBtn.type = "button";
                deleteBtn.className = "btn btn-outline-danger btn-sm";
                deleteBtn.title = "Delete Document";
                deleteBtn.innerHTML = '<i class="fas fa-trash"></i>';
                deleteBtn.onclick = () => {
                    storedFiles.splice(index, 1);
                    renderUploadedFiles();
                };

                actions.appendChild(viewBtn);
                actions.appendChild(deleteBtn);
                fileRow.appendChild(fileDetails);
                fileRow.appendChild(actions);
                uploadedFilesContainer.appendChild(fileRow);
            });
        }

        // ✅ Updated Form submission handler
        editForm.addEventListener("submit", function (e) {
            // Check if there are valid documents only on form submission
            if (!hasValidDocumentCount()) {
                e.preventDefault();
                showInlineValidation();
                return;
            }

            const submitBtn = editForm.querySelector('.submit-btn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';

            function resetSubmitButton() {
                submitBtn.disabled = false;
                submitBtn.innerHTML = 'Update Submission <span class="arrow-icon"></span>';
            }

            if (storedFiles.length > 0) {
                e.preventDefault();
                const formData = new FormData(editForm);
                storedFiles.forEach(fileInfo => formData.append("UploadedFiles", fileInfo.file));

                fetch(editForm.action, {
                    method: "POST",
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    }
                })
                .then(async response => {
                    const contentType = response.headers.get("content-type");

                    // Check if response is JSON
                    if (contentType && contentType.includes("application/json")) {
                        const data = await response.json();

                        if (data.success) {
                            // ✅ Get tender number from form or response
                            const tenderNumber = data.tenderNumber ||
                                               document.querySelector('input[name="TenderNumber"]')?.value ||
                                               document.querySelector('[data-tender-number]')?.getAttribute('data-tender-number') ||
                                               'this tender';

                            const redirectUrl = data.redirectUrl || '/OVRS_User/OVRS_Submissions_Drafts';

                            // Show success modal with tender number
                            showSuccessModal(tenderNumber, redirectUrl);
                        } else {
                            showErrorModal(data.message || "Failed to update submission.");
                            resetSubmitButton();
                        }
                    }
                    // Handle redirect responses
                    else if (response.redirected) {
                        const tenderNumber = document.querySelector('input[name="TenderNumber"]')?.value || 'this tender';
                        showSuccessModal(tenderNumber, response.url);
                    }
                    // Handle HTML responses (validation errors)
                    else {
                        response.text().then(html => {
                            document.body.innerHTML = html;
                            resetSubmitButton();
                        });
                    }
                })
                .catch(error => {
                    console.error('Submission error:', error);
                    showErrorModal("An error occurred while updating your submission. Please try again.");
                    resetSubmitButton();
                });
            }
        });

        // ======= Delete Document Modal Logic =======
        // Event delegation for delete buttons on existing documents
        document.addEventListener('click', function(e) {
            if (e.target.closest('.delete-existing-doc')) {
                e.preventDefault();
                const btn = e.target.closest('.delete-existing-doc');
                const docId = btn.getAttribute('data-doc-id');
                const docName = btn.getAttribute('data-doc-name');

                currentDocumentToDelete = {
                    id: parseInt(docId),
                    name: docName
                };

                // Set document name in modal
                document.getElementById('documentToDeleteInfo').textContent = docName;

                // Show modal using Bootstrap
                const modal = new bootstrap.Modal(document.getElementById('deleteDocumentModal'));
                modal.show();
            }
        });

        // Handle confirm delete in modal
        document.getElementById('confirmDeleteDocumentBtn').addEventListener('click', function() {
            if (currentDocumentToDelete) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteDocumentModal'));
                modal.hide();

                // Remove document from view and mark for deletion
                removeDocumentFromView(currentDocumentToDelete.id);

                currentDocumentToDelete = null;
            }
        });

        // Reset current document when modal is closed
        document.getElementById('deleteDocumentModal').addEventListener('hidden.bs.modal', function () {
            currentDocumentToDelete = null;
        });

        // Initialize - no automatic validation on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Just initialize, don't show validation
        });
    </script>
}

<style>
    /* Consistent modal size for all popups */
    .modal-dialog {
        max-width: 400px;
        min-width: 320px;
        width: 90%;
        margin: auto;
    }

    .modal-content {
        padding: 24px 18px;
        box-sizing: border-box;
        word-break: break-word;
    }

    .modal-title,
    .modal-body p,
    .modal-footer button {
        white-space: normal;
        word-break: break-word;
        font-size: 1.1rem;
    }

    .spinner-border-sm {
        width: 1rem;
        height: 1rem;
        border-width: 0.15em;
        vertical-align: middle;
        margin-left: 8px;
    }
    /* Disabled state */
    .btn1:disabled {
        background: #ccc !important;
        color: #666 !important;
        box-shadow: none !important;
        cursor: not-allowed;
    }

    .btn1 {
        min-width: 120px;
        font-weight: 500;
        border-radius: 6px;
        padding: 8px 16px;
        border: none;
        color: white;
        transition: all 0.2s ease-in-out;
        box-shadow: 0 4px 0 rgba(0,0,0,0.25); /* 3D pressed look */
    }

    /* Cancel button */
    .btn1-cancel {
        background: #006400;
    }

        .btn1-cancel:hover {
            background: #008000;
            box-shadow: 0 5px 0 rgba(0,0,0,0.3);
        }

    /* Delete button */
    .btn1-delete {
        background: #d11a2a;
    }

        .btn1-delete:hover {
            background: #e60000;
            box-shadow: 0 5px 0 rgba(0,0,0,0.3);
        }

    #successModal .modal-dialog {
        max-width: 340px;
        margin: 1.75rem auto;
    }

    #successModal .modal-content {
        border-radius: 14px;
        box-shadow: 0 6px 32px rgba(22,163,74,0.10), 0 1.5px 4px rgba(0,0,0,0.04);
        padding: 0;
        background: #fff;
    }

    #successModal .modal-header {
        border-bottom: none;
        padding: 18px 24px 0 24px;
        text-align: center;
    }

    #successModal .modal-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #16a34a;
        letter-spacing: 0.01em;
    }

    #successModal .modal-body {
        padding: 12px 24px 0 24px;
        font-size: 1rem;
        color: #333;
    }

    #successModal .modal-footer {
        border-top: none;
        padding: 16px 24px 20px 24px;
        display: flex;
        justify-content: center;
        gap: 12px;
    }

    #successModal .btn-success {
        background: linear-gradient(90deg, #16a34a 60%, #22c55e 100%);
        border: none;
        font-weight: 600;
        padding: 8px 24px;
        border-radius: 8px;
        font-size: 1rem;
        box-shadow: 0 2px 8px rgba(22,163,74,0.08);
    }

        #successModal .btn-success:hover, #successModal .btn-success:focus {
            background: linear-gradient(90deg, #15803d 60%, #16a34a 100%);
            color: #fff;
        }

    .tender-app-card {
        background: #fff;
        border-radius: 12px;
        margin: 0 auto;
        max-width: 780px;
        margin-top: 24px;
        padding: 38px 36px 26px 36px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.11);
        position: relative;
    }

    .details-header {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .back-arrow {
        color: #1a7f37;
        font-size: 1.7rem;
        text-decoration: none;
