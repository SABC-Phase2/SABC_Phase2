@model List<SABC_Phase2.Models.OVRS.SubmissionViewModel>
@using SABC_Phase2.Models.OVRS
@{
    int pageSize = ViewBag.PageSize ?? 5;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalItems = ViewBag.TotalItems ?? (Model?.Count ?? 0);
    int totalPages = ViewBag.TotalPages ?? 1;
    int emptyRows = pageSize - (Model?.Count ?? 0);
    var drafts = ViewBag.DraftTiles as List<DraftTileViewModel>;
    var pagedDrafts = ViewBag.DraftListPaged as List<DraftTileViewModel>;
    int draftPageSize = ViewBag.DraftPageSize ?? 5;
    int draftCurrentPage = ViewBag.DraftCurrentPage ?? 1;
    int draftTotalItems = ViewBag.DraftTotalItems ?? (drafts?.Count ?? 0);
    int draftTotalPages = ViewBag.DraftTotalPages ?? 1;
}

<!-- Breadcrumb -->
<div class="container-fluid" style="margin-top: 10px;">
    <div class="row">
        <div class="col-12">
            <a href="@Url.Action("Index", "Home")" style="color:#17994d; text-decoration:none;">Home</a>
            <span style="color:#888;"> &gt; </span>
            <a href="#" style="color:#17994d; text-decoration:none;">My Documents</a>
        </div>
    </div>
</div>

<!-- Submissions Section (Toggle + Card) -->
<div class="submission-section">
    <!-- Toggle Header -->
    <div class="submission-toggle" id="submissionToggle">
        <span class="submission-title">Submissions</span>
        <span class="toggle-arrow" id="toggleArrow">&#9660;</span>
    </div>

    <!-- Card appears below toggle, styled as separate element -->
    <div class="submission-card" id="submissionCard" style="display: none;">
        <!-- Add this submissions header section -->
        <div class="submissions-header-row">
            <h2 class="submissions-header-title">Submissions <span id="submissionsTotal">@(Model != null ? $"Total: {Model.Count}" : "Total: 0")</span></h2>
        </div>
        <div class="details-underline"></div>
        <br />
        <!-- Submissions Table -->
        <div class="table-responsive">
            <table class="table table-bordered submissions-table" style="margin-bottom: 0;">
                <thead style="background: #17994d; color: #fff;">
                    <tr>
                        <th style="vertical-align: middle;">Tender Number</th>
                        <th style="vertical-align: middle;">Date Submitted</th>
                        <th style="vertical-align: middle;">Time Submitted</th>
                        <th style="vertical-align: middle;">Status</th>
                        <th style="vertical-align: middle;">Closing Date &amp; Time</th>
                        <th style="vertical-align: middle;">Update</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var row in Model)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("View_Tender_Details", "OVRS_User", new { id = row.TenderId })">@row.TenderNumber</a>
                                </td>
                                <td>@row.DateSubmitted</td>
                                <td>@row.TimeSubmitted</td>
                                <td>
                                    <span class="@(GetStatusClass(row.Status))">@row.Status</span>
                                </td>
                                <td>@row.ClosingDateTime</td>
                                <td>
                                    @if (row.Status == "Open Tender")
                                    {
                                        <a href="@Url.Action("Edit_OVRS_Submissions", "OVRS_User", new { id = row.ApplicationId })" class="btn-edit"><i class="fas fa-pencil-alt"></i>Edit</a>
                                    }
                                    else
                                    {
                                        <a class="btn-edit disabled" tabindex="-1" aria-disabled="true" style="pointer-events:none;opacity:0.6;"><i class="fas fa-pencil-alt"></i>Edit</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">No submissions available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>



        <!-- Pagination Controls: -->
        @if (totalPages > 1)
        {
            <div class="custom-pagination">
                <ul class="pagination-list">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link arrow-link"
                           href="?page=@(currentPage - 1)"
                           tabindex="@(currentPage == 1 ? "-1" : "0")"
                           aria-label="Previous">
                            <span aria-hidden="true">&#8592;</span>
                        </a>
                    </li>
                    @if (currentPage > 3)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?page=1">1</a>
                        </li>
                        @if (currentPage > 4)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }
                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                    {
                        if (i == currentPage)
                        {
                            <li class="page-item active">
                                <span class="page-link"><span class="page-number">@i</span></span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" href="?page=@i">@i</a>
                            </li>
                        }
                    }
                    @if (currentPage < totalPages - 2)
                    {
                        if (currentPage < totalPages - 3)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" href="?page=@totalPages">@totalPages</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link arrow-link"
                           href="?page=@(currentPage + 1)"
                           tabindex="@(currentPage == totalPages ? "-1" : "0")"
                           aria-label="Next">
                            <span aria-hidden="true">&#8594;</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>

<!-- Drafts Section -->
<div class="drafts-section">
    <div class="drafts-toggle" id="draftsToggle">
        <span class="drafts-title">Drafts</span>
        <span class="toggle-arrow" id="draftsArrow">&#9660;</span>
    </div>

    <div class="drafts-card" id="draftsCard" style="display: none;">
        <div class="drafts-header-row">
            <h2 class="drafts-header-title">Draft Responses <span id="draftsTotal">@((drafts != null) ? $"Total: {drafts.Count}" : "")</span></h2>
            <div class="view-toggle-buttons">
                <button id="gridViewBtn" class="view-toggle active" title="Grid View">
                    <i class="fas fa-th"></i>
                </button>
                <button id="listViewBtn" class="view-toggle" title="List View">
                    <i class="fas fa-list"></i>
                </button>
            </div>
        </div>
        <div class="details-underline"></div>
        <br />

        @if (drafts != null && drafts.Any())
        {
            <!-- Grid View with Carousel -->
            <div class="draft-carousel-wrapper">
                <button class="carousel-arrow prev" onclick="moveCarousel(-1)">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <div class="draft-carousel-container">
                    <div class="draft-carousel" id="draftGridView">
                        @foreach (var draft in drafts)
                        {
                            <div class="draft-carousel-item">
                                <a href="#"
                                   class="draft-tile-link"
                                   data-tender-id="@draft.TenderId"
                                   data-draft-id="@draft.DraftId"
                                   data-tender-number="@draft.TenderNumber"
                                   data-tender-title="@draft.TenderTitle"
                                   data-closing-date="@(draft.ClosingDate?.ToString("dd MMM yyyy") ?? "-")"
                                   data-closing-time="@(draft.ClosingTime.HasValue? draft.ClosingTime.Value.ToString(@"hh\:mm") : "-")"
                                   data-status="@(draft.Status?.ToLowerInvariant() ?? "draft")">
                                    <div class="draft-tile-card" data-draft-id="@draft.DraftId">
                                        <div class="draft-card-logo">
                                            <img src="~/lib/Images/cropped_logoblack.png" alt="SABC Logo">
                                        </div>
                                        <span class="badge @GetStatusClass(draft.Status)">
                                            @(draft.Status?.ToUpperInvariant() ?? "DRAFT")
                                        </span>
                                        <div class="draft-card-content">
                                            <div class="draft-tender-number">@draft.TenderNumber</div>
                                            <div class="draft-tender-title">@draft.TenderTitle</div>
                                            <div class="draft-closing-date">CLOSING DATE: @(draft.ClosingDate?.ToString("dd MMM yyyy") ?? "-")</div>
                                            <div class="draft-closing-time">TIME: @(draft.ClosingTime.HasValue? draft.ClosingTime.Value.ToString(@"hh\:mm") : "-")</div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <button class="carousel-arrow next" onclick="moveCarousel(1)">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>

            <!-- List View (hidden by default) -->
            <div class="draft-list-view" id="draftListView" style="display: none;">
                @if (pagedDrafts != null && pagedDrafts.Any())
                {
                    foreach (var draft in pagedDrafts)
                    {
                        <a href="#"
                           class="draft-list-row"
                           data-tender-id="@draft.TenderId"
                           data-draft-id="@draft.DraftId"
                           data-tender-number="@draft.TenderNumber"
                           data-tender-title="@draft.TenderTitle"
                           data-closing-date="@(draft.ClosingDate?.ToString("dd MMM yyyy") ?? "-")"
                           data-closing-time="@(draft.ClosingTime.HasValue? draft.ClosingTime.Value.ToString(@"hh\:mm") : "-")"
                           data-status="@(draft.Status?.ToLowerInvariant() ?? "draft")">
                            <div class="draft-list-logo">
                                <img src="~/lib/Images/cropped_logoblack.png" alt="SABC Logo">
                            </div>
                            <div class="draft-list-details">
                                <div class="draft-list-number-desc">
                                    <span class="draft-list-tender-number">@draft.TenderNumber</span>
                                    <span class="draft-list-tender-desc">: @draft.TenderTitle</span>
                                </div>
                                <div class="draft-list-meta">
                                    <span class="draft-list-closing-date">
                                        CLOSING DATE: <span style="color:#d32f2f;">@(draft.ClosingDate?.ToString("dd MMM yyyy") ?? "-")</span>
                                    </span>
                                    <span class="draft-list-closing-time">
                                        <span class="dot"></span>
                                        TIME: <span style="color:#d32f2f;">@(draft.ClosingTime.HasValue? draft.ClosingTime.Value.ToString(@"hh\:mm") : "-")</span>
                                    </span>
                                    <span class="draft-list-status">
                                        <span class="dot"></span>
                                        Status:
                                        <span class="status-badge @GetStatusClass(draft.Status)" style="font-weight:600;">
                                            @(draft.Status?.ToUpperInvariant() ?? "DRAFT")
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div style="color:#555; font-size:1.1rem; padding: 24px 0 0 8px;">
                        No draft responses available.
                    </div>
                }
            </div>
            @* Move pagination bar OUTSIDE of .draft-list-view, but still inside .drafts-card *@
            @if (draftTotalPages > 1)
            {
                <div class="custom-pagination draft-list-pagination" style="margin-bottom: 0;">
                    <ul class="pagination-list">
                        <li class="page-item @(draftCurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link arrow-link"
                               href="?draftPage=@(draftCurrentPage - 1)&section=drafts&view=list"
                               tabindex="@(draftCurrentPage == 1 ? "-1" : "0")"
                               aria-label="Previous">
                                <span aria-hidden="true">&#8592;</span>
                            </a>
                        </li>
                        @if (draftCurrentPage > 3)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?draftPage=1&section=drafts&view=list">1</a>
                            </li>
                            @if (draftCurrentPage > 4)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        @for (int i = Math.Max(1, draftCurrentPage - 2); i <= Math.Min(draftTotalPages, draftCurrentPage + 2); i++)
                        {
                            if (i == draftCurrentPage)
                            {
                                <li class="page-item active">
                                    <span class="page-link"><span class="page-number">@i</span></span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?draftPage=@i&section=drafts&view=list">@i</a>
                                </li>
                            }
                        }
                        @if (draftCurrentPage < draftTotalPages - 2)
                        {
                            if (draftCurrentPage < draftTotalPages - 3)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" href="?draftPage=@draftTotalPages&section=drafts&view=list">@draftTotalPages</a>
                            </li>
                        }
                        <li class="page-item @(draftCurrentPage == draftTotalPages ? "disabled" : "")">
                            <a class="page-link arrow-link"
                               href="?draftPage=@(draftCurrentPage + 1)&section=drafts&view=list"
                               tabindex="@(draftCurrentPage == draftTotalPages ? "-1" : "0")"
                               aria-label="Next">
                                <span aria-hidden="true">&#8594;</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }
        }
        else
        {
            <div style="color:#555; font-size:1.1rem; padding: 24px 0 0 8px;">
                No draft responses available.
            </div>
        }
    </div>
</div>
<div class="modal fade" id="deleteDraftModal" tabindex="-1" aria-labelledby="deleteDraftModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteDraftModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this draft?</p>
                <p class="text-muted" id="draftToDeleteInfo"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete Draft</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    <div id="draftToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div id="draftToastMessage" class="toast-body">
                Draft deleted successfully
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<!-- Closed Tender Modal -->
<div class="modal fade" id="closedTenderModal" tabindex="-1" aria-labelledby="closedTenderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="closedTenderModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Tender Closed
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>This tender is now closed and you cannot continue to edit this draft.</strong></p>
                <p class="text-muted mb-3" id="closedTenderInfo"><!-- Tender details will be populated here --></p>
                <p class="text-secondary small">
                    <i class="fas fa-info-circle me-1"></i>
                    You can either delete this draft to clean up your drafts list, or keep it for your records.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-danger" id="deleteClosedDraftBtn">
                    <i class="fas fa-trash-alt me-1"></i>Delete Draft
                </button>
            </div>
        </div>
    </div>
</div>


@functions {
    public string GetStatusClass(string status)
    {
        switch ((status ?? "").ToLowerInvariant())
        {
            case "open tender":
            case "open":
                return "status-open";
            case "closed tender":
            case "closed":
                return "status-closed";
            case "cancelled tender":
            case "cancelled":
                return "status-cancelled";
            case "awarded tender":
            case "awarded":
                return "status-awarded";
            default:
                return "";
        }
    }
}


<script>
    // Store the current draft to be deleted
    let currentDraftToDelete = null;
    let currentClosedDraft = null;

    // Helper to get query parameter
    function getQueryParam(name) {
        const url = new URL(window.location.href);
        return url.searchParams.get(name);
    }

    // Function to check if tender is closed
    function isTenderClosed(status) {
        const closedStatuses = ['closed tender', 'closed', 'cancelled tender', 'cancelled', 'awarded tender', 'awarded'];
        return closedStatuses.includes((status || '').toLowerCase());
    }

    // Function to handle draft link clicks
    function handleDraftClick(e, element) {
        e.preventDefault();

        const tenderId = element.getAttribute('data-tender-id');
        const draftId = element.getAttribute('data-draft-id');
        const tenderNumber = element.getAttribute('data-tender-number');
        const tenderTitle = element.getAttribute('data-tender-title');
        const closingDate = element.getAttribute('data-closing-date');
        const closingTime = element.getAttribute('data-closing-time');
        const status = element.getAttribute('data-status');

        console.log(`Clicking draft: ${tenderNumber}, Status: ${status}`);

        if (isTenderClosed(status)) {
            // Show closed tender modal
            currentClosedDraft = {
                tenderId: tenderId,
                draftId: draftId,
                element: element
            };

            // Update modal content
            document.getElementById('closedTenderInfo').innerHTML =
                `<strong>${tenderNumber}</strong>: ${tenderTitle}<br/>` +
                `<small class="text-muted">Closing Date: ${closingDate} at ${closingTime}</small><br/>` +
                `<small class="text-danger">Status: ${status.toUpperCase()}</small>`;

            // Show the modal
            const modal = new bootstrap.Modal(document.getElementById('closedTenderModal'));
            modal.show();
        } else {
            // Tender is open, proceed normally
            const url = `@Url.Action("Tender_Application", "OVRS_User")?id=${tenderId}&draftId=${draftId}`;
            console.log(`Redirecting to: ${url}`);
            window.location.href = url;
        }
    }

    // Initialize draft click handlers
    function initializeDraftClickHandlers() {
        // Handle grid view clicks
        document.querySelectorAll('.draft-tile-link').forEach(link => {
            link.addEventListener('click', function(e) {
                handleDraftClick(e, this);
            });
        });

        // Handle list view clicks
        document.querySelectorAll('.draft-list-row').forEach(link => {
            link.addEventListener('click', function(e) {
                handleDraftClick(e, this);
            });
        });
    }

    // Handle delete from closed tender modal
    document.getElementById('deleteClosedDraftBtn')?.addEventListener('click', function() {
        if (currentClosedDraft) {
            // Hide closed tender modal first
            const closedModal = bootstrap.Modal.getInstance(document.getElementById('closedTenderModal'));
            closedModal.hide();

            // Set up for regular delete flow
            const draftCard = currentClosedDraft.element.querySelector('.draft-tile-card') ||
                             currentClosedDraft.element.querySelector('.draft-list-details');

            const tenderNumber = currentClosedDraft.element.getAttribute('data-tender-number');
            const tenderTitle = currentClosedDraft.element.getAttribute('data-tender-title');

            currentDraftToDelete = {
                id: currentClosedDraft.draftId,
                element: currentClosedDraft.element.closest('.draft-carousel-item') || currentClosedDraft.element
            };

            // Update delete modal content
            document.getElementById('draftToDeleteInfo').textContent =
                `${tenderNumber}: ${tenderTitle} (Closed Tender)`;

            // Show delete confirmation modal
            setTimeout(() => {
                const deleteModal = new bootstrap.Modal(document.getElementById('deleteDraftModal'));
                deleteModal.show();
            }, 300);
        }
    });

    // Section toggling logic
    function openSection(section) {
        const draftsCard = document.getElementById('draftsCard');
        const draftsArrow = document.getElementById('draftsArrow');
        const submissionsCard = document.getElementById('submissionCard');
        const submissionsArrow = document.getElementById('toggleArrow');

        if (section === 'drafts') {
            draftsCard.style.display = 'block';
            draftsArrow.style.transform = 'rotate(180deg)';
            submissionsCard.style.display = 'none';
            submissionsArrow.style.transform = 'rotate(0deg)';
        } else {
            submissionsCard.style.display = 'block';
            submissionsArrow.style.transform = 'rotate(180deg)';
            draftsCard.style.display = 'none';
            draftsArrow.style.transform = 'rotate(0deg)';
        }
    }

    // Initialize toggle functionality
    function setupToggle(toggleId, cardId, arrowId) {
        const toggle = document.getElementById(toggleId);
        const card = document.getElementById(cardId);
        const arrow = document.getElementById(arrowId);

        if (toggle && card && arrow) {
            toggle.addEventListener('click', function() {
                const isOpen = card.style.display === 'block';
                card.style.display = isOpen ? 'none' : 'block';
                arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
            });
        }
    }

    // Carousel functionality
    const carousel = {
        currentSlide: 0,
        itemsPerPage: 4,
        totalSlides: 0,

        init: function() {
            const carouselElement = document.getElementById('draftGridView');
            if (!carouselElement) return;

            this.totalSlides = carouselElement.querySelectorAll('.draft-carousel-item').length;
            this.updateControls();
        },

        move: function(direction) {
            this.currentSlide += direction;

            // Boundary checks with no wrap-around
            if (this.currentSlide < 0) {
                this.currentSlide = 0;
            } else if (this.currentSlide * this.itemsPerPage >= this.totalSlides - this.itemsPerPage) {
                this.currentSlide = Math.floor((this.totalSlides - 1) / this.itemsPerPage);
            }

            this.updatePosition();
            this.updateControls();
        },

        updatePosition: function() {
            const carouselElement = document.getElementById('draftGridView');
            if (!carouselElement) return;

            const itemWidth = 100 / this.itemsPerPage;
            const transformValue = -this.currentSlide * itemWidth;
            carouselElement.style.transform = `translateX(${transformValue}%)`;
        },

        updateControls: function() {
            const prevBtn = document.querySelector('.carousel-arrow.prev');
            const nextBtn = document.querySelector('.carousel-arrow.next');

            if (prevBtn) {
                prevBtn.style.visibility = this.currentSlide === 0 ? 'hidden' : 'visible';
            }
            if (nextBtn) {
                nextBtn.style.visibility = this.currentSlide >= Math.floor((this.totalSlides - 1) / this.itemsPerPage) ? 'hidden' : 'visible';
            }
        }
    };

    // View toggle functionality
    function setupViewToggle() {
        const gridViewBtn = document.getElementById('gridViewBtn');
        const listViewBtn = document.getElementById('listViewBtn');
        const draftGridView = document.getElementById('draftGridView');
        const draftListView = document.getElementById('draftListView');
        const carouselArrows = document.querySelectorAll('.carousel-arrow');

        function updatePaginationVisibility() {
            const pagination = document.querySelector('.draft-list-pagination');
            if (pagination) {
                pagination.style.display = (draftListView.style.display !== 'none') ? 'flex' : 'none';
            }
        }

        if (gridViewBtn && listViewBtn && draftGridView && draftListView) {
            // Show grid view by default
            gridViewBtn.classList.add('active');
            listViewBtn.classList.remove('active');
            draftGridView.style.display = 'flex';
            draftListView.style.display = 'none';

            carouselArrows.forEach(arrow => {
                arrow.style.display = 'flex';
            });
            updatePaginationVisibility();

            gridViewBtn.addEventListener('click', function() {
                gridViewBtn.classList.add('active');
                listViewBtn.classList.remove('active');
                draftGridView.style.display = 'flex';
                draftListView.style.display = 'none';
                carouselArrows.forEach(arrow => {
                    arrow.style.display = 'flex';
                });
                carousel.init();
                updatePaginationVisibility();
                // Re-initialize click handlers when switching views
                initializeDraftClickHandlers();
            });

            listViewBtn.addEventListener('click', function() {
                listViewBtn.classList.add('active');
                gridViewBtn.classList.remove('active');
                draftGridView.style.display = 'none';
                draftListView.style.display = 'block';
                carouselArrows.forEach(arrow => {
                    arrow.style.display = 'none';
                });
                updatePaginationVisibility();
                // Re-initialize click handlers when switching views
                initializeDraftClickHandlers();
            });
        }
    }

    // Function to initialize delete functionality
    function initializeDraftDelete() {
        // Add delete button to each draft card
        document.querySelectorAll('.draft-carousel-item').forEach(item => {
            const deleteBtn = document.createElement('button');
            deleteBtn.className = 'draft-delete-btn';
            deleteBtn.innerHTML = '<i class="fas fa-trash-alt"></i>';
            deleteBtn.style.display = 'none';

            // Add click event to show modal
            deleteBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                const draftCard = this.closest('.draft-tile-card');
                const tenderNumber = draftCard.querySelector('.draft-tender-number').textContent;
                const tenderTitle = draftCard.querySelector('.draft-tender-title').textContent;

                // Store the draft ID from data attribute
                const draftId = draftCard.getAttribute('data-draft-id');
                currentDraftToDelete = {
                    id: draftId,
                    element: item
                };

                // Update modal content
                document.getElementById('draftToDeleteInfo').textContent =
                    `${tenderNumber}: ${tenderTitle}`;

                // Show the modal
                const modal = new bootstrap.Modal(document.getElementById('deleteDraftModal'));
                modal.show();
            });

            item.querySelector('.draft-tile-card').style.position = 'relative';
            item.querySelector('.draft-tile-card').appendChild(deleteBtn);
        });

        // Add hover events to show/hide delete button
        document.querySelectorAll('.draft-tile-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                const deleteBtn = this.querySelector('.draft-delete-btn');
                if (deleteBtn) deleteBtn.style.display = 'block';
            });

            card.addEventListener('mouseleave', function() {
                const deleteBtn = this.querySelector('.draft-delete-btn');
                if (deleteBtn) deleteBtn.style.display = 'none';
            });
        });

        // Handle the actual deletion when confirmed
        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (currentDraftToDelete) {
                deleteDraft(currentDraftToDelete.id, currentDraftToDelete.element);
            }
        });
    }

    function showToast(message, type = 'info') {
        const toastEl = document.getElementById('draftToast');
        const toastMessage = document.getElementById('draftToastMessage');

        // Set message and type (Bootstrap contextual colors)
        toastMessage.textContent = message;
        toastEl.className = `toast align-items-center text-bg-${type} border-0`;

        const toast = new bootstrap.Toast(toastEl);
        toast.show();
    }

    // Function to handle AJAX deletion
    function deleteDraft(draftId, element) {
        // Show loading state
        const deleteBtn = document.getElementById('confirmDeleteBtn');
        const originalText = deleteBtn.innerHTML;
        deleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Deleting...';
        deleteBtn.disabled = true;

        // AJAX call to delete the draft
        fetch('@Url.Action("DeleteDraft", "OVRS_User")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({ draftId: draftId })
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                // Remove the draft element from the DOM
                element.remove();

                // Update counts
                updateDraftCounts(-1);

                // Update carousel after deletion
                carousel.totalSlides--;
                carousel.updateControls();

                // Show success message
                showToast('Draft deleted successfully', 'success');
            } else {
                throw new Error(data.message || 'Failed to delete draft');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast('Error deleting draft: ' + error.message, 'error');
        })
        .finally(() => {
            // Hide modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('deleteDraftModal'));
            modal.hide();

            // Reset button state
            deleteBtn.innerHTML = originalText;
            deleteBtn.disabled = false;
            currentDraftToDelete = null;
            currentClosedDraft = null;
        });
    }

    // Function to update draft counts after deletion
    function updateDraftCounts(change) {
        // Update the main drafts count
        const draftsTotal = document.getElementById('draftsTotal');
        if (draftsTotal) {
            const currentCount = parseInt(draftsTotal.textContent.match(/\d+/)[0]) || 0;
            draftsTotal.textContent = `Total: ${currentCount + change}`;
        }
    }

    // Initialize everything when DOM is loaded
    document.addEventListener('DOMContentLoaded', function() {
        setupToggle('submissionToggle', 'submissionCard', 'toggleArrow');
        setupToggle('draftsToggle', 'draftsCard', 'draftsArrow');

        // Open correct section based on URL parameter
        const section = getQueryParam('section');
        openSection(section);

        // Set up view toggles and carousel
        setupViewToggle();
        carousel.init();

        // Initialize delete functionality
        initializeDraftDelete();

        // Initialize draft click handlers
        initializeDraftClickHandlers();

        // If drafts section and view=list, force list view active
        const view = getQueryParam('view');
        if (section === 'drafts' && view === 'list') {
            const gridViewBtn = document.getElementById('gridViewBtn');
            const listViewBtn = document.getElementById('listViewBtn');
            const draftGridView = document.getElementById('draftGridView');
            const draftListView = document.getElementById('draftListView');
            const carouselArrows = document.querySelectorAll('.carousel-arrow');

            if (gridViewBtn && listViewBtn && draftGridView && draftListView) {
                listViewBtn.classList.add('active');
                gridViewBtn.classList.remove('active');
                draftGridView.style.display = 'none';
                draftListView.style.display = 'block';
                carouselArrows.forEach(arrow => {
                    arrow.style.display = 'none';
                });
                // Show pagination
                const pagination = document.querySelector('.draft-list-pagination');
                if (pagination) {
                    pagination.style.display = 'flex';
                }
            }
        }
    });

    // Expose carousel move function to global scope for HTML onclick
    window.moveCarousel = function(direction) {
        carousel.move(direction);
    };
</script>


