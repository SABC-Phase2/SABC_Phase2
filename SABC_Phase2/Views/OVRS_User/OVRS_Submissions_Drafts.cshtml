/*List View css for Drafts */

/* Container for the entire list view; sets vertical stacking, spacing, and scroll for overflow */
.draft-list-view {
    display: flex;
    flex-direction: column;
    gap: 18px;            /* Space between rows */
    margin-top: 10px;
    max-height: 450px;    /* Limits height and allows scrolling */
    overflow-y: auto;
    padding-right: 12px;
}

/* Individual row in the list (entire draft entry) */
.draft-list-row {
    display: flex;
    align-items: flex-start;
    gap: 18px;                   /* Gap between logo and details */
    background: #fff;
    border-radius: 6px;          /* Rounded corners (can be 0 for flat look) */
    box-shadow: 0 1px 4px rgba(0,0,0,0.07);   /* Subtle shadow */
    border: 1px solid #e1eae3;   /* Light border around row */
    padding: 14px 16px;          /* Inner space */
    text-decoration: none;       /* Remove underline for links */
    color: #222;
    transition: box-shadow 0.15s;
}
/* Hover effect for row: stronger shadow and background color */
.draft-list-row:hover {
    box-shadow: 0 3px 10px rgba(30,30,30,0.15);
    background: #f7fdf9;
}

/* Logo on the left of each row */
.draft-list-logo {
    width: 48px;
    height: 48px;
    border-radius: 50%;      /* Circular logo */
    overflow: hidden;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
    flex-shrink: 0;
}
/* Logo image styling */
.draft-list-logo img {
    width: 42px;
    height: 42px;
    border-radius: 50%;
}

/* Container for details on the right */
.draft-list-details {
    flex: 1;
    display: flex;
    flex-direction: column;
}

/* Tender number and title styling */
.draft-list-number-desc {
    font-size: 1.12rem;
    font-weight: 700;
    color: #17994d;
    margin-bottom: 6px;
}
.draft-list-tender-number { font-weight: 700; color: #17994d;}
.draft-list-tender-desc { font-weight: 500; color: #222; }

/* Row of meta info (date, time, status) */
.draft-list-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;                  /* Space between meta items */
    font-size: 1.01rem;
    align-items: center;
    margin-left: 2px;
    margin-top: 0px;
}

/* Colored dots for visual labels */
.draft-list-meta .dot {
    height: 9px;
    width: 9px;
    background: #d32f2f;   /* Red dot */
    border-radius: 50%;
    display: inline-block;
    margin-right: 4px;
    vertical-align: middle;
}
.draft-list-status .dot {
    background: #17994d;   /* Green dot for status */
}

/* Badge for status (OPEN, CLOSED, etc) */
.status-badge {
    display: inline-block;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 1rem;
    margin-left: 4px;
    color: #fff;
    vertical-align: middle;
}
.status-open { background-color: #17994d !important; }
.status-closed { background-color: #fbc02d !important; color: #000 !important; }
.status-awarded { background-color: #0288d1 !important; }
.status-cancelled { background-color: #888 !important; }

/* --- Prevent blue link color on hover for labels --- */
.draft-list-row,
.draft-list-row:hover {
    color: #222 !important; /* Ensure text color stays the same on hover */
}

/* Make "Closing Date" and "Time" labels and values red */
.draft-list-closing-date,
.draft-list-closing-time {
    color: #d32f2f !important;
}
.draft-list-row:hover .draft-list-closing-date,
.draft-list-row:hover .draft-list-closing-time {
    color: #d32f2f !important;
}

/* Ensure status label stays default color on hover */
.draft-list-status {
    color: #222 !important;
}
.draft-list-row:hover .draft-list-status {
    color: #222 !important;
}
</style>

