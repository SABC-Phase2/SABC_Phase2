@model List<SABC_Phase2.Models.OVRS.SubmissionViewModel>
@using SABC_Phase2.Models.OVRS
@{
    var drafts = ViewBag.DraftTiles as List<DraftTileViewModel>; // Passed from controller
}

<!-- Breadcrumb -->
<div class="container-fluid" style="margin-top: 10px;">
    <div class="row">
        <div class="col-12">
            <a href="@Url.Action("Index", "Home")" style="color:#17994d; text-decoration:none;">Home</a>
            <span style="color:#888;"> &gt; </span>
            <a href="#" style="color:#17994d; text-decoration:none;">My Documents</a>
        </div>
    </div>
</div>

<!-- Submissions Section (Toggle + Card) -->
<div class="submission-section">
    <!-- Toggle Header -->
    <div class="submission-toggle" id="submissionToggle">
        <span class="submission-title">Submissions</span>
        <span class="toggle-arrow" id="toggleArrow">&#9660;</span>
    </div>

    <!-- Card appears below toggle, styled as separate element -->
    <div class="submission-card" id="submissionCard" style="display: none;">
        <!-- Submissions Table -->
        <div class="table-responsive">
            <table class="table table-bordered submissions-table" style="margin-bottom: 0;">
                <thead style="background: #17994d; color: #fff;">
                    <tr>
                        <th style="vertical-align: middle;">Tender Number</th>
                        <th style="vertical-align: middle;">Date Submitted</th>
                        <th style="vertical-align: middle;">Time Submitted</th>
                        <th style="vertical-align: middle;">Status</th>
                        <th style="vertical-align: middle;">Closing Date &amp; Time</th>
                        <th style="vertical-align: middle;">Update</th>
                    </tr>
                </thead>
   <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var row in Model)
        {
            <tr>
                <td>
                 <a href="@Url.Action("View_Tender_Details", "OVRS_User", new { id = row.TenderId })">@row.TenderNumber</a>
                </td>
                <td>@row.DateSubmitted</td>
                <td>@row.TimeSubmitted</td>
                <td>
                    <span class="@(GetStatusClass(row.Status))">@row.Status</span>
                </td>
                <td>@row.ClosingDateTime</td>
                                <td>
                                    @if (row.Status == "Open Tender")
                                    {
                                        <a href="@Url.Action("Edit_OVRS_Submissions", "OVRS_User", new { id = row.ApplicationId })" class="btn-edit">Edit</a>
                                    }
                                    else
                                    {
                                        <a class="btn-edit disabled" tabindex="-1" aria-disabled="true" style="pointer-events:none;opacity:0.6;">Edit</a>
                                    }
                                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="6">No submissions available.</td>
        </tr>
    }
</tbody>
            </table>
        </div>
    </div>
</div>

<!-- Drafts Section (Toggle + Card), styled in green -->
<div class="drafts-section">
    <!-- Toggle Header -->
    <div class="drafts-toggle" id="draftsToggle">
        <span class="drafts-title">Drafts</span>
        <span class="toggle-arrow" id="draftsArrow">&#9660;</span>
    </div>

    <div class="drafts-card" id="draftsCard" style="display: none;">
        <div class="drafts-header-row">
            <h2 class="drafts-header-title">Draft Responses <span id="draftsTotal" style="font-size:1rem;font-weight:normal;color:#555;margin-left:8px;">@((drafts != null) ? $"Total: {drafts.Count}" : "")</span></h2>
            <div class="view-toggle-buttons">
                <button id="gridViewBtn" class="view-toggle active" title="Grid View">
                    <i class="fas fa-th"></i>
                </button>
                <button id="listViewBtn" class="view-toggle" title="List View">
                    <i class="fas fa-list"></i>
                </button>
            </div>
        </div>
        <div class="details-underline"></div>
        <br />

        @if (drafts != null && drafts.Any())
        {
            <!-- Grid View (default) -->
            <div class="draft-carousel" id="draftGridView" style="display: flex; gap: 24px; overflow-x: auto; padding-bottom: 8px;">
                @foreach (var draft in drafts)
                {
                    <a href="@Url.Action("Tender_Application", "OVRS_User", new { id = draft.TenderId, draftId = draft.DraftId })" style="text-decoration:none; color:inherit;">
                        <div class="draft-tile-card">
                            <div class="draft-card-logo">
                                <img src="~/lib/Images/cropped_logoblack.png" alt="SABC Logo">
                            </div>
                            <span class="badge @GetStatusClass(draft.Status)">
                                @(draft.Status?.ToUpperInvariant() ?? "DRAFT")
                            </span>
                            <div class="draft-card-content">
                                <div class="draft-tender-number">@draft.TenderNumber</div>
                                <div class="draft-tender-title">@draft.TenderTitle</div>
                                <div class="draft-closing-date">CLOSING DATE: @(draft.ClosingDate?.ToString("dd MMM yyyy") ?? "-")</div>
                                <div class="draft-closing-time">TIME: @(draft.ClosingTime.HasValue ? draft.ClosingTime.Value.ToString(@"hh\:mm") : "-")</div>
                            </div>
                        </div>
                    </a>
                }
            </div>

            <!-- List View (hidden by default) -->
            <div class="draft-list-view" id="draftListView" style="display: none;">
                @foreach (var draft in drafts)
                {
                    <a href="@Url.Action("Tender_Application", "OVRS_User", new { id = draft.TenderId, draftId = draft.DraftId })" class="draft-list-row">
                        <div class="draft-list-logo">
                            <img src="~/lib/Images/cropped_logoblack.png" alt="SABC Logo">
                        </div>
                        <div class="draft-list-details">
                            <div class="draft-list-number-desc">
                                <span class="draft-list-tender-number">@draft.TenderNumber</span>
                                <span class="draft-list-tender-desc">: @draft.TenderTitle</span>
                            </div>
                            <div class="draft-list-meta">
                                <span class="draft-list-closing-date">
                                    @* <span class="dot"></span> *@
                                    CLOSING DATE: <span style="color:#d32f2f;">@(draft.ClosingDate?.ToString("dd MMM yyyy") ?? "-")</span>
                                </span>
                                <span class="draft-list-closing-time">
                                    <span class="dot"></span>
                                    TIME: <span style="color:#d32f2f;">@(draft.ClosingTime.HasValue ? draft.ClosingTime.Value.ToString(@"hh\:mm") : "-")</span>
                                </span>
                                <span class="draft-list-status">
                                    <span class="dot"></span>
                                    Status:
                                    <span class="status-badge @GetStatusClass(draft.Status)" style="font-weight:600;">
                                        @(draft.Status?.ToUpperInvariant() ?? "DRAFT")
                                    </span>
                                </span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div style="color:#555; font-size:1.1rem; padding: 24px 0 0 8px;">
                No draft responses available.
            </div>
        }
    </div>
</div>


@functions {
    public string GetStatusClass(string status)
    {
        switch ((status ?? "").ToLowerInvariant())
        {
            case "open tender":
            case "open":
                return "status-open";
            case "closed tender":
            case "closed":
                return "status-closed";
            case "cancelled tender":
            case "cancelled":
                return "status-cancelled";
            case "awarded tender":
            case "awarded":
                return "status-awarded";
            default:
                return "";
        }
    }
}

<script>
    // Helper to get query parameter
    function getQueryParam(name) {
        const url = new URL(window.location.href);
        return url.searchParams.get(name);
    }

    // Section toggling logic
    function openSection(section) {
        if (section === 'drafts') {
            // Open drafts, close submissions
            draftsCard.style.display = 'block';
            draftsArrow.style.transform = 'rotate(180deg)';
            card.style.display = 'none';
            arrow.style.transform = 'rotate(0deg)';
        } else {
            // Open submissions (default), close drafts
            card.style.display = 'block';
            arrow.style.transform = 'rotate(180deg)';
            draftsCard.style.display = 'none';
            draftsArrow.style.transform = 'rotate(0deg)';
        }
    }

    // Existing queries for toggles
    const toggle = document.getElementById('submissionToggle');
    const card = document.getElementById('submissionCard');
    const arrow = document.getElementById('toggleArrow');

    if (toggle && card && arrow) {
        toggle.addEventListener('click', function() {
            const isOpen = card.style.display === 'block';
            card.style.display = isOpen ? 'none' : 'block';
            arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
        });
    }

    const draftsToggle = document.getElementById('draftsToggle');
    const draftsCard = document.getElementById('draftsCard');
    const draftsArrow = document.getElementById('draftsArrow');

    if (draftsToggle && draftsCard && draftsArrow) {
        draftsToggle.addEventListener('click', function() {
            const isOpen = draftsCard.style.display === 'block';
            draftsCard.style.display = isOpen ? 'none' : 'block';
            draftsArrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
        });
    }

    // On page load, open correct section
    document.addEventListener('DOMContentLoaded', function() {
        const section = getQueryParam('section');
        openSection(section);
    });

    // --- List/Grid Toggle logic for Drafts ---
    const gridViewBtn = document.getElementById('gridViewBtn');
    const listViewBtn = document.getElementById('listViewBtn');
    const draftGridView = document.getElementById('draftGridView');
    const draftListView = document.getElementById('draftListView');

    if (gridViewBtn && listViewBtn && draftGridView && draftListView) {
        gridViewBtn.addEventListener('click', function () {
            gridViewBtn.classList.add('active');
            listViewBtn.classList.remove('active');
            draftGridView.style.display = 'flex';
            draftListView.style.display = 'none';
        });

        listViewBtn.addEventListener('click', function () {
            listViewBtn.classList.add('active');
            gridViewBtn.classList.remove('active');
            draftGridView.style.display = 'none';
            draftListView.style.display = 'block';
        });
    }
</script>


