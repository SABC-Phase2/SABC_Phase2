const form = document.querySelector('form[action*="OVRS_Profiles"]');
const saveBtn = document.getElementById('saveBtn');
const deleteBtn = document.getElementById('showDeleteAccountModalBtn'); // Add this line
if (form) {
    form.addEventListener('submit', function(e) {
        const currentPassword = document.querySelector('[name="CurrentPassword"]')?.value || '';
        const newPassword = document.querySelector('[name="NewPassword"]')?.value || '';
        const confirmPassword = document.querySelector('[name="ConfirmPassword"]')?.value || '';
        
        // Check if user is trying to change password
        const changingPassword = currentPassword || newPassword || confirmPassword;
        
        if (changingPassword) {
            // Check if all password fields are filled and passwords match
            if (currentPassword && newPassword && confirmPassword && newPassword === confirmPassword) {
                // Check if password meets security requirements
                const requirements = validatePasswordRequirements(newPassword);
                updateRequirementDisplay(requirements);
                
                if (!isPasswordValid(requirements)) {
                    e.preventDefault(); // Prevent form submission
                    passwordRequirementsModal.show();
                    return false;
                }
            }
        }

        // If submitting (not prevented by password modal), disable the Save and Delete buttons
        if (saveBtn) {
            saveBtn.disabled = true;
            saveBtn.textContent = 'Saving...';
            saveBtn.classList.add('btn-disabled-saving');
        }
        if (deleteBtn) {
            deleteBtn.disabled = true;
            deleteBtn.classList.add('btn-disabled-saving');
        }
        
        // Keep existing error display logic
        const passwordErrorBlock = document.getElementById('passwordErrorBlock');
        if (passwordErrorBlock) {
            passwordErrorBlock.style.display = 'block';
