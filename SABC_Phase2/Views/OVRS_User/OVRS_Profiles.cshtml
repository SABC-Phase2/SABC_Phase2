<!-- Password Security Requirements Modal (Admin-style) -->
<div class="modal fade" id="passwordRequirementsModal" tabindex="-1" aria-labelledby="passwordRequirementsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content">
            <!-- Error image and title, both enlarged and centered -->
            <div class="modal-header d-block border-0 text-center" style="background:transparent;">
                <img src="~/lib/Images/X-Box.png" alt="Error"
                     style="width: 96px; height: 96px; margin: 0 auto 12px auto; display: block;" />
                <h5 class="modal-title w-100" id="passwordRequirementsModalLabel"
                    style="color:#e53935; font-weight:900; font-size:2rem; text-align:center;">
                    Error
                </h5>
            </div>
            <div class="modal-body" style="text-align:center;">
                <p class="mb-2" style="font-size:1.2rem; font-weight:600;">Password Requirements:</p>
                <ul class="list-unstyled mb-0" id="passwordRequirementsChecklist" style="display:inline-block; text-align:left;">
                    @{
                        string attemptedPassword = ViewBag.AttemptedPassword ?? Model?.NewPassword ?? "";
                        bool hasLength = attemptedPassword.Length >= 8 && attemptedPassword.Length <= 15;
                        bool hasLower = attemptedPassword.Any(char.IsLower);
                        bool hasUpper = attemptedPassword.Any(char.IsUpper);
                        bool hasDigit = attemptedPassword.Any(char.IsDigit);
                        bool hasSpecial = attemptedPassword.Any(c => "!@#$%^&*()_+-=[]{}|;:,.<>?".Contains(c));
                    }
                    <li>
                        <span class="@(hasLength ? "text-success" : "text-danger")" style="font-size:1.1rem;">
                            <i class="fa-solid @(hasLength ? "fa-check-circle" : "fa-xmark-circle") me-1"></i>
                            Use 8 or more characters
                        </span>
                    </li>
                    <li>
                        <span class="@(hasLower ? "text-success" : "text-danger")" style="font-size:1.1rem;">
                            <i class="fa-solid @(hasLower ? "fa-check-circle" : "fa-xmark-circle") me-1"></i>
                            Use lower case letters (e.g. a)
                        </span>
                    </li>
                    <li>
                        <span class="@(hasUpper ? "text-success" : "text-danger")" style="font-size:1.1rem;">
                            <i class="fa-solid @(hasUpper ? "fa-check-circle" : "fa-xmark-circle") me-1"></i>
                            Use upper case letters (e.g. A)
                        </span>
                    </li>
                    <li>
                        <span class="@(hasDigit ? "text-success" : "text-danger")" style="font-size:1.1rem;">
                            <i class="fa-solid @(hasDigit ? "fa-check-circle" : "fa-xmark-circle") me-1"></i>
                            Use a number (e.g. 123)
                        </span>
                    </li>
                    <li>
                        <span class="@(hasSpecial ? "text-success" : "text-danger")" style="font-size:1.1rem;">
                            <i class="fa-solid @(hasSpecial ? "fa-check-circle" : "fa-xmark-circle") me-1"></i>
                            Use a symbol (e.g. !#$*)
                        </span>
                    </li>
                </ul>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal" id="closePasswordReqModalBtn">Close</button>
            </div>
        </div>
    </div>
</div>

