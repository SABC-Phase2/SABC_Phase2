@{
    ViewData["BannerText"] = "PROFILE";
    ViewData["Title"] = "Profile";
}
@using SABC_Phase2.Services

@if (TempData["ProfileUpdateSuccess"] != null)
{
    <div class="alert alert-success">@TempData["ProfileUpdateSuccess"]</div>
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="breadcrumb-custom">
    Home<span class="breadcrumb-arrow">&#x2794;</span> <span class="breadcrumb-active">Profile</span>
</div>

<div class="tab-container">
    <div class="profile-page container-fluid">
        <div class="row">
            <div class="col-md-12">
                <form id="profileForm" method="post" enctype="multipart/form-data">
                    <!-- First & Last Name side by side -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="FirstName">First Name <span class="text-danger">*</span></label>
                                <input type="text" id="FirstName" name="FirstName" class="form-control" placeholder="Enter your first name" value="@Model.FirstName" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="LastName">Last Name <span class="text-danger">*</span></label>
                                <input type="text" id="LastName" name="LastName" class="form-control" placeholder="Enter your last name" value="@Model.LastName" />
                            </div>
                        </div>
                    </div>      

                    <div class="form-group">
                        <label for="CompanyName">Company name</label>
                        <input type="text" id="CompanyName" name="CompanyName" class="form-control" placeholder="Enter your company name" value="@Model.CompanyName" readonly />
                    </div>


                    <div class="form-group mt-3">
                        <label for="PhoneNumber">Phone number <span class="text-danger">*</span></label>
                        <div class="input-group" id="phoneRow">
                            <!-- Country code dropdown -->
                            <select id="CountryCode" name="CountryCode" class="form-select" style="max-width: 180px;"
                                    data-original="@Model.CountryCode" disabled>
                                @foreach (var countryCode in (List<CountryCode>)ViewBag.CountryCodes)
                                {
                                    var isSelected = countryCode.DialingCode == Model.CountryCode;
                                    <option value="@countryCode.DialingCode"
                                            data-flag="@countryCode.FlagUrl"
                                            selected="@(isSelected ? "selected" : null)">
                                        @countryCode.DialingCode (@countryCode.CountryName)
                                    </option>
                                }
                            </select>

                            <!-- Phone number input -->
                            <input type="text" id="PhoneNumber" name="PhoneNumber"
                                   class="form-control" placeholder="Enter your phone number"
                                   value="@Model.PhoneNumber" data-original="@Model.PhoneNumber"
                                   readonly />

                            <!-- Country flag -->
                            <span id="flagWrapper" class="input-group-text bg-white">
                                <img id="CountryFlag" src="" alt="Country flag" style="width:40px; height:auto;" />
                            </span>


                            <!-- Change / Cancel actions -->
                            <!-- Change / Cancel actions -->
                            <a href="javascript:void(0)" id="changePhoneBtn" class="change-link ms-2">
                                Change
                            </a>
                            <a href="javascript:void(0)" id="cancelPhoneBtn" class="ms-2 d-none" title="Cancel">
                                <i class="fa fa-trash text-danger"></i>
                            </a>

                        </div>
                    </div>

                   
                    <!-- Email -->
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="emailInput">Email address</label>
                            <div class="d-flex align-items-center" id="emailRow">
                                <input type="email" id="emailInput" name="Email"
                                       class="form-control me-2"
                                       value="@Model.Email" placeholder="Enter your email address"
                                       data-original="@Model.Email" readonly />
                                <a href="javascript:void(0)" id="changeEmailBtn" class="change-link ms-2">
                                    Change
                                </a>
                                <a href="javascript:void(0)" id="cancelEmailBtn" class="ms-2 d-none" title="Cancel">
                                    <i class="fa fa-trash text-danger"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <hr />

                    <!-- Password -->
                    <div class="form-group d-flex justify-content-between align-items-center">
                        <div style="width:100%;">
                            <label>Password</label>
                            <p id="passwordStatic" class="form-static">Last updated on Mar 23, 2025</p>

                            <!-- Password inputs (hidden by default) -->
                            <!-- Password inputs (hidden by default) -->
                            <div id="passwordInputs" class="d-none">
                                <input type="password" id="currentPassword" name="CurrentPassword"
                                       class="form-control mb-2" placeholder="Enter current password" />
                                <input type="password" id="newPassword" name="NewPassword"
                                       class="form-control mb-2" placeholder="Enter new password" />
                                <input type="password" id="confirmPassword" name="ConfirmPassword"
                                       class="form-control mb-2" placeholder="Confirm new password" />
                            </div>
                        </div>

                        <!-- Change & Cancel Links -->
                        <div class="text-end">
                            <a href="javascript:void(0)" id="changePasswordBtn" class="change-link" onclick="showPasswordInputs()">Change</a>
                            <a href="javascript:void(0)" id="cancelPasswordBtn" class="change-link d-none text-danger" onclick="hidePasswordInputs()">Cancel</a>
                        </div>
                    </div>
                    <hr />

                    <div class="form-group">
                        <label>Delete account</label>
                        <p class="text-muted small">Please note that all of the information will be permanently deleted</p>
                        <button type="button" class="btn btn-danger">Delete account</button>
                    </div>

                    <div class="form-group text-end mt-4">
                        <button type="submit" class="btn btn-success">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- Password Validation Modal -->
<div class="modal fade" id="passwordValidationModal" tabindex="-1" aria-labelledby="passwordValidationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="passwordValidationModalLabel">Password Validation Error</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="passwordValidationModalMessage">
                <!-- JS will fill error message here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- OTP Verification Modal -->
<div class="modal fade" id="otpModal" tabindex="-1" aria-labelledby="otpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="otpModalLabel">OTP Verification</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <p>Please enter the 6-digit OTP sent to your new email or phone number.</p>
                <div class="d-flex justify-content-center mb-2" id="otpInputs">
                    <input type="text" maxlength="1" class="otp-input form-control mx-1 text-center" style="width:40px;display:inline-block;" />
                    <input type="text" maxlength="1" class="otp-input form-control mx-1 text-center" style="width:40px;display:inline-block;" />
                    <input type="text" maxlength="1" class="otp-input form-control mx-1 text-center" style="width:40px;display:inline-block;" />
                    <input type="text" maxlength="1" class="otp-input form-control mx-1 text-center" style="width:40px;display:inline-block;" />
                    <input type="text" maxlength="1" class="otp-input form-control mx-1 text-center" style="width:40px;display:inline-block;" />
                    <input type="text" maxlength="1" class="otp-input form-control mx-1 text-center" style="width:40px;display:inline-block;" />
                </div>
                <div id="otpError" class="text-danger mb-2" style="display:none;"></div>
                <button type="button" id="verifyOtpBtn" class="btn btn-success mt-2">Verify OTP</button>
            </div>
        </div>
    </div>
</div>

<!-- ... (Your razor markup above remains unchanged up to script tag) ... -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // --- Password Validation Modal Logic ---
        var form = document.getElementById('profileForm');
        var passwordModal = new bootstrap.Modal(document.getElementById('passwordValidationModal'));
        var otpModal = new bootstrap.Modal(document.getElementById('otpModal'));

        // Save original values for email and phone
        var emailInput = document.getElementById('emailInput');
        var phoneInput = document.getElementById('PhoneNumber');
        var countryInput = document.getElementById('CountryCode');
        var originalEmail = emailInput.getAttribute('data-original');
        var originalPhone = phoneInput.getAttribute('data-original');
        var originalCountry = countryInput.getAttribute('data-original');

        // Helper to check if OTP modal is open
        let otpInProgress = false;

        form.addEventListener('submit', function (e) {
            // If OTP modal is being handled, skip all JS checks (so submit proceeds after OTP)
            if (otpInProgress) {
                otpInProgress = false;
                return;
            }

            // ----- Password JS validation -----
            var current = document.getElementById('currentPassword').value.trim();
            var newPass = document.getElementById('newPassword').value.trim();
            var confirm = document.getElementById('confirmPassword').value.trim();
            var errors = [];
            if (current || newPass || confirm) {
                if (!current || !newPass || !confirm) {
                    errors.push("All password fields are required.");
                } else if (newPass !== confirm) {
                    errors.push("Passwords do not match.");
                }
            }
            if (errors.length > 0) {
                e.preventDefault();
                var message = errors.map(x => `<div>${x}</div>`).join('');
                document.getElementById('passwordValidationModalMessage').innerHTML = message;
                passwordModal.show();
                return;
            }

            // ----- Email/Phone change OTP logic -----
            var emailChanged = emailInput.value !== originalEmail;
            var phoneChanged = phoneInput.value !== originalPhone || countryInput.value !== originalCountry;

            if (emailChanged || phoneChanged) {
                e.preventDefault();
                otpInProgress = true;

                // Optionally: call backend to send OTP here
                // fetch('/Profile/SendOtp', { method: "POST", ... })

                // Clear OTP inputs & error
                document.querySelectorAll('.otp-input').forEach(i => { i.value = ""; });
                document.getElementById('otpError').style.display = 'none';

                otpModal.show();

                // Focus first input after modal opens
                setTimeout(() => { document.querySelector('.otp-input').focus(); }, 300);

                // Handle auto-focus and backspace
                document.querySelectorAll('.otp-input').forEach((input, idx, arr) => {
                    input.oninput = function () {
                        if (this.value.length === 1 && idx < arr.length - 1) arr[idx + 1].focus();
                    };
                    input.onkeydown = function (e) {
                        if (e.key === "Backspace" && !this.value && idx > 0) arr[idx - 1].focus();
                    };
                });

                // Handle OTP verify button
                document.getElementById('verifyOtpBtn').onclick = function () {
                    let otp = Array.from(document.querySelectorAll('.otp-input')).map(i => i.value).join('');
                    if (otp.length !== 6 || !/^\d{6}$/.test(otp)) {
                        document.getElementById('otpError').innerText = "Please enter a valid 6-digit OTP.";
                        document.getElementById('otpError').style.display = 'block';
                        return;
                    }
                    // TODO: AJAX to validate OTP on backend here!
                    // fetch('/Profile/ValidateOtp', { ... }).then(...)

                    // DEMO: always allow for now
                    document.getElementById('otpError').style.display = 'none';
                    otpModal.hide();
                    setTimeout(() => form.submit(), 300); // let modal close first
                };
            }
        });

        // ---- Existing phone/email edit logic ----
        let editMode = ""; // "", "email", or "phone"

        window.phoneChanged = function() {
            const origPhone = phoneInput.getAttribute('data-original');
            const origCode = countryInput.getAttribute('data-original');
            const currPhone = phoneInput.value;
            const currCode = countryInput.value;
            return (origPhone !== currPhone) || (origCode !== currCode);
        };

        window.emailChanged = function() {
            return emailInput.value !== emailInput.getAttribute('data-original');
        };

        window.setPhoneEditable = function(editable) {
            phoneInput.readOnly = !editable;
            countryInput.disabled = !editable;
            document.getElementById('changePhoneBtn').classList.toggle('d-none', editable);
            document.getElementById('cancelPhoneBtn').classList.toggle('d-none', !editable);
            const flagWrapper = document.getElementById('flagWrapper');
            if (!editable) {
                flagWrapper.classList.add("disabled-bg");
                flagWrapper.classList.remove("bg-white");
            } else {
                flagWrapper.classList.remove("disabled-bg");
                flagWrapper.classList.add("bg-white");
            }
        };

        window.setEmailEditable = function(editable) {
            const changeBtn = document.getElementById('changeEmailBtn');
            const cancelBtn = document.getElementById('cancelEmailBtn');
            if (editable) {
                emailInput.readOnly = false;
                emailInput.value = "";
                emailInput.placeholder = "Enter new email address";
                changeBtn.classList.add("d-none");
                cancelBtn.classList.remove("d-none");
                emailInput.focus();
            } else {
                emailInput.readOnly = true;
                emailInput.value = emailInput.getAttribute('data-original');
                emailInput.placeholder = "Enter your email address";
                changeBtn.classList.remove("d-none");
                cancelBtn.classList.add("d-none");
            }
        };

        window.togglePhoneEdit = function() {
            if (editMode === "email" && emailChanged()) {
                alert("You have made changes to your email address. Please save or reset those changes before editing your phone number.");
                setPhoneEditable(false);
                return;
            }
            if (editMode !== "phone") {
                editMode = "phone";
                setPhoneEditable(true);
                setEmailEditable(false);
            }
        };

        window.cancelPhoneEdit = function() {
            editMode = "";
            setPhoneEditable(false);
            setEmailEditable(false);
            phoneInput.value = phoneInput.getAttribute('data-original');
            countryInput.value = countryInput.getAttribute('data-original');
        };

        window.toggleEmailEdit = function() {
            if (editMode === "phone" && phoneChanged()) {
                alert("You have made changes to your phone number. Please save or reset those changes before editing your email address.");
                setEmailEditable(false);
                return;
            }
            if (editMode !== "email") {
                editMode = "email";
                setEmailEditable(true);
                setPhoneEditable(false);
            }
        };

        window.cancelEmailEdit = function() {
            editMode = "";
            setEmailEditable(false);
            setPhoneEditable(false);
            emailInput.value = emailInput.getAttribute('data-original');
        };

        window.handlePhoneEdit = function() {
            if (editMode === "email") {
                setPhoneEditable(false);
                return;
            }
            setPhoneEditable(true);
            setEmailEditable(false);
            editMode = "phone";
        };

        window.resetEditMode = function() {
            editMode = "";
            setPhoneEditable(false);
            setEmailEditable(false);
            phoneInput.setAttribute('data-original', phoneInput.value);
            countryInput.setAttribute('data-original', countryInput.value);
            emailInput.setAttribute('data-original', emailInput.value);
            hidePasswordInputs();
        };

        window.updateFlag = function() {
            var select = document.getElementById('CountryCode');
            var selectedOption = select.options[select.selectedIndex];
            var flagUrl = selectedOption.getAttribute('data-flag');
            var flagImg = document.getElementById('CountryFlag');
            if (flagUrl) {
                flagImg.src = flagUrl;
                flagImg.style.display = 'inline-block';
            } else {
                flagImg.style.display = 'none';
            }
        };

        window.showPasswordInputs = function() {
            document.getElementById("passwordStatic").classList.add("d-none");
            document.getElementById("passwordInputs").classList.remove("d-none");
            document.getElementById("changePasswordBtn").classList.add("d-none");
            document.getElementById("cancelPasswordBtn").classList.remove("d-none");
            document.getElementById("currentPassword").value = "";
            document.getElementById("newPassword").value = "";
            document.getElementById("confirmPassword").value = "";
        };

        window.hidePasswordInputs = function() {
            document.getElementById("passwordStatic").classList.remove("d-none");
            document.getElementById("passwordInputs").classList.add("d-none");
            document.getElementById("changePasswordBtn").classList.remove("d-none");
            document.getElementById("cancelPasswordBtn").classList.add("d-none");
            document.getElementById("currentPassword").value = "";
            document.getElementById("newPassword").value = "";
            document.getElementById("confirmPassword").value = "";
        };

        // Initial setup
        updateFlag();
        setPhoneEditable(false);
        setEmailEditable(false);

        document.getElementById('CountryCode').addEventListener('change', function() {
            updateFlag();
            if (editMode === "phone") handlePhoneEdit();
        });
        document.getElementById('PhoneNumber').addEventListener('input', function(){
            if (editMode === "phone") handlePhoneEdit();
        });
        document.getElementById('changePhoneBtn').addEventListener('click', togglePhoneEdit);
        document.getElementById('cancelPhoneBtn').addEventListener('click', cancelPhoneEdit);

        document.getElementById('changeEmailBtn').addEventListener('click', toggleEmailEdit);
        document.getElementById('cancelEmailBtn').addEventListener('click', cancelEmailEdit);

        // Optionally reset on form submit
        document.querySelector('form').addEventListener('submit', resetEditMode);
    });
</script>

