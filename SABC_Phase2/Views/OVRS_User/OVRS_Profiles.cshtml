                    <h5 class="modal-title" id="changeEmailModalLabel">Change Email Address</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="input-group">
                            <input type="email" class="form-control" id="newEmailInput" name="newEmail" placeholder="Enter new email address" required />
                            <button type="button" class="btn btn-success" id="sendOtpBtn" style="min-width:130px;">Send OTP</button>
                        </div>
                        <div class="invalid-feedback" id="newEmailError" style="display:block"></div>
                    </div>
                    <div id="otpSection" class="mb-3 d-none">
                        <label>Enter OTP Code</label>
                        <div class="d-flex justify-content-between gap-2 mb-2">
                            <input type="text" class="form-control text-center otp-input" maxlength="1" />
                            <input type="text" class="form-control text-center otp-input" maxlength="1" />
                            <input type="text" class="form-control text-center otp-input" maxlength="1" />
                            <input type="text" class="form-control text-center otp-input" maxlength="1" />
                            <input type="text" class="form-control text-center otp-input" maxlength="1" />
                            <input type="text" class="form-control text-center otp-input" maxlength="1" />
                        </div>
                        <button type="button" class="btn btn-primary w-100" id="verifyOtpBtn">Verify OTP</button>
                        <div class="invalid-feedback" id="otpError" style="display:block"></div>
                        <div class="valid-feedback" id="otpSuccess" style="display:block"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    @* <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button> *@
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Phone Change Modal -->
<div class="modal fade" id="changePhoneModal" tabindex="-1" aria-labelledby="changePhoneModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="changePhoneForm" autocomplete="off" onsubmit="return false;">
                <div class="modal-header">
                    <h5 class="modal-title" id="changePhoneModalLabel">Change Phone Number</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">New Phone Number</label>
                        <div class="input-group">
                            <span class="input-group-text flag-box">
                                <img id="newCountryFlag" src="@Model.CountryCodes.FirstOrDefault(c => c.DialingCode == Model.CountryCode)?.FlagUrl" alt="Country flag" />
                            </span>
                            <select id="newCountryCode" name="newCountryCode" class="form-select country-select" style="max-width: 150px;">
                                @foreach (var cc in Model.CountryCodes)
                                {
                                    <option value="@cc.DialingCode"
                                            data-flag="@cc.FlagUrl"
                                            data-country="@cc.CountryName"
                                            selected="@(cc.DialingCode == Model.CountryCode ? "selected" : null)">
                                        @cc.CountryName (@cc.DialingCode)
                                    </option>
                                }
                            </select>
                            <input type="tel" 
                                   class="form-control phone-input" 
                                   id="newPhoneInput" 
                                   name="newPhone" 
                                   placeholder="Enter new phone number" 
                                   maxlength="15"
                                   required />
                            <button type="button" class="btn btn-success" id="sendPhoneOtpBtn" style="min-width:130px;">
                                Send OTP
                            </button>
                        </div>
                        <div class="invalid-feedback" id="newPhoneError" style="display:block"></div>
                    </div>

                    <div id="phoneOtpSection" class="mb-3 d-none">
                        <label class="form-label">Enter 6-Digit OTP Code</label>
                        <div class="d-flex justify-content-between gap-2 mb-3">
                            <input type="text" class="form-control text-center phone-otp-input" maxlength="1" pattern="[0-9]" />
                            <input type="text" class="form-control text-center phone-otp-input" maxlength="1" pattern="[0-9]" />
                            <input type="text" class="form-control text-center phone-otp-input" maxlength="1" pattern="[0-9]" />
                            <input type="text" class="form-control text-center phone-otp-input" maxlength="1" pattern="[0-9]" />
                            <input type="text" class="form-control text-center phone-otp-input" maxlength="1" pattern="[0-9]" />
                            <input type="text" class="form-control text-center phone-otp-input" maxlength="1" pattern="[0-9]" />
                        </div>
                        <button type="button" class="btn btn-primary w-100" id="verifyPhoneOtpBtn">
                            Verify OTP
                        </button>
                        <div class="invalid-feedback" id="phoneOtpError" style="display:block"></div>
                        <div class="valid-feedback text-success" id="phoneOtpSuccess" style="display:block"></div>
                        <small class="text-muted mt-2 d-block">
                            Didn't receive the code? Make sure your phone number is correct and try again.
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>



<!--Delete Account Model Popup-->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="deleteAccountForm" method="post" action="@Url.Action("DeleteAccount", "OVRS_User")">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteAccountModalLabel">Confirm Account Deletion</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to permanently delete your account? This action cannot be undone.</p>
                    <div class="mb-3">
                        <label for="confirmEmail" class="form-label">Your Email Address</label>
                        <input type="email" class="form-control" id="confirmEmail" name="ConfirmEmail"
                               placeholder="Enter your email address" required />
                    </div>
                    <div class="mb-3">
                        <label for="confirmPhrase" class="form-label">
                            To verify, type <strong>"Delete my account"</strong> exactly as it appears
                        </label>
                        <input type="text" class="form-control" id="confirmPhrase" name="ConfirmPhrase" required />
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="confirmDeleteBtn" class="btn btn-danger" disabled>Yes, Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
document.addEventListener('DOMContentLoaded', function () {

    // ---- PHONE CHANGE FLAG ----
    var newCountryCodeSelect = document.getElementById('newCountryCode');
    var newCountryFlag = document.getElementById('newCountryFlag');

    if (newCountryCodeSelect && newCountryFlag) {
        function updateNewFlag() {
            var selectedOption = newCountryCodeSelect.options[newCountryCodeSelect.selectedIndex];
            var flagUrl = selectedOption.getAttribute('data-flag');
            if (flagUrl) {
                newCountryFlag.src = flagUrl;
                newCountryFlag.style.display = '';
            } else {
                newCountryFlag.style.display = 'none';
            }
        }

        // Function to update option texts based on dropdown state
        function updateOptionTexts() {
            var selectedOption = newCountryCodeSelect.options[newCountryCodeSelect.selectedIndex];
            var selectedValue = selectedOption.value;
            
            Array.from(newCountryCodeSelect.options).forEach(function(option) {
                var countryCode = option.value;
                var countryName = option.getAttribute('data-country') || option.textContent.split(' (')[0];
                
                if (option.value === selectedValue) {
                    // For the selected option, show only country code when closed
                    option.textContent = countryCode;
                } else {
                    // For other options, show full text
                    option.textContent = countryName + ' (' + countryCode + ')';
                }
            });
        }

        function updateSelectDisplay() {
            updateNewFlag();
            updateOptionTexts();
        }

        // Update display when selection changes
        newCountryCodeSelect.addEventListener('change', updateSelectDisplay);

        // When dropdown opens, show full text for all options
        newCountryCodeSelect.addEventListener('mousedown', function() {
            Array.from(newCountryCodeSelect.options).forEach(function(option) {
                var countryCode = option.value;
                var countryName = option.getAttribute('data-country') || option.textContent.split(' (')[0];
                option.textContent = countryName + ' (' + countryCode + ')';
            });
        });

        // When dropdown closes, update display back to country code only for selected
        newCountryCodeSelect.addEventListener('blur', function() {
            setTimeout(function() {
                updateOptionTexts();
            }, 100);
        });

        var changePhoneModalEl = document.getElementById('changePhoneModal');
        if (changePhoneModalEl) {
            changePhoneModalEl.addEventListener('shown.bs.modal', updateSelectDisplay);
        }

        // Run once on page load
        updateSelectDisplay();
    }

    // ---- PHONE CHANGE FLOW ----
    var changePhoneBtn = document.getElementById('changePhoneBtn');
    var sendPhoneOtpBtn = document.getElementById('sendPhoneOtpBtn');
    var verifyPhoneOtpBtn = document.getElementById('verifyPhoneOtpBtn');
    var phoneOtpSection = document.getElementById('phoneOtpSection');
    var newPhoneInput = document.getElementById('newPhoneInput');
    var changePhoneModal = null;

    // Initialize modal instance
    var changePhoneModalEl = document.getElementById('changePhoneModal');
    if (changePhoneModalEl) {
        changePhoneModal = bootstrap.Modal.getInstance(changePhoneModalEl) || new bootstrap.Modal(changePhoneModalEl);
    }

    // Function to reset phone form
    function resetPhoneForm() {
        if (newPhoneInput) newPhoneInput.value = '';
        document.querySelectorAll('.phone-otp-input').forEach(i => i.value = '');
        document.getElementById('phoneOtpError').textContent = '';
        document.getElementById('phoneOtpSuccess').textContent = '';
        document.getElementById('newPhoneError').textContent = '';
        if (phoneOtpSection) phoneOtpSection.classList.add('d-none');
        if (sendPhoneOtpBtn) {
            sendPhoneOtpBtn.disabled = false;
            sendPhoneOtpBtn.textContent = 'Send OTP';
        }
        if (verifyPhoneOtpBtn) {
            verifyPhoneOtpBtn.disabled = false;
            verifyPhoneOtpBtn.textContent = 'Verify OTP';
        }
        // Re-enable inputs
        if (newPhoneInput) newPhoneInput.disabled = false;
        if (newCountryCodeSelect) newCountryCodeSelect.disabled = false;
    }

    // Handle change phone button click
    if (changePhoneBtn) {
        changePhoneBtn.addEventListener('click', function () {
            resetPhoneForm();
            if (changePhoneModal) {
                changePhoneModal.show();
            }
        });
    }

    // Send Phone OTP
    if (sendPhoneOtpBtn) {
        sendPhoneOtpBtn.addEventListener('click', async function () {
            var phone = newPhoneInput.value.trim();
            var countryCode = newCountryCodeSelect.value.trim();

            // Clear previous errors
            document.getElementById('newPhoneError').textContent = '';

            // Validation
            if (!phone) {
                document.getElementById('newPhoneError').textContent = "Please enter phone number.";
                return;
            }

            if (!countryCode) {
                document.getElementById('newPhoneError').textContent = "Please select country code.";
                return;
            }

            // Basic phone number validation (digits only, reasonable length)
            if (!/^\d{8,15}$/.test(phone)) {
                document.getElementById('newPhoneError').textContent = "Please enter a valid phone number (8-15 digits).";
                return;
            }

            // Disable button and show loading state
            sendPhoneOtpBtn.disabled = true;
            sendPhoneOtpBtn.textContent = 'Sending...';

            try {
                // Get CSRF token
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                var headers = { 'Content-Type': 'application/json' };
                if (token) {
                    headers['RequestVerificationToken'] = token.value;
                }

                let response = await fetch('/OVRS_User/SendPhoneOtp', {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify({ 
                        phoneNumber: phone, 
                        countryCode: countryCode 
                    })
                });
                
                let data = await response.json();
                
                if (data.success) {
                    // Show OTP section
                    phoneOtpSection.classList.remove('d-none');
                    document.getElementById('newPhoneError').textContent = '';
                    sendPhoneOtpBtn.textContent = 'OTP Sent';
                    
                    // Focus first OTP input
                    const firstOtpInput = document.querySelector('.phone-otp-input');
                    if (firstOtpInput) firstOtpInput.focus();
                    
                    // Disable inputs to prevent changes
                    newPhoneInput.disabled = true;
                    newCountryCodeSelect.disabled = true;
                } else {
                    // Show error
                    document.getElementById('newPhoneError').textContent = data.message || 'Failed to send OTP';
                    sendPhoneOtpBtn.disabled = false;
                    sendPhoneOtpBtn.textContent = 'Send OTP';
                }
            } catch (error) {
                console.error('Error sending phone OTP:', error);
                document.getElementById('newPhoneError').textContent = "Error sending OTP. Please try again.";
                sendPhoneOtpBtn.disabled = false;
                sendPhoneOtpBtn.textContent = 'Send OTP';
            }
        });
    }

    // Phone OTP Inputs auto-move and validation
    const phoneOtpInputs = document.querySelectorAll('.phone-otp-input');
    phoneOtpInputs.forEach((input, index) => {
        input.addEventListener('input', (e) => {
            // Only allow digits
            input.value = input.value.replace(/[^0-9]/g, '');
            
            if (input.value.length === 1 && index < phoneOtpInputs.length - 1) {
                phoneOtpInputs[index + 1].focus();
            }
            
            // Auto-verify when all inputs are filled
            let otpCode = Array.from(phoneOtpInputs).map(i => i.value).join('');
            if (otpCode.length === 6 && /^\d{6}$/.test(otpCode)) {
                // Small delay to ensure UI updates
                setTimeout(() => {
                    if (verifyPhoneOtpBtn && !verifyPhoneOtpBtn.disabled) {
                        verifyPhoneOtpBtn.click();
                    }
                }, 100);
            }
        });
        
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !input.value && index > 0) {
                phoneOtpInputs[index - 1].focus();
            }
        });
        
        input.addEventListener('paste', (e) => {
            e.preventDefault();
            const paste = (e.clipboardData || window.clipboardData).getData('text');
            const digits = paste.replace(/[^0-9]/g, '').substring(0, 6);
            
            digits.split('').forEach((digit, i) => {
                if (phoneOtpInputs[index + i]) {
                    phoneOtpInputs[index + i].value = digit;
                }
            });
            
            // Focus next empty input or trigger verification
            const nextEmptyIndex = digits.length + index;
            if (nextEmptyIndex < phoneOtpInputs.length) {
                phoneOtpInputs[nextEmptyIndex].focus();
            } else if (digits.length === 6) {
                setTimeout(() => {
                    if (verifyPhoneOtpBtn && !verifyPhoneOtpBtn.disabled) {
                        verifyPhoneOtpBtn.click();
                    }
                }, 100);
            }
        });
    });

    // Verify Phone OTP
    if (verifyPhoneOtpBtn) {
        verifyPhoneOtpBtn.addEventListener('click', async function () {
            let otpCode = Array.from(phoneOtpInputs).map(i => i.value).join('');

            // Clear previous errors
            document.getElementById('phoneOtpError').textContent = '';
            document.getElementById('phoneOtpSuccess').textContent = '';

            if (otpCode.length < 6 || !/^\d{6}$/.test(otpCode)) {
                document.getElementById('phoneOtpError').textContent = "Please enter the complete 6-digit OTP.";
                return;
            }

            // Disable button and show loading state
            verifyPhoneOtpBtn.disabled = true;
            verifyPhoneOtpBtn.textContent = 'Verifying...';

            try {
                // Get CSRF token
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                var headers = { 'Content-Type': 'application/json' };
                if (token) {
                    headers['RequestVerificationToken'] = token.value;
                }

                let response = await fetch('/OVRS_User/VerifyPhoneOtp', {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify({ otp: otpCode })
                });
                
                let data = await response.json();
                
                if (data.success) {
                    // Show success message
                    document.getElementById('phoneOtpSuccess').textContent = data.message || 'Phone number updated successfully';
                    document.getElementById('phoneOtpError').textContent = '';
                    
                    // Update the displayed phone number on the main form
                    const phoneStatic = document.getElementById('phoneStatic');
                    if (phoneStatic) {
                        phoneStatic.textContent = `${newCountryCodeSelect.value} ${newPhoneInput.value}`;
                    }
                    
                    // Update hidden form fields for main form submission
                    const hiddenPhoneInput = document.querySelector('input[name="PhoneNumber"]');
                    const hiddenCountryCodeInput = document.querySelector('input[name="CountryCode"]');
                    if (hiddenPhoneInput) hiddenPhoneInput.value = newPhoneInput.value;
                    if (hiddenCountryCodeInput) hiddenCountryCodeInput.value = newCountryCodeSelect.value;
                    
                    // Close modal after delay
                    setTimeout(() => {
                        if (changePhoneModal) {
                            changePhoneModal.hide();
                        }
                    }, 1500);
                } else {
                    // Show error
                    document.getElementById('phoneOtpError').textContent = data.message || 'Invalid or expired OTP';
                    verifyPhoneOtpBtn.disabled = false;
                    verifyPhoneOtpBtn.textContent = 'Verify OTP';
                    
                    // Clear OTP inputs for retry
                    phoneOtpInputs.forEach(input => input.value = '');
                    phoneOtpInputs[0].focus();
                }
            } catch (error) {
                console.error('Error verifying phone OTP:', error);
                document.getElementById('phoneOtpError').textContent = "Error verifying OTP. Please try again.";
                verifyPhoneOtpBtn.disabled = false;
                verifyPhoneOtpBtn.textContent = 'Verify OTP';
            }
        });
    }

    // Reset form when modal is closed
    if (changePhoneModalEl) {
        changePhoneModalEl.addEventListener('hidden.bs.modal', function () {
            resetPhoneForm();
        });
    }

    // ---- EMAIL CHANGE FLOW ----
    var changeEmailBtn = document.getElementById('changeEmailBtn');
    var sendOtpBtn = document.getElementById('sendOtpBtn');
    var verifyOtpBtn = document.getElementById('verifyOtpBtn');
    var otpSection = document.getElementById('otpSection');
    var newEmailInput = document.getElementById('newEmailInput');

    // Add spinner inside buttons
    if (sendOtpBtn) {
        sendOtpBtn.innerHTML = '<span class="spinner-border spinner-border-sm d-none" role="status" id="sendOtpSpinner"></span> <span class="btn-text">Send OTP</span>';
    }
    if (verifyOtpBtn) {
        verifyOtpBtn.innerHTML = '<span class="spinner-border spinner-border-sm d-none" role="status" id="verifyOtpSpinner"></span> <span class="btn-text">Verify OTP</span>';
    }

    var sendOtpSpinner = document.getElementById('sendOtpSpinner');
    var verifyOtpSpinner = document.getElementById('verifyOtpSpinner');
    var newEmailError = document.getElementById('newEmailError');

    if (changeEmailBtn) {
        changeEmailBtn.addEventListener('click', function () {
            // Clear inputs/errors when opening modal
            newEmailInput.value = '';
            newEmailInput.classList.remove('is-invalid', 'is-valid');
            document.querySelectorAll('.otp-input').forEach(i => i.value = '');
            document.getElementById('otpError').textContent = '';
            document.getElementById('otpSuccess').textContent = '';
            newEmailError.textContent = '';
            otpSection.classList.add('d-none');

            newEmailInput.removeAttribute('readonly');
            sendOtpBtn.disabled = false;

            var modal = new bootstrap.Modal(document.getElementById('changeEmailModal'));
            modal.show();
        });
    }

    // Send Email OTP with visual feedback
    if (sendOtpBtn) {
        sendOtpBtn.addEventListener('click', async function () {
            var newEmail = newEmailInput.value.trim();
            newEmailInput.classList.remove('is-invalid', 'is-valid');
            newEmailError.textContent = "";

            if (!newEmail) {
                newEmailError.textContent = "Please enter email.";
                newEmailInput.classList.add('is-invalid');
                return;
            }

            sendOtpSpinner.classList.remove('d-none');
            sendOtpBtn.disabled = true;

            try {
                let res = await fetch('/OVRS_User/SendEmailOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(newEmail)
                });
                let data = await res.json();
                if (data.success) {
                    otpSection.classList.remove('d-none');
                    newEmailError.textContent = '';
                    newEmailInput.classList.remove('is-invalid');
                    newEmailInput.classList.add('is-valid');
                    document.querySelector('.otp-input').focus();
                    newEmailInput.setAttribute('readonly', true);
                    sendOtpBtn.querySelector('.btn-text').textContent = 'OTP Sent';
                } else {
                    newEmailError.textContent = data.message;
                    newEmailInput.value = '';
                    newEmailInput.classList.remove('is-valid');
                    newEmailInput.classList.add('is-invalid');
                    newEmailInput.focus();
                    sendOtpBtn.disabled = false;
                    sendOtpBtn.querySelector('.btn-text').textContent = 'Send OTP';
                    otpSection.classList.add('d-none');
                }
            } catch (err) {
                newEmailError.textContent = "Error sending OTP. Please try again.";
                newEmailInput.value = '';
                newEmailInput.classList.remove('is-valid');
                newEmailInput.classList.add('is-invalid');
                newEmailInput.focus();
                sendOtpBtn.disabled = false;
                sendOtpBtn.querySelector('.btn-text').textContent = 'Send OTP';
                otpSection.classList.add('d-none');
            } finally {
                sendOtpSpinner.classList.add('d-none');
            }
        });
    }

    // Email OTP input behavior
    const otpInputs = document.querySelectorAll('.otp-input');
    otpInputs.forEach((input, index) => {
        input.addEventListener('input', () => {
            if (input.value.length === 1 && index < otpInputs.length - 1) {
                otpInputs[index + 1].focus();
            }
            // Auto-submit when all inputs are filled
            let otpCode = Array.from(otpInputs).map(i => i.value).join('');
            if (otpCode.length === otpInputs.length && otpCode.match(/^\d+$/)) {
                // Optionally, disable auto-submit if already submitting
                if (!verifyOtpBtn.disabled) {
                    verifyOtpBtn.click();
                }
            }
        });
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && !input.value && index > 0) {
                otpInputs[index - 1].focus();
            }
        });
    });

    // Verify Email OTP
    if (verifyOtpBtn) {
        verifyOtpBtn.addEventListener('click', async function () {
            let otpCode = Array.from(otpInputs)
                                .map(i => i.value)
                                .join('');

            if (!otpCode || otpCode.length < 6) {
                document.getElementById('otpError').textContent = "Please enter full 6-digit OTP.";
                return;
            }

            // Show spinner and disable button
            verifyOtpSpinner.classList.remove('d-none');
            verifyOtpBtn.disabled = true;

            try {
                let res = await fetch('/OVRS_User/VerifyEmailOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ otp: otpCode })
                });
                let data = await res.json();
                if (data.success) {
                    document.getElementById('otpError').textContent = '';
                    document.getElementById('otpSuccess').textContent = data.message;
                    document.getElementById('emailStatic').textContent = newEmailInput.value;

                    setTimeout(() => {
                        var modal = bootstrap.Modal.getInstance(document.getElementById('changeEmailModal'));
                        modal.hide();
                    }, 1500);
                } else {
                    document.getElementById('otpError').textContent = data.message;
                    verifyOtpBtn.disabled = false; // re-enable if failed
                }
            } catch (err) {
                document.getElementById('otpError').textContent = "Error verifying OTP.";
                verifyOtpBtn.disabled = false; // re-enable if failed
            } finally {
                verifyOtpSpinner.classList.add('d-none'); // hide spinner
            }
        });
    }

    // ---- PASSWORD VALIDATION HIDING ON INPUT ----
    const passwordFields = ['CurrentPassword', 'NewPassword', 'ConfirmPassword'];
    
    passwordFields.forEach(function(fieldName) {
        const input = document.querySelector(`[name="${fieldName}"]`);
        if (input) {
            input.addEventListener('input', function () {
                // Hide the centralized error block under the Password label
                const passwordErrorBlock = document.getElementById('passwordErrorBlock');
                if (passwordErrorBlock) {
                    passwordErrorBlock.style.display = 'none';
                }
                
                // Also hide individual field validation messages
                const fieldValidationSpan = input.parentElement.querySelector('.text-danger');
                if (fieldValidationSpan) {
                    fieldValidationSpan.style.display = 'none';
                }
                
                // Hide general model errors that contain "password" (case insensitive)
                const generalErrors = document.querySelectorAll('.text-danger');
                generalErrors.forEach(function(errorElement) {
                    if (errorElement.textContent && 
                        errorElement.textContent.toLowerCase().includes('password')) {
                        errorElement.style.display = 'none';
                    }
                });
            });
        }
    });

    // ---- FORM SUBMISSION HANDLING ----
    // Show all password errors again when form is submitted
    const form = document.querySelector('form[action*="OVRS_Profiles"]');
    if (form) {
        form.addEventListener('submit', function() {
            // Re-show the password error block if it exists
            const passwordErrorBlock = document.getElementById('passwordErrorBlock');
            if (passwordErrorBlock) {
                passwordErrorBlock.style.display = 'block';
            }
            
            // Re-show individual field validation messages
            passwordFields.forEach(function(fieldName) {
                const input = document.querySelector(`[name="${fieldName}"]`);
                if (input) {
                    const fieldValidationSpan = input.parentElement.querySelector('.text-danger');
                    if (fieldValidationSpan && fieldValidationSpan.textContent.trim()) {
                        fieldValidationSpan.style.display = 'block';
                    }
                }
            });
            
            // Re-show general password-related errors
            const generalErrors = document.querySelectorAll('.text-danger');
            generalErrors.forEach(function(errorElement) {
                if (errorElement.textContent && 
                    errorElement.textContent.toLowerCase().includes('password')) {
                    errorElement.style.display = 'block';
                }
            });
        });
    }

}); // End DOMContentLoaded

// ---- Password and email toggle remains unchanged ----
function toggleEdit(field) {
    if (field === 'email') {
        document.getElementById("emailStatic").classList.toggle("d-none");
        document.getElementById("emailInput").classList.toggle("d-none");
    }
}

// Password change toggle
var changePasswordBtn = document.getElementById('changePasswordBtn');
var passwordFields = document.getElementById('passwordFields');
if (changePasswordBtn) {
    changePasswordBtn.addEventListener('click', function () {
        if (passwordFields.classList.contains('d-none')) {
            // OPEN: Show password fields
            passwordFields.classList.remove('d-none');
        } else {
            // CLOSE: Hide password fields, clear values and errors
            passwordFields.classList.add('d-none');

            // Clear input values
            document.querySelector('[name="CurrentPassword"]').value = '';
            document.querySelector('[name="NewPassword"]').value = '';
            document.querySelector('[name="ConfirmPassword"]').value = '';

            // Optionally hide error block/messages
            var passwordErrorBlock = document.getElementById('passwordErrorBlock');
            if (passwordErrorBlock) passwordErrorBlock.style.display = 'none';

            // Hide individual field validation (if present)
            document.querySelectorAll('#passwordFields .text-danger').forEach(function(span) {
                span.style.display = 'none';
            });
        }
    });
}

// Delete Account Modal
document.addEventListener('DOMContentLoaded', function () {
    // Show the delete modal on delete button click
    const deleteBtn = document.getElementById('showDeleteAccountModalBtn');
    const deleteModal = document.getElementById('deleteAccountModal');
    if (deleteBtn && deleteModal) {
        deleteBtn.addEventListener('click', function () {
            var modal = new bootstrap.Modal(deleteModal);
            modal.show();
        });
    }

    // Validate email and phrase for enabling the delete confirm button
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
    const confirmEmail = document.getElementById('confirmEmail');
    const confirmPhrase = document.getElementById('confirmPhrase');

    function validateDeleteFields() {
        if (
            confirmEmail && confirmPhrase &&
            confirmEmail.value.trim() &&
            confirmPhrase.value.trim() === 'Delete my account'
        ) {
            confirmDeleteBtn.disabled = false;
        } else {
            confirmDeleteBtn.disabled = true;
        }
    }

    if (confirmEmail && confirmPhrase) {
        confirmEmail.addEventListener('input', validateDeleteFields);
        confirmPhrase.addEventListener('input', validateDeleteFields);
    }

    // Optional: clear the form when modal is closed
    if (deleteModal) {
        deleteModal.addEventListener('hidden.bs.modal', function () {
            if (confirmEmail) confirmEmail.value = '';
            if (confirmPhrase) confirmPhrase.value = '';
            if (confirmDeleteBtn) confirmDeleteBtn.disabled = true;
        });
    }
});
</script>
