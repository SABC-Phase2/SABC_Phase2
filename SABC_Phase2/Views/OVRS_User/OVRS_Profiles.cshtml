<script>
document.addEventListener('DOMContentLoaded', function () {
    // ---- PASSWORD VALIDATION MODAL ----
    const passwordRequirementsModal = new bootstrap.Modal(document.getElementById('passwordRequirementsModal'));
    const newPasswordField = document.querySelector('[name="NewPassword"]');

    // Password validation functions
    function validatePasswordRequirements(password) {
        const requirements = {
            length: password.length >= 8 && password.length <= 15,
            lowercase: /[a-z]/.test(password),
            uppercase: /[A-Z]/.test(password),
            number: /\d/.test(password),
            // Escape the minus correctly so Razor doesn't get confused
            special: /[!@@#$%^&*()_+\-=\[\]{}|;:,.<>?]/.test(password)
        };

        return requirements;
    }

    function updateRequirementDisplay(requirements) {
        const requirementElements = {
            length: document.getElementById('req-length'),
            lowercase: document.getElementById('req-lowercase'),
            uppercase: document.getElementById('req-uppercase'),
            number: document.getElementById('req-number'),
            special: document.getElementById('req-special')
        };

        Object.keys(requirements).forEach(key => {
            const element = requirementElements[key];
            if (element) {
                const icon = element.querySelector('i');
                
                if (requirements[key]) {
                    element.classList.remove('requirement-not-met');
                    element.classList.add('requirement-met');
                    if (icon) icon.className = 'fas fa-check requirement-met';
                } else {
                    element.classList.remove('requirement-met');
                    element.classList.add('requirement-not-met');
                    if (icon) icon.className = 'fas fa-times requirement-not-met';
                }
            }
        });
    }

    function isPasswordValid(requirements) {
        return Object.values(requirements).every(req => req === true);
    }

    // Real-time password validation (optional - for better UX)
    if (newPasswordField) {
        newPasswordField.addEventListener('input', function() {
            const password = this.value;
            if (password) {
                const requirements = validatePasswordRequirements(password);
                updateRequirementDisplay(requirements);
            }
        });
    }

    // ---- PHONE CHANGE FLAG ----
    var newCountryCodeSelect = document.getElementById('newCountryCode');
    var newCountryFlag = document.getElementById('newCountryFlag');

    if (newCountryCodeSelect && newCountryFlag) {
        function updateNewFlag() {
            var selectedOption = newCountryCodeSelect.options[newCountryCodeSelect.selectedIndex];
            var flagUrl = selectedOption.getAttribute('data-flag');
            if (flagUrl) {
                newCountryFlag.src = flagUrl;
                newCountryFlag.style.display = '';
            } else {
                newCountryFlag.style.display = 'none';
            }
        }

        // Function to update option texts based on dropdown state
        function updateOptionTexts() {
            var selectedOption = newCountryCodeSelect.options[newCountryCodeSelect.selectedIndex];
            var selectedValue = selectedOption.value;
            
            Array.from(newCountryCodeSelect.options).forEach(function(option) {
                var countryCode = option.value;
                var countryName = option.getAttribute('data-country') || option.textContent.split(' (')[0];
                
                if (option.value === selectedValue) {
                    // For the selected option, show only country code when closed
                    option.textContent = countryCode;
                } else {
                    // For other options, show full text
                    option.textContent = countryName + ' (' + countryCode + ')';
                }
            });
        }

        function updateSelectDisplay() {
            updateNewFlag();
            updateOptionTexts();
        }

        // Update display when selection changes
        newCountryCodeSelect.addEventListener('change', updateSelectDisplay);

        // When dropdown opens, show full text for all options
        newCountryCodeSelect.addEventListener('mousedown', function() {
            Array.from(newCountryCodeSelect.options).forEach(function(option) {
                var countryCode = option.value;
                var countryName = option.getAttribute('data-country') || option.textContent.split(' (')[0];
                option.textContent = countryName + ' (' + countryCode + ')';
            });
        });

        // When dropdown closes, update display back to country code only for selected
        newCountryCodeSelect.addEventListener('blur', function() {
            setTimeout(function() {
                updateOptionTexts();
            }, 100);
        });

        var changePhoneModalEl = document.getElementById('changePhoneModal');
        if (changePhoneModalEl) {
            changePhoneModalEl.addEventListener('shown.bs.modal', updateSelectDisplay);
        }

        // Run once on page load
        updateSelectDisplay();
    }

    // ---- PHONE CHANGE FLOW ----
        var newCountryCodeSelect = document.getElementById('newCountryCode');
    var newCountryFlag = document.getElementById('newCountryFlag');
    var changePhoneBtn = document.getElementById('changePhoneBtn');
    var sendPhoneOtpBtn = document.getElementById('sendPhoneOtpBtn');
    var verifyPhoneOtpBtn = document.getElementById('verifyPhoneOtpBtn');
    var newPhoneInput = document.getElementById('newPhoneInput');
    var phoneOtpInputs = document.querySelectorAll('.phone-otp-input');
    var resendPhoneOtpLink = document.getElementById('resendPhoneOtpLink');
    var phoneOtpTimer = document.getElementById('phoneOtpTimer');
    var newPhoneError = document.getElementById('newPhoneError');
    var phoneOtpError = document.getElementById('phoneOtpError');
    var phoneOtpSuccess = document.getElementById('phoneOtpSuccess');

// Add spinner inside buttons
    if (sendPhoneOtpBtn) {
        sendPhoneOtpBtn.innerHTML = '<span class="spinner-border spinner-border-sm d-none" role="status" id="sendPhoneOtpSpinner"></span> <span class="btn-text">Get OTP</span>';
    }
    if (verifyPhoneOtpBtn) {
        verifyPhoneOtpBtn.innerHTML = '<span class="spinner-border spinner-border-sm d-none" role="status" id="verifyPhoneOtpSpinner"></span> <span class="btn-text">Verify</span>';
    }
    var sendPhoneOtpSpinner = document.getElementById('sendPhoneOtpSpinner');
    var verifyPhoneOtpSpinner = document.getElementById('verifyPhoneOtpSpinner');

    let phoneCountdownInterval;
    let phoneOtpTimeLeft = 300; // 5 minutes
    let phoneResendCooldownTime = 60;
    let phoneResendCooldownLeft = 0;
    let phoneResendCooldownInterval = null;
