@model SABC_Phase2.Models.OVRS.OVRS_UserProfileViewModel
@using Microsoft.AspNetCore.Mvc.ModelBinding
@functions {
    private IEnumerable<ModelError> GetErrors(string key)
    {
        return ViewData.ModelState.ContainsKey(key)
            ? ViewData.ModelState[key].Errors
            : Enumerable.Empty<ModelError>();
    }
}
@functions {
    public bool ShouldShowPasswordFields()
    {
        // Show password fields if any were filled, or if there was a password error
        return !string.IsNullOrWhiteSpace(Model.CurrentPassword)
            || !string.IsNullOrWhiteSpace(Model.NewPassword)
            || !string.IsNullOrWhiteSpace(Model.ConfirmPassword)
            || (
                (ViewData.ModelState["CurrentPassword"]?.Errors.Count ?? 0) > 0
                || (ViewData.ModelState["NewPassword"]?.Errors.Count ?? 0) > 0
                || (ViewData.ModelState["ConfirmPassword"]?.Errors.Count ?? 0) > 0
                || (ViewData.ModelState[string.Empty]?.Errors?.Any(e => e.ErrorMessage.Contains("password", StringComparison.OrdinalIgnoreCase)) ?? false)
            );
    }
}
