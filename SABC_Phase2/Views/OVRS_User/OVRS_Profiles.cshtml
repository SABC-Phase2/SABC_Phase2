<script>
document.addEventListener('DOMContentLoaded', function () {


// ---- PHONE CHANGE FLAG ----
var newCountryCodeSelect = document.getElementById('newCountryCode');
var newCountryFlag = document.getElementById('newCountryFlag');

if (newCountryCodeSelect && newCountryFlag) {
    function updateNewFlag() {
        var selectedOption = newCountryCodeSelect.options[newCountryCodeSelect.selectedIndex];
        var flagUrl = selectedOption.getAttribute('data-flag');
        if (flagUrl) {
            newCountryFlag.src = flagUrl;
            newCountryFlag.style.display = '';
        } else {
            newCountryFlag.style.display = 'none';
        }
    }

    // Function to update option texts based on dropdown state
    function updateOptionTexts() {
        var selectedOption = newCountryCodeSelect.options[newCountryCodeSelect.selectedIndex];
        var selectedValue = selectedOption.value;
        
        Array.from(newCountryCodeSelect.options).forEach(function(option) {
            var countryCode = option.value;
            var countryName = option.getAttribute('data-country') || option.textContent.split(' (')[0];
            
            if (option.value === selectedValue) {
                // For the selected option, show only country code when closed
                option.textContent = countryCode;
            } else {
                // For other options, show full text
                option.textContent = countryName + ' (' + countryCode + ')';
            }
        });
    }

    function updateSelectDisplay() {
        updateNewFlag();
        updateOptionTexts();
    }

    // Update display when selection changes
    newCountryCodeSelect.addEventListener('change', updateSelectDisplay);

    // When dropdown opens, show full text for all options
    newCountryCodeSelect.addEventListener('mousedown', function() {
        Array.from(newCountryCodeSelect.options).forEach(function(option) {
            var countryCode = option.value;
            var countryName = option.getAttribute('data-country') || option.textContent.split(' (')[0];
            option.textContent = countryName + ' (' + countryCode + ')';
        });
    });

    // When dropdown closes, update display back to country code only for selected
    newCountryCodeSelect.addEventListener('blur', function() {
        setTimeout(function() {
            updateOptionTexts();
        }, 100);
    });

    document.getElementById('changePhoneModal')
        .addEventListener('shown.bs.modal', updateSelectDisplay);

    // Run once on page load
    updateSelectDisplay();
}



    // ---- PHONE CHANGE FLOW ----
var changePhoneBtn = document.getElementById('changePhoneBtn');
var sendPhoneOtpBtn = document.getElementById('sendPhoneOtpBtn');
var verifyPhoneOtpBtn = document.getElementById('verifyPhoneOtpBtn');
var phoneOtpSection = document.getElementById('phoneOtpSection');
var newPhoneInput = document.getElementById('newPhoneInput');
var newCountryCode = document.getElementById('newCountryCode');
// Update flag when selecting new country code
var newCountryCodeSelect = document.getElementById('newCountryCode');
var newCountryFlag = document.getElementById('newCountryFlag');

@* if (newCountryCodeSelect && newCountryFlag) {
    newCountryCodeSelect.addEventListener('change', function () {
        var selectedOption = newCountryCodeSelect.options[newCountryCodeSelect.selectedIndex];
        var flagUrl = selectedOption.getAttribute('data-flag');
        newCountryFlag.src = flagUrl;
    });
} *@


if (changePhoneBtn) {
    changePhoneBtn.addEventListener('click', function () {
        // Reset form
        newPhoneInput.value = '';
        document.querySelectorAll('.phone-otp-input').forEach(i => i.value = '');
        document.getElementById('phoneOtpError').textContent = '';
        document.getElementById('phoneOtpSuccess').textContent = '';
        document.getElementById('newPhoneError').textContent = '';
        phoneOtpSection.classList.add('d-none');
        
        var modal = new bootstrap.Modal(document.getElementById('changePhoneModal'));
        modal.show();
    });
}

@* ------------------------------------------------------------------ *@
// Send OTP
if (sendPhoneOtpBtn) {
    sendPhoneOtpBtn.addEventListener('click', async function () {
        var phone = newPhoneInput.value.trim();
        var code = newCountryCode.value;

        if (!phone) {
            document.getElementById('newPhoneError').textContent = "Please enter phone number.";
            return;
        }

        sendPhoneOtpBtn.disabled = true;

        try {
            let res = await fetch('/OVRS_User/SendPhoneOtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ phoneNumber: phone, countryCode: code })
            });
            let data = await res.json();
            if (data.success) {
                phoneOtpSection.classList.remove('d-none');
                document.getElementById('newPhoneError').textContent = '';
            } else {
                document.getElementById('newPhoneError').textContent = data.message;
                sendPhoneOtpBtn.disabled = false;
            }
        } catch {
            document.getElementById('newPhoneError').textContent = "Error sending OTP. Try again.";
            sendPhoneOtpBtn.disabled = false;
        }
    });
}

// OTP Inputs auto-move
const phoneOtpInputs = document.querySelectorAll('.phone-otp-input');
phoneOtpInputs.forEach((input, index) => {
    input.addEventListener('input', () => {
        if (input.value.length === 1 && index < phoneOtpInputs.length - 1) {
            phoneOtpInputs[index + 1].focus();
        }
    });
});

// Verify OTP
if (verifyPhoneOtpBtn) {
    verifyPhoneOtpBtn.addEventListener('click', async function () {
        let otpCode = Array.from(phoneOtpInputs).map(i => i.value).join('');

        if (otpCode.length < 6) {
            document.getElementById('phoneOtpError').textContent = "Enter full 6-digit OTP.";
            return;
        }

        verifyPhoneOtpBtn.disabled = true;

        try {
            let res = await fetch('/OVRS_User/VerifyPhoneOtp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ otp: otpCode })
            });
            let data = await res.json();
            if (data.success) {
                document.getElementById('phoneOtpSuccess').textContent = data.message;
                document.getElementById('phoneStatic').textContent = 
                    newCountryCode.value + " " + newPhoneInput.value;

                setTimeout(() => {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('changePhoneModal'));
                    modal.hide();
                }, 1500);
            } else {
                document.getElementById('phoneOtpError').textContent = data.message;
                verifyPhoneOtpBtn.disabled = false;
            }
        } catch {
            document.getElementById('phoneOtpError').textContent = "Error verifying OTP.";
            verifyPhoneOtpBtn.disabled = false;
        }
    });
}
@* ------------------------------------ *@

    // ---- EMAIL CHANGE FLOW ----
    var changeEmailBtn = document.getElementById('changeEmailBtn');
    var sendOtpBtn = document.getElementById('sendOtpBtn');
    var verifyOtpBtn = document.getElementById('verifyOtpBtn');
    var otpSection = document.getElementById('otpSection');
    var newEmailInput = document.getElementById('newEmailInput');

    // Add spinner inside buttons
    if (sendOtpBtn) {
        sendOtpBtn.innerHTML = '<span class="spinner-border spinner-border-sm d-none" role="status" id="sendOtpSpinner"></span> <span class="btn-text">Send OTP</span>';
    }
    if (verifyOtpBtn) {
        verifyOtpBtn.innerHTML = '<span class="spinner-border spinner-border-sm d-none" role="status" id="verifyOtpSpinner"></span> <span class="btn-text">Verify OTP</span>';
    }

    var sendOtpSpinner = document.getElementById('sendOtpSpinner');
    var verifyOtpSpinner = document.getElementById('verifyOtpSpinner');
    var newEmailError = document.getElementById('newEmailError');

    if (changeEmailBtn) {
        changeEmailBtn.addEventListener('click', function () {
            // Clear inputs/errors when opening modal
            newEmailInput.value = '';
            newEmailInput.classList.remove('is-invalid', 'is-valid');
            document.querySelectorAll('.otp-input').forEach(i => i.value = '');
            document.getElementById('otpError').textContent = '';
            document.getElementById('otpSuccess').textContent = '';
            newEmailError.textContent = '';
            otpSection.classList.add('d-none');

            newEmailInput.removeAttribute('readonly');
            sendOtpBtn.disabled = false;

            var modal = new bootstrap.Modal(document.getElementById('changeEmailModal'));
            modal.show();
        });
    }

    // Send OTP with visual feedback
    if (sendOtpBtn) {
        sendOtpBtn.addEventListener('click', async function () {
            var newEmail = newEmailInput.value.trim();
            newEmailInput.classList.remove('is-invalid', 'is-valid');
            newEmailError.textContent = "";

            if (!newEmail) {
                newEmailError.textContent = "Please enter email.";
                newEmailInput.classList.add('is-invalid');
                return;
            }

            sendOtpSpinner.classList.remove('d-none');
            sendOtpBtn.disabled = true;

            try {
                let res = await fetch('/OVRS_User/SendEmailOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(newEmail)
                });
                let data = await res.json();
                if (data.success) {
                    otpSection.classList.remove('d-none');
                    newEmailError.textContent = '';
                    newEmailInput.classList.remove('is-invalid');
                    newEmailInput.classList.add('is-valid');
                    document.querySelector('.otp-input').focus();
                    newEmailInput.setAttribute('readonly', true);
                    sendOtpBtn.querySelector('.btn-text').textContent = 'OTP Sent';
                } else {
                    newEmailError.textContent = data.message;
                    newEmailInput.value = '';
                    newEmailInput.classList.remove('is-valid');
                    newEmailInput.classList.add('is-invalid');
                    newEmailInput.focus();
                    sendOtpBtn.disabled = false;
                    sendOtpBtn.querySelector('.btn-text').textContent = 'Send OTP';
                    otpSection.classList.add('d-none');
                }
            } catch (err) {
                newEmailError.textContent = "Error sending OTP. Please try again.";
                newEmailInput.value = '';
                newEmailInput.classList.remove('is-valid');
                newEmailInput.classList.add('is-invalid');
                newEmailInput.focus();
                sendOtpBtn.disabled = false;
                sendOtpBtn.querySelector('.btn-text').textContent = 'Send OTP';
                otpSection.classList.add('d-none');
            } finally {
                sendOtpSpinner.classList.add('d-none');
            }
        });
    }
// ---- OTP input behavior ----
const otpInputs = document.querySelectorAll('.otp-input');
otpInputs.forEach((input, index) => {
    input.addEventListener('input', () => {
        if (input.value.length === 1 && index < otpInputs.length - 1) {
            otpInputs[index + 1].focus();
        }
        // Auto-submit when all inputs are filled
        let otpCode = Array.from(otpInputs).map(i => i.value).join('');
        if (otpCode.length === otpInputs.length && otpCode.match(/^\d+$/)) {
            // Optionally, disable auto-submit if already submitting
            if (!verifyOtpBtn.disabled) {
                verifyOtpBtn.click();
            }
        }
    });
    input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !input.value && index > 0) {
            otpInputs[index - 1].focus();
        }
    });
});

    // Verify OTP
    if (verifyOtpBtn) {
        verifyOtpBtn.addEventListener('click', async function () {
            let otpCode = Array.from(otpInputs)
                                .map(i => i.value)
                                .join('');

            if (!otpCode || otpCode.length < 6) {
                document.getElementById('otpError').textContent = "Please enter full 6-digit OTP.";
                return;
            }

            // Show spinner and disable button
            verifyOtpSpinner.classList.remove('d-none');
            verifyOtpBtn.disabled = true;

            try {
                let res = await fetch('/OVRS_User/VerifyEmailOtp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ otp: otpCode })
                });
                let data = await res.json();
                if (data.success) {
                    document.getElementById('otpError').textContent = '';
                    document.getElementById('otpSuccess').textContent = data.message;
                    document.getElementById('emailStatic').textContent = newEmailInput.value;

                    setTimeout(() => {
                        var modal = bootstrap.Modal.getInstance(document.getElementById('changeEmailModal'));
                        modal.hide();
                    }, 1500);
                } else {
                    document.getElementById('otpError').textContent = data.message;
                    verifyOtpBtn.disabled = false; // re-enable if failed
                }
            } catch (err) {
                document.getElementById('otpError').textContent = "Error verifying OTP.";
                verifyOtpBtn.disabled = false; // re-enable if failed
            } finally {
                verifyOtpSpinner.classList.add('d-none'); // hide spinner
            }
        });
    }

    // ---- PASSWORD VALIDATION HIDING ON INPUT ----
    const passwordFields = ['CurrentPassword', 'NewPassword', 'ConfirmPassword'];
    
    passwordFields.forEach(function(fieldName) {
        const input = document.querySelector(`[name="${fieldName}"]`);
        if (input) {
            input.addEventListener('input', function () {
                // Hide the centralized error block under the Password label
                const passwordErrorBlock = document.getElementById('passwordErrorBlock');
                if (passwordErrorBlock) {
                    passwordErrorBlock.style.display = 'none';
                }
                
                // Also hide individual field validation messages
                const fieldValidationSpan = input.parentElement.querySelector('.text-danger');
                if (fieldValidationSpan) {
                    fieldValidationSpan.style.display = 'none';
                }
                
                // Hide general model errors that contain "password" (case insensitive)
                const generalErrors = document.querySelectorAll('.text-danger');
                generalErrors.forEach(function(errorElement) {
                    if (errorElement.textContent && 
                        errorElement.textContent.toLowerCase().includes('password')) {
                        errorElement.style.display = 'none';
                    }
                });
            });
        }
    });

    // ---- FORM SUBMISSION HANDLING ----
    // Show all password errors again when form is submitted
    const form = document.querySelector('form[action*="OVRS_Profiles"]');
    if (form) {
        form.addEventListener('submit', function() {
            // Re-show the password error block if it exists
            const passwordErrorBlock = document.getElementById('passwordErrorBlock');
            if (passwordErrorBlock) {
                passwordErrorBlock.style.display = 'block';
            }
            
            // Re-show individual field validation messages
            passwordFields.forEach(function(fieldName) {
                const input = document.querySelector(`[name="${fieldName}"]`);
                if (input) {
                    const fieldValidationSpan = input.parentElement.querySelector('.text-danger');
                    if (fieldValidationSpan && fieldValidationSpan.textContent.trim()) {
                        fieldValidationSpan.style.display = 'block';
                    }
                }
            });
            
            // Re-show general password-related errors
            const generalErrors = document.querySelectorAll('.text-danger');
            generalErrors.forEach(function(errorElement) {
                if (errorElement.textContent && 
                    errorElement.textContent.toLowerCase().includes('password')) {
                    errorElement.style.display = 'block';
                }
            });
        });
    }

}); // End DOMContentLoaded

// ---- Password and email toggle remains unchanged ----
function toggleEdit(field) {
    if (field === 'email') {
        document.getElementById("emailStatic").classList.toggle("d-none");
        document.getElementById("emailInput").classList.toggle("d-none");
    }
}

// Password change toggle
var changePasswordBtn = document.getElementById('changePasswordBtn');
var passwordFields = document.getElementById('passwordFields');
if (changePasswordBtn) {
    changePasswordBtn.addEventListener('click', function () {
        if (passwordFields.classList.contains('d-none')) {
            // OPEN: Show password fields
            passwordFields.classList.remove('d-none');
        } else {
            // CLOSE: Hide password fields, clear values and errors
            passwordFields.classList.add('d-none');

            // Clear input values
            document.querySelector('[name="CurrentPassword"]').value = '';
            document.querySelector('[name="NewPassword"]').value = '';
            document.querySelector('[name="ConfirmPassword"]').value = '';

            // Optionally hide error block/messages
            var passwordErrorBlock = document.getElementById('passwordErrorBlock');
            if (passwordErrorBlock) passwordErrorBlock.style.display = 'none';

            // Hide individual field validation (if present)
            document.querySelectorAll('#passwordFields .text-danger').forEach(function(span) {
                span.style.display = 'none';
            });
        }
    });
}


document.addEventListener('DOMContentLoaded', function () {
    // Show the delete modal on delete button click
    const deleteBtn = document.querySelector('button.btn-danger:not([type="submit"])'); // Your "Delete account" button
    const deleteModal = document.getElementById('deleteAccountModal');
    if (deleteBtn && deleteModal) {
        deleteBtn.addEventListener('click', function () {
            var modal = new bootstrap.Modal(deleteModal);
            modal.show();
        });
    }

    // Validate email and phrase for enabling the delete confirm button
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
    const confirmEmail = document.getElementById('confirmEmail');
    const confirmPhrase = document.getElementById('confirmPhrase');

    function validateDeleteFields() {
        if (
            confirmEmail.value.trim() &&
            confirmPhrase.value.trim() === 'Delete my account'
        ) {
            confirmDeleteBtn.disabled = false;
        } else {
            confirmDeleteBtn.disabled = true;
        }
    }

    if (confirmEmail && confirmPhrase) {
        confirmEmail.addEventListener('input', validateDeleteFields);
        confirmPhrase.addEventListener('input', validateDeleteFields);
    }

    // Optional: clear the form when modal is closed
    if (deleteModal) {
        deleteModal.addEventListener('hidden.bs.modal', function () {
            if (confirmEmail) confirmEmail.value = '';
            if (confirmPhrase) confirmPhrase.value = '';
            if (confirmDeleteBtn) confirmDeleteBtn.disabled = true;
        });
    }
});
</script>

