                <li><a href="https://www.sabc.co.za/sabc/sabc-careers/" title="Jobs">Jobs</a></li>
                <li><a href="https://www.sabc.co.za/sabc/tender-search/" title="Tenders">Tenders</a></li>
            </ul>
            <ul>
                <li><a href="https://www.sabcsales.co.za/" title="Advertise">Advertise</a></li>
