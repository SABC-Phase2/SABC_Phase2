                <li><a href="https://www.sabc.co.za/sabc/sabc-board/" title="SABC Board">SABC Board</a></li>
                <li><a href="https://www.sabc.co.za/sabc/media-statement" title="Press Releases">Press Releases</a></li>
            </ul>
        </div>

        <div class="dmma">
            <p>SABC © 2025</p>
            <a href="http://www.iabsa.net/" title="IAB South Africa Website" target="_blank">
                <img src="https://www.sabc.co.za/sabc/wp-content/uploads/2017/08/mastfooter-iabsa-logo.png" alt="IAB Logo">
            </a>
            <div class="bccsalogo">
                <a href="https://www.sabc.co.za/sabc/bccsa-code-of-conduct/" title="BCCSA South Africa" target="_blank">
                    <img src="https://www.sabc.co.za/sabc/wp-content/uploads/2023/04/bbcsa.png" alt="BCCSA Logo">
                </a>
            </div>
        </div>
    </div>
</div>
