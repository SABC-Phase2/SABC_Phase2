<style>

    .sabc_header {
        width: 100%;
        margin-right: auto;
        margin-left: auto;
        position: fixed;
        top: 0px;
        left: 0;
        right: 0px;
        z-index: 9999;
    }

        .sabc_header .container {
            max-width: 95% !important;
        }

        .sabc_header .top_bar {
            background-color: #131313;
            padding-bottom: 15px;
            padding-top: 15px;
            padding-right: 15px;
            padding-left: 15px;
        }

            .sabc_header .top_bar ul {
                list-style-type: none;
                display: inline-block;
                padding: 0px;
                width: 100%;
                margin-bottom: 0px;
                margin-top: 6px;
                font-size: 12px;
            }

                .sabc_header .top_bar ul li {
                    color: #fff;
                    display: inline-block;
                    margin-right: 30px;
                    font-size: 12px;
                }

            .sabc_header .top_bar .whatsapp {
                color: green;
            }

            .sabc_header .top_bar .search {
                position: relative;
                width: 300px;
                display: inline-block;
                float: right;
            }

                .sabc_header .top_bar .search input {
                    border-radius: 0px;
                    padding: 6px 15px;
                    width: 100%;
                    border: 0px;
                    background-color: #555;
                    color: #fff;
                    font-size: 12px;
                }

                    .sabc_header .top_bar .search input::placeholder {
                        color: #fff;
                        font-size: 12px;
                    }

                .sabc_header .top_bar .search button {
                    border-radius: 0px;
                    border: 0px;
                    position: absolute;
                    top: 0px;
                    right: 0px;
                    padding: 6px 12px;
                }

        .sabc_header .menu_bar {
            background-color: #000;
            padding-bottom: 5px;
            padding-top: 5px;
            padding-right: 15px;
            padding-left: 15px;
        }

            .sabc_header .menu_bar img {
                height: 45px;
            }

            .sabc_header .menu_bar ul.nav-menu {
                list-style-type: none;
                display: flex;
                justify-content: center; /* Center items */
                align-items: center;
                padding: 0;
                margin: 0;
                float: none;
                width: 100%;
                gap: 25px; /* Adjust this value for more/less space */
            }

                .sabc_header .menu_bar ul.nav-menu li.menu-item {
                    text-align: center;
                    margin: 0;
                    position: relative;
                    font-size: 12px;
                    /* Remove flex: 1 1 0; to avoid stretching */
                }
                    /* Nav links: no underline by default, underline on hover */
                    .sabc_header .menu_bar ul.nav-menu li.menu-item a.menu-link {
                        line-height: 45px;
                        color: #fff;
                        font-size: 12px;
                        letter-spacing: -1px;
                        text-decoration: none;
                        transition: color 0.2s, text-decoration 0.2s;
                        display: inline-block;
                        position: relative;
                        text-transform: uppercase; /* Make text uppercase */
                        padding: 0 6px;
                    }

                    .sabc_header .menu_bar ul.nav-menu li.menu-item a {
                        line-height: 45px;
                        color: #fff;
                        font-size: 12px;
                        letter-spacing: -1px;
                    }

            .sabc_header .menu_bar ul.sub-menu {
                display: none;
                position: absolute;
                top: 45px;
                right: -15px;
                z-index: 9;
                background-color: #000;
                padding: 0px;
                margin-bottom: 0px;
                margin-top: 0px;
                list-style-type: none;
                width: 200px;
                border-top: 1px solid #e79d19;
            }

            .sabc_header .menu_bar ul.nav-menu li.menu-item:hover ul.sub-menu {
                display: inline-block;
            }

            .sabc_header .menu_bar ul.sub-menu li.menu-item {
                width: 100%;
                margin-right: 0px;
                display: block;
                border-top: 1px solid #999;
            }

                .sabc_header .menu_bar ul.sub-menu li.menu-item a {
                    padding: 5px 20px;
                    text-align: right;
                    width: 100%;
                    display: block;
                    line-height: 35px;
                }

                    .sabc_header .menu_bar ul.sub-menu li.menu-item a .fa {
                        margin-right: -10px;
                    }

            .sabc_header .menu_bar ul.sub-sub-menu {
                display: none;
                position: absolute;
                left: 100%;
                top: 0px;
                z-index: 9;
                background-color: #000;
                padding: 0px;
                margin-bottom: 0px;
                margin-top: 0px;
                list-style-type: none;
            }

            .sabc_header .menu_bar ul.sub-menu li.menu-item:hover {
                border-top-color: #e79d19;
            }

                .sabc_header .menu_bar ul.sub-menu li.menu-item:hover ul.sub-sub-menu {
                    display: inline-block;
                }

            .sabc_header .menu_bar ul.sub-sub-menu li.menu-item a {
                white-space: nowrap;
            }

            /* Underline on hover */
            .sabc_header .menu_bar ul.nav-menu li.menu-item a.menu-link:hover {
                text-decoration: underline;
            }

            /* Active link color */
            .sabc_header .menu_bar ul.nav-menu li.menu-item a.menu-link.active,
            .sabc_header .menu_bar ul.nav-menu li.menu-item a.menu-link[aria-current="page"] {
                color: #e79d19;
                text-decoration: none;
            }

            /* Remove any existing arrow styles */
            .sabc_header .menu_bar ul.nav-menu li.menu-item > a.menu-link::after {
                content: none;
            }

            /* Style the Font Awesome angle-down icons */
            .sabc_header .menu_bar ul.nav-menu li.menu-item.has-children .fa-angle-down {
                font-size: 0.7em;
                margin-left: 4px;
                color: #e79d19;
                transition: transform 0.3s ease;
            }

            /* Rotate the icon when menu is open (optional) */
            .sabc_header .menu_bar ul.nav-menu li.menu-item.has-children:hover .fa-angle-down {
                transform: rotate(180deg);
            }

            /* Style for submenu items with angle-right icons */
            .sabc_header .menu_bar ul.sub-menu li.menu-item.has-children .fa-angle-right {
                font-size: 0.7em;
                margin-left: 4px;
                color: #e79d19;
                position: absolute;
                right: 10px;
            }

            /* Remove arrow for sub-sub-menus */
            .sabc_header .menu_bar ul.sub-menu li.menu-item > a.menu-link::after,
            .sabc_header .menu_bar ul.sub-sub-menu li.menu-item > a.menu-link::after {
                content: "";
            }

    .sabclogo {
        width: auto; /* let it size naturally */
        height: auto;
        display: flex;
        align-items: center; /* vertically center the image */
    }

        /* Keep the logo image height consistent */
        .sabclogo img {
            height: 41px;
        }

    /* ---------------- MOBILE STYLES ONLY ---------------- */
    @@media (max-width: 991px) {
        /* Top bar stacks */
        .sabc_header .top_bar .row {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .sabc_header .top_bar ul {
            justify-content: center;
            font-size: 13px;
        }

        .sabc_header .top_bar .search {
            width: 100%;
            margin: 10px 0 0 0;
        }
        /* Menu bar compact layout */
        .sabc_header .menu_bar .row {
            flex-wrap: nowrap;
            align-items: center;
        }

        .sabc_header .menu-toggle {
            margin-left: 12px;
        }
        /* Hamburger visible */
        .sabc_header .menu-toggle {
            display: block;
            font-size: 22px;
            color: #fff;
            cursor: pointer;
            margin-left: auto;
        }
        /* Hide nav by default */
        .sabc_header .nav-menu {
            display: none !important;
            flex-direction: column;
            align-items: flex-start;
            background: #111;
            width: 100vw;
            position: fixed;
            left: 0;
            z-index: 10000;
            /* Remove static top, will set via JS */
            padding: 10px 0;
        }

            .sabc_header .nav-menu.show {
                display: flex !important;
            }

            .sabc_header .nav-menu .menu-item {
                width: 100%;
                border-top: 1px solid #222;
            }

                .sabc_header .nav-menu .menu-item a {
                    width: 100%;
                    padding: 10px 15px;
                }
    }
    /* MOBILE + TABLET (up to 1280px) */
    @@media (max-width: 1280px) {
        .sabc_header .menu-toggle {
            display: block;
            font-size: 22px;
            color: #fff;
            cursor: pointer;
            margin-left: auto;
        }
        /* Hide nav by default */
        .sabc_header .nav-menu {
            display: none !important;
            flex-direction: column;
            align-items: flex-start;
            background: #111;
            width: 100vw;
            position: fixed;
            left: 0;
            z-index: 10000;
            padding: 10px 0;
        }

            .sabc_header .nav-menu.show {
                display: flex !important;
            }

            .sabc_header .nav-menu .menu-item {
                width: 100%;
                border-top: 1px solid #222;
            }

                .sabc_header .nav-menu .menu-item a {
                    width: 100%;
                    padding: 10px 15px;
                }
    }

    /* DESKTOP (above 1280px) */
    @@media (min-width: 1281px) {
        .sabc_header .menu-toggle {
            display: none !important;
        }

        .sabc_header .nav-menu {
            display: flex !important;
        }
    }

</style>
