<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SABC_Phase2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SABC_Phase2.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>
<body>
    <header>
        @await Html.PartialAsync("~/Views/Shared/header.cshtml")
    </header>
    <div class="page-banner">
        @ViewData["BannerText"]
        </div>
    @await Html.PartialAsync("~/Views/Shared/sidebar.cshtml")
    <div class="container">
        <main role="main" class="pb-3 page-body-bg">
            @RenderBody()
        </main>
        
    </div>
    <footer>
        @await Html.PartialAsync("~/Views/Shared/footer.cshtml")

    </footer>
    

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }
html, body {
    height: 100%;
    min-height: 100vh;
    margin: 0;
    padding: 0;
}
body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: url('/lib/Images/bg.png');
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    background-attachment: fixed;
    width: 100vw;
    height: 100vh;
    transform: scaleX(-1); /* Flip horizontally */
    pointer-events: none;
}
body {
    background: none !important; /* Remove the original background to avoid double images */
}

    .page-body-bg {
        padding: 20px;
        min-height: 100vh;
        background: transparent;
    }

    .page-banner {
        position: relative; /* Same as sidebar width */
        width: 100%;
        height: 20px;
        margin-right: 0px;
        text-align: center;
        text-transform: uppercase;
        font-size: 44px;
        font-style: Bold;
        color: #000;
        padding: 119px 0;
        background-image: url("/lib/Images/banner.png");
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
    }
</style>
