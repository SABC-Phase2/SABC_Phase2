    }

        .menu-toggle i {
            margin-right: 13px;
            font-size: 2em;
        }

            .menu-toggle i.fas.fa-bars {
                font-size: 2em; /* Adjust this value as needed for desired size */
            }

    .profile {
        display: flex;
