@* Sidebar Razor View for OVRS_User and Administrator roles *@
@{
    var supplierType = User.Identity.IsAuthenticated ? User.FindFirst("SupplierType")?.Value : null;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="sidebar expanded" id="sidebar">
    <div class="menu-toggle" onclick="toggleSidebar()">
        <i class="fas fa-bars" style="margin-right:10px"></i>
        <span class="label">Menu</span>
    </div>
    <!-- Clock section with single divider line -->
    @if (User.Identity.IsAuthenticated && supplierType == "Foreign Supplier")
    {
        <div class="divider-line"></div>
        <div id="sast-clock-box" class="sast-clock-box">
            <span id="sast-clock-label">South African Time</span>
            <span id="sast-clock-sidebar">--:--</span>
        </div>
       
    }
    <div class="profile profile-dropdown" id="profileDropdown" onclick="toggleProfileDropdown(event)">
        <i class="fas fa-user-circle fa-2x"></i>
        <div class="info">
            @if (User.Identity.IsAuthenticated)
            {
                <span class="name">@User.Identity.Name</span>
                <br />
                <span class="supplier-type">@User.FindFirst("SupplierType")?.Value</span>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" style="color:inherit;text-decoration:none;">
                    <span class="name">Sign In / Register</span>
                </a>
            }
        </div>

        @if (User.Identity.IsAuthenticated)
        {
            <span class="chevron-toggle">
                <i class="fas fa-chevron-down" style="margin-left:12px;"></i>
            </span>
            <div class="profile-dropdown-menu" id="profileDropdownMenu">
                @if (User.IsInRole("IT_Admin") || User.IsInRole("Tender_Administrator") || User.IsInRole("Vendor_Administrator"))
                {
                    // All admin types go to Administrator_Profiles in TenderAdmin
                    <a href="@Url.Action("Administrator_Profiles", "TenderAdmin")" class="dropdown-item">
                        <i class="fas fa-id-badge fa-2x"></i> View Profile
                    </a>
                }
                else
                {
                    // OVRS_User and others go to OVRS_Profiles in OVRS_User
                    <a href="@Url.Action("OVRS_Profiles", "OVRS_User")" class="dropdown-item">
                        <i class="fas fa-id-badge fa-2x"></i> View Profile
                    </a>
                }
                <form action="@Url.Action("Logout", "Account")" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item logout">
                        <i class="fas fa-sign-out-alt fa-2x"></i> Logout
                    </button>
                </form>
            </div>
        }
    </div>


    <div class="menu">
        @if (User.Identity.IsAuthenticated && User.IsInRole("IT_Admin"))
        {
            @* IT_Admin MENU: Only Users and Help *@
            <div class="menu-section">
                <i class="fas fa-user-shield fa-2x"></i>
                <a asp-controller="TenderAdmin" asp-action="Users_Management" class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Users
                </a>
            </div>
            <div class="menu-section">
                <i class="fas fa-question fa-2x"></i>
                <a asp-controller="Home" asp-action="Help" class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Help
                </a>
            </div>
        }
        else if (User.Identity.IsAuthenticated && User.IsInRole("Tender_Administrator"))
        {
            @* Tender_Administrator MENU: Tender Panel, Scheduled Tenders, Drafts, Reports, Help *@
            <div class="menu-section has-submenu" onclick="toggleSubmenu(event, this)">
                <i class="fas fa-users fa-2x"></i>
                <a asp-controller="TenderAdmin" asp-action="Index"
                   class="label main-link"
                   style="color:inherit; text-decoration:none; flex: 1;">
                    Tenders Panel
                </a>
                <span class="chevron-toggle">
                    <i class="fas fa-chevron-down submenu-icon" style="margin-left:auto;"></i>
                </span>
            </div>
            <div class="submenu visible">
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="TenderAdmin" asp-action="Index" asp-route-status="open"
                       class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Open Tenders
                    </a>
                </div>
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="TenderAdmin" asp-action="Index" asp-route-status="closed"
                       class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Closed Tenders
                    </a>
                </div>
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="TenderAdmin" asp-action="Index" asp-route-status="cancelled"
                       class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Cancelled Tenders
                    </a>
                </div>
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="TenderAdmin" asp-action="Index" asp-route-status="awarded"
                       class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Awarded Tenders
                    </a>
                </div>
            </div>
            <div class="menu-section">
                <i class="fas fa-file-alt fa-2x"></i>
                <a asp-controller="TenderAdmin" asp-action="ScheduledIndex" class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Scheduled Tenders
                </a>
            </div>
            <div class="menu-section">
                <i class="fas fa-times fa-2x"></i>
                <a asp-controller="TenderAdmin" asp-action="DraftIndex" class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Drafts
                </a>
            </div>
            <div class="menu-section">
                <i class="fas fa-download fa-2x"></i>
                <a asp-controller="TenderAdmin" asp-action="Reports_Index" class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Reports
                </a>
            </div>
            <div class="menu-section">
                <i class="fas fa-question fa-2x"></i>
                <a asp-controller="Home" asp-action="Help" class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Help
                </a>
            </div>
        }
        else if (User.Identity.IsAuthenticated && User.IsInRole("Vendor_Administrator"))
        {
            @* Vendor_Administrator MENU: *@
            <div class="menu-section">
                <i class="fas fa-handshake fa-2x" style="color: white;"></i>
                <a href="https://etender.sabc.co.za/login.aspx"
                   target="_blank"
                   class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Registered Suppliers
                </a>
            </div>
           
            <div class="menu-section">
                <i class="fas fa-question fa-2x"></i>
                <a asp-controller="Home" asp-action="Help" class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Help
                </a>
            </div>
          
        }
        else if (User.Identity.IsAuthenticated && User.IsInRole("OVRS_User"))
        {
            @* OVRS_USER MENU *@
            <div class="menu-section has-submenu" onclick="toggleSubmenu(event, this)">
                <i class="fas fa-users fa-2x"></i>
                <a asp-controller="OVRS_User" asp-action="AllTenders" class="label main-link" style="color:inherit; text-decoration:none; flex: 1;">
                    Tenders
                </a>
                <span class="chevron-toggle">
                    <i class="fas fa-chevron-down submenu-icon" style="margin-left:auto;"></i>
                </span>
            </div>
            <div class="submenu visible">
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="open" class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Open Tenders
                    </a>
                </div>
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="closed" class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Closed Tenders
                    </a>
                </div>
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="cancelled" class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Cancelled Tenders
                    </a>
                </div>
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="awarded" class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Awarded Tenders
                    </a>
                </div>
            </div>
            <div class="menu-section">
                <i class="fas fa-handshake fa-2x" style="color: white;"></i>
                <a href="https://etender.sabc.co.za/login.aspx"
                   target="_blank"
                   class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Company Details
                </a>
            </div>
            <div class="menu-section">
                <i class="fas fa-file-alt fa-2x" style="color: white;"></i>
                <a asp-controller="OVRS_User" asp-action="OVRS_Documents" class="label" style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    My Documents
                </a>
            </div>
            <div class="menu-section">
                <i class="fas fa-question fa-2x"></i>
                <a asp-controller="Home" asp-action="Help" class="label" style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Help
                </a>
            </div>
        }
        else
        {
            @* Unauthenticated or other menu *@
            <div class="menu-section has-submenu" onclick="toggleSubmenu(event, this)">
                <i class="fas fa-users fa-2x"></i>
                <a asp-controller="OVRS_User" asp-action="AllTenders" class="label main-link" style="color:inherit; text-decoration:none; flex: 1;">
                    Tenders
                </a>
                <span class="chevron-toggle">
                    <i class="fas fa-chevron-down submenu-icon" style="margin-left:auto;"></i>
                </span>
            </div>
            <div class="submenu visible">
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="open" class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Open Tenders
                    </a>
                </div>
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="closed" class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Closed Tenders
                    </a>
                </div>
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="cancelled" class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Cancelled Tenders
                    </a>
                </div>
                <div class="menu-section sub-item">
                    <i class="fas fa-circle-dot green"></i>
                    <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="awarded" class="label"
                       style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                        Awarded Tenders
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<script>
    // Clock Javascript
    function updateSASTClock() {
        fetch('/api/time/sast-now')
            .then(response => response.json())
            .then(data => {
                const timePart = data.time.split(' ')[1]; // HH:mm:ss

                const headerClock = document.getElementById("sast-clock-header");
                const sidebarClock = document.getElementById("sast-clock-sidebar");

                if (headerClock) headerClock.textContent = timePart;
                if (sidebarClock) sidebarClock.textContent = timePart.substring(0,5); // just HH:mm
            })
            .catch(() => {
                const headerClock = document.getElementById("sast-clock-header");
                const sidebarClock = document.getElementById("sast-clock-sidebar");

                if (headerClock) headerClock.textContent = "--:--:--";
                if (sidebarClock) sidebarClock.textContent = "--:--";
            });
    }


    // Initial call
    updateSASTClock();
    // Update every 5 seconds for live clock
    setInterval(updateSASTClock, 5000);

    // --------------------------------------------------------------

    function toggleSidebar() {
        const sidebar = document.getElementById("sidebar");
        sidebar.classList.toggle("collapsed");

        const menuIcon = sidebar.querySelector(".menu-toggle i.fas.fa-bars");
        if (menuIcon) {
            menuIcon.classList.toggle("rotated", sidebar.classList.contains("collapsed"));
        }

        // Toggle chevron visibility based on sidebar state
        const chevrons = document.querySelectorAll('.chevron-toggle');
        if (sidebar.classList.contains("collapsed")) {
            chevrons.forEach(chevron => {
                chevron.style.display = "none";
            });
        } else {
            chevrons.forEach(chevron => {
                chevron.style.display = "inline";
                // Restore rotation state if submenu was open
                const submenu = chevron.closest('.has-submenu')?.nextElementSibling;
                const icon = chevron.querySelector(".submenu-icon");
                if (submenu?.classList.contains('visible')) {
                    icon?.classList.add("rotated");
                } else {
                    icon?.classList.remove("rotated");
                }
            });
        }
    }

    function toggleSubmenu(event, element) {
        const isLinkClick = event.target.closest('a');
        if (isLinkClick) return; // Don't toggle submenu if clicking the link

        const submenu = element.nextElementSibling;
        submenu.classList.toggle("visible");
        const chevronToggle = element.querySelector('.chevron-toggle');
        const icon = chevronToggle?.querySelector(".submenu-icon");

        if (submenu.classList.contains("visible")) {
            chevronToggle.style.display = "inline";
            icon?.classList.add("rotated");
        } else {
            chevronToggle.style.display = "inline";
            icon?.classList.remove("rotated");
        }
    }

    function manageSubmenus() {
        const currentPath = window.location.pathname.toLowerCase();
        const currentSearch = window.location.search.toLowerCase();
        let foundActive = false;
        let activeSubmenu = null;
        let parentMenuItem = null;

        // Reset all active states
        document.querySelectorAll('.menu-section').forEach(function(el) {
            el.classList.remove('active');
        });

        // First pass - find active item and its parent submenu
        document.querySelectorAll('.menu-section.sub-item a').forEach(function(link) {
            if (link.pathname.toLowerCase() === currentPath) {
                const linkSearch = link.search.toLowerCase();
                if ((!linkSearch && !currentSearch) || (linkSearch && currentSearch && linkSearch === currentSearch)) {
                    link.parentElement.classList.add('active');
                    foundActive = true;
                    activeSubmenu = link.closest('.submenu');
                    parentMenuItem = activeSubmenu?.previousElementSibling;
                }
            }
        });

        // If a submenu item is active, also mark its parent menu item as active
        if (parentMenuItem) {
            parentMenuItem.classList.add('active');
        }

        // Second pass - close all submenus except the active one
        document.querySelectorAll('.submenu').forEach(function(submenu) {
            const parentItem = submenu.previousElementSibling;
            const chevron = parentItem?.querySelector('.chevron-toggle');
            const icon = chevron?.querySelector(".submenu-icon");

            if (submenu === activeSubmenu) {
                submenu.classList.add('visible');
                if (chevron) chevron.style.display = "inline";
                if (icon) icon.classList.add("rotated");
            } else {
                submenu.classList.remove('visible');
                if (chevron) chevron.style.display = "inline";
                if (icon) icon.classList.remove("rotated");
            }
        });

        // Handle non-submenu active states
        if (!foundActive) {
            document.querySelectorAll('.menu-section:not(.sub-item) a').forEach(function(link) {
                if (link.pathname && link.pathname.toLowerCase() === currentPath) {
                    link.parentElement.classList.add('active');
                    foundActive = true;
                }
            });
        }
    }

    function toggleProfileDropdown(e) {
        e.stopPropagation();

        const profile = document.getElementById('profileDropdown');
        const caret = profile.querySelector('.profile-caret');
        const menu = document.getElementById('profileDropdownMenu');
        const isOpen = profile.classList.contains('open');
        profile.classList.toggle('open', !isOpen);

        if (caret) caret.classList.toggle('open', !isOpen);
        if (menu) menu.style.display = !isOpen ? 'flex' : 'none';
    }

    function adjustSidebarHeight() {
        const headerHeight = 120; // Same as .sidebar top
        const footer = document.querySelector('footer');
        const sidebar = document.querySelector('.sidebar');

        if (footer && sidebar) {
            const footerRect = footer.getBoundingClientRect();
            const footerTop = footerRect.top + window.scrollY;
            const viewportHeight = window.innerHeight;
            const scrollY = window.scrollY;
            const maxHeight = footerTop - scrollY - headerHeight;

            sidebar.style.height = `${Math.max(0, maxHeight)}px`;
        }
    }

    // Initialize on DOM load
    document.addEventListener("DOMContentLoaded", function() {
        manageSubmenus();

        const sidebar = document.getElementById("sidebar");
        const chevrons = document.querySelectorAll('.chevron-toggle');

        if (sidebar.classList.contains("collapsed")) {
            chevrons.forEach(chevron => {
                chevron.style.display = "none";
            });
        } else {
            chevrons.forEach(chevron => {
                chevron.style.display = "inline";
            });
        }
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        const profile = document.getElementById('profileDropdown');
        if (profile && profile.classList.contains('open')) {
            if (!profile.contains(event.target)) {
                profile.classList.remove('open');
                const caret = profile.querySelector('.profile-caret');
                if (caret) caret.classList.remove('open');
                document.getElementById('profileDropdownMenu').style.display = 'none';
            }
        }

        // Auto-close submenus when clicking elsewhere
        if (!event.target.closest('.has-submenu') && !event.target.closest('.submenu')) {
            document.querySelectorAll('.submenu').forEach(submenu => {
                if (!submenu.contains(event.target)) {
                    submenu.classList.remove('visible');
                    const chevron = submenu.previousElementSibling?.querySelector('.chevron-toggle');
                    const icon = chevron?.querySelector(".submenu-icon");
                    if (chevron) chevron.style.display = "inline";
                    if (icon) icon.classList.remove("rotated");
                }
            });
        }
    });

    // Handle navigation clicks to manage submenus
    document.addEventListener('click', function(event) {
        if (event.target.closest('a') && !event.target.closest('.dropdown-item')) {
            setTimeout(manageSubmenus, 10);
        }
    });

    // Window event listeners
    window.addEventListener('scroll', adjustSidebarHeight);
    window.addEventListener('resize', adjustSidebarHeight);
    window.addEventListener('load', adjustSidebarHeight);
</script>



<style>
    /* --------------------------------- */

    /* Clock Styles - Compact */
    .sast-clock-box {
        width: 100%;
        text-align: center;
        padding: 8px 0;
        color: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 0px; /* Reduced from previous value, only affects top spacing */
    }

    #sast-clock-label {
        font-size: 0.7em;
        letter-spacing: 0.5px;
        opacity: 0.7;
        text-transform: uppercase;
        font-weight: 300;
        margin-bottom: 1px;
    }

    #sast-clock-header {
        font-size: 1.1em;
        font-weight: 400;
        color: #fbbd08;
        letter-spacing: 1px;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    #sast-clock {
        font-size: 1.1em;
        font-weight: 400;
        color: #fbbd08;
        letter-spacing: 1px;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    #sast-clock-sidebar {
        font-size: 1.1em;
        font-weight: 400;
        color: #fbbd08;
        letter-spacing: 1px;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    /* Divider line style */
    .divider-line {
        height: 1px;
        width: 100%;
        background-color: #666;
        margin: 1px 0 18px 0;
        margin-top: 0px;
    }

    /* Collapsed state */
    .sidebar.collapsed .sast-clock-box {
        padding: 6px 0;
    }

    .sidebar.collapsed #sast-clock-label {
        display: none;
    }

    .sidebar.collapsed #sast-clock {
        font-size: 0.9em;
    }

    /* --------------------------------- */

    /* Modify the existing .green class and add active state */
    .menu-section.sub-item i.fa-circle-dot {
        color: #33cc33; /* Green by default */
    }

    .menu-section.sub-item.active i.fa-circle-dot {
        color: #fbbd08 !important; /* Yellow when active */
    }

    /* Keep all other active states normal */
    .menu-section.sub-item.active {
        background-color: transparent;
        color: white; /* Keep text white */
    }

        /* Ensure the label stays white when active */
        .menu-section.sub-item.active .label {
            color: white;
        }

    .sidebar {
        background-color: #333;
        color: #fff;
        width: 280px;
        position: fixed;
        top: 120px;
        left: 0;
        height: calc(100vh - 90px);
        padding: 10px;
        padding-left: 10px;
        transition: width 0.3s ease;
        overflow: hidden;
        overflow-x: hidden;
        z-index: 9998;
    }

    .menu {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
    }

    .sidebar.collapsed {
        width: 70px;
    }

    .menu-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 18px 10px;
        width: 100%;
    }

        .menu-toggle i {
            margin-right: 13px;
            font-size: 2em;
        }

            .menu-toggle i.fas.fa-bars {
                font-size: 2em;
            }

    .profile {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px 0;
        border-top: 1px solid #666;
        border-bottom: 1px solid #666;
        margin-bottom: 15px;
        width: 100%;
    }

        .profile .info {
            margin-left: 30px;
        }

        .profile img {
            border-radius: 50%;
            width: 40px;
            height: 40px;
        }

        .profile .name {
            font-weight: bold;
        }

        .profile .role {
            font-size: 12px;
            color: #ccc;
        }

    .menu-section {
        width: 90%;
        justify-content: flex-start;
        margin: 0;
        box-sizing: border-box;
        padding: 14px 18px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        transition: background 0.2s, color 0.2s;
        gap: 0; /* Remove default gap, we'll set it for main items only */
    }

        .menu-section:not(.sub-item) .label {
            margin-left: 28px; /* More space between icon and label for main nav */
        }

        .menu-section:hover {
            background-color: #444;
        }

        .menu-section.active {
            background-color: #fbbd08;
            color: black;
        }

        .menu-section i {
            width: 50px; /* Increased from 30px for better alignment */
            text-align: center;
            min-width: 50px;
        }

    .submenu {
        display: none;
        flex-direction: column;
        width: 100%;
        margin: 0;
        padding: 0;
    }

        .submenu.visible {
            display: flex;
        }

