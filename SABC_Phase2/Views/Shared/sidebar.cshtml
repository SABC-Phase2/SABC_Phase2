        padding: 10px;
        padding-left: 10px;
        transition: width 0.3s ease;
        overflow: auto;
        overflow-x: hidden;
        z-index: 9998;
    }

    .menu {
        display: flex;
        flex-direction: column;
        align-items: center; /* Center contents horizontally */
        gap: 10px; /* Small gap between nav items */
    }

    .sidebar.collapsed {
        width: 70px;
    }

    .menu-toggle {
        display: flex;
        align-items: center;
        justify-content: center; /* Center horizontally */
        cursor: pointer;
        padding: 18px 10px; /* Remove side padding for better fit */
