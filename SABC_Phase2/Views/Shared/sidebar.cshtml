        padding: 14px 18px; /* Increased padding for more space around text */
        border-radius: 8px; /* Optional: slightly more rounded corners */
        display: flex;
        align-items: center;
        transition: background 0.2s, color 0.2s;
    }

        .menu-section:hover {
            background-color: #444;
        }

    font-face-name {
        color: #fbbd08;
    }

    .menu-section.active {
        background-color: #fbbd08;
