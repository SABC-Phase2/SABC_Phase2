<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">



<div class="sidebar expanded" id="sidebar">
    <div class="menu-toggle" onclick="toggleSidebar()">
      <i class="fas fa-bars"></i>
      <span class="label">Hide Menu</span>
    </div>

    <div class="profile">
      <i class="fas fa-user-circle fa-3x"></i>
      <div class="info">
        <span class="name">Truth Xiviti</span>
        <br />
        <span class="role">Administrator</span>
      </div>
    </div>

    <div class="menu">
        <div class="menu-section has-submenu active" onclick="toggleSubmenu(this)">
            <i class="fas fa-users"></i>
            <span class="label">Tenders</span>
            <i class="fas fa-chevron-up submenu-icon" style="margin-left:auto;"></i>
        </div>

        <div class="submenu visible">
            <div class="menu-section sub-item">
                <i class="fas fa-circle-dot green"></i>
                <a asp-controller="TenderAdmin" asp-action="Index" class="label" style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    All Tender Tenders
                </a>
            </div>
            <div class="menu-section sub-item"><i class="fas fa-circle-dot green"></i><span class="label">Open Tenders</span></div>
            <div class="menu-section sub-item"><i class="fas fa-circle-dot green"></i><span class="label">Closed Tenders</span></div>
            <div class="menu-section sub-item"><i class="fas fa-circle-dot green"></i><span class="label">Canceled Tenders</span></div>
            <div class="menu-section sub-item"><i class="fas fa-circle-dot green"></i><span class="label">Awarded Tenders</span></div>
        </div>
          <div class="menu-section">
              <i class="fas fa-file-alt"></i>
            <a asp-controller="TenderAdmin" asp-action="ScheduledIndex" class="label" style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                Scheduled Tenders
            </a>
          </div>
        <div class="menu-section">
            <i class="fas fa-times"></i>
            <a asp-controller="TenderAdmin" asp-action="DraftIndex" class="label" style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                Drafts
            </a>
        </div>
      <div class="menu-section"><i class="fas fa-download"></i><span class="label">  Reports</span></div>
      <div class="menu-section"><i class="fas fa-question"></i><span class="label">  Help</span></div>
    </div>
  </div>



<script>

    function toggleSidebar() {
      const sidebar = document.getElementById("sidebar");
      sidebar.classList.toggle("collapsed");
      const menuIcon = sidebar.querySelector(".menu-toggle i.fas.fa-bars");
      if (menuIcon) {
        menuIcon.classList.toggle("rotated", sidebar.classList.contains("collapsed"));
      }
    }
    function toggleSubmenu(element) {
      const submenu = element.nextElementSibling;
      submenu.classList.toggle("visible");

      const icon = element.querySelector(".submenu-icon");
      if (icon) icon.classList.toggle("rotated");
    }

      function adjustSidebarHeight() {
        const headerHeight = 120; // Same as .sidebar top
        const footer = document.querySelector('footer');
        const sidebar = document.querySelector('.sidebar');

        if (footer && sidebar) {
            const footerRect = footer.getBoundingClientRect();
            const footerTop = footerRect.top + window.scrollY;
            const viewportHeight = window.innerHeight;
            const scrollY = window.scrollY;

            // Distance from top of page to top of footer minus the header height
            const maxHeight = footerTop - scrollY - headerHeight;

            sidebar.style.height = `${Math.max(0, maxHeight)}px`;
        }
    }

    window.addEventListener('scroll', adjustSidebarHeight);
    window.addEventListener('resize', adjustSidebarHeight);
    window.addEventListener('load', adjustSidebarHeight);
</script>

<style>

