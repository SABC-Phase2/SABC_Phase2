<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<div class="sidebar expanded" id="sidebar">
    <div class="menu-toggle" onclick="toggleSidebar()">
        <i class="fas fa-bars"></i>
        <span class="label">Hide Menu</span>
    </div>

    <div class="profile">
        <i class="fas fa-user-circle fa-3x"></i>
        <div class="info">
            <span class="name">Truth Xiviti</span>
            <br />
            <span class="role">Administrator</span>
        </div>
    </div>

    <div class="menu">
        <div class="menu-section has-submenu" onclick="toggleSubmenu(this)">
            <i class="fas fa-users"></i>
            <a asp-controller="TenderAdmin" asp-action="Index" class="label main-link" style="color:inherit; text-decoration:none; flex: 1;">
                Tenders
            </a>
            <span class="chevron-toggle">
                <i class="fas fa-chevron-down submenu-icon" style="margin-left:auto;"></i>
            </span>
        </div>

        <div class="submenu visible">
            <div class="menu-section sub-item">
                <i class="fas fa-circle-dot green"></i>
                <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="open" class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Open Tenders
                </a>
            </div>
            <div class="menu-section sub-item">
                <i class="fas fa-circle-dot green"></i>
                <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="closed" class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Closed Tenders
                </a>
            </div>
            <div class="menu-section sub-item">
                <i class="fas fa-circle-dot green"></i>
                <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="cancelled" class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Cancelled Tenders
                </a>
            </div>
            <div class="menu-section sub-item">
                <i class="fas fa-circle-dot green"></i>
                <a asp-controller="OVRS_User" asp-action="Index" asp-route-status="awarded" class="label"
                   style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                    Awarded Tenders
                </a>
            </div>
        </div>
        <div class="menu-section">
            <i class="fas fa-file-alt"></i>
            <a asp-controller="TenderAdmin" asp-action="ScheduledIndex" class="label" style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                Scheduled Tenders
            </a>
        </div>
        <div class="menu-section">
            <i class="fas fa-times"></i>
            <a asp-controller="TenderAdmin" asp-action="DraftIndex" class="label" style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                Drafts
            </a>
        </div>
        <div class="menu-section">
            <i class="fas fa-download"></i>
            <a asp-controller="TenderAdmin" asp-action="Reports_Index" class="label" style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                Reports
            </a>
        </div>

        <div class="menu-section">
            <i class="fas fa-handshake" style="color: white;"></i>
            <span class="label">Company Details</span>
        </div>
        <div class="menu-section">
            <i class="fas fa-file-alt" style="color: white;"></i>
            <a asp-controller="OVRS_User" asp-action="OVRS_Documents" class="label" style="color:inherit; text-decoration:none; display:inline-block; width:100%;">
                My Documents
            </a>
        </div>



        <div class="menu-section">
            <i class="fas fa-question"></i>
            <span class="label">Help</span>
        </div>
     
    </div>
</div>

<script>
    function toggleSidebar() {
      const sidebar = document.getElementById("sidebar");
      sidebar.classList.toggle("collapsed");
      const menuIcon = sidebar.querySelector(".menu-toggle i.fas.fa-bars");
      if (menuIcon) {
        menuIcon.classList.toggle("rotated", sidebar.classList.contains("collapsed"));
      }
    }
    function toggleSubmenu(element) {
        const isLinkClick = event.target.closest('a');
        if (isLinkClick) return; // Don't toggle submenu if clicking the link

        const submenu = element.nextElementSibling;
        submenu.classList.toggle("visible");

        // Find the chevron toggle span
        const chevronToggle = element.querySelector('.chevron-toggle');
        if (submenu.classList.contains("visible")) {
            // Show chevron if submenu is visible
            chevronToggle.style.display = "inline";
            const icon = chevronToggle.querySelector(".submenu-icon");
            if (icon) icon.classList.add("rotated");
        } else {
            // Hide chevron if submenu is hidden
            chevronToggle.style.display = "none";
        }
    }

    // On page load, set chevron visibility based on submenu state
    document.addEventListener("DOMContentLoaded", function () {
        var submenuTrigger = document.querySelector('.menu-section.has-submenu');
        var submenu = submenuTrigger && submenuTrigger.nextElementSibling;
        var chevronToggle = submenuTrigger && submenuTrigger.querySelector('.chevron-toggle');

        if (submenu && chevronToggle) {
            if (submenu.classList.contains('visible')) {
                chevronToggle.style.display = "inline";
                const icon = chevronToggle.querySelector(".submenu-icon");
                if (icon) icon.classList.add("rotated");
            } else {
                chevronToggle.style.display = "none";
            }
        }

        // Highlight the correct menu item based on URL
        document.querySelectorAll('.menu-section').forEach(function (el) {
            el.classList.remove('active');
        });

        var currentPath = window.location.pathname.toLowerCase();
        var currentSearch = window.location.search.toLowerCase();

        var foundActive = false;
        document.querySelectorAll('.menu-section.sub-item a').forEach(function(link) {
            if (link.pathname.toLowerCase() === currentPath) {
                var linkSearch = link.search.toLowerCase();
                if (linkSearch && currentSearch && linkSearch === currentSearch) {
                    link.parentElement.classList.add('active');
                    foundActive = true;
                }
            }
        });
        if (!foundActive) {
            document.querySelectorAll('.menu-section:not(.sub-item) a').forEach(function(link) {
                if (link.pathname && link.pathname.toLowerCase() === currentPath) {
                    link.parentElement.classList.add('active');
                    foundActive = true;
                }
            });
        }
        if (!foundActive) {
            var helpSection = document.querySelector('.menu-section:last-child');
            if (helpSection) helpSection.classList.add('active');
        }
    });

    function adjustSidebarHeight() {
        const headerHeight = 120; // Same as .sidebar top
        const footer = document.querySelector('footer');
        const sidebar = document.querySelector('.sidebar');

        if (footer && sidebar) {
            const footerRect = footer.getBoundingClientRect();
            const footerTop = footerRect.top + window.scrollY;
            const viewportHeight = window.innerHeight;
            const scrollY = window.scrollY;
            const maxHeight = footerTop - scrollY - headerHeight;
            sidebar.style.height = `${Math.max(0, maxHeight)}px`;
        }
    }

    window.addEventListener('scroll', adjustSidebarHeight);
    window.addEventListener('resize', adjustSidebarHeight);
    window.addEventListener('load', adjustSidebarHeight);
</script>

<style>
    .sidebar {
        background-color: #333;
        color: #fff;
        width: 280px;
        position: fixed;
        top: 120px;
        left: 0;
        height: calc(100vh - 90px);
        padding: 10px;
        padding-left: 10px;
        transition: width 0.3s ease;
        overflow: auto;
        overflow-x: hidden;
        z-index: 9998;
    }

    .menu {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .sidebar.collapsed {
        width: 70px;
    }

    .menu-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 18px 10px;
        width: 100%;
    }

        .menu-toggle i {
            margin-right: 13px;
            font-size: 2em;
        }

            .menu-toggle i.fas.fa-bars {
                font-size: 2em;
            }

    .profile {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 10px 0;
        border-top: 1px solid #666;
        border-bottom: 1px solid #666;
        margin-bottom: 15px;
        width: 100%;
    }

        .profile .info {
            margin-left: 10px;
        }

        .profile img {
            border-radius: 50%;
            width: 40px;
            height: 40px;
        }

        .profile .name {
            font-weight: bold;
        }

        .profile .role {
            font-size: 12px;
            color: #ccc;
        }

    .menu-section {
        width: 90%;
        justify-content: flex-start;
        margin: 0;
        box-sizing: border-box;
        padding: 14px 18px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        transition: background 0.2s, color 0.2s;
    }

        .menu-section:hover {
            background-color: #444;
        }

        .menu-section.active {
            background-color: #fbbd08;
            color: black;
        }

        .menu-section i {
            width: 30px;
            text-align: center;
        }

    .submenu {
        display: none;
        flex-direction: column;
        width: 100%;
        margin: 0;
        padding: 0;
    }

        .submenu.visible {
            display: flex;
        }

    .submenu-icon {
        margin-left: auto;
        transition: transform 0.3s ease;
    }

        .submenu-icon.rotated {
            transform: rotate(180deg);
        }

    .chevron-toggle {
        display: inline;
    }

    /* Style sub-items same as menu-section but indented */
    .menu-section.sub-item {
        padding-left: 70px;
        font-size: 14px;
    }

        .menu-section.sub-item:hover {
            background-color: #444;
        }

    .submenu li {
        display: flex;
        align-items: center;
        margin-bottom: 5px;
    }

    .dot {
        height: 10px;
        width: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 10px;
    }

    .green {
        color: #33cc33 !important;
    }

    .label {
        display: inline-block;
        white-space: nowrap;
    }

    .sidebar.collapsed {
        width: 70px;
        min-width: 70px;
    }

        .sidebar.collapsed .profile .info {
            display: none;
        }

        .sidebar.collapsed .label {
            display: none;
        }

    .menu-toggle i.fas.fa-bars.rotated {
        transform: rotate(90deg);
        transition: transform 0.3s;
    }

    .sidebar.collapsed .submenu-icon {
        display: none !important;
    }
</style>